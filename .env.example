# file-fly environment template. Copy to `.env` and fill in. Every variable is
# optional unless noted; see `src/environment.ts` for the authoritative schema
# and defaults. Never commit a real `.env`.

NODE_ENV=development
PORT=3000

# --- Basic auth perimeter -------------------------------------------------------
# Both or neither. When both are set, EVERY route except /health requires the
# `x-auth-username` and `x-auth-password` headers, re-sent on every request
# (curl: -H "x-auth-username: alice" -H "x-auth-password: s3cret").
# When unset, the perimeter is skipped entirely (with one boot warning).
# The standard Authorization header is never honored.
# AUTH_USERNAME=
# AUTH_PASSWORD=

# --- Logging -------------------------------------------------------------------
# fatal | error | warn | info | debug | trace. Unset: info in prod, debug elsewhere.
# Invalid values reject boot.
# LOG_LEVEL=info

# --- Metrics -------------------------------------------------------------------
# METRICS_DIR=./metrics
# METRICS_TOKEN=               # bearer for GET /metrics; required in production
# METRICS_FLUSH_INTERVAL_MS=1000
# METRICS_RETENTION_DAYS=35

# --- Output cache --------------------------------------------------------------
# CACHE_DIR=./cache
# CACHE_TTL_MS=86400000
# CACHE_MAX_BYTES=2147483648
# CACHE_SWEEP_INTERVAL_MS=600000
# CACHE_TMP_MAX_AGE_MS=3600000

# --- ClamAV (virus scanning; skipped with a warning when unset) ----------------
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=60000
# CLAMAV_MAX_BYTES=26214400

# --- OCR (tesseract.js pool) ---------------------------------------------------
# TESSERACT_DIR=               # defaults to <CACHE_DIR>/tesseract
# TESSERACT_POOL_SIZE=2
# TESSERACT_PRELOAD=eng
# TESSERACT_RECYCLE_JOBS=500
# TESSERACT_TIMEOUT_MS=60000

# --- Networking ----------------------------------------------------------------
# CORS_ORIGIN=                  # production only; comma-separated; unset = no cross-origin reads
# TRUST_PROXY=false             # honor X-Forwarded-For (only behind a proxy you control)
# EGRESS_ALLOWLIST=             # comma-separated hostnames for the source= download path

# --- Dashboard static files ----------------------------------------------------
# DASHBOARD_DIR=./packages/dashboard/dist
