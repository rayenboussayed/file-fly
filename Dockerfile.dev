# Custom development image based on platformatic/node-caged (Node 26, pointer compression).
FROM platformatic/node-caged:26-slim AS dev

ENV NODE_ENV=development \
    NPM_CONFIG_UPDATE_NOTIFIER=false

WORKDIR /app

# Install runtime/build dependencies required by NestJS, native modules, and optional tooling.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       ca-certificates \
       openssl \
  && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm ci

COPY . .

EXPOSE 3000

CMD ["npm", "run", "start:dev"]
