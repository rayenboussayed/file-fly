# Custom development image based on platformatic/node-caged (Node 26, pointer compression).
FROM platformatic/node-caged:26-slim AS dev

ENV NODE_ENV=development \
    NPM_CONFIG_UPDATE_NOTIFIER=false

WORKDIR /app

# Install runtime/build dependencies required by NestJS, native modules, and optional tooling.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       ca-certificates \
       openssl \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir -p /app && chown -R node:node /app

# Run as the image's unprivileged node user (uid 1000) so files written into the
# bind-mounted repo (dist/, cache/) keep the host user's ownership.
USER node

COPY --chown=node:node package.json package-lock.json .npmrc ./
COPY --chown=node:node packages/backend/package.json packages/backend/package.json
# husky (the `prepare` script) is not a dependency; install without lifecycle scripts.
RUN npm ci --ignore-scripts

COPY --chown=node:node . .

EXPOSE 3000

CMD ["npm", "run", "start:dev", "-w", "file-fly-backend"]
