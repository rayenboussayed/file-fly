{
  "name": "file-fly-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "check": "npm run build && npm run typecheck && npm run lint && npm run test:full",
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint . --fix --cache --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:perf": "vitest bench --run --config ./vitest.config.performance.ts",
    "test:mem": "vitest run --config ./vitest.config.mem.ts",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "npm run build && vitest run --config ./vitest.config.e2e.ts",
    "test:full": "npm run test && npm run test:e2e",
    "script:union-to-enum": "node scripts/union-to-enum.js --types DemuxerFormat MuxerFormat --unions MuxerFormat --output src/constants/av-formats.ts"
  },
