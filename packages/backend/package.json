{
  "name": "file-fly-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "check": "npm run build && npm run typecheck && npm run lint && npm run test:full",
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint . --fix --cache --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:perf": "vitest bench --run --config ./vitest.config.perf.ts",
    "test:mem": "vitest run --config ./vitest.config.mem.ts",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "npm run build && vitest run --config ./vitest.config.e2e.ts",
    "test:full": "npm run test && npm run test:e2e",
    "script:union-to-enum": "node scripts/union-to-enum.js --file node_modules/node-av/dist/constants/formats.d.ts --types DemuxerFormat MuxerFormat --output src/constants/av-formats.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "clamscan": "^2.4.0",
    "file-type": "^22.3.0",
    "jutilities": "^1.3.0",
    "nestjs-cls": "^7.0.2",
    "node-av": "^6.2.0",
    "pdq-wasm": "^0.3.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "undici": "^8.12.3",
    "zod": "^4.6.7",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/clamscan": "^2.4.1",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
