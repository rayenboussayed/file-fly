/pdf/elements.js:135","src":"packages/backend/src/resources/pdf/elements.ts:266"},"level":0},{"id":"paintCellText","longname":"paintCellText","name":"paintCellText","kind":"function","scope":"global","description":"Paints one cell's text lines, vertically top-aligned with padding.","params":[{"description":"The target page.","name":"page","type":{"names":["PDFPage"]}},{"description":"The normalized cell.","name":"cell","type":{"names":["{ align: Align; colSpan: number; fill?: string; size: number; text: string; }"]}},{"description":"The cell's left edge in points.","name":"cellX","type":{"names":["number"]}},{"description":"The cell's top edge (distance from the page top) in points.","name":"cursorY","type":{"names":["number"]}},{"description":"The text column width in points.","name":"innerWidth","type":{"names":["number"]}},{"description":"The body font.","name":"font","type":{"names":["PDFFont"]}},{"description":"The header font for the header row.","name":"headerFont","type":{"names":["PDFFont"]}},{"description":"Whether this cell belongs to the header row.","name":"isHeader","type":{"names":["boolean"]}}],"meta":{"lineno":240},"order":14,"mdaics":{"dist":"packages/backend/dist/resources/pdf/elements.js:148","src":"packages/backend/src/resources/pdf/elements.ts:298"},"level":0},{"id":"paintRow","longname":"paintRow","name":"paintRow","kind":"function","scope":"global","description":"Paints one row: cell backgrounds, borders and text.","params":[{"description":"The target page.","name":"page","type":{"names":["PDFPage"]}},{"description":"The normalized cells in the row.","name":"row","type":{"names":["{ align: Align; colSpan: number; fill?: string; size: number; text: string; }[]"]}},{"description":"The resolved column widths in points.","name":"colWidths","type":{"names":["number[]"]}},{"description":"The row's top edge (distance from the page top) in points.","name":"cursorY","type":{"names":["number"]}},{"description":"The row height in points.","name":"rowHeight","type":{"names":["number"]}},{"description":"The row's left edge in points.","name":"startX","type":{"names":["number"]}},{"description":"The body font.","name":"font","type":{"names":["PDFFont"]}},{"description":"The header font for the header row.","name":"headerFont","type":{"names":["PDFFont"]}},{"description":"Whether this is the header row.","name":"isHeader","type":{"names":["boolean"]}},{"description":"The y-from-top to pdf-lib y converter.","name":"topToY","type":{"names":["(y: number, h: number) => number"]}}],"meta":{"lineno":265},"order":15,"mdaics":{"dist":"packages/backend/dist/resources/pdf/elements.js:160","src":"packages/backend/src/resources/pdf/elements.ts:333"},"level":0},{"id":"assertTableEncodable","longname":"assertTableEncodable","name":"assertTableEncodable","kind":"function","scope":"global","description":"Validates that every table cell text encodes with the table font (Helvetica WinAnsi).","params":[{"description":"The validated table element.","name":"element","type":{"names":["{ rows: (string | { [x: string]: any; text: string; align?: \"left\" | \"center\" | \"right\"; colSpan?: number; size?: number; })[][]; type: \"table\"; w: number; x: number; y: number; colWidths?: number[]; header?: boolean; }"]}},{"description":"The table body font.","name":"font","type":{"names":["PDFFont"]}}],"meta":{"lineno":381},"order":16,"mdaics":{"dist":"packages/backend/dist/resources/pdf/elements.js:271","src":"packages/backend/src/resources/pdf/elements.ts:497"},"level":0},{"id":"exhaustiveNever","longname":"exhaustiveNever","name":"exhaustiveNever","kind":"function","scope":"global","description":"Throws for an unrepresentable element; only reachable via a widened union.","params":[{"description":"The element the check failed on.","name":"value","type":{"names":["never"]}}],"exceptions":[{"type":{"names":["Error"]},"description":"Always."}],"meta":{"lineno":462},"order":18,"mdaics":{"dist":"packages/backend/dist/resources/pdf/elements.js:336","src":"packages/backend/src/resources/pdf/elements.ts:598"},"returns":[{"type":{"names":["never"]}}],"level":0}],"fp":"8ec9ffc6b6c575b5034752fbe8e88cc6fff263a00b8a4936e890a78d68cbc699","issues":[],"kind":"tdata","lastUsed":1795079891592,"symbols":0},"md:packages/backend/src/resources/pdf/elements.ts":{"fp":"a3e8f10082d1f65c288e179c74a126a445e0e53bbdfa95d4a05f979c0429d537","issues":[],"kind":"md","markdown":"## Constants\n\n<dl>\n<dt><a href=\"#STANDARD\">STANDARD</a></dt>\n<dd><p>Map of the 14 Standard PDF fonts to pdf-lib&#39;s StandardFonts enum.</p>\n</dd>\n<dt><a href=\"#standardValueOf\">standardValueOf</a> ⇒ <code>StandardFonts</code></dt>\n<dd><p>Looks up a standard font without prototype-index access.</p>\n</dd>\n<dt><a href=\"#PAGE_SIZES\">PAGE_SIZES</a></dt>\n<dd><p>Page dimensions in points (1 pt = 1/72 inch).</p>\n</dd>\n<dt><a href=\"#pageSizeOf\">pageSizeOf</a> ⇒ <code>[number, number]</code></dt>\n<dd><p>Page dimensions in points for the given size/orientation, landscape swaps them.</p>\n</dd>\n<dt><a href=\"#drawElement\">drawElement</a> ⇒ <code>void</code></dt>\n<dd><p>Draws one element onto the page (image/table/field handled via the pre-embedded state).</p>\n</dd>\n<dt><a href=\"#collectFontNames\">collectFontNames</a> ⇒ <code>string[]</code></dt>\n<dd><p>Fonts referenced by an element (embedded or standard name).</p>\n</dd>\n<dt><a href=\"#segmentPages\">segmentPages</a> ⇒ <code>{ elements: Array&lt;Exclude&lt;ElementType, { type: &quot;pageBreak&quot;; }&gt;&gt;; page: PdfPageType; }[]</code></dt>\n<dd><p>Splits each page&#39;s element list at <code>pageBreak</code> elements into physical page segments.</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#resolveFont\">resolveFont(ctx, name)</a> ⇒ <code>PDFFont</code></dt>\n<dd><p>Resolves a public font name to the pre-embedded font; missing names are a build error.</p>\n</dd>\n<dt><a href=\"#isStandardWinAnsiFont\">isStandardWinAnsiFont(ctx, name)</a> ⇒ <code>boolean</code></dt>\n<dd><p>Whether the named font is a WinAnsi standard font (not Symbol/ZapfDingbats, not embedded).</p>\n</dd>\n<dt><a href=\"#assertWinAnsiText\">assertWinAnsiText(text, where)</a></dt>\n<dd><p>Throws 400 when any character is outside the WinAnsi encoding (standard fonts only).</p>\n</dd>\n<dt><a href=\"#assertFontEncodes\">assertFontEncodes(font, fontName, text, where)</a></dt>\n<dd><p>Belt-and-braces: any standard font rejects what its own encoding cannot carry.</p>\n</dd>\n<dt><a href=\"#wrapParagraph\">wrapParagraph(text, font, size, maxWidth)</a> ⇒ <code>string[]</code></dt>\n<dd><p>Word-greedy line breaking, respecting the given width at the given size.</p>\n</dd>\n<dt><a href=\"#wrapLines\">wrapLines(text, font, size, maxWidth)</a> ⇒ <code>string[]</code></dt>\n<dd><p>Wraps text on newlines, then on words; empty paragraphs become blank lines.</p>\n</dd>\n<dt><a href=\"#textOffset\">textOffset(align, lineWidth, boxWidth)</a> ⇒ <code>number</code></dt>\n<dd><p>Horizontal offset for a line within a box.</p>\n</dd>\n<dt><a href=\"#cellOf\">cellOf(cell)</a> ⇒ <code>{ align: Align; colSpan: number; fill?: string; size: number; text: string; }</code></dt>\n<dd><p>Normalizes a table cell union (string or object) to the internal shape.</p>\n</dd>\n<dt><a href=\"#cellFontOf\">cellFontOf(font, headerFont, isHeader)</a> ⇒ <code>PDFFont</code></dt>\n<dd><p>Picks the header font for header rows, the body font otherwise.</p>\n</dd>\n<dt><a href=\"#rowHeightOf\">rowHeightOf(row, colWidths, font, headerFont, isHeader)</a> ⇒ <code>number</code></dt>\n<dd><p>Measures a table row&#39;s height from its tallest cell after wrapping.</p>\n</dd>\n<dt><a href=\"#paintCellText\">paintCellText(page, cell, cellX, cursorY, innerWidth, font, headerFont, isHeader)</a></dt>\n<dd><p>Paints one cell&#39;s text lines, vertically top-aligned with padding.</p>\n</dd>\n<dt><a href=\"#paintRow\">paintRow(page, row, colWidths, cursorY, rowHeight, startX, font, headerFont, isHeader, topToY)</a></dt>\n<dd><p>Paints one row: cell backgrounds, borders and text.</p>\n</dd>\n<dt><a href=\"#assertTableEncodable\">assertTableEncodable(element, font)</a></dt>\n<dd><p>Validates that every table cell text encodes with the table font (Helvetica WinAnsi).</p>\n</dd>\n<dt><a href=\"#exhaustiveNever\">exhaustiveNever(value)</a> ⇒ <code>never</code></dt>\n<dd><p>Throws for an unrepresentable element; only reachable via a widened union.</p>\n</dd>\n</dl>\n\n<a name=\"STANDARD\"></a>\n\n## STANDARD\nMap of the 14 Standard PDF fonts to pdf-lib's StandardFonts enum.\n\n**Kind**: global constant  \nsrc: packages/backend/src/resources/pdf/elements.ts:30  \ndist: packages/backend/dist/resources/pdf/elements.js:13\n<a name=\"standardValueOf\"></a>\n\n## standardValueOf ⇒ <code>StandardFonts</code>\nLooks up a standard font without prototype-index access.\n\n**Kind**: global constant  \n**Returns**: <code>StandardFonts</code> - The enum value, or undefined.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| name | <code>string</code> | The public font name. |\n\nsrc: packages/backend/src/resources/pdf/elements.ts:74  \ndist: packages/backend/dist/resources/pdf/elements.js:37\n<a name=\"PAGE_SIZES\"></a>\n\n## PAGE\\_SIZES\nPage dimensions in points (1 pt = 1/72 inch).\n\n**Kind**: global constant  \nsrc: packages/backend/src/resources/pdf/elements.ts:122  \ndist: packages/backend/dist/resources/pdf/elements.js:61\n<a name=\"pageSizeOf\"></a>\n\n## pageSizeOf ⇒ <code>[number, number]</code>\nPage dimensions in points for the given size/orientation, landscape swaps them.\n\n**Kind**: global constant  \n**Returns**: <code>[number, number]</code> - The width and height in points.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| page | <code>{ elements: ({ [x: string]: any; text: string; type: &quot;text&quot;; x: number; y: number; align?: &quot;left&quot; \\| &quot;center&quot; \\| &quot;right&quot;; font?: string; size?: number; w?: number; } \\| { [x: string]: any; h: number; type: &quot;rect&quot;; w: number; x: number; y: number; dash?: boolean; strokeWidth?: number; } \\| { [x: string]: any; h: number; type: &quot;ellipse&quot;; w: number; x: number; y: number; strokeWidth?: number; } \\| { [x: string]: any; type: &quot;line&quot;; x1: number; x2: number; y1: number; y2: number; dash?: boolean; thickness?: number; } \\| { data: string; h: number; imageType: &quot;png&quot; \\| &quot;jpg&quot;; type: &quot;image&quot;; w: number; x: number; y: number; opacity?: number; } \\| { rows: (string \\| { [x: string]: any; text: string; align?: &quot;left&quot; \\| &quot;center&quot; \\| &quot;right&quot;; colSpan?: number; size?: number; })[][]; type: &quot;table&quot;; w: number; x: number; y: number; colWidths?: number[]; header?: boolean; } \\| { [x: string]: any; fieldType: &quot;text&quot; \\| &quot;checkbox&quot;; type: &quot;field&quot;; x: number; y: number; h?: number; value?: string; w?: number; } \\| { [x: string]: any; format: string; type: &quot;pageNumber&quot;; x: number; y: number; font?: string; size?: number; } \\| { type: &quot;pageBreak&quot;; })[]; margin: { bottom: number; left: number; right: number; top: number; }; orientation: &quot;portrait&quot; \\| &quot;landscape&quot;; size: &quot;a4&quot; \\| &quot;a3&quot; \\| &quot;a5&quot; \\| &quot;letter&quot; \\| &quot;legal&quot; \\| &quot;tabloid&quot;; }</code> | The validated page payload. |\n\nsrc: packages/backend/src/resources/pdf/elements.ts:136  \ndist: packages/backend/dist/resources/pdf/elements.js:69\n<a name=\"drawElement\"></a>\n\n## drawElement ⇒ <code>void</code>\nDraws one element onto the page (image/table/field handled via the pre-embedded state).\n\n**Kind**: global constant  \n**Returns**: <code>void</code> - Nothing.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| pdfDoc | <code>PDFDocument</code> | The document being built (needed for the AcroForm). |\n| page | <code>PDFPage</code> | The target page. |\n| element | <code>{ [x: string]: any; text: string; type: &quot;text&quot;; x: number; y: number; align?: &quot;left&quot; \\| &quot;center&quot; \\| &quot;right&quot;; font?: string; size?: number; w?: number; } \\| { [x: string]: any; h: number; type: &quot;rect&quot;; w: number; x: number; y: number; dash?: boolean; strokeWidth?: number; } \\| { [x: string]: any; h: number; type: &quot;ellipse&quot;; w: number; x: number; y: number; strokeWidth?: number; } \\| { [x: string]: any; type: &quot;line&quot;; x1: number; x2: number; y1: number; y2: number; dash?: boolean; thickness?: number; } \\| { data: string; h: number; imageType: &quot;png&quot; \\| &quot;jpg&quot;; type: &quot;image&quot;; w: number; x: number; y: number; opacity?: number; } \\| { rows: (string \\| { [x: string]: any; text: string; align?: &quot;left&quot; \\| &quot;center&quot; \\| &quot;right&quot;; colSpan?: number; size?: number; })[][]; type: &quot;table&quot;; w: number; x: number; y: number; colWidths?: number[]; header?: boolean; } \\| { [x: string]: any; fieldType: &quot;text&quot; \\| &quot;checkbox&quot;; type: &quot;field&quot;; x: number; y: number; h?: number; value?: string; w?: number; } \\| { [x: string]: any; format: string; type: &quot;pageNumber&quot;; x: number; y: number; font?: string; size?: number; }</code> | The validated element descriptor. |\n| ctx | <code>BuilderContext</code> | The pre-embedded font state. |\n| images | <code>Map&lt;object, PDFImage&gt;</code> | The pre-embedded images. |\n| totalPages | <code>number</code> | Logical page count, for pageNumber elements. |\n| pageNumber | <code>number</code> | 1-based number of this page, for pageNumber elements. |\n\nsrc: packages/backend/src/resources/pdf/elements.ts:554  \ndist: packages/backend/dist/resources/pdf/elements.js:306\n<a name=\"collectFontNames\"></a>\n\n## collectFontNames ⇒ <code>string[]</code>\nFonts referenced by an element (embedded or standard name).\n\n**Kind**: global constant  \n**Returns**: <code>string[]</code> - The referenced font names.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| element | <code>{ [x: string]: any; text: string; type: &quot;text&quot;; x: number; y: number; align?: &quot;left&quot; \\| &quot;center&quot; \\| &quot;right&quot;; font?: string; size?: number; w?: number; } \\| { [x: string]: any; h: number; type: &quot;rect&quot;; w: number; x: number; y: number; dash?: boolean; strokeWidth?: number; } \\| { [x: string]: any; h: number; type: &quot;ellipse&quot;; w: number; x: number; y: number; strokeWidth?: number; } \\| { [x: string]: any; type: &quot;line&quot;; x1: number; x2: number; y1: number; y2: number; dash?: boolean; thickness?: number; } \\| { data: string; h: number; imageType: &quot;png&quot; \\| &quot;jpg&quot;; type: &quot;image&quot;; w: number; x: number; y: number; opacity?: number; } \\| { rows: (string \\| { [x: string]: any; text: string; align?: &quot;left&quot; \\| &quot;center&quot; \\| &quot;right&quot;; colSpan?: number; size?: number; })[][]; type: &quot;table&quot;; w: number; x: number; y: number; colWidths?: number[]; header?: boolean; } \\| { [x: string]: any; fieldType: &quot;text&quot; \\| &quot;checkbox&quot;; type: &quot;field&quot;; x: number; y: number; h?: number; value?: string; w?: number; } \\| { [x: string]: any; format: string; type: &quot;pageNumber&quot;; x: number; y: number; font?: string; size?: number; }</code> | The element to inspect. |\n\nsrc: packages/backend/src/resources/pdf/elements.ts:607  \ndist: packages/backend/dist/resources/pdf/elements.js:339\n<a name=\"segmentPages\"></a>\n\n## segmentPages ⇒ <code>{ elements: Array&lt;Exclude&lt;ElementType, { type: &quot;pageBreak&quot;; }&gt;&gt;; page: PdfPageType; }[]</code>\nSplits each page's element list at `pageBreak` elements into physical page segments.\n\n**Kind**: global constant  \n**Returns**: <code>{ elements: Array&lt;Exclude&lt;ElementType, { type: &quot;pageBreak&quot;; }&gt;&gt;; page: PdfPageType; }[]</code> - The physical pages to draw, in order.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| pages | <code>({ elements: ({ [x: string]: any; text: string; type: &quot;text&quot;; x: number; y: number; align?: &quot;left&quot; \\| &quot;center&quot; \\| &quot;right&quot;; font?: string; size?: number; w?: number; } \\| { [x: string]: any; h: number; type: &quot;rect&quot;; w: number; x: number; y: number; dash?: boolean; strokeWidth?: number; } \\| { [x: string]: any; h: number; type: &quot;ellipse&quot;; w: number; x: number; y: number; strokeWidth?: number; } \\| { [x: string]: any; type: &quot;line&quot;; x1: number; x2: number; y1: number; y2: number; dash?: boolean; thickness?: number; } \\| { data: string; h: number; imageType: &quot;png&quot; \\| &quot;jpg&quot;; type: &quot;image&quot;; w: number; x: number; y: number; opacity?: number; } \\| { rows: (string \\| { [x: string]: any; text: string; align?: &quot;left&quot; \\| &quot;center&quot; \\| &quot;right&quot;; colSpan?: number; size?: number; })[][]; type: &quot;table&quot;; w: number; x: number; y: number; colWidths?: number[]; header?: boolean; } \\| { [x: string]: any; fieldType: &quot;text&quot; \\| &quot;checkbox&quot;; type: &quot;field&quot;; x: number; y: number; h?: number; value?: string; w?: number; } \\| { [x: string]: any; format: string; type: &quot;pageNumber&quot;; x: number; y: number; font?: string; size?: number; } \\| { type: &quot;pageBreak&quot;; })[]; margin: { bottom: number; left: number; right: number; top: number; }; orientation: &quot;portrait&quot; \\| &quot;landscape&quot;; size: &quot;a4&quot; \\| &quot;a3&quot; \\| &quot;a5&quot; \\| &quot;letter&quot; \\| &quot;legal&quot; \\| &quot;tabloid&quot;; } &amp; { elements: ElementType[]; })[]</code> | The validated page payloads from the build request. |\n\nsrc: packages/backend/src/resources/pdf/elements.ts:624  \ndist: packages/backend/dist/resources/pdf/elements.js:348\n<a name=\"resolveFont\"></a>\n\n## resolveFont(ctx, name) ⇒ <code>PDFFont</code>\nResolves a public font name to the pre-embedded font; missing names are a build error.\n\n**Kind**: global function  \n**Returns**: <code>PDFFont</code> - The embedded font.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| ctx | <code>BuilderContext</code> | The pre-embedded font state. |\n| name | <code>string</code> | The public font name, or undefined for the default. |\n\nsrc: packages/backend/src/resources/pdf/elements.ts:62  \ndist: packages/backend/dist/resources/pdf/elements.js:29\n<a name=\"isStandardWinAnsiFont\"></a>\n\n## isStandardWinAnsiFont(ctx, name) ⇒ <code>boolean</code>\nWhether the named font is a WinAnsi standard font (not Symbol/ZapfDingbats, not embedded).\n\n**Kind**: global function  \n**Returns**: <code>boolean</code> - True when the font is a WinAnsi standard font.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| ctx | <code>BuilderContext</code> | The pre-embedded font state. |\n| name | <code>string</code> | The public font name. |\n\nsrc: packages/backend/src/resources/pdf/elements.ts:85  \ndist: packages/backend/dist/resources/pdf/elements.js:39\n<a name=\"assertWinAnsiText\"></a>\n\n## assertWinAnsiText(text, where)\nThrows 400 when any character is outside the WinAnsi encoding (standard fonts only).\n\n**Kind**: global function  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| text | <code>string</code> | The text to check. |\n| where | <code>string</code> | Where in the document the text lives. |\n\nsrc: packages/backend/src/resources/pdf/elements.ts:93  \ndist: packages/backend/dist/resources/pdf/elements.js:40\n<a name=\"assertFontEncodes\"></a>\n\n## assertFontEncodes(font, fontName, text, where)\nBelt-and-braces: any standard font rejects what its own encoding cannot carry.\n\n**Kind**: global function  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| font | <code>PDFFont</code> | The resolved font instance. |\n| fontName | <code>string</code> | The public font name, for error messages. |\n| text | <code>string</code> | The text to probe-encode. |\n| where | <code>string</code> | Where in the document the text lives, for error messages. |\n\nsrc: packages/backend/src/resources/pdf/elements.ts:110  \ndist: packages/backend/dist/resources/pdf/elements.js:50\n<a name=\"wrapParagraph\"></a>\n\n## wrapParagraph(text, font, size, maxWidth) ⇒ <code>string[]</code>\nWord-greedy line breaking, respecting the given width at the given size.\n\n**Kind**: global function  \n**Returns**: <code>string[]</code> - The wrapped lines.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| text | <code>string</code> | The text to wrap. |\n| font | <code>PDFFont</code> | The font used for measuring. |\n| size | <code>number</code> | Font size in points. |\n| maxWidth | <code>number</code> | Maximum line width in points. |\n\nsrc: packages/backend/src/resources/pdf/elements.ts:150  \ndist: packages/backend/dist/resources/pdf/elements.js:74\n<a name=\"wrapLines\"></a>\n\n## wrapLines(text, font, size, maxWidth) ⇒ <code>string[]</code>\nWraps text on newlines, then on words; empty paragraphs become blank lines.\n\n**Kind**: global function  \n**Returns**: <code>string[]</code> - The wrapped lines.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| text | <code>string</code> | The text to wrap. |\n| font | <code>PDFFont</code> | The font used for measuring. |\n| size | <code>number</code> | Font size in points. |\n| maxWidth | <code>number</code> | Maximum line width in points. |\n\nsrc: packages/backend/src/resources/pdf/elements.ts:175  \ndist: packages/backend/dist/resources/pdf/elements.js:91\n<a name=\"textOffset\"></a>\n\n## textOffset(align, lineWidth, boxWidth) ⇒ <code>number</code>\nHorizontal offset for a line within a box.\n\n**Kind**: global function  \n**Returns**: <code>number</code> - The x offset in points from the box's left edge.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| align | <code>Align</code> | Horizontal alignment mode. |\n| lineWidth | <code>number</code> | Measured width of the line in points. |\n| boxWidth | <code>number</code> | Box width in points. |\n\nsrc: packages/backend/src/resources/pdf/elements.ts:195  \ndist: packages/backend/dist/resources/pdf/elements.js:103\n<a name=\"cellOf\"></a>\n\n## cellOf(cell) ⇒ <code>{ align: Align; colSpan: number; fill?: string; size: number; text: string; }</code>\nNormalizes a table cell union (string or object) to the internal shape.\n\n**Kind**: global function  \n**Returns**: <code>{ align: Align; colSpan: number; fill?: string; size: number; text: string; }</code> - The normalized cell.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| cell | <code>string \\| { [x: string]: any; text: string; align?: &quot;left&quot; \\| &quot;center&quot; \\| &quot;right&quot;; colSpan?: number; size?: number; }</code> | The raw cell from the validated schema. |\n\nsrc: packages/backend/src/resources/pdf/elements.ts:240  \ndist: packages/backend/dist/resources/pdf/elements.js:131\n<a name=\"cellFontOf\"></a>\n\n## cellFontOf(font, headerFont, isHeader) ⇒ <code>PDFFont</code>\nPicks the header font for header rows, the body font otherwise.\n\n**Kind**: global function  \n**Returns**: <code>PDFFont</code> - The font to use for this cell.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| font | <code>PDFFont</code> | The body font. |\n| headerFont | <code>PDFFont</code> | The header font, for the header row. |\n| isHeader | <code>boolean</code> | Whether this cell belongs to the header row. |\n\nsrc: packages/backend/src/resources/pdf/elements.ts:254  \ndist: packages/backend/dist/resources/pdf/elements.js:134\n<a name=\"rowHeightOf\"></a>\n\n## rowHeightOf(row, colWidths, font, headerFont, isHeader) ⇒ <code>number</code>\nMeasures a table row's height from its tallest cell after wrapping.\n\n**Kind**: global function  \n**Returns**: <code>number</code> - The row height in points.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| row | <code>{ align: Align; colSpan: number; fill?: string; size: number; text: string; }[]</code> | The normalized cells in the row. |\n| colWidths | <code>number[]</code> | The resolved column widths in points. |\n| font | <code>PDFFont</code> | The body font. |\n| headerFont | <code>PDFFont</code> | The header font, for the header row. |\n| isHeader | <code>boolean</code> | Whether this is the header row. |\n\nsrc: packages/backend/src/resources/pdf/elements.ts:266  \ndist: packages/backend/dist/resources/pdf/elements.js:135\n<a name=\"paintCellText\"></a>\n\n## paintCellText(page, cell, cellX, cursorY, innerWidth, font, headerFont, isHeader)\nPaints one cell's text lines, vertically top-aligned with padding.\n\n**Kind**: global function  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| page | <code>PDFPage</code> | The target page. |\n| cell | <code>{ align: Align; colSpan: number; fill?: string; size: number; text: string; }</code> | The normalized cell. |\n| cellX | <code>number</code> | The cell's left edge in points. |\n| cursorY | <code>number</code> | The cell's top edge (distance from the page top) in points. |\n| innerWidth | <code>number</code> | The text column width in points. |\n| font | <code>PDFFont</code> | The body font. |\n| headerFont | <code>PDFFont</code> | The header font for the header row. |\n| isHeader | <code>boolean</code> | Whether this cell belongs to the header row. |\n\nsrc: packages/backend/src/resources/pdf/elements.ts:298  \ndist: packages/backend/dist/resources/pdf/elements.js:148\n<a name=\"paintRow\"></a>\n\n## paintRow(page, row, colWidths, cursorY, rowHeight, startX, font, headerFont, isHeader, topToY)\nPaints one row: cell backgrounds, borders and text.\n\n**Kind**: global function  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| page | <code>PDFPage</code> | The target page. |\n| row | <code>{ align: Align; colSpan: number; fill?: string; size: number; text: string; }[]</code> | The normalized cells in the row. |\n| colWidths | <code>number[]</code> | The resolved column widths in points. |\n| cursorY | <code>number</code> | The row's top edge (distance from the page top) in points. |\n| rowHeight | <code>number</code> | The row height in points. |\n| startX | <code>number</code> | The row's left edge in points. |\n| font | <code>PDFFont</code> | The body font. |\n| headerFont | <code>PDFFont</code> | The header font for the header row. |\n| isHeader | <code>boolean</code> | Whether this is the header row. |\n| topToY | <code>(y: number, h: number) &#x3D;&gt; number</code> | The y-from-top to pdf-lib y converter. |\n\nsrc: packages/backend/src/resources/pdf/elements.ts:333  \ndist: packages/backend/dist/resources/pdf/elements.js:160\n<a name=\"assertTableEncodable\"></a>\n\n## assertTableEncodable(element, font)\nValidates that every table cell text encodes with the table font (Helvetica WinAnsi).\n\n**Kind**: global function  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| element | <code>{ rows: (string \\| { [x: string]: any; text: string; align?: &quot;left&quot; \\| &quot;center&quot; \\| &quot;right&quot;; colSpan?: number; size?: number; })[][]; type: &quot;table&quot;; w: number; x: number; y: number; colWidths?: number[]; header?: boolean; }</code> | The validated table element. |\n| font | <code>PDFFont</code> | The table body font. |\n\nsrc: packages/backend/src/resources/pdf/elements.ts:497  \ndist: packages/backend/dist/resources/pdf/elements.js:271\n<a name=\"exhaustiveNever\"></a>\n\n## exhaustiveNever(value) ⇒ <code>never</code>\nThrows for an unrepresentable element; only reachable via a widened union.\n\n**Kind**: global function  \n**Throws**:\n\n- <code>Error</code> Always.\n\n\n| Param | Type | Description |\n| --- | --- | --- |\n| value | <code>never</code> | The element the check failed on. |\n\nsrc: packages/backend/src/resources/pdf/elements.ts:598  \ndist: packages/backend/dist/resources/pdf/elements.js:336\n","symbols":21,"lastUsed":1795079891648},"tdata:packages/backend/src/resources/pdf/pdf.controller.ts":{"doclets":[{"id":"PdfController","longname":"PdfController","name":"PdfController","kind":"member","scope":"global","description":"PDF routes. `/pdf/build` consumes JSON and bypasses the media\ninterceptors by design (JSON bodies are never virus-scanned or signature-probed);\n`/pdf/extract` and `/pdf/metadata` take the binary upload and are ClamAV-scanned.","params":[],"meta":{"lineno":46},"order":0,"mdaics":{"dist":"packages/backend/dist/resources/pdf/pdf.controller.js:21","src":"packages/backend/src/resources/pdf/pdf.controller.ts:29"},"level":0},{"id":"PdfController#build","longname":"PdfController#build","name":"build","kind":"function","scope":"instance","description":"Builds a PDF from the JSON payload (201).","memberof":"PdfController","params":[{"description":"Raw reply, streamed as application/pdf.","name":"response","type":{"names":["FastifyReply<import(\"fastify\").RouteGenericInterface, import(\"fastify\").RawServerDefault, import(\"http\").IncomingMessage, import(\"http\").ServerResponse<import(\"http\").IncomingMessage>, unknown, import(\"fastify\").FastifySchema, import(\"fastify\").FastifyTypeProviderDefault, unknown>"]}},{"description":"Pages, elements, embedded fonts and metadata.","name":"body","type":{"names":["{ pages: { elements: ({ [x: string]: any; text: string; type: \"text\"; x: number; y: number; align?: \"left\" | \"center\" | \"right\"; font?: string; size?: number; w?: number; } | { [x: string]: any; h: number; type: \"rect\"; w: number; x: number; y: number; dash?: boolean; strokeWidth?: number; } | { [x: string]: any; h: number; type: \"ellipse\"; w: number; x: number; y: number; strokeWidth?: number; } | { [x: string]: any; type: \"line\"; x1: number; x2: number; y1: number; y2: number; dash?: boolean; thickness?: number; } | { data: string; h: number; imageType: \"png\" | \"jpg\"; type: \"image\"; w: number; x: number; y: number; opacity?: number; } | { rows: (string | { [x: string]: any; text: string; align?: \"left\" | \"center\" | \"right\"; colSpan?: number; size?: number; })[][]; type: \"table\"; w: number; x: number; y: number; colWidths?: number[]; header?: boolean; } | { [x: string]: any; fieldType: \"text\" | \"checkbox\"; type: \"field\"; x: number; y: number; h?: number; value?: string; w?: number; } | { [x: string]: any; format: string; type: \"pageNumber\"; x: number; y: number; font?: string; size?: number; } | { type: \"pageBreak\"; })[]; margin: { bottom: number; left: number; right: number; top: number; }; orientation: \"portrait\" | \"landscape\"; size: \"a4\" | \"a3\" | \"a5\" | \"letter\" | \"legal\" | \"tabloid\"; }[]; embeddedFonts?: { [x: string]: any; data: string; }[]; metadata?: { author?: string; creationDate?: string; creator?: string; keywords?: string | string[]; language?: string; subject?: string; title?: string; }; }"]}}],"returns":[{"description":"The document bytes (201).","type":{"names":["Promise<void>"]}}],"meta":{"lineno":82},"async":true,"order":1,"mdaics":{"dist":"packages/backend/dist/resources/pdf/pdf.controller.js:28","src":"packages/backend/src/resources/pdf/pdf.controller.ts:42"},"level":0},{"id":"PdfController#extract","longname":"PdfController#extract","name":"extract","kind":"function","scope":"instance","description":"Extracts text page by page (201).","memberof":"PdfController","params":[{"description":"Empty query object; junk parameters are rejected with 400.","name":"_query","type":{"names":["unknown"]}}],"returns":[{"description":"The extracted metadata, page count and per-page text.","type":{"names":["Promise<{ format: string; metadata: { author: string; creationDate: string; creator: string; keywords: string; modificationDate: string; producer: string; subject: string; title: string; }; pageCount: number; structure: { pages: { page: number; text: string; }[]; }; text: string; }>"]}}],"meta":{"lineno":93},"order":2,"mdaics":{"dist":"packages/backend/dist/resources/pdf/pdf.controller.js:34","src":"packages/backend/src/resources/pdf/pdf.controller.ts:61"},"level":0},{"id":"PdfController#metadata","longname":"PdfController#metadata","name":"metadata","kind":"function","scope":"instance","description":"Normalized PDF metadata (201).","memberof":"PdfController","params":[{"description":"Empty query object; junk parameters are rejected with 400.","name":"_query","type":{"names":["unknown"]}}],"returns":[{"description":"The metadata document.","type":{"names":["Promise<{ author: string; creationDate: string; creator: string; encrypted: boolean; keywords: string; modificationDate: string; orientation: \"portrait\" | \"landscape\"; pageCount: number; pageSize: { height: number; width: number; }; producer: string; subject: string; title: string; format: string; }>"]}}],"meta":{"lineno":101},"order":3,"mdaics":{"dist":"packages/backend/dist/resources/pdf/pdf.controller.js:37","src":"packages/backend/src/resources/pdf/pdf.controller.ts:74"},"level":0}],"fp":"4c4be3dbf2ba51bd4eb3d569b553f8417e1382ac57d7003476f4e32e1e9166b1","issues":[],"kind":"tdata","lastUsed":1795079891707,"symbols":0},"md:packages/backend/src/resources/pdf/pdf.controller.ts":{"fp":"16a0ea743af6e752addae82cfe2b37bfc9d338d0dab422f607a2d37ab50a1540","issues":[],"kind":"md","markdown":"<a name=\"PdfController\"></a>\n\n## PdfController\nPDF routes. `/pdf/build` consumes JSON and bypasses the media\ninterceptors by design (JSON bodies are never virus-scanned or signature-probed);\n`/pdf/extract` and `/pdf/metadata` take the binary upload and are ClamAV-scanned.\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/pdf/pdf.controller.ts:29  \ndist: packages/backend/dist/resources/pdf/pdf.controller.js:21\n\n* [PdfController](#PdfController)\n    * [.build(response, body)](#PdfController+build) ⇒ <code>Promise&lt;void&gt;</code>\n    * [.extract(_query)](#PdfController+extract) ⇒ <code>Promise&lt;{ format: string; metadata: { author: string; creationDate: string; creator: string; keywords: string; modificationDate: string; producer: string; subject: string; title: string; }; pageCount: number; structure: { pages: { page: number; text: string; }[]; }; text: string; }&gt;</code>\n    * [.metadata(_query)](#PdfController+metadata) ⇒ <code>Promise&lt;{ author: string; creationDate: string; creator: string; encrypted: boolean; keywords: string; modificationDate: string; orientation: &quot;portrait&quot; \\| &quot;landscape&quot;; pageCount: number; pageSize: { height: number; width: number; }; producer: string; subject: string; title: string; format: string; }&gt;</code>\n\n<a name=\"PdfController+build\"></a>\n\n### pdfController.build(response, body) ⇒ <code>Promise&lt;void&gt;</code>\nBuilds a PDF from the JSON payload (201).\n\n**Kind**: instance method of [<code>PdfController</code>](#PdfController)  \n**Returns**: <code>Promise&lt;void&gt;</code> - The document bytes (201).  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| response | <code>FastifyReply&lt;import(&quot;fastify&quot;).RouteGenericInterface, import(&quot;fastify&quot;).RawServerDefault, import(&quot;http&quot;).IncomingMessage, import(&quot;http&quot;).ServerResponse&lt;import(&quot;http&quot;).IncomingMessage&gt;, unknown, import(&quot;fastify&quot;).FastifySchema, import(&quot;fastify&quot;).FastifyTypeProviderDefault, unknown&gt;</code> | Raw reply, streamed as application/pdf. |\n| body | <code>{ pages: { elements: ({ [x: string]: any; text: string; type: &quot;text&quot;; x: number; y: number; align?: &quot;left&quot; \\| &quot;center&quot; \\| &quot;right&quot;; font?: string; size?: number; w?: number; } \\| { [x: string]: any; h: number; type: &quot;rect&quot;; w: number; x: number; y: number; dash?: boolean; strokeWidth?: number; } \\| { [x: string]: any; h: number; type: &quot;ellipse&quot;; w: number; x: number; y: number; strokeWidth?: number; } \\| { [x: string]: any; type: &quot;line&quot;; x1: number; x2: number; y1: number; y2: number; dash?: boolean; thickness?: number; } \\| { data: string; h: number; imageType: &quot;png&quot; \\| &quot;jpg&quot;; type: &quot;image&quot;; w: number; x: number; y: number; opacity?: number; } \\| { rows: (string \\| { [x: string]: any; text: string; align?: &quot;left&quot; \\| &quot;center&quot; \\| &quot;right&quot;; colSpan?: number; size?: number; })[][]; type: &quot;table&quot;; w: number; x: number; y: number; colWidths?: number[]; header?: boolean; } \\| { [x: string]: any; fieldType: &quot;text&quot; \\| &quot;checkbox&quot;; type: &quot;field&quot;; x: number; y: number; h?: number; value?: string; w?: number; } \\| { [x: string]: any; format: string; type: &quot;pageNumber&quot;; x: number; y: number; font?: string; size?: number; } \\| { type: &quot;pageBreak&quot;; })[]; margin: { bottom: number; left: number; right: number; top: number; }; orientation: &quot;portrait&quot; \\| &quot;landscape&quot;; size: &quot;a4&quot; \\| &quot;a3&quot; \\| &quot;a5&quot; \\| &quot;letter&quot; \\| &quot;legal&quot; \\| &quot;tabloid&quot;; }[]; embeddedFonts?: { [x: string]: any; data: string; }[]; metadata?: { author?: string; creationDate?: string; creator?: string; keywords?: string \\| string[]; language?: string; subject?: string; title?: string; }; }</code> | Pages, elements, embedded fonts and metadata. |\n\nsrc: packages/backend/src/resources/pdf/pdf.controller.ts:42  \ndist: packages/backend/dist/resources/pdf/pdf.controller.js:28\n<a name=\"PdfController+extract\"></a>\n\n### pdfController.extract(_query) ⇒ <code>Promise&lt;{ format: string; metadata: { author: string; creationDate: string; creator: string; keywords: string; modificationDate: string; producer: string; subject: string; title: string; }; pageCount: number; structure: { pages: { page: number; text: string; }[]; }; text: string; }&gt;</code>\nExtracts text page by page (201).\n\n**Kind**: instance method of [<code>PdfController</code>](#PdfController)  \n**Returns**: <code>Promise&lt;{ format: string; metadata: { author: string; creationDate: string; creator: string; keywords: string; modificationDate: string; producer: string; subject: string; title: string; }; pageCount: number; structure: { pages: { page: number; text: string; }[]; }; text: string; }&gt;</code> - The extracted metadata, page count and per-page text.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| _query | <code>unknown</code> | Empty query object; junk parameters are rejected with 400. |\n\nsrc: packages/backend/src/resources/pdf/pdf.controller.ts:61  \ndist: packages/backend/dist/resources/pdf/pdf.controller.js:34\n<a name=\"PdfController+metadata\"></a>\n\n### pdfController.metadata(_query) ⇒ <code>Promise&lt;{ author: string; creationDate: string; creator: string; encrypted: boolean; keywords: string; modificationDate: string; orientation: &quot;portrait&quot; \\| &quot;landscape&quot;; pageCount: number; pageSize: { height: number; width: number; }; producer: string; subject: string; title: string; format: string; }&gt;</code>\nNormalized PDF metadata (201).\n\n**Kind**: instance method of [<code>PdfController</code>](#PdfController)  \n**Returns**: <code>Promise&lt;{ author: string; creationDate: string; creator: string; encrypted: boolean; keywords: string; modificationDate: string; orientation: &quot;portrait&quot; \\| &quot;landscape&quot;; pageCount: number; pageSize: { height: number; width: number; }; producer: string; subject: string; title: string; format: string; }&gt;</code> - The metadata document.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| _query | <code>unknown</code> | Empty query object; junk parameters are rejected with 400. |\n\nsrc: packages/backend/src/resources/pdf/pdf.controller.ts:74  \ndist: packages/backend/dist/resources/pdf/pdf.controller.js:37\n","symbols":4,"lastUsed":1795079891805},"tdata:packages/backend/src/resources/pdf/pdf.module.ts":{"doclets":[{"id":"PdfModule","longname":"PdfModule","