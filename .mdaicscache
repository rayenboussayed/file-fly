ng, unknown>"]}}],"meta":{"lineno":480},"order":17,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/xlsx.service.js:337","src":"packages/backend/src/resources/xlsx/xlsx.service.ts:442"},"level":0},{"id":"emptyTypes","longname":"emptyTypes","name":"emptyTypes","kind":"function","scope":"global","description":"Zeroed per-type census for a sheet.","params":[],"returns":[{"description":"A zeroed map from SheetJS cell type tag to count.","type":{"names":["Map<string, number>"]}}],"meta":{"lineno":498},"order":18,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/xlsx.service.js:349","src":"packages/backend/src/resources/xlsx/xlsx.service.ts:462"},"level":0},{"id":"XlsxService#build","longname":"XlsxService#build","name":"build","kind":"function","scope":"instance","description":"Builds a workbook from the payload and returns the .xlsx bytes.\nCell objects pass through to SheetJS (formulas, number formats, links, comments).\nStyles, images, charts and panes are SheetJS Pro-only and not supported.","memberof":"XlsxService","params":[{"description":"Validated build payload.","name":"body","type":{"names":["{ sheets: { [x: string]: any; rows: (Record<string, string | number | boolean | { [x: string]: unknown; c?: { [x: string]: unknown; a: string; t: string; }[]; f?: string; l?: { [x: string]: unknown; Target?: string; Tooltip?: string; }; t?: \"b\" | \"n\" | \"s\" | \"d\" | \"e\" | \"z\"; v?: unknown; z?: string; }> | (string | number | boolean | { [x: string]: unknown; c?: { [x: string]: unknown; a: string; t: string; }[]; f?: string; l?: { [x: string]: unknown; Target?: string; Tooltip?: string; }; t?: \"b\" | \"n\" | \"s\" | \"d\" | \"e\" | \"z\"; v?: unknown; z?: string; })[])[]; cellDates?: boolean; cols?: { [x: string]: unknown; hidden?: boolean; level?: number; wch?: number; width?: number; wpx?: number; }[]; columns?: string[]; merges?: any[]; sheetVisibility?: 0 | 1 | 2; }[]; workbook?: { [x: string]: unknown; Names?: { [x: string]: unknown; Name: string; Ref: string; Sheet?: number; }[]; Props?: { [x: string]: unknown; Author?: string; Category?: string; Comments?: string; Company?: string; CreatedDate?: Date; Keywords?: string; Manager?: string; ModifiedBy?: string; ModifiedDate?: Date; Subject?: string; Title?: string; }; WBProps?: { [x: string]: unknown; CodeName?: string; date1904?: boolean; filterPrivacy?: boolean; }; }; }"]}}],"returns":[{"description":"The workbook bytes.","type":{"names":["Promise<Buffer<ArrayBufferLike>>"]}}],"meta":{"lineno":248},"async":true,"order":13,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/xlsx.service.js:137","src":"packages/backend/src/resources/xlsx/xlsx.service.ts:223"},"level":0},{"id":"XlsxService#extract","longname":"XlsxService#extract","name":"extract","kind":"function","scope":"instance","description":"Extracts one sheet as typed JSON. Object rows need a header: pass\n`header=1` (AOA) for raw rows, `header=A` for column letters, or a\ncomma-separated header list; omit `header` to use the first row as keys.","memberof":"XlsxService","params":[{"description":"Validated flat reader options.","name":"query","type":{"names":["{ [x: string]: any; maxCells: number; raw: boolean; blankrows?: boolean; skipHidden?: boolean; }"]}}],"returns":[{"description":"The sheet name plus the records.","type":{"names":["Promise<{ records: unknown[]; sheet: string; truncated: boolean; } | { records: unknown[]; sheet: string; truncated?: undefined; }>"]}}],"meta":{"lineno":299},"async":true,"order":14,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/xlsx.service.js:177","src":"packages/backend/src/resources/xlsx/xlsx.service.ts:271"},"level":0},{"id":"XlsxService#metadata","longname":"XlsxService#metadata","name":"metadata","kind":"function","scope":"instance","description":"Structural metadata for an uploaded workbook: dims, counts, props, names,\nformula inventory and a per-type cell census, capped at `maxCells`.","memberof":"XlsxService","params":[{"description":"Validated flat metadata options.","name":"query","type":{"names":["{ maxCells: number; }"]}}],"returns":[{"description":"The metadata document.","type":{"names":["Promise<{ custprops: object; definedNames: { name: string; ref: string; sheet: number; }[]; props: XLSX.FullProperties; sheets: { autofilter: boolean; cells: number; cols: number; formulas: number; hidden: boolean; merges: number; name: string; ref: string; rows: number; types: { [k: string]: number; }; }[]; totalCells: number; }>"]}}],"meta":{"lineno":360},"async":true,"order":15,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/xlsx.service.js:229","src":"packages/backend/src/resources/xlsx/xlsx.service.ts:329"},"level":0}],"fp":"a5fc7142dfa6c2c739a133cda607e871d4e7a39795e078d10dc466c15b8c6cd8","issues":[],"kind":"tdata","lastUsed":1795079893545,"symbols":0},"tdata:packages/backend/src/services/anti-virus.service.spec.ts":{"doclets":[{"id":"defaultEnv","longname":"defaultEnv","name":"defaultEnv","kind":"function","scope":"global","description":"Default mocked environment, restored before/after every test.","params":[],"returns":[{"description":"The default mocked CLAMAV_* environment values.","type":{"names":["{ CLAMAV_HOST: string; CLAMAV_MAX_BYTES: number; CLAMAV_PORT: number; CLAMAV_TIMEOUT_MS: number; }"]}}],"meta":{"lineno":9},"order":0,"mdaics":{"src":"packages/backend/src/services/anti-virus.service.spec.ts:11"},"level":0},{"id":"freshScanResult","longname":"freshScanResult","name":"freshScanResult","kind":"function","scope":"global","params":[],"returns":[{"description":"A clean scan verdict, as `_processResult` would produce it.","type":{"names":["{ file: any; isInfected: boolean | null; viruses: string[]; }"]}}],"meta":{"lineno":16},"order":1,"mdaics":{"src":"packages/backend/src/services/anti-virus.service.spec.ts:19"},"level":0},{"id":"env","longname":"env","name":"env","kind":"function","scope":"global","description":"The mocked environment; tests may mutate it, `beforeEach`/`afterEach`\nrestore the defaults.","params":[],"returns":[{"description":"The stable mocked environment object.","type":{"names":["Record<string, unknown>"]}}],"meta":{"lineno":26},"order":2,"mdaics":{"src":"packages/backend/src/services/anti-virus.service.spec.ts:30"},"level":0},{"id":"asHttpException","longname":"asHttpException","name":"asHttpException","kind":"function","scope":"global","description":"Asserts that an error carries the shape of an HTTP exception.","params":[{"description":"The value thrown by the scan.","name":"error","type":{"names":["unknown"]}}],"returns":[{"description":"The exception's status/response accessors.","type":{"names":["{ getResponse: () => unknown; getStatus: () => number; }"]}}],"meta":{"lineno":137},"order":5,"mdaics":{"src":"packages/backend/src/services/anti-virus.service.spec.ts:141"},"level":0},{"id":"branchOf","longname":"branchOf","name":"branchOf","kind":"function","scope":"global","description":"Builds a fresh branch stream carrying the given number of bytes.","params":[{"description":"The payload size in bytes.","name":"bytes","type":{"names":["number"]}}],"returns":[{"description":"A readable branch.","type":{"names":["Readable"]}}],"meta":{"lineno":153},"order":6,"mdaics":{"src":"packages/backend/src/services/anti-virus.service.spec.ts:163"},"level":0},{"id":"catchException","longname":"catchException","name":"catchException","kind":"function","scope":"global","description":"Awaits a scan expected to reject and returns the thrown exception.","params":[{"description":"The scan promise.","name":"promise","type":{"names":["Promise<unknown>"]}}],"returns":[{"description":"The thrown HTTP exception.","type":{"names":["Promise<{ getResponse: () => unknown; getStatus: () => number; }>"]}}],"meta":{"lineno":161},"async":true,"order":7,"mdaics":{"src":"packages/backend/src/services/anti-virus.service.spec.ts:172"},"level":0},{"id":"createService","longname":"createService","name":"createService","kind":"function","scope":"global","description":"Builds a fresh `AntiVirusService` wired to a real `NormalizedClsService`\nover a stubbed `ClsService`, isolating the module graph per test.","params":[],"returns":[{"description":"The service, the CLS backing map and the source-stream destroy spy.","type":{"names":["Promise<{ cls: { get: <T>(key: symbol) => T; set: (key: symbol, value: unknown) => Map<symbol, unknown>; }; normalizedCls: import(\"./normalized-cls.service.js\").NormalizedClsService; service: import(\"./anti-virus.service.js\").AntiVirusService; sourceDestroy: import(\"vitest\").Mock<import(\"@vitest/spy\").Procedure>; store: Map<symbol, unknown>; }>"]}}],"meta":{"lineno":175},"async":true,"order":8,"mdaics":{"src":"packages/backend/src/services/anti-virus.service.spec.ts:186"},"level":0},{"id":"stubRequest","longname":"stubRequest","name":"stubRequest","kind":"function","scope":"global","description":"Points CLS at a request carrying the given content-length, or deletes it.","params":[{"description":"The CLS backing map.","name":"store","type":{"names":["Map<symbol, unknown>"]}},{"description":"The header value; `undefined` removes the request stub.","name":"contentLength","type":{"names":["string"]}}],"meta":{"lineno":195},"order":9,"mdaics":{"src":"packages/backend/src/services/anti-virus.service.spec.ts:209"},"level":0},{"id":"MockNodeClam#init","longname":"MockNodeClam#init","name":"init","kind":"function","scope":"instance","description":"Mock `init`: counts calls, rejects when an init error is armed.","memberof":"MockNodeClam","params":[],"returns":[{"description":"The initialized instance (`this`).","type":{"names":["Promise<this>"]}}],"meta":{"lineno":92},"async":true,"order":3,"mdaics":{"src":"packages/backend/src/services/anti-virus.service.spec.ts:96"}},{"id":"MockNodeClam#scanStream","longname":"MockNodeClam#scanStream","name":"scanStream","kind":"function","scope":"instance","description":"Mock `scanStream`: behaves like the real one, attaching to the passed\nstream, counting the bytes that reach clamd, and settling on `end`/`error`.","memberof":"MockNodeClam","params":[{"description":"The (byte counter) stream to scan.","name":"stream","type":{"names":["Readable"]}}],"returns":[{"description":"The configured scan verdict, or a rejection.","type":{"names":["Promise<unknown>"]}}],"meta":{"lineno":104},"order":4,"mdaics":{"src":"packages/backend/src/services/anti-virus.service.spec.ts:108"}}],"fp":"2fd5756510a459f13fab2bd14ade08c5ac22c78d56ff22c5ee8808555ba7d561","issues":[],"kind":"tdata","lastUsed":1795079893645,"symbols":0},"md:packages/backend/src/services/anti-virus.service.spec.ts":{"fp":"de0e6852e930b94e807ad634d15322022e6b9b97af1190507096c133357ac788","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","markdown":"## Functions\n\n<dl>\n<dt><a href=\"#defaultEnv\">defaultEnv()</a> ⇒ <code>{ CLAMAV_HOST: string; CLAMAV_MAX_BYTES: number; CLAMAV_PORT: number; CLAMAV_TIMEOUT_MS: number; }</code></dt>\n<dd><p>Default mocked environment, restored before/after every test.</p>\n</dd>\n<dt><a href=\"#freshScanResult\">freshScanResult()</a> ⇒ <code>{ file: any; isInfected: boolean | null; viruses: string[]; }</code></dt>\n<dd></dd>\n<dt><a href=\"#env\">env()</a> ⇒ <code>Record&lt;string, unknown&gt;</code></dt>\n<dd><p>The mocked environment; tests may mutate it, <code>beforeEach</code>/<code>afterEach</code>\nrestore the defaults.</p>\n</dd>\n<dt><a href=\"#asHttpException\">asHttpException(error)</a> ⇒ <code>{ getResponse: () &#x3D;&gt; unknown; getStatus: () &#x3D;&gt; number; }</code></dt>\n<dd><p>Asserts that an error carries the shape of an HTTP exception.</p>\n</dd>\n<dt><a href=\"#branchOf\">branchOf(bytes)</a> ⇒ <code>Readable</code></dt>\n<dd><p>Builds a fresh branch stream carrying the given number of bytes.</p>\n</dd>\n<dt><a href=\"#catchException\">catchException(promise)</a> ⇒ <code>Promise&lt;{ getResponse: () &#x3D;&gt; unknown; getStatus: () &#x3D;&gt; number; }&gt;</code></dt>\n<dd><p>Awaits a scan expected to reject and returns the thrown exception.</p>\n</dd>\n<dt><a href=\"#createService\">createService()</a> ⇒ <code>Promise&lt;{ cls: { get: &lt;T&gt;(key: symbol) &#x3D;&gt; T; set: (key: symbol, value: unknown) &#x3D;&gt; Map&lt;symbol, unknown&gt;; }; normalizedCls: import(&quot;./normalized-cls.service.js&quot;).NormalizedClsService; service: import(&quot;./anti-virus.service.js&quot;).AntiVirusService; sourceDestroy: import(&quot;vitest&quot;).Mock&lt;import(&quot;@vitest/spy&quot;).Procedure&gt;; store: Map&lt;symbol, unknown&gt;; }&gt;</code></dt>\n<dd><p>Builds a fresh <code>AntiVirusService</code> wired to a real <code>NormalizedClsService</code>\nover a stubbed <code>ClsService</code>, isolating the module graph per test.</p>\n</dd>\n<dt><a href=\"#stubRequest\">stubRequest(store, contentLength)</a></dt>\n<dd><p>Points CLS at a request carrying the given content-length, or deletes it.</p>\n</dd>\n</dl>\n\n<a name=\"defaultEnv\"></a>\n\n## defaultEnv() ⇒ <code>{ CLAMAV\\_HOST: string; CLAMAV\\_MAX\\_BYTES: number; CLAMAV\\_PORT: number; CLAMAV\\_TIMEOUT\\_MS: number; }</code>\nDefault mocked environment, restored before/after every test.\n\n**Kind**: global function  \n**Returns**: <code>{ CLAMAV\\_HOST: string; CLAMAV\\_MAX\\_BYTES: number; CLAMAV\\_PORT: number; CLAMAV\\_TIMEOUT\\_MS: number; }</code> - The default mocked CLAMAV_* environment values.  \nsrc: packages/backend/src/services/anti-virus.service.spec.ts:11  \n<a name=\"freshScanResult\"></a>\n\n## freshScanResult() ⇒ <code>{ file: any; isInfected: boolean \\| null; viruses: string[]; }</code>\n**Kind**: global function  \n**Returns**: <code>{ file: any; isInfected: boolean \\| null; viruses: string[]; }</code> - A clean scan verdict, as `_processResult` would produce it.  \nsrc: packages/backend/src/services/anti-virus.service.spec.ts:19  \n<a name=\"env\"></a>\n\n## env() ⇒ <code>Record&lt;string, unknown&gt;</code>\nThe mocked environment; tests may mutate it, `beforeEach`/`afterEach`\nrestore the defaults.\n\n**Kind**: global function  \n**Returns**: <code>Record&lt;string, unknown&gt;</code> - The stable mocked environment object.  \nsrc: packages/backend/src/services/anti-virus.service.spec.ts:30  \n<a name=\"asHttpException\"></a>\n\n## asHttpException(error) ⇒ <code>{ getResponse: () &#x3D;&gt; unknown; getStatus: () &#x3D;&gt; number; }</code>\nAsserts that an error carries the shape of an HTTP exception.\n\n**Kind**: global function  \n**Returns**: <code>{ getResponse: () &#x3D;&gt; unknown; getStatus: () &#x3D;&gt; number; }</code> - The exception's status/response accessors.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| error | <code>unknown</code> | The value thrown by the scan. |\n\nsrc: packages/backend/src/services/anti-virus.service.spec.ts:141  \n<a name=\"branchOf\"></a>\n\n## branchOf(bytes) ⇒ <code>Readable</code>\nBuilds a fresh branch stream carrying the given number of bytes.\n\n**Kind**: global function  \n**Returns**: <code>Readable</code> - A readable branch.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| bytes | <code>number</code> | The payload size in bytes. |\n\nsrc: packages/backend/src/services/anti-virus.service.spec.ts:163  \n<a name=\"catchException\"></a>\n\n## catchException(promise) ⇒ <code>Promise&lt;{ getResponse: () &#x3D;&gt; unknown; getStatus: () &#x3D;&gt; number; }&gt;</code>\nAwaits a scan expected to reject and returns the thrown exception.\n\n**Kind**: global function  \n**Returns**: <code>Promise&lt;{ getResponse: () &#x3D;&gt; unknown; getStatus: () &#x3D;&gt; number; }&gt;</code> - The thrown HTTP exception.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| promise | <code>Promise&lt;unknown&gt;</code> | The scan promise. |\n\nsrc: packages/backend/src/services/anti-virus.service.spec.ts:172  \n<a name=\"createService\"></a>\n\n## createService() ⇒ <code>Promise&lt;{ cls: { get: &lt;T&gt;(key: symbol) &#x3D;&gt; T; set: (key: symbol, value: unknown) &#x3D;&gt; Map&lt;symbol, unknown&gt;; }; normalizedCls: import(&quot;./normalized-cls.service.js&quot;).NormalizedClsService; service: import(&quot;./anti-virus.service.js&quot;).AntiVirusService; sourceDestroy: import(&quot;vitest&quot;).Mock&lt;import(&quot;@vitest/spy&quot;).Procedure&gt;; store: Map&lt;symbol, unknown&gt;; }&gt;</code>\nBuilds a fresh `AntiVirusService` wired to a real `NormalizedClsService`\nover a stubbed `ClsService`, isolating the module graph per test.\n\n**Kind**: global function  \n**Returns**: <code>Promise&lt;{ cls: { get: &lt;T&gt;(key: symbol) &#x3D;&gt; T; set: (key: symbol, value: unknown) &#x3D;&gt; Map&lt;symbol, unknown&gt;; }; normalizedCls: import(&quot;./normalized-cls.service.js&quot;).NormalizedClsService; service: import(&quot;./anti-virus.service.js&quot;).AntiVirusService; sourceDestroy: import(&quot;vitest&quot;).Mock&lt;import(&quot;@vitest/spy&quot;).Procedure&gt;; store: Map&lt;symbol, unknown&gt;; }&gt;</code> - The service, the CLS backing map and the source-stream destroy spy.  \nsrc: packages/backend/src/services/anti-virus.service.spec.ts:186  \n<a name=\"stubRequest\"></a>\n\n## stubRequest(store, contentLength)\nPoints CLS at a request carrying the given content-length, or deletes it.\n\n**Kind**: global function  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| store | <code>Map&lt;symbol, unknown&gt;</code> | The CLS backing map. |\n| contentLength | <code>string</code> | The header value; `undefined` removes the request stub. |\n\nsrc: packages/backend/src/services/anti-virus.service.spec.ts:209  \n","symbols":10,"lastUsed":1795079893676},"md:packages/backend/src/resources/xlsx/xlsx.service.ts":{"fp":"73f4bf726d0a645b0827a3af39e3cb3ac56e1e71ffb69901f0c5b119fcb14c95","issues":[],"kind":"md","markdown":"## Members\n\n<dl>\n<dt><a href=\"#XlsxService\">XlsxService</a></dt>\n<dd><p>XLSX feature service: builds workbooks and parses/metadata-inspects uploads.</p>\n</dd>\n</dl>\n\n## Constants\n\n<dl>\n<dt><a href=\"#SPREADSHEET_MIME\">SPREADSHEET_MIME</a></dt>\n<dd><p>The only OOXML spreadsheet mime accepted: macro-enabled and template files are rejected.</p>\n</dd>\n<dt><a href=\"#XLSX_TOTAL_UNCOMPRESSED\">XLSX_TOTAL_UNCOMPRESSED</a></dt>\n<dd><p>Total uncompressed byte ceiling for xlsx archives; ~3.5x tighter than the shared cap.</p>\n</dd>\n<dt><a href=\"#UNSAFE_FORMULA\">UNSAFE_FORMULA</a></dt>\n<dd><p>Formulas with DDE or remote-execution payloads are refused; ordinary functions pass through.\nAnchored at ^ with optional leading whitespace; <code>!cmd|...</code> style payloads are also refused.</p>\n</dd>\n<dt><a href=\"#MAX_RECORDS\">MAX_RECORDS</a></dt>\n<dd><p>Maximum number of row records <code>/xlsx/extract</code> returns (defense-in-depth with the maxCells census).</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#assertXlsxSignature\">assertXlsxSignature(buffer)</a> ⇒ <code>Promise&lt;void&gt;</code></dt>\n<dd><p>The scanner sees declared content types only; verify the bytes too.\nThe signature must be the plain spreadsheet OOXML mime, so renamed images and .xlsm are rejected.</p>\n</dd>\n<dt><a href=\"#countCells\">countCells(parts)</a> ⇒ <code>number</code></dt>\n<dd><p>Counts <c> cell tags across worksheets; a cheap pre-parse bomb guard (no XML decoding).</p>\n</dd>\n<dt><a href=\"#readBody\">readBody(cls, maxCells)</a> ⇒ <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code></dt>\n<dd><p>Reads the uploaded workbook into memory, bounded by the scanner cap.\nThe scanner only opens the source when ClamAV is enabled, so the service must too.\nApplies the OOXML zip-bomb caps and a worksheet cell ceiling before SheetJS sees a byte.</p>\n</dd>\n<dt><a href=\"#toBadRequest\">toBadRequest(error)</a> ⇒ <code>BadRequestException</code></dt>\n<dd><p>Maps a SheetJS failure to a 400.</p>\n</dd>\n<dt><a href=\"#assertSafeCells\">assertSafeCells(sheets)</a></dt>\n<dd><p>Walks every cell once and rejects unsafe formulas.</p>\n</dd>\n<dt><a href=\"#assertSafeFormula\">assertSafeFormula(f)</a></dt>\n<dd><p>Rejects a formula string with a code-execution vector.</p>\n</dd>\n<dt><a href=\"#assertSafeCell\">assertSafeCell(cell)</a></dt>\n<dd><p>Rejects cell objects whose formula opens a code-execution vector on file open.</p>\n</dd>\n<dt><a href=\"#sheetIndex\">sheetIndex(names, sheet)</a> ⇒ <code>number</code></dt>\n<dd><p>Finds the sheet index by name or number; throws 400 when absent.\nExact names win over numeric indices, so a sheet called &quot;2024&quot; is addressable by name.</p>\n</dd>\n<dt><a href=\"#buildSheet\">buildSheet(sheet)</a> ⇒ <code>XLSX.WorkSheet</code></dt>\n<dd><p>Builds one worksheet from the payload&#39;s sheet options.</p>\n</dd>\n<dt><a href=\"#values2cells\">values2cells(row, columns)</a> ⇒ <code>Record&lt;string, unknown&gt;</code></dt>\n<dd><p>Strips prototype-polluting keys from object rows (json_to_sheet does not).</p>\n</dd>\n<dt><a href=\"#emptyTypes\">emptyTypes()</a> ⇒ <code>Map&lt;string, number&gt;</code></dt>\n<dd><p>Zeroed per-type census for a sheet.</p>\n</dd>\n</dl>\n\n<a name=\"XlsxService\"></a>\n\n## XlsxService\nXLSX feature service: builds workbooks and parses/metadata-inspects uploads.\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/xlsx/xlsx.service.ts:213  \ndist: packages/backend/dist/resources/xlsx/xlsx.service.js:132\n\n* [XlsxService](#XlsxService)\n    * [.build(body)](#XlsxService+build) ⇒ <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code>\n    * [.extract(query)](#XlsxService+extract) ⇒ <code>Promise&lt;{ records: unknown[]; sheet: string; truncated: boolean; } \\| { records: unknown[]; sheet: string; truncated?: undefined; }&gt;</code>\n    * [.metadata(query)](#XlsxService+metadata) ⇒ <code>Promise&lt;{ custprops: object; definedNames: { name: string; ref: string; sheet: number; }[]; props: XLSX.FullProperties; sheets: { autofilter: boolean; cells: number; cols: number; formulas: number; hidden: boolean; merges: number; name: string; ref: string; rows: number; types: { [k: string]: number; }; }[]; totalCells: number; }&gt;</code>\n\n<a name=\"XlsxService+build\"></a>\n\n### xlsxService.build(body) ⇒ <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code>\nBuilds a workbook from the payload and returns the .xlsx bytes.\nCell objects pass through to SheetJS (formulas, number formats, links, comments).\nStyles, images, charts and panes are SheetJS Pro-only and not supported.\n\n**Kind**: instance method of [<code>XlsxService</code>](#XlsxService)  \n**Returns**: <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code> - The workbook bytes.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| body | <code>{ sheets: { [x: string]: any; rows: (Record&lt;string, string \\| number \\| boolean \\| { [x: string]: unknown; c?: { [x: string]: unknown; a: string; t: string; }[]; f?: string; l?: { [x: string]: unknown; Target?: string; Tooltip?: string; }; t?: &quot;b&quot; \\| &quot;n&quot; \\| &quot;s&quot; \\| &quot;d&quot; \\| &quot;e&quot; \\| &quot;z&quot;; v?: unknown; z?: string; }&gt; \\| (string \\| number \\| boolean \\| { [x: string]: unknown; c?: { [x: string]: unknown; a: string; t: string; }[]; f?: string; l?: { [x: string]: unknown; Target?: string; Tooltip?: string; }; t?: &quot;b&quot; \\| &quot;n&quot; \\| &quot;s&quot; \\| &quot;d&quot; \\| &quot;e&quot; \\| &quot;z&quot;; v?: unknown; z?: string; })[])[]; cellDates?: boolean; cols?: { [x: string]: unknown; hidden?: boolean; level?: number; wch?: number; width?: number; wpx?: number; }[]; columns?: string[]; merges?: any[]; sheetVisibility?: 0 \\| 1 \\| 2; }[]; workbook?: { [x: string]: unknown; Names?: { [x: string]: unknown; Name: string; Ref: string; Sheet?: number; }[]; Props?: { [x: string]: unknown; Author?: string; Category?: string; Comments?: string; Company?: string; CreatedDate?: Date; Keywords?: string; Manager?: string; ModifiedBy?: string; ModifiedDate?: Date; Subject?: string; Title?: string; }; WBProps?: { [x: string]: unknown; CodeName?: string; date1904?: boolean; filterPrivacy?: boolean; }; }; }</code> | Validated build payload. |\n\nsrc: packages/backend/src/resources/xlsx/xlsx.service.ts:223  \ndist: packages/backend/dist/resources/xlsx/xlsx.service.js:137\n<a name=\"XlsxService+extract\"></a>\n\n### xlsxService.extract(query) ⇒ <code>Promise&lt;{ records: unknown[]; sheet: string; truncated: boolean; } \\| { records: unknown[]; sheet: string; truncated?: undefined; }&gt;</code>\nExtracts one sheet as typed JSON. Object rows need a header: pass\n`header=1` (AOA) for raw rows, `header=A` for column letters, or a\ncomma-separated header list; omit `header` to use the first row as keys.\n\n**Kind**: instance method of [<code>XlsxService</code>](#XlsxService)  \n**Returns**: <code>Promise&lt;{ records: unknown[]; sheet: string; truncated: boolean; } \\| { records: unknown[]; sheet: string; truncated?: undefined; }&gt;</code> - The sheet name plus the records.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| query | <code>{ [x: string]: any; maxCells: number; raw: boolean; blankrows?: boolean; skipHidden?: boolean; }</code> | Validated flat reader options. |\n\nsrc: packages/backend/src/resources/xlsx/xlsx.service.ts:271  \ndist: packages/backend/dist/resources/xlsx/xlsx.service.js:177\n<a name=\"XlsxService+metadata\"></a>\n\n### xlsxService.metadata(query) ⇒ <code>Promise&lt;{ custprops: object; definedNames: { name: string; ref: string; sheet: number; }[]; props: XLSX.FullProperties; sheets: { autofilter: boolean; cells: number; cols: number; formulas: number; hidden: boolean; merges: number; name: string; ref: string; rows: number; types: { [k: string]: number; }; }[]; totalCells: number; }&gt;</code>\nStructural metadata for an uploaded workbook: dims, counts, props, names,\nformula inventory and a per-type cell census, capped at `maxCells`.\n\n**Kind**: instance method of [<code>XlsxService</code>](#XlsxService)  \n**Returns**: <code>Promise&lt;{ custprops: object; definedNames: { name: string; ref: string; sheet: number; }[]; props: XLSX.FullProperties; sheets: { autofilter: boolean; cells: number; cols: number; formulas: number; hidden: boolean; merges: number; name: string; ref: string; rows: number; types: { [k: string]: number; }; }[]; totalCells: number; }&gt;</code> - The metadata document.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| query | <code>{ maxCells: number; }</code> | Validated flat metadata options. |\n\nsrc: packages/backend/src/resources/xlsx/xlsx.service.ts:329  \ndist: packages/backend/dist/resources/xlsx/xlsx.service.js:229\n<a name=\"SPREADSHEET_MIME\"></a>\n\n## SPREADSHEET\\_MIME\nThe only OOXML spreadsheet mime accepted: macro-enabled and template files are rejected.\n\n**Kind**: global constant  \nsrc: packages/backend/src/resources/xlsx/xlsx.service.ts:19  \ndist: packages/backend/dist/resources/xlsx/xlsx.service.js:18\n<a name=\"XLSX_TOTAL_UNCOMPRESSED\"></a>\n\n## XLSX\\_TOTAL\\_UNCOMPRESSED\nTotal uncompressed byte ceiling for xlsx archives; ~3.5x tighter than the shared cap.\n\n**Kind**: global constant  \nsrc: packages/backend/src/resources/xlsx/xlsx.service.ts:35  \ndist: packages/backend/dist/resources/xlsx/xlsx.service.js:25\n<a name=\"UNSAFE_FORMULA\"></a>\n\n## UNSAFE\\_FORMULA\nFormulas with DDE or remote-execution payloads are refused; ordinary functions pass through.\nAnchored at ^ with optional leading whitespace; `!cmd|...` style payloads are also refused.\n\n**Kind**: global constant  \nsrc: packages/backend/src/resources/xlsx/xlsx.service.ts:108  \ndist: packages/backend/dist/resources/xlsx/xlsx.service.js:66\n<a name=\"MAX_RECORDS\"></a>\n\n## MAX\\_RECORDS\nMaximum number of row records `/xlsx/extract` returns (defense-in-depth with the maxCells census).\n\n**Kind**: global constant  \nsrc: packages/backend/src/resources/xlsx/xlsx.service.ts:174  \ndist: packages/backend/dist/resources/xlsx/xlsx.service.js:104\n<a name=\"assertXlsxSignature\"></a>\n\n## assertXlsxSignature(buffer) ⇒ <code>Promise&lt;void&gt;</code>\nThe scanner sees declared content types only; verify the bytes too.\nThe signature must be the plain spreadsheet OOXML mime, so renamed images and .xlsm are rejected.\n\n**Kind**: global function  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| buffer | <code>Buffer&lt;ArrayBufferLike&gt;</code> | The buffered upload. |\n\nsrc: packages/backend/src/resources/xlsx/xlsx.service.ts:27  \ndist: packages/backend/dist/resources/xlsx/xlsx.service.js:19\n<a name=\"countCells\"></a>\n\n## countCells(parts) ⇒ <code>number</code>\nCounts <c> cell tags across worksheets; a cheap pre-parse bomb guard (no XML decoding).\n\n**Kind**: global function  \n**Returns**: <code>number</code> - The total number of cell tags found.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| parts | <code>Map&lt;string, Buffer&lt;ArrayBufferLike&gt;&gt;</code> | The validated OOXML parts (worksheet parts only are scanned). |\n\nsrc: packages/backend/src/resources/xlsx/xlsx.service.ts:42  \ndist: packages/backend/dist/resources/xlsx/xlsx.service.js:26\n<a name=\"readBody\"></a>\n\n## readBody(cls, maxCells) ⇒ <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code>\nReads the uploaded workbook into memory, bounded by the scanner cap.\nThe scanner only opens the source when ClamAV is enabled, so the service must too.\nApplies the OOXML zip-bomb caps and a worksheet cell ceiling before SheetJS sees a byte.\n\n**Kind**: global function  \n**Returns**: <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code> - The workbook bytes, capped.  \n**Throws**:\n\n- <code>UnsupportedMediaTypeException</code> For over-broad mimes or wrong signatures.\n- <code>BadRequestException</code> For zip structures exceeding the OOXML caps.\n- <code>PayloadTooLargeException</code> For archives with too many cells.\n\n\n| Param | Type | Description |\n| --- | --- | --- |\n| cls | <code>NormalizedClsService</code> | Normalized request context (source stream accessors). |\n| maxCells | <code>number</code> | Reject archives whose worksheets carry more cells than this. |\n\nsrc: packages/backend/src/resources/xlsx/xlsx.service.ts:63  \ndist: packages/backend/dist/resources/xlsx/xlsx.service.js:36\n<a name=\"toBadRequest\"></a>\n\n## toBadRequest(error) ⇒ <code>BadRequestException</code>\nMaps a SheetJS failure to a 400.\n\n**Kind**: global function  \n**Returns**: <code>BadRequestException</code> - A 400 exception carrying the message.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| error | <code>unknown</code> | The error thrown by SheetJS. |\n\nsrc: packages/backend/src/resources/xlsx/xlsx.service.ts:98  \ndist: packages/backend/dist/resources/xlsx/xlsx.service.js:62\n<a name=\"assertSafeCells\"></a>\n\n## assertSafeCells(sheets)\nWalks every cell once and rejects unsafe formulas.\n\n**Kind**: global function  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| sheets | <code>{ [x: string]: any; rows: (Record&lt;string, string \\| number \\| boolean \\| { [x: string]: unknown; c?: { [x: string]: unknown; a: string; t: string; }[]; f?: string; l?: { [x: string]: unknown; Target?: string; Tooltip?: string; }; t?: &quot;b&quot; \\| &quot;n&quot; \\| &quot;s&quot; \\| &quot;d&quot; \\| &quot;e&quot; \\| &quot;z&quot;; v?: unknown; z?: string; }&gt; \\| (string \\| number \\| boolean \\| { [x: string]: unknown; c?: { [x: string]: unknown; a: string; t: string; }[]; f?: string; l?: { [x: string]: unknown; Target?: string; Tooltip?: string; }; t?: &quot;b&quot; \\| &quot;n&quot; \\| &quot;s&quot; \\| &quot;d&quot; \\| &quot;e&quot; \\| &quot;z&quot;; v?: unknown; z?: string; })[])[]; cellDates?: boolean; cols?: { [x: string]: unknown; hidden?: boolean; level?: number; wch?: number; width?: number; wpx?: number; }[]; columns?: string[]; merges?: any[]; sheetVisibility?: 0 \\| 1 \\| 2; }[]</code> | The validated sheet descriptors. |\n\nsrc: packages/backend/src/resources/xlsx/xlsx.service.ts:120  \ndist: packages/backend/dist/resources/xlsx/xlsx.service.js:72\n<a name=\"assertSafeFormula\"></a>\n\n## assertSafeFormula(f)\nRejects a formula string with a code-execution vector.\n\n**Kind**: global function  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| f | <code>string</code> | The formula, without a leading equals sign. |\n\nsrc: packages/backend/src/resources/xlsx/xlsx.service.ts:134  \ndist: packages/backend/dist/resources/xlsx/xlsx.service.js:81\n<a name=\"assertSafeCell\"></a>\n\n## assertSafeCell(cell)\nRejects cell objects whose formula opens a code-execution vector on file open.\n\n**Kind**: global function  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| cell | <code>unknown</code> | One candidate cell (passed through by the build payload). |\n\nsrc: packages/backend/src/resources/xlsx/xlsx.service.ts:155  \ndist: packages/backend/dist/resources/xlsx/xlsx.service.js:97\n<a name=\"sheetIndex\"></a>\n\n## sheetIndex(names, sheet) ⇒ <code>number</code>\nFinds the sheet index by name or number; throws 400 when absent.\nExact names win over numeric indices, so a sheet called \"2024\" is addressable by name.\n\n**Kind**: global function  \n**Returns**: <code>number</code> - The resolved index.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| names | <code>string[]</code> | The workbook's ordered sheet names. |\n| sheet | <code>string</code> | Name or 0-based index; undefined means the first sheet. |\n\nsrc: packages/backend/src/resources/xlsx/xlsx.service.ts:191  \ndist: packages/backend/dist/resources/xlsx/xlsx.service.js:111\n<a name=\"buildSheet\"></a>\n\n## buildSheet(sheet) ⇒ <code>XLSX.WorkSheet</code>\nBuilds one worksheet from the payload's sheet options.\n\n**Kind**: global function  \n**Returns**: <code>XLSX.WorkSheet</code> - The populated SheetJS worksheet.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| sheet | <code>{ [x: string]: any; rows: (Record&lt;string, string \\| number \\| boolean \\| { [x: string]: unknown; c?: { [x: string]: unknown; a: string; t: string; }[]; f?: string; l?: { [x: string]: unknown; Target?: string; Tooltip?: string; }; t?: &quot;b&quot; \\| &quot;n&quot; \\| &quot;s&quot; \\| &quot;d&quot; \\| &quot;e&quot; \\| &quot;z&quot;; v?: unknown; z?: string; }&gt; \\| (string \\| number \\| boolean \\| { [x: string]: unknown; c?: { [x: string]: unknown; a: string; t: string; }[]; f?: string; l?: { [x: string]: unknown; Target?: string; Tooltip?: string; }; t?: &quot;b&quot; \\| &quot;n&quot; \\| &quot;s&quot; \\| &quot;d&quot; \\| &quot;e&quot; \\| &quot;z&quot;; v?: unknown; z?: string; })[])[]; cellDates?: boolean; cols?: { [x: string]: unknown; hidden?: boolean; level?: number; wch?: number; width?: number; wpx?: number; }[]; columns?: string[]; merges?: any[]; sheetVisibility?: 0 \\| 1 \\| 2; }</code> | The validated sheet descriptor. |\n\nsrc: packages/backend/src/resources/xlsx/xlsx.service.ts:410  \ndist: packages/backend/dist/resources/xlsx/xlsx.service.js:308\n<a name=\"values2cells\"></a>\n\n## values2cells(row, columns) ⇒ <code>Record&lt;string, unknown&gt;</code>\nStrips prototype-polluting keys from object rows (json_to_sheet does not).\n\n**Kind**: global function  \n**Returns**: <code>Record&lt;string, unknown&gt;</code> - A clean row object safe for json_to_sheet.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| row | <code>Record&lt;string, unknown&gt;</code> | The raw object row. |\n| columns | <code>string[]</code> | Optional column-order lock; keys not listed are dropped. |\n\nsrc: packages/backend/src/resources/xlsx/xlsx.service.ts:442  \ndist: packages/backend/dist/resources/xlsx/xlsx.service.js:337\n<a name=\"emptyTypes\"></a>\n\n## emptyTypes() ⇒ <code>Map&lt;string, number&gt;</code>\nZeroed per-type census for a sheet.\n\n**Kind**: global function  \n**Returns**: <code>Map&lt;string, number&gt;</code> - A zeroed map from SheetJS cell type tag to count.  \nsrc: packages/backend/src/resources/xlsx/xlsx.service.ts:462  \ndist: packages/backend/dist/resources/xlsx/xlsx.service.js:349\n","symbols":19,"lastUsed":1795079893618},"tdata:packages/backend/src/services/anti-virus.service.ts":{"doclets":[{"id":"<anonymous>~AntiVirusService()","longname":"<anonymous>~AntiVirusService","name":"AntiVirusService","kind":"constructor","description":"Creates the service.","memberof":"<anonymous>~AntiVirusService","params":[{"description":"CLS facade for the current request, source stream and scan verdict.","name":"normalizedCls","type":{"names":["NormalizedClsService"]}}],"order":3,"returns":[{"type":{"names":["AntiVirusService"]}}]},{"id":"AntiVirusService","longname":"AntiVirusService","name":"AntiVirusService","kind":"member","scope":"global","description":"Scans the request payload with ClamAV (INSTREAM via `clamd`) before it is\nprocessed further.\n\nWhen `CLAMAV_HOST` or `CLAMAV_PORT` is unset the integration is disabled and\ncallers are expected to skip it entirely (see {@link enabled}); the scan\nitself assumes the daemon is configured and fails closed otherwise.\n\nA declared `content-length` above `CLAMAV_MAX_BYTES` is rejected with\n`PayloadTooLargeException` before the body is read. Otherwise the body is\nbuffered once (bounded by `CLAMAV_MAX_BYTES`, same pattern as the OCR\npipeline) so the verdict can be delivered before any worker sees a single\nbyte; after a clean verdict the buffered body is replayed into the pipeline\nas a fresh `Readable`. Buffering (rather than teeing) is deliberate: a tee\nbranch that nobody has consumed yet stalls at 16 KiB and starves the scan,\nwhich deadlocks every body past the buffer high-water mark.\n\nThe method fails closed: no outcome other than a conclusive \"clean\" answer\nis ever reported as safe — infected payloads, inconclusive daemon replies,\noversized bodies and scanner errors all throw.","params":[],"meta":{"lineno":92},"order":1,"mdaics":{"dist":"packages/backend/dist/services/anti-virus.service.js:40","src":"packages/backend/src/services/anti-virus.service.ts:90"},"level":0},{"id":"loadClamAv","longname":"loadClamAv","name":"loadClamAv","kind":"constant","scope":"global","description":"Builds the ClamAV client at most once per process; the initialized instance\nis reused for every scan. The connection is tested with a ping at init time\n(`bypassTest: false`), so an unreachable daemon rejects here and every caller\nmaps that to `ServiceUnavailableException`. A rejected initialization is\ndropped from the memoization cache, so the next call retries from scratch.","params":[],"returns":[{"description":"The initialized ClamAV client."}],"meta":{"lineno":49},"order":0,"mdaics":{"dist":"packages/backend/dist/services/anti-virus.service.js:18","src":"packages/backend/src/services/anti-virus.service.ts:45"},"level":0},{"id":"AntiVirusService#enabled","longname":"AntiVirusService#enabled","name":"enabled","kind":"function","scope":"instance","description":"Whether the ClamAV integration is configured. Read at call time so tests\ncan flip the environment between assertions.","memberof":"AntiVirusService","params":[],"returns":[{"description":"True when both `CLAMAV_HOST` and `CLAMAV_PORT` are set.","type":{"names":["boolean"]}}],"meta":{"lineno":120},"order":4,"mdaics":{"dist":"packages/backend/dist/services/anti-virus.service.js:46","src":"packages/backend/src/services/anti-virus.service.ts:104"},"level":0},{"id":"AntiVirusService#scan","longname":"AntiVirusService#scan","name":"scan","kind":"function","scope":"instance","description":"Buffers the full payload (bounded by `CLAMAV_MAX_BYTES`), scans the\nbuffer with ClamAV, then replaces the CLS source stream with a replay\n`Readable` so the downstream pipeline consumes the body as usual.\n\nOn any failure the source stream is destroyed and the pipeline is never\nstarted: fail-closed, like everywhere else in this service. After a\nclean verdict CLS holds `{ isInfected: false, viruses: [] }` and the\nreplayed body is handed downstream.","memberof":"AntiVirusService","params":[{"description":"Object carrying the request source stream to scan.","name":"options","type":{"names":["{ stream: Readable; }"]}},{"description":"The source stream (upload `request.raw` or the download body); replaced in CLS on success.","name":"options.stream"}],"returns":[{"description":"The clean verdict, stored in CLS.","type":{"names":["Promise<AntiVirusScanResult>"]}}],"exceptions":[{"description":"PayloadTooLargeException When the payload exceeds `CLAMAV_MAX_BYTES`; clamd is never contacted."},{"description":"UnprocessableEntityException When clamd reports an infected payload."},{"description":"ServiceUnavailableException When clamd replies inconclusively, or the client cannot initialize/scan."}],"meta":{"lineno":139},"async":true,"order":5,"mdaics":{"dist":"packages/backend/dist/services/anti-virus.service.js:49","src":"packages/backend/src/services/anti-virus.service.ts:124"},"level":0},{"id":"<anonymous>~AntiVirusService","longname":"<anonymous>~AntiVirusService","name":"AntiVirusService","kind":"class","scope":"inner","memberof":"<anonymous>","meta":{"lineno":112},"order":2,"mdaics":{"dist":"packages/backend/dist/services/anti-virus.service.js:41","src":"packages/backend/src/services/anti-virus.service.ts:97"}}],"fp":"ef2f69e419f1a06678f713d1f42e630200e3fd792a273e85d72a6a2623fa87b8","issues":[],"kind":"tdata","lastUsed":1795079893705,"symbols":0},"md:packages/backend/src/services/anti-virus.service.ts":{"fp":"591a8a01ed2c7fe48a8037a8c7fe7c0ccd7b1c923d90b4d5b35e590aca4e68a2","issues":[],"kind":"md","markdown":"## Members\n\n<dl>\n<dt><a href=\"#AntiVirusService\">AntiVirusService</a></dt>\n<dd><p>Scans the request payload with ClamAV (INSTREAM via <code>clamd</code>) before it is\nprocessed further.</p>\n<p>When <code>CLAMAV_HOST</code> or <code>CLAMAV_PORT</code> is unset the integration is disabled and\ncallers are expected to skip it entirely (see <a href=\"enabled\">enabled</a>); the scan\nitself assumes the daemon is configured and fails closed otherwise.</p>\n<p>A declared <code>content-length</code> above <code>CLAMAV_MAX_BYTES</code> is rejected with\n<code>PayloadTooLargeException</code> before the body is read. Otherwise the body is\nbuffered once (bounded by <code>CLAMAV_MAX_BYTES</code>, same pattern as the OCR\npipeline) so the verdict can be delivered before any worker sees a single\nbyte; after a clean verdict the buffered body is replayed into the pipeline\nas a fresh <code>Readable</code>. Buffering (rather than teeing) is deliberate: a tee\nbranch that nobody has consumed yet stalls at 16 KiB and starves the scan,\nwhich deadlocks every body past the buffer high-water mark.</p>\n<p>The method fails closed: no outcome other than a conclusive &quot;clean&quot; answer\nis ever reported as safe — infected payloads, inconclusive daemon replies,\noversized bodies and scanner errors all throw.</p>\n</dd>\n</dl>\n\n## Constants\n\n<dl>\n<dt><a href=\"#loadClamAv\">loadClamAv</a> ⇒</dt>\n<dd><p>Builds the ClamAV client at most once per process; the initialized instance\nis reused for every scan. The connection is tested with a ping at init time\n(<code>bypassTest: false</code>), so an unreachable daemon rejects here and every caller\nmaps that to <code>ServiceUnavailableException</code>. A rejected initialization is\ndropped from the memoization cache, so the next call retries from scratch.</p>\n</dd>\n</dl>\n\n<a name=\"AntiVirusService\"></a>\n\n## AntiVirusService\nScans the request payload with ClamAV (INSTREAM via `clamd`) before it is\nprocessed further.\n\nWhen `CLAMAV_HOST` or `CLAMAV_PORT` is unset the integration is disabled and\ncallers are expected to skip it entirely (see [enabled](enabled)); the scan\nitself assumes the daemon is configured and fails closed otherwise.\n\nA declared `content-length` above `CLAMAV_MAX_BYTES` is rejected with\n`PayloadTooLargeException` before the body is read. Otherwise the body is\nbuffered once (bounded by `CLAMAV_MAX_BYTES`, same pattern as the OCR\npipeline) so the verdict can be delivered before any worker sees a single\nbyte; after a clean verdict the buffered body is replayed into the pipeline\nas a fresh `Readable`. Buffering (rather than teeing) is deliberate: a tee\nbranch that nobody has consumed yet stalls at 16 KiB and starves the scan,\nwhich deadlocks every body past the buffer high-water mark.\n\nThe method fails closed: no outcome other than a conclusive \"clean\" answer\nis ever reported as safe — infected payloads, inconclusive daemon replies,\noversized bodies and scanner errors all throw.\n\n**Kind**: global variable  \nsrc: packages/backend/src/services/anti-virus.service.ts:90  \ndist: packages/backend/dist/services/anti-virus.service.js:40\n\n* [AntiVirusService](#AntiVirusService)\n    * [.enabled()](#AntiVirusService+enabled) ⇒ <code>boolean</code>\n    * [.scan(options)](#AntiVirusService+scan) ⇒ <code>Promise&lt;AntiVirusScanResult&gt;</code>\n\n<a name=\"AntiVirusService+enabled\"></a>\n\n### antiVirusService.enabled() ⇒ <code>boolean</code>\nWhether the ClamAV integration is configured. Read at call time so tests\ncan flip the environment between assertions.\n\n**Kind**: instance method of [<code>AntiVirusService</code>](#AntiVirusService)  \n**Returns**: <code>boolean</code> - True when both `CLAMAV_HOST` and `CLAMAV_PORT` are set.  \nsrc: packages/backend/src/services/anti-virus.service.ts:104  \ndist: packages/backend/dist/services/anti-virus.service.js:46\n<a name=\"AntiVirusService+scan\"></a>\n\n### antiVirusService.scan(options) ⇒ <code>Promise&lt;AntiVirusScanResult&gt;</code>\nBuffers the full payload (bounded by `CLAMAV_MAX_BYTES`), scans the\nbuffer with ClamAV, then replaces the CLS source stream with a replay\n`Readable` so the downstream pipeline consumes the body as usual.\n\nOn any failure the source stream is destroyed and the pipeline is never\nstarted: fail-closed, like everywhere else in this service. After a\nclean verdict CLS holds `{ isInfected: false, viruses: [] }` and the\nreplayed body is handed downstream.\n\n**Kind**: instance method of [<code>AntiVirusService</code>](#AntiVirusService)  \n**Returns**: <code>Promise&lt;AntiVirusScanResult&gt;</code> - The clean verdict, stored in CLS.  \n**Throws**:\n\n- PayloadTooLargeException When the payload exceeds `CLAMAV_MAX_BYTES`; clamd is never contacted.\n- UnprocessableEntityException When clamd reports an infected payload.\n- ServiceUnavailableException When clamd replies inconclusively, or the client cannot initialize/scan.\n\n\n| Param | Type | Description |\n| --- | --- | --- |\n| options | <code>{ stream: Readable; }</code> | Object carrying the request source stream to scan. |\n| options.stream |  | The source stream (upload `request.raw` or the download body); replaced in CLS on success. |\n\nsrc: packages/backend/src/services/anti-virus.service.ts:124  \ndist: packages/backend/dist/services/anti-virus.service.js:49\n<a name=\"loadClamAv\"></a>\n\n## loadClamAv ⇒\nBuilds the ClamAV client at most once per process; the initialized instance\nis reused for every scan. The connection is tested with a ping at init time\n(`bypassTest: false`), so an unreachable daemon rejects here and every caller\nmaps that to `ServiceUnavailableException`. A rejected initialization is\ndropped from the memoization cache, so the next call retries from scratch.\n\n**Kind**: global constant  \n**Returns**: The initialized ClamAV client.  \nsrc: packages/backend/src/services/anti-virus.service.ts:45  \ndist: packages/backend/dist/services/anti-virus.service.js:18\n","symbols":6,"lastUsed":1795079893758},"tdata:packages/backend/src/services/cache-janitor.service.spec.ts":{"doclets":[],"fp":"5366cc83f06015ac8a7b77166c26613288c253cbab2589c17547b4463173f499","issues":[],"kind":"tdata","lastUsed":1795079893758,"symbols":0},"md:packages/backend/src/services/cache-janitor.service.spec.ts":{"fp":"51b5353657095445f0238dcf612380ca5de66cdbc35545f6ccdc69b0a5d8f3fe","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795079893768},"tdata:packages/backend/src/services/file-type.service.spec.ts":{"doclets":[{"id":"FILE_TYPE_API_SURFACE","longname":"FILE_TYPE_API_SURFACE","name":"FILE_TYPE_API_SURFACE","kind":"constant","scope":"global","description":"Named symbol for the mdaics docs site (see https://github.com/rayenboussayed/mdaics); no runtime use.","meta":{"lineno":94},"order":2,"mdaics":{"src":"packages/backend/src/services/file-type.service.spec.ts:120"},"level":0},{"id":"<anonymous>~counted","longname":"<anonymous>~counted","name":"counted","kind":"function","scope":"inner","description":"Replays the fixture chunks while counting them.","meta":{"lineno":61},"yields":[{"description":"The fixture chunks one at a time."}],"memberof":"<anonymous>","params":[],"async":true,"generator":true,"order":0,"mdaics":{"src":"packages/backend/src/services/file-type.service.spec.ts:81"},"returns":[{"type":{"names":["AsyncGenerator<Buffer<ArrayBuffer>, void, unknown>"]}}]},{"id":"<anonymous>~broken","longname":"<anonymous>~broken","name":"broken","kind":"function","scope":"inner","description":"Replays the fixture header, then fails mid-read.","meta":{"lineno":83},"yields":[{"description":"The fixture header, then throws."}],"memberof":"<anonymous>","params":[],"async":true,"generator":true,"order":1,"mdaics":{"src":"packages/backend/src/services/file-type.service.spec.ts:107"},"returns":[{"type":{"names":["AsyncGenerator<Buffer<ArrayBuffer>, void, unknown>"]}}]}],"fp":"3315a46d79e0ead58b545d9eb3d769cbd9066803de10f73a423ecded52e800d0","issues":[],"kind":"tdata","lastUsed":1795079893778,"symbols":0},"tdata:packages/backend/src/services/cache-janitor.service.ts":{"doclets":[{"id":"CacheJanitorService","longname":"CacheJanitorService","name":"CacheJanitorService","kind":"member","scope":"global","description":"Continuous cache maintenance: TTL, size cap (least-recently-used first), orphan cleanup.","params":[],"meta":{"lineno":41},"order":0,"mdaics":{"dist":"packages/backend/dist/services/cache-janitor.service.js:12","src":"packages/backend/src/services/cache-janitor.service.ts:23"},"level":0}],"fp":"637ca887b7296a3f1b27bb9a623506b0db51f26bef58f8dcbcff68f576fd0e53","issues":[],"kind":"tdata","lastUsed":1795079893768,"symbols":0},"md:packages/backend/src/services/file-type.service.spec.ts":{"fp":"b585789b50ee544a7338178c7467c3f656db35cc4965cefb40f18d8f74215160","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","markdown":"<a name=\"FILE_TYPE_API_SURFACE\"></a>\n\n## FILE\\_TYPE\\_API\\_SURFACE\nNamed symbol for the mdaics docs site (see https://github.com/rayenboussayed/mdaics); no runtime use.\n\n**Kind**: global constant  \nsrc: packages/backend/src/services/file-type.service.spec.ts:120  \n","symbols":3,"lastUsed":1795079893850},"md:packages/backend/src/services/cache-janitor.service.ts":{"fp":"75bbef75996cc637f376e0e9bf0449ae72983a859cbed517e60adc8a14aceac1","issues":[],"kind":"md","markdown":"<a name=\"CacheJanitorService\"></a>\n\n## CacheJanitorService\nContinuous cache maintenance: TTL, size cap (least-recently-used first), orphan cleanup.\n\n**Kind**: global variable  \nsrc: packages/backend/src/services/cache-janitor.service.ts:23  \ndist: packages/backend/dist/services/cache-janitor.service.js:12\n","symbols":1,"lastUsed":1795079893831},"tdata:packages/backend/src/services/normalized-cls.service.spec.ts":{"doclets":[],"fp":"1bc2712dd2bf3a554c775eb3272a2391ee116ab40a15d9e8933c427015243ac7","issues":[],"kind":"tdata","lastUsed":1795079893859,"symbols":0},"md:packages/backend/src/services/normalized-cls.service.spec.ts":{"fp":"15ddc3c1d74dca44d9c9212cc53530956763f1e5c617d1bef2c5582ac34f1dca","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795079893866},"tdata:packages/backend/src/services/file-type.service.ts":{"doclets":[{"id":"FileTypeService","longname":"FileTypeService","name":"FileTypeService","kind":"member","scope":"global","description":"File-type sniffing helpers shared by the signature gates.","params":[],"meta":{"lineno":39},"order":0,"mdaics":{"dist":"packages/backend/dist/services/file-type.service.js:39 (approx.)","src":"packages/backend/src/services/file-type.service.ts:10"},"level":0},{"id":"nonDestructiveWebStream","longname":"nonDestructiveWebStream","name":"nonDestructiveWebStream","kind":"function","scope":"global","description":"Wraps a Node readable in a web stream whose `cancel` only detaches the\npump, without destroying the Node stream.\n\n`fileTypeFromStream` cancels its web stream as soon as the signature is\nknown; with `Readable.toWeb` that cancel destroys the Node stream (with an\nAbortError), which would kill the probe branch of the shared tee. Here the\npump stops requesting chunks and instead keeps pulling from the same\niterator, discarding everything, so the probe branch of the tee keeps\nflowing and the upload is not stalled by the probe being finished.","params":[{"description":"The Node readable to wrap (e.g. a probe branch of a tee).","name":"node","type":{"names":["Readable"]}}],"returns":[{"description":"A web ReadableStream serving the same bytes.","type":{"names":["ReadableStream<Uint8Array<ArrayBufferLike>>"]}}],"meta":{"lineno":138},"order":4,"mdaics":{"dist":"packages/backend/dist/services/file-type.service.js:138 (approx.)","src":"packages/backend/src/services/file-type.service.ts:103"},"level":0},{"id":"FileTypeService#isCsv","longname":"FileTypeService#isCsv","name":"isCsv","kind":"function","scope":"instance","description":"Whether the mime is csv text. Content-level checks happen in the csv module;\nfile-type cannot sniff csv, so this matches on the declared mime only.","memberof":"FileTypeService","params":[{"description":"Detected or declared content type.","name":"mime","type":{"names":["string"]}}],"returns":[{"description":"True for text/csv.","type":{"names":["boolean"]}}],"meta":{"lineno":66},"order":1,"mdaics":{"dist":"packages/backend/dist/services/file-type.service.js:66 (approx.)","src":"packages/backend/src/services/file-type.service.ts:23"},"level":0},{"id":"FileTypeService#isDocument","longname":"FileTypeService#isDocument","name":"isDocument","kind":"function","scope":"instance","description":"Whether the mime is an office or PDF document the document pipeline accepts.","memberof":"FileTypeService","params":[{"description":"Detected content type (e.g. from the parser).","name":"mime","type":{"names":["string"]}}],"returns":[{"description":"True for docx, pptx and pdf mimes.","type":{"names":["boolean"]}}],"meta":{"lineno":74},"order":2,"mdaics":{"dist":"packages/backend/dist/services/file-type.service.js:74 (approx.)","src":"packages/backend/src/services/file-type.service.ts:32"},"level":0},{"id":"FileTypeService#isSpreadsheet","longname":"FileTypeService#isSpreadsheet","name":"isSpreadsheet","kind":"function","scope":"instance","description":"Whether the mime is a spreadsheet the xlsx pipeline accepts.","memberof":"FileTypeService","params":[{"description":"Detected content type (e.g. from the parser).","name":"mime","type":{"names":["string"]}}],"returns":[{"description":"True for the OOXML spreadsheet mime.","type":{"names":["boolean"]}}],"meta":{"lineno":89},"order":3,"mdaics":{"dist":"packages/backend/dist/services/file-type.service.js:89 (approx.)","src":"packages/backend/src/services/file-type.service.ts:51"},"level":0},{"id":"nonDestructiveWebStream~drainIterator","longname":"nonDestructiveWebStream~drainIterator","name":"drainIterator","kind":"function","scope":"inner","description":"Reads the remainder of the Node stream with the same iterator, discarding\nevery chunk, so a paused tee unblocks.","memberof":"nonDestructiveWebStream","params":[],"returns":[{"description":"The number of bytes discarded.","type":{"names":["Promise<number>"]}}],"meta":{"lineno":146},"async":true,"order":5,"mdaics":{"dist":"packages/backend/dist/services/file-type.service.js:146 (approx.)","src":"packages/backend/src/services/file-type.service.ts:112"},"level":0}],"fp":"0b3fa630946a850681eb3c63d2fceab4571416650e410ab6aec46e241f6e188f","issues":[],"kind":"tdata","symbols":0,"lastUsed":1795079894083},"md:packages/backend/src/services/file-type.service.ts":{"fp":"4e3ef244914054b4833db5db7df4c89cce373ade044117dc7f47edf889176efd","issues":["dist sourcemap missing or unmatched — dist line is an approximation"],"kind":"md","markdown":"## Members\n\n<dl>\n<dt><a href=\"#FileTypeService\">FileTypeService</a></dt>\n<dd><p>File-type sniffing helpers shared by the signature gates.</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#nonDestructiveWebStream\">nonDestructiveWebStream(node)</a> ⇒ <code>ReadableStream&lt;Uint8Array&lt;ArrayBufferLike&gt;&gt;</code></dt>\n<dd><p>Wraps a Node readable in a web stream whose <code>cancel</code> only detaches the\npump, without destroying the Node stream.</p>\n<p><code>fileTypeFromStream</code> cancels its web stream as soon as the signature is\nknown; with <code>Readable.toWeb</code> that cancel destroys the Node stream (with an\nAbortError), which would kill the probe branch of the shared tee. Here the\npump stops requesting chunks and instead keeps pulling from the same\niterator, discarding everything, so the probe branch of the tee keeps\nflowing and the upload is not stalled by the probe being finished.</p>\n</dd>\n</dl>\n\n<a name=\"FileTypeService\"></a>\n\n## FileTypeService\nFile-type sniffing helpers shared by the signature gates.\n\n**Kind**: global variable  \nsrc: packages/backend/src/services/file-type.service.ts:10  \ndist: packages/backend/dist/services/file-type.service.js:39 (approx.)\n\n* [FileTypeService](#FileTypeService)\n    * [.isCsv(mime)](#FileTypeService+isCsv) ⇒ <code>boolean</code>\n    * [.isDocument(mime)](#FileTypeService+isDocument) ⇒ <code>boolean</code>\n    * [.isSpreadsheet(mime)](#FileTypeService+isSpreadsheet) ⇒ <code>boolean</code>\n\n<a name=\"FileTypeService+isCsv\"></a>\n\n### fileTypeService.isCsv(mime) ⇒ <code>boolean</code>\nWhether the mime is csv text. Content-level checks happen in the csv module;\nfile-type cannot sniff csv, so this matches on the declared mime only.\n\n**Kind**: instance method of [<code>FileTypeService</code>](#FileTypeService)  \n**Returns**: <code>boolean</code> - True for text/csv.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| mime | <code>string</code> | Detected or declared content type. |\n\nsrc: packages/backend/src/services/file-type.service.ts:23  \ndist: packages/backend/dist/services/file-type.service.js:66 (approx.)\n<a name=\"FileTypeService+isDocument\"></a>\n\n### fileTypeService.isDocument(mime) ⇒ <code>boolean</code>\nWhether the mime is an office or PDF document the document pipeline accepts.\n\n**Kind**: instance method of [<code>FileTypeService</code>](#FileTypeService)  \n**Returns**: <code>boolean</code> - True for docx, pptx and pdf mimes.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| mime | <code>string</code> | Detected content type (e.g. from the parser). |\n\nsrc: packages/backend/src/services/file-type.service.ts:32  \ndist: packages/backend/dist/services/file-type.service.js:74 (approx.)\n<a name=\"FileTypeService+isSpreadsheet\"></a>\n\n### fileTypeService.isSpreadsheet(mime) ⇒ <code>boolean</code>\nWhether the mime is a spreadsheet the xlsx pipeline accepts.\n\n**Kind**: instance method of [<code>FileTypeService</code>](#FileTypeService)  \n**Returns**: <code>boolean</code> - True for the OOXML spreadsheet mime.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| mime | <code>string</code> | Detected content type (e.g. from the parser). |\n\nsrc: packages/backend/src/services/file-type.service.ts:51  \ndist: packages/backend/dist/services/file-type.service.js:89 (approx.)\n<a name=\"nonDestructiveWebStream\"></a>\n\n## nonDestructiveWebStream(node) ⇒ <code>ReadableStream&lt;Uint8Array&lt;ArrayBufferLike&gt;&gt;</code>\nWraps a Node readable in a web stream whose `cancel` only detaches the\npump, without destroying the Node stream.\n\n`fileTypeFromStream` cancels its web stream as soon as the signature is\nknown; with `Readable.toWeb` that cancel destroys the Node stream (with an\nAbortError), which would kill the probe branch of the shared tee. Here the\npump stops requesting chunks and instead keeps pulling from the same\niterator, discarding everything, so the probe branch of the tee keeps\nflowing and the upload is not stalled by the probe being finished.\n\n**Kind**: global function  \n**Returns**: <code>ReadableStream&lt;Uint8Array&lt;ArrayBufferLike&gt;&gt;</code> - A web ReadableStream serving the same bytes.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| node | <code>Readable</code> | The Node readable to wrap (e.g. a probe branch of a tee). |\n\nsrc: packages/backend/src/services/file-type.service.ts:103  \ndist: packages/backend/dist/services/file-type.service.js:138 (approx.)\n<a name=\"nonDestructiveWebStream..drainIterator\"></a>\n\n### nonDestructiveWebStream~drainIterator() ⇒ <code>Promise&lt;number&gt;</code>\nReads the remainder of the Node stream with the same iterator, discarding\nevery chunk, so a paused tee unblocks.\n\n**Kind**: inner method of [<code>nonDestructiveWebStream</code>](#nonDestructiveWebStream)  \n**Returns**: <code>Promise&lt;number&gt;</code> - The number of bytes discarded.  \nsrc: packages/backend/src/services/file-type.service.ts:112  \ndist: packages/backend/dist/services/file-type.service.js:146 (approx.)\n","symbols":6,"lastUsed":1795079894126},"tdata:packages/backend/src/services/ooxml-meta.spec.ts":{"doclets":[],"fp":"ee55a5ccdf5443d17732386dbbb4b41d7f2d21cda47f8b1bf776661dd5f5b9ba","issues":[],"kind":"tdata","lastUsed":1795079893888,"symbols":0},"md:packages/backend/src/services/ooxml-meta.spec.ts":{"fp":"0bf07bff21839d92d2bbe29e84920f408f6ab15caeb2490eb83ca0c4582b79e1","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795079893888},"tdata:packages/backend/src/services/normalized-cls.service.ts":{"doclets":[{"id":"NormalizedClsService","longname":"NormalizedClsService","name":"NormalizedClsService","kind":"member","scope":"global","description":"Lazy, typed accessors over the CLS store for the current request context.","params":[],"meta":{"lineno":40},"order":0,"mdaics":{"dist":"packages/backend/dist/services/normalized-cls.service.js:40 (approx.)","src":"packages/backend/src/services/normalized-cls.service.ts:29"},"level":0}],"fp":"58ae662dcba08a99f12184915881a2df04943b8159597c0bf740749e5122bdc4","issues":[],"kind":"tdata","symbols":0,"lastUsed":1795079894155},"md:packages/backend/src/services/normalized-cls.service.ts":{"fp":"dbb0ad106d27f9154af270dfb9e6796f09b5ef5950a9f8c39c00e52d3555ef91","issues":["dist sourcemap missing or unmatched — dist line is an approximation"],"kind":"md","markdown":"<a name=\"NormalizedClsService\"></a>\n\n## NormalizedClsService\nLazy, typed accessors over the CLS store for the current request context.\n\n**Kind**: global variable  \nsrc: packages/backend/src/services/normalized-cls.service.ts:29  \ndist: packages/backend/dist/services/normalized-cls.service.js:40 (approx.)\n","symbols":1,"lastUsed":1795079894208},"tdata:packages/backend/src/services/ooxml-meta.ts":{"doclets":[{"id":"parseOoxmlMetadata","longname":"parseOoxmlMetadata","name":"parseOoxmlMetadata","kind":"function","scope":"global","description":"Extracts normalized metadata from an OOXML package.","params":[{"description":"The parts returned by {@link OoxmlReader.readParts}.","name":"parts","type":{"names":["Map<string, Buffer<ArrayBufferLike>>"]}}],"returns":[{"description":"The normalized properties; empty object when no docProps part is present.","type":{"names":["OoxmlMetadata"]}}],"meta":{"lineno":40},"order":0,"mdaics":{"dist":"packages/backend/dist/services/ooxml-meta.js:32","src":"packages/backend/src/services/ooxml-meta.ts:72"},"level":0}],"fp":"7ac8834de4a6dc3068b235e427592705c4883adf7cf126be1b0c223827e579a2","issues":[],"kind":"tdata","lastUsed":1795079893888,"symbols":0},"md:packages/backend/src/services/ooxml-meta.ts":{"fp":"bdb3726f0b0a607d3f5443163e33cf625842e7dfb36d075453a05cf6af3ea85a","issues":[],"kind":"md","markdown":"<a name=\"parseOoxmlMetadata\"></a>\n\n## parseOoxmlMetadata(parts) ⇒ <code>OoxmlMetadata</code>\nExtracts normalized metadata from an OOXML package.\n\n**Kind**: global function  \n**Returns**: <code>OoxmlMetadata</code> - The normalized properties; empty object when no docProps part is present.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| parts | <code>Map&lt;string, Buffer&lt;ArrayBufferLike&gt;&gt;</code> | The parts returned by [OoxmlReader.readParts](OoxmlReader.readParts). |\n\nsrc: packages/backend/src/services/ooxml-meta.ts:72  \ndist: packages/backend/dist/services/ooxml-meta.js:32\n","symbols":1,"lastUsed":1795079893923},"tdata:packages/backend/src/services/ooxml-reader.spec.ts":{"doclets":[],"fp":"b48765f19b30911ceb9825b73280daa5b9268438ef9221e64c0ad2e9961c6f4f","issues":[],"kind":"tdata","lastUsed":1795079893900,"symbols":0},"md:packages/backend/src/services/ooxml-reader.spec.ts":{"fp":"068cf8bc256bae1f42aef5657738eda25c8c7ef0f62584728b87ec562719b7ab","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795079893902},"tdata:packages/backend/src/services/ooxml-xml.spec.ts":{"doclets":[],"fp":"e43bf7d3143eb640974da1c4462beaa1e497971a0cedfc4e9ef502d9bb9d52db","issues":[],"kind":"tdata","lastUsed":1795079893933,"symbols":0},"md:packages/backend/src/services/ooxml-xml.spec.ts":{"fp":"e66303fb33d410c29ffc65f3fc805add73f98e18757e5e6985baa3b36775bb03","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795079893933},"tdata:packages/backend/src/services/ooxml-reader.ts":{"doclets":[{"id":"OoxmlError","longname":"OoxmlError","name":"OoxmlError","kind":"class","scope":"global","description":"Error thrown for any OOXML structural problem; maps to HTTP 400/415 at the boundary.","meta":{"lineno":12},"order":4,"mdaics":{"dist":"packages/backend/dist/services/ooxml-reader.js:7","src":"packages/backend/src/services/ooxml-reader.ts:24"},"level":0},{"id":"OoxmlReader","longname":"OoxmlReader","name":"OoxmlReader","kind":"class","scope":"global","description":"Opens an OOXML package (docx/pptx/xlsx) from a buffer and extracts its parts.\nPackages are ordinary zips; the signature interceptor guarantees the mime, while\nthis validates the zip structure itself with conservative caps.\n\nIn-memory only by design; entries are never written to disk.","meta":{"lineno":21},"order":5,"mdaics":{"dist":"packages/backend/dist/services/ooxml-reader.js:9","src":"packages/backend/src/services/ooxml-reader.ts:33"},"level":0},{"id":"OOXML_LIMITS","longname":"OOXML_LIMITS","name":"OOXML_LIMITS","kind":"constant","scope":"global","description":"Hard limits applied to every OOXML package read, enforced before inflating.","params":[],"meta":{"lineno":3},"order":0,"mdaics":{"dist":"packages/backend/dist/services/ooxml-reader.js:2","src":"packages/backend/src/services/ooxml-reader.ts:4"},"level":0},{"id":"OOXML_LIMITS.maxEntries","longname":"OOXML_LIMITS.maxEntries","name":"maxEntries","kind":"member","scope":"static","description":"Maximum number of zip entries inspected (central directory scan).","memberof":"OOXML_LIMITS","meta":{"lineno":5},"order":1,"mdaics":{"dist":"packages/backend/dist/services/ooxml-reader.js:3","src":"packages/backend/src/services/ooxml-reader.ts:6"},"level":0},{"id":"OOXML_LIMITS.maxEntryUncompressed","longname":"OOXML_LIMITS.maxEntryUncompressed","name":"maxEntryUncompressed","kind":"member","scope":"static","description":"Maximum uncompressed size of a single entry.","memberof":"OOXML_LIMITS","meta":{"lineno":7},"order":2,"mdaics":{"dist":"packages/backend/dist/services/ooxml-reader.js:4","src":"packages/backend/src/services/ooxml-reader.ts:8"},"level":0},{"id":"OOXML_LIMITS.maxTotalUncompressed","longname":"OOXML_LIMITS.maxTotalUncompressed","name":"maxTotalUncompressed","kind":"member","scope":"static","description":"Maximum uncompressed bytes of the whole package.","memberof":"OOXML_LIMITS","meta":{"lineno":9},"order":3,"mdaics":{"dist":"packages/backend/dist/services/ooxml-reader.js:5","src":"packages/backend/src/services/ooxml-reader.ts:10"},"level":0},{"id":"OoxmlReader.partText","longname":"OoxmlReader.partText","name":"partText","kind":"function","scope":"static","description":"Reads the parts as utf-8 strings.","memberof":"OoxmlReader","params":[{"description":"The parts returned by {@link OoxmlReader.readParts}.","name":"parts","type":{"names":["Map<string, Buffer<ArrayBufferLike>>"]}},{"description":"Zip path of the part to read.","name":"name","type":{"names":["string"]}}],"returns":[{"description":"The utf-8 text, or `undefined` when the part is absent.","type":{"names":["string"]}}],"meta":{"lineno":28},"order":6,"mdaics":{"dist":"packages/backend/dist/services/ooxml-reader.js:10","src":"packages/backend/src/services/ooxml-reader.ts:40"},"level":0},{"id":"OoxmlReader.readParts","longname":"OoxmlReader.readParts","name":"readParts","kind":"function","scope":"static","description":"Reads every entry of the package into memory.","memberof":"OoxmlReader","params":[{"description":"The full, already upload-capped file.","name":"buffer","type":{"names":["Buffer<ArrayBufferLike>"]}},{"description":"Optional per-call cap overrides.","name":"limits","type":{"names":["OoxmlReadLimits"]}}],"returns":[{"description":"The parts, keyed by zip path (e.g. `docProps/core.xml`).","type":{"names":["Map<string, Buffer<ArrayBufferLike>>"]}}],"exceptions":[{"type":{"names":["OoxmlError"]},"description":"On structural problems: invalid zip, entry count, or uncompressed size caps."}],"meta":{"lineno":38},"order":7,"mdaics":{"dist":"packages/backend/dist/services/ooxml-reader.js:13","src":"packages/backend/src/services/ooxml-reader.ts:51"},"level":0}],"fp":"3d3f45ca998264e811774708876d2b35411d5035239cf4a7d6f3fe5477b60171","issues":[],"kind":"tdata","lastUsed":1795079893929,"symbols":0},"md:packages/backend/src/services/ooxml-reader.ts":{"fp":"07d54dfd88b6cb2ebf2320e205b12990ce26221c16b517719a67a9286c34739c","issues":[],"kind":"md","markdown":"## Classes\n\n<dl>\n<dt><a href=\"#OoxmlError\">OoxmlError</a></dt>\n<dd><p>Error thrown for any OOXML structural problem; maps to HTTP 400/415 at the boundary.</p>\n</dd>\n<dt><a href=\"#OoxmlReader\">OoxmlReader</a></dt>\n<dd><p>Opens an OOXML package (docx/pptx/xlsx) from a buffer and extracts its parts.\nPackages are ordinary zips; the signature interceptor guarantees the mime, while\nthis validates the zip structure itself with conservative caps.</p>\n<p>In-memory only by design; entries are never written to disk.</p>\n</dd>\n</dl>\n\n## Constants\n\n<dl>\n<dt><a href=\"#OOXML_LIMITS\">OOXML_LIMITS</a></dt>\n<dd><p>Hard limits applied to every OOXML package read, enforced before inflating.</p>\n</dd>\n</dl>\n\n<a name=\"OoxmlError\"></a>\n\n## OoxmlError\nError thrown for any OOXML structural problem; maps to HTTP 400/415 at the boundary.\n\n**Kind**: global class  \nsrc: packages/backend/src/services/ooxml-reader.ts:24  \ndist: packages/backend/dist/services/ooxml-reader.js:7\n<a name=\"OoxmlReader\"></a>\n\n## OoxmlReader\nOpens an OOXML package (docx/pptx/xlsx) from a buffer and extracts its parts.\nPackages are ordinary zips; the signature interceptor guarantees the mime, while\nthis validates the zip structure itself with conservative caps.\n\nIn-memory only by design; entries are never written to disk.\n\n**Kind**: global class  \nsrc: packages/backend/src/services/ooxml-reader.ts:33  \ndist: packages/backend/dist/services/ooxml-reader.js:9\n\n* [OoxmlReader](#OoxmlReader)\n    * [.partText(parts, name)](#OoxmlReader.partText) ⇒ <code>string</code>\n    * [.readParts(buffer, limits)](#OoxmlReader.readParts) ⇒ <code>Map&lt;string, Buffer&lt;ArrayBufferLike&gt;&gt;</code>\n\n<a name=\"OoxmlReader.partText\"></a>\n\n### OoxmlReader.partText(parts, name) ⇒ <code>string</code>\nReads the parts as utf-8 strings.\n\n**Kind**: static method of [<code>OoxmlReader</code>](#OoxmlReader)  \n**Returns**: <code>string</code> - The utf-8 text, or `undefined` when the part is absent.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| parts | <code>Map&lt;string, Buffer&lt;ArrayBufferLike&gt;&gt;</code> | The parts returned by [readParts](#OoxmlReader.readParts). |\n| name | <code>string</code> | Zip path of the part to read. |\n\nsrc: packages/backend/src/services/ooxml-reader.ts:40  \ndist: packages/backend/dist/services/ooxml-reader.js:10\n<a name=\"OoxmlReader.readParts\"></a>\n\n### OoxmlReader.readParts(buffer, limits) ⇒ <code>Map&lt;string, Buffer&lt;ArrayBufferLike&gt;&gt;</code>\nReads every entry of the package into memory.\n\n**Kind**: static method of [<code>OoxmlReader</code>](#OoxmlReader)  \n**Returns**: <code>Map&lt;string, Buffer&lt;ArrayBufferLike&gt;&gt;</code> - The parts, keyed by zip path (e.g. `docProps/core.xml`).  \n**Throws**:\n\n- [<code>OoxmlError</code>](#OoxmlError) On structural problems: invalid zip, entry count, or uncompressed size caps.\n\n\n| Param | Type | Description |\n| --- | --- | --- |\n| buffer | <code>Buffer&lt;ArrayBufferLike&gt;</code> | The full, already upload-capped file. |\n| limits | <code>OoxmlReadLimits</code> | Optional per-call cap overrides. |\n\nsrc: packages/backend/src/services/ooxml-reader.ts:51  \ndist: packages/backend/dist/services/ooxml-reader.js:13\n<a name=\"OOXML_LIMITS\"></a>\n\n## OOXML\\_LIMITS\nHard limits applied to every OOXML package read, enforced before inflating.\n\n**Kind**: global constant  \nsrc: packages/backend/src/services/ooxml-reader.ts:4  \ndist: packages/backend/dist/services/ooxml-reader.js:2\n\n* [OOXML_LIMITS](#OOXML_LIMITS)\n    * [.maxEntries](#OOXML_LIMITS.maxEntries)\n    * [.maxEntryUncompressed](#OOXML_LIMITS.maxEntryUncompressed)\n    * [.maxTotalUncompressed](#OOXML_LIMITS.maxTotalUncompressed)\n\n<a name=\"OOXML_LIMITS.maxEntries\"></a>\n\n### OOXML_LIMITS.maxEntries\nMaximum number of zip entries inspected (central directory scan).\n\n**Kind**: static property of [<code>OOXML\\_LIMITS</code>](#OOXML_LIMITS)  \nsrc: packages/backend/src/services/ooxml-reader.ts:6  \ndist: packages/backend/dist/services/ooxml-reader.js:3\n<a name=\"OOXML_LIMITS.maxEntryUncompressed\"></a>\n\n### OOXML_LIMITS.maxEntryUncompressed\nMaximum uncompressed size of a single entry.\n\n**Kind**: static property of [<code>OOXML\\_LIMITS</code>](#OOXML_LIMITS)  \nsrc: packages/backend/src/services/ooxml-reader.ts:8  \ndist: packages/backend/dist/services/ooxml-reader.js:4\n<a name=\"OOXML_LIMITS.maxTotalUncompressed\"></a>\n\n### OOXML_LIMITS.maxTotalUncompressed\nMaximum uncompressed bytes of the whole package.\n\n**Kind**: static property of [<code>OOXML\\_LIMITS</code>](#OOXML_LIMITS)  \nsrc: packages/backend/src/services/ooxml-reader.ts:10  \ndist: packages/backend/dist/services/ooxml-reader.js:5\n","symbols":8,"lastUsed":1795079893965},"tdata:packages/backend/src/services/ooxml-xml.ts":{"doclets":[{"id":"xml","longname":"xml","name":"xml","kind":"constant","scope":"global","description":"Shared fast-xml-parser configuration for OOXML parts: entities are never\nexpanded, namespace prefixes are stripped (producers vary), attributes are\nkept, tag values are not coerced.","meta":{"lineno":7},"order":0,"mdaics":{"dist":"packages/backend/dist/services/ooxml-xml.js:2","src":"packages/backend/src/services/ooxml-xml.ts:8"},"level":0},{"id":"xmlRaw","longname":"xmlRaw","name":"xmlRaw","kind":"constant","scope":"global","description":"Namespace-preserving variant of {@link xml}, for parts where `id` and `r:id`\nmust not collide (presentation.xml's sldId list). Attribute keys keep their\nfull names (`@_r:id`, `@_id`).","meta":{"lineno":19},"order":1,"mdaics":{"dist":"packages/backend/dist/services/ooxml-xml.js:9","src":"packages/backend/src/services/ooxml-xml.ts:21"},"level":0},{"id":"attr","longname":"attr","name":"attr","kind":"constant","scope":"global","description":"Reads an attribute (namespace prefixes are stripped before parse).","params":[{"description":"The parsed element (or attribute holder).","name":"value","type":{"names":["unknown"]}},{"description":"The attribute name without its `@_` prefix.","name":"name","type":{"names":["string"]}}],"returns":[{"description":"The attribute string, or ''.","type":{"names":["string"]}}],"meta":{"lineno":32},"order":2,"mdaics":{"dist":"packages/backend/dist/services/ooxml-xml.js:16","src":"packages/backend/src/services/ooxml-xml.ts:35"},"level":0},{"id":"walkXml","longname":"walkXml","name":"walkXml","kind":"constant","scope":"global","description":"Depth-first walk of a parsed XML tree; visits every key/value pair.","params":[{"description":"The parsed XML node (or subtree).","name":"node","type":{"names":["unknown"]}},{"description":"Callback per key/value pair; may throw to abort the walk.","name":"visit","type":{"names":["(key: string, value: unknown) => void"]}}],"meta":{"lineno":45},"order":3,"mdaics":{"dist":"packages/backend/dist/services/ooxml-xml.js:24","src":"packages/backend/src/services/ooxml-xml.ts:48"},"level":0},{"id":"collectByKey","longname":"collectByKey","name":"collectByKey","kind":"constant","scope":"global","description":"Every element under a given key, anywhere in the tree.","params":[{"description":"The parsed XML node (or subtree).","name":"node","type":{"names":["unknown"]}},{"description":"The local (namespace-stripped) element name, e.g. `p`, `tbl`, `tr`.","name":"key","type":{"names":["string"]}}],"returns":[{"description":"The matched elements, in document order.","type":{"names":["unknown[]"]}}],"meta":{"lineno":66},"order":4,"mdaics":{"dist":"packages/backend/dist/services/ooxml-xml.js:39","src":"packages/backend/src/services/ooxml-xml.ts:67"},"level":0},{"id":"collectByLocalName","longname":"collectByLocalName","name":"collectByLocalName","kind":"constant","scope":"global","description":"Every element under a given local name, ignoring namespace prefixes (any alias).","params":[{"description":"The parsed XML node (or subtree), with prefixes preserved.","name":"node","type":{"names":["unknown"]}},{"description":"The element's local name without its prefix.","name":"localName","type":{"names":["string"]}}],"returns":[{"description":"The matched elements, in document order.","type":{"names":["unknown[]"]}}],"meta":{"lineno":82},"order":5,"mdaics":{"dist":"packages/backend/dist/services/ooxml-xml.js:49","src":"packages/backend/src/services/ooxml-xml.ts:82"},"level":0},{"id":"textOf","longname":"textOf","name":"textOf","kind":"constant","scope":"global","description":"Concatenated text of every <w:t>/<a:t> under a node (attributes ignored).","params":[{"description":"The parsed XML node (or subtree).","name":"node","type":{"names":["unknown"]}}],"returns":[{"description":"The concatenated string.","type":{"names":["string"]}}],"meta":{"lineno":112},"order":7,"mdaics":{"dist":"packages/backend/dist/services/ooxml-xml.js:69","src":"packages/backend/src/services/ooxml-xml.ts:111"},"level":0},{"id":"collectRelationships","longname":"collectRelationships","name":"collectRelationships","kind":"constant","scope":"global","description":"Maps r:id to its target for a .rels part.","params":[{"description":"The raw rels XML, or undefined.","name":"relsXml","type":{"names":["string"]}}],"returns":[{"description":"The id-to-target map.","type":{"names":["Map<string, RelationshipInfo>"]}}],"meta":{"lineno":128},"order":8,"mdaics":{"dist":"packages/backend/dist/services/ooxml-xml.js:80","src":"packages/backend/src/services/ooxml-xml.ts:134"},"level":0},{"id":"textValue","longname":"textValue","name":"textValue","kind":"function","scope":"global","description":"A <w:t>/<a:t> node may be a plain string or { '#text': string } when attributes are kept.","params":[{"description":"The text node value.","name":"value","type":{"names":["unknown"]}}],"returns":[{"description":"The string, or ''.","type":{"names":["string"]}}],"meta":{"lineno":97},"order":6,"mdaics":{"dist":"packages/backend/dist/services/ooxml-xml.js:59","src":"packages/backend/src/services/ooxml-xml.ts:97"},"level":0}],"fp":"d2977c50e20b50e610503ee4d7e66155647adfdc068c42410a4f816412561a94","issues":[],"kind":"tdata","lastUsed":1795079893975,"symbols":0},"md:packages/backend/src/services/ooxml-xml.ts":{"fp":"8ba5f00d3c532c5fae1954a89f2816781d46a1047f8bb45b6f62b95e54366326","issues":[],"kind":"md","markdown":"## Constants\n\n<dl>\n<dt><a href=\"#xml\">xml</a></dt>\n<dd><p>Shared fast-xml-parser configuration for OOXML parts: entities are never\nexpanded, namespace prefixes are stripped (producers vary), attributes are\nkept, tag values are not coerced.</p>\n</dd>\n<dt><a href=\"#xmlRaw\">xmlRaw</a></dt>\n<dd><p>Namespace-preserving variant of <a href=\"#xml\">xml</a>, for parts where <code>id</code> and <code>r:id</code>\nmust not collide (presentation.xml&#39;s sldId list). Attribute keys keep their\nfull names (<code>@_r:id</code>, <code>@_id</code>).</p>\n</dd>\n<dt><a href=\"#attr\">attr</a> ⇒ <code>string</code></dt>\n<dd><p>Reads an attribute (namespace prefixes are stripped before parse).</p>\n</dd>\n<dt><a href=\"#walkXml\">walkXml</a></dt>\n<dd><p>Depth-first walk of a parsed XML tree; visits every key/value pair.</p>\n</dd>\n<dt><a href=\"#collectByKey\">collectByKey</a> ⇒ <code>unknown[]</code></dt>\n<dd><p>Every element under a given key, anywhere in the tree.</p>\n</dd>\n<dt><a href=\"#collectByLocalName\">collectByLocalName</a> ⇒ <code>unknown[]</code></dt>\n<dd><p>Every element under a given local name, ignoring namespace prefixes (any alias).</p>\n</dd>\n<dt><a href=\"#textOf\">textOf</a> ⇒ <code>string</code></dt>\n<dd><p>Concatenated text of every &lt;w:t&gt;/&lt;a:t&gt; under a node (attributes ignored).</p>\n</dd>\n<dt><a href=\"#collectRelationships\">collectRelationships</a> ⇒ <code>Map&lt;string, RelationshipInfo&gt;</code></dt>\n<dd><p>Maps r:id to its target for a .rels part.</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#textValue\">textValue(value)</a> ⇒ <code>string</code></dt>\n<dd><p>A &lt;w:t&gt;/&lt;a:t&gt; node may be a plain string or { &#39;#text&#39;: string } when attributes are kept.</p>\n</dd>\n</dl>\n\n<a name=\"xml\"></a>\n\n## xml\nShared fast-xml-parser configuration for OOXML parts: entities are never\nexpanded, namespace prefixes are stripped (producers vary), attributes are\nkept, tag values are not coerced.\n\n**Kind**: global constant  \nsrc: packages/backend/src/services/ooxml-xml.ts:8  \ndist: packages/backend/dist/services/ooxml-xml.js:2\n<a name=\"xmlRaw\"></a>\n\n## xmlRaw\nNamespace-preserving variant of [xml](#xml), for parts where `id` and `r:id`\nmust not collide (presentation.xml's sldId list). Attribute keys keep their\nfull names (`@_r:id`, `@_id`).\n\n**Kind**: global constant  \nsrc: packages/backend/src/services/ooxml-xml.ts:21  \ndist: packages/backend/dist/services/ooxml-xml.js:9\n<a name=\"attr\"></a>\n\n## attr ⇒ <code>string</code>\nReads an attribute (namespace prefixes are stripped before parse).\n\n**Kind**: global constant  \n**Returns**: <code>string</code> - The attribute string, or ''.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| value | <code>unknown</code> | The parsed element (or attribute holder). |\n| name | <code>string</code> | The attribute name without its `@_` prefix. |\n\nsrc: packages/backend/src/services/ooxml-xml.ts:35  \ndist: packages/backend/dist/services/ooxml-xml.js:16\n<a name=\"walkXml\"></a>\n\n## walkXml\nDepth-first walk of a parsed XML tree; visits every key/value pair.\n\n**Kind**: global constant  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| node | <code>unknown</code> | The parsed XML node (or subtree). |\n| visit | <code>(key: string, value: unknown) &#x3D;&gt; void</code> | Callback per key/value pair; may throw to abort the walk. |\n\nsrc: packages/backend/src/services/ooxml-xml.ts:48  \ndist: packages/backend/dist/services/ooxml-xml.js:24\n<a name=\"collectByKey\"></a>\n\n## collectByKey ⇒ <code>unknown[]</code>\nEvery element under a given key, anywhere in the tree.\n\n**Kind**: global constant  \n**Returns**: <code>unknown[]</code> - The matched elements, in document order.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| node | <code>unknown</code> | The parsed XML node (or subtree). |\n| key | <code>string</code> | The local (namespace-stripped) element name, e.g. `p`, `tbl`, `tr`. |\n\nsrc: packages/backend/src/services/ooxml-xml.ts:67  \ndist: packages/backend/dist/services/ooxml-xml.js:39\n<a name=\"collectByLocalName\"></a>\n\n## collectByLocalName ⇒ <code>unknown[]</code>\nEvery element under a given local name, ignoring namespace prefixes (any alias).\n\n**Kind**: global constant  \n**Returns**: <code>unknown[]</code> - The matched elements, in document order.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| node | <code>unknown</code> | The parsed XML node (or subtree), with prefixes preserved. |\n| localName | <code>string</code> | The element's local name without its prefix. |\n\nsrc: packages/backend/src/services/ooxml-xml.ts:82  \ndist: packages/backend/dist/services/ooxml-xml.js:49\n<a name=\"textOf\"></a>\n\n## textOf ⇒ <code>string</code>\nConcatenated text of every <w:t>/<a:t> under a node (attributes ignored).\n\n**Kind**: global constant  \n**Returns**: <code>string</code> - The concatenated string.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| node | <code>unknown</code> | The parsed XML node (or subtree). |\n\nsrc: packages/backend/src/services/ooxml-xml.ts:111  \ndist: packages/backend/dist/services/ooxml-xml.js:69\n<a name=\"collectRelationships\"></a>\n\n## collectRelationships ⇒ <code>Map&lt;string, RelationshipInfo&gt;</code>\nMaps r:id to its target for a .rels part.\n\n**Kind**: global constant  \n**Returns**: <code>Map&lt;string, RelationshipInfo&gt;</code> - The id-to-target map.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| relsXml | <code>string</code> | The raw rels XML, or undefined. |\n\nsrc: packages/backend/src/services/ooxml-xml.ts:134  \ndist: packages/backend/dist/services/ooxml-xml.js:80\n<a name=\"textValue\"></a>\n\n## textValue(value) ⇒ <code>string</code>\nA <w:t>/<a:t> node may be a plain string or { '#text': string } when attributes are kept.\n\n**Kind**: global function  \n**Returns**: <code>string</code> - The string, or ''.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| value | <code>unknown</code> | The text node value. |\n\nsrc: packages/backend/src/services/ooxml-xml.ts:97  \ndist: packages/backend/dist/services/ooxml-xml.js:59\n","symbols":9,"lastUsed":1795079894035},"tdata:packages/backend/src/services/worker.service.spec.ts":{"doclets":[{"id":"NULL_TAG","longname":"NULL_TAG","name":"NULL_TAG","kind":"constant","scope":"global","description":"Tag the service mixes into the key when workerData carries no operation/inputFormat.","params":[],"meta":{"lineno":15},"order":0,"mdaics":{"src":"packages/backend/src/services/worker.service.spec.ts:17"},"level":0},{"id":"drainToString","longname":"drainToString","name":"drainToString","kind":"function","scope":"global","description":"Reads a stream to EOF and returns its decoded contents.","params":[{"description":"The stream to consume.","name":"stream","type":{"names":["Readable"]}}],"returns":[{"description":"The decoded stream contents.","type":{"names":["Promise<string>"]}}],"meta":{"lineno":22},"async":true,"order":1,"mdaics":{"src":"packages/backend/src/services/worker.service.spec.ts:27"},"level":0},{"id":"<anonymous>~service","longname":"<anonymous>~service","name":"service","kind":"constant","scope":"inner","description":"Reads a stream to EOF and returns its decoded contents.","memberof":"<anonymous>","params":[{"description":"Stream to consume.","name":"stream"}],"returns":[{"description":"The decoded stream contents."}],"meta":{"lineno":103},"order":2,"mdaics":{"src":"packages/backend/src/services/worker.service.spec.ts:116"}},{"id":"<anonymous>~broken","longname":"<anonymous>~broken","name":"broken","kind":"function","scope":"inner","description":"Yields one chunk then fails mid-stream.","meta":{"lineno":326},"yields":[{"description":"The first chunk, then throws."}],"memberof":"<anonymous>","params":[],"async":true,"generator":true,"order":3,"mdaics":{"src":"packages/backend/src/services/worker.service.spec.ts:365"},"returns":[{"type":{"names":["AsyncGenerator<Buffer<ArrayBuffer>, void, unknown>"]}}]}],"fp":"182477a59f160d0bd8902c9848fc61595f2a7ba36a3a227daa8fcecc3032fa10","issues":[],"kind":"tdata","lastUsed":1795079894035,"symbols":0},"md:packages/backend/src/services/worker.service.spec.ts":{"fp":"df51b61ca46bf2703b274554dd33ac0ec73e873c7365cf70b16f0388e91e7777","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","markdown":"## Constants\n\n<dl>\n<dt><a href=\"#NULL_TAG\">NULL_TAG</a></dt>\n<dd><p>Tag the service mixes into the key when workerData carries no operation/inputFormat.</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#drainToString\">drainToString(stream)</a> ⇒ <code>Promise&lt;string&gt;</code></dt>\n<dd><p>Reads a stream to EOF and returns its decoded contents.</p>\n</dd>\n</dl>\n\n<a name=\"NULL_TAG\"></a>\n\n## NULL\\_TAG\nTag the service mixes into the key when workerData carries no operation/inputFormat.\n\n**Kind**: global constant  \nsrc: packages/backend/src/services/worker.service.spec.ts:17  \n<a name=\"drainToString\"></a>\n\n## drainToString(stream) ⇒ <code>Promise&lt;string&gt;</code>\nReads a stream to EOF and returns its decoded contents.\n\n**Kind**: global function  \n**Returns**: <code>Promise&lt;string&gt;</code> - The decoded stream contents.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| stream | <code>Readable</code> | The stream to consume. |\n\nsrc: packages/backend/src/services/worker.service.spec.ts:27  \n","symbols":4,"lastUsed":1795079894062},"tdata:packages/backend/src/undici.ts":{"doclets":[],"fp":"0c899cc2024b82b0e5af5fda1e9bf6fb84b20d9b1810b4a361482fd28ce3d628","issues":[],"kind":"tdata","lastUsed":1795079894093,"symbols":0},"md:packages/backend/src/undici.ts":{"fp":"0559eef733b4e02c03eac15829fa667f974c81257cf0b11bf0840448bc83e095","issues":[],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795079894127},"tdata:packages/backend/src/services/worker.service.ts":{"doclets":[{"id":"WorkerService","longname":"WorkerService","name":"WorkerService","kind":"member","scope":"global","description":"Spawns sibling worker threads for CPU-heavy media/document work and serves their output (with a shared stream cache).","params":[],"meta":{"lineno":86},"order":2,"mdaics":{"dist":"packages/backend/dist/services/worker.service.js:86 (approx.)","src":"packages/backend/src/services/worker.service.ts:68"},"level":0},{"id":"WORKER_ENV_KEYS","longname":"WORKER_ENV_KEYS","name":"WORKER_ENV_KEYS","kind":"constant","scope":"global","description":"Environment for spawned worker threads: only what first-party workers need\n(paths, locales, log level, node/tmp dirs). Secrets such as METRICS_TOKEN,\nAUTH_* or ClamAV credentials never cross into a worker.","params":[],"meta":{"lineno":52},"order":0,"mdaics":{"dist":"packages/backend/dist/services/worker.service.js:23","src":"packages/backend/src/services/worker.service.ts:26"},"level":0},{"id":"workerEnv","longname":"workerEnv","name":"workerEnv","kind":"function","scope":"global","description":"Builds the worker environment from WORKER_ENV_KEYS.","params":[],"returns":[{"description":"A fresh env record; FILE_FLY_WORKER is always set to '1'.","type":{"names":["Record<string, string>"]}}],"meta":{"lineno":73},"order":1,"mdaics":{"dist":"packages/backend/dist/services/worker.service.js:40","src":"packages/backend/src/services/worker.service.ts:48"},"level":0},{"id":"workerPath","longname":"workerPath","name":"workerPath","kind":"function","scope":"global","description":"Resolves a worker filename relative to the calling module's location.\n\nServices pass `'./name.worker.js'` to mean \"same folder\"; `new Worker(path)`\nwould otherwise resolve it against the process cwd and fail in production.","params":[{"description":"Worker filename as declared by the caller (e.g. `'./worker/index.js'`).","name":"filename","type":{"names":["string"]}},{"description":"`import.meta.url` of the module that declared the filename.","name":"metaUrl","type":{"names":["string"]}}],"returns":[{"description":"Absolute path to the worker file.","type":{"names":["string"]}}],"meta":{"lineno":324},"order":12,"mdaics":{"dist":"packages/backend/dist/services/worker.service.js:324 (approx.)","src":"packages/backend/src/services/worker.service.ts:316"},"level":0},{"id":"<anonymous>~WorkerService#inflight","longname":"<anonymous>~WorkerService#inflight","name":"inflight","kind":"member","scope":"instance","description":"cache key -> promise resolved (never rejected) when the producer settles.","memberof":"<anonymous>~WorkerService","meta":{"lineno":107},"order":3,"mdaics":{"dist":"packages/backend/dist/services/worker.service.js:57","src":"packages/backend/src/services/worker.service.ts:76"}},{"id":"<anonymous>~WorkerService#maxWorkers","longname":"<anonymous>~WorkerService#maxWorkers","name":"maxWorkers","kind":"member","scope":"instance","description":"Upper bound on concurrent worker threads; excess createWorker calls queue instead of forking unboundedly.","memberof":"<anonymous>~WorkerService","meta":{"lineno":110},"order":4,"mdaics":{"dist":"packages/backend/dist/services/worker.service.js:59","src":"packages/backend/src/services/worker.service.ts:81"}},{"id":"WorkerService#createWorker","longname":"WorkerService#createWorker","name":"createWorker","kind":"function","scope":"instance","description":"Returns the processed output. Served from CACHE_DIR when possible,\notherwise produced by a worker thread (and cached while streaming).","memberof":"WorkerService","params":[{"description":"Worker entry file to run in a worker thread.","name":"filename","type":{"names":["string"]}},{"description":"Worker and cache options.","name":"options","type":{"names":["CreateWorkerOptions"]}}],"returns":[{"description":"Processed output stream.","type":{"names":["Promise<Readable>"]}}],"meta":{"lineno":123},"async":true,"order":5,"mdaics":{"dist":"packages/backend/dist/services/worker.service.js:123 (approx.)","src":"packages/backend/src/services/worker.service.ts:94"},"level":0},{"id":"WorkerService#acquireWorkerSlot","longname":"WorkerService#acquireWorkerSlot","name":"acquireWorkerSlot","kind":"function","scope":"instance","description":"Waits until a worker slot is free, then takes it.","memberof":"WorkerService","params":[],"meta":{"lineno":151},"async":true,"order":6,"mdaics":{"dist":"packages/backend/dist/services/worker.service.js:151 (approx.)","src":"packages/backend/src/services/worker.service.ts:127"},"returns":[{"type":{"names":["Promise<void>"]}}],"level":0},{"id":"WorkerService#keyFor","longname":"WorkerService#keyFor","name":"keyFor","kind":"function","scope":"instance","description":"Builds the cache key: parts joined with NUL so no component can smuggle separators.","memberof":"WorkerService","params":[{"description":"Deterministic base key from the request (file signature + query + hash).","name":"baseKey","type":{"names":["string"]}},{"description":"Worker entry filename mixed into the key.","name":"filename","type":{"names":["string"]}},{"description":"Worker payload mixed into the key.","name":"workerData","type":{"names":["unknown"]}}],"returns":[{"description":"The composite cache key.","type":{"names":["string"]}}],"meta":{"lineno":165},"order":7,"mdaics":{"dist":"packages/backend/dist/services/worker.service.js:165 (approx.)","src":"packages/backend/src/services/worker.service.ts:142"},"level":0},{"id":"WorkerService#persist","longname":"WorkerService#persist","name":"persist","kind":"function","scope":"instance","description":"Persists the finished branch via StreamCache (atomic tmp+rename, 0o600).\nEmpties are not servable: read path treats size===0 as a miss, so a 0-byte\nentry is simply ignored until the janitor reaps it.\nFailures never affect the client: the entry is unlinked once the worker has settled.","memberof":"WorkerService","params":[{"description":"Cache key.","name":"key","type":{"names":["string"]}},{"description":"Source stream to persist.","name":"branch","type":{"names":["Readable"]}},{"description":"Worker exit status.","name":"succeeded","type":{"names":["Promise<boolean>"]}}],"meta":{"lineno":185},"order":8,"mdaics":{"dist":"packages/backend/dist/services/worker.service.js:185 (approx.)","src":"packages/backend/src/services/worker.service.ts:163"},"level":0},{"id":"WorkerService#releaseWorkerSlot","longname":"WorkerService#releaseWorkerSlot","name":"releaseWorkerSlot","kind":"function","scope":"instance","description":"Releases a worker slot, waking one queued caller if any.","memberof":"WorkerService","params":[],"meta":{"lineno":217},"order":9,"mdaics":{"dist":"packages/backend/dist/services/worker.service.js:217 (approx.)","src":"packages/backend/src/services/worker.service.ts:202"},"level":0},{"id":"WorkerService#touch","longname":"WorkerService#touch","name":"touch","kind":"function","scope":"instance","description":"Refreshes the entry's mtime so the janitor's LRU eviction keeps hot entries.","memberof":"WorkerService","params":[{"description":"Cache key of the entry.","name":"key","type":{"names":["string"]}}],"meta":{"lineno":307},"async":true,"order":11,"mdaics":{"dist":"packages/backend/dist/services/worker.service.js:307 (approx.)","src":"packages/backend/src/services/worker.service.ts:301"},"returns":[{"type":{"names":["Promise<void>"]}}],"level":0},{"id":"<anonymous>~succeeded","longname":"<anonymous>~succeeded","name":"succeeded","kind":"constant","scope":"inner","description":"Resolves true only for a clean exit (code 0, nothing on stderr as error).","memberof":"<anonymous>","params":[],"meta":{"lineno":257},"order":10,"mdaics":{"dist":"packages/backend/dist/services/worker.service.js:160","src":"packages/backend/src/services/worker.service.ts:247"}}],"fp":"0c49be4a59fd62cdda13e149cd4ecea538155a8cbd196bba0d05ced41dbc8691","issues":[],"kind":"tdata","symbols":0,"lastUsed":1795079894384},"md:packages/backend/src/services/worker.service.ts":{"fp":"ea0d097324d0f81fc3ec3c506075ba3d57e96cb7e974b45ee8de386597175fd5","issues":["dist sourcemap missing or unmatched — dist line is an approximation"],"kind":"md","markdown":"## Members\n\n<dl>\n<dt><a href=\"#WorkerService\">WorkerService</a></dt>\n<dd><p>Spawns sibling worker threads for CPU-heavy media/document work and serves their output (with a shared stream cache).</p>\n</dd>\n</dl>\n\n## Constants\n\n<dl>\n<dt><a href=\"#WORKER_ENV_KEYS\">WORKER_ENV_KEYS</a></dt>\n<dd><p>Environment for spawned worker threads: only what first-party workers need\n(paths, locales, log level, node/tmp dirs). Secrets such as METRICS_TOKEN,\nAUTH_* or ClamAV credentials never cross into a worker.</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#workerEnv\">workerEnv()</a> ⇒ <code>Record&lt;string, string&gt;</code></dt>\n<dd><p>Builds the worker environment from WORKER_ENV_KEYS.</p>\n</dd>\n<dt><a href=\"#workerPath\">workerPath(filename, metaUrl)</a> ⇒ <code>string</code></dt>\n<dd><p>Resolves a worker filename relative to the calling module&#39;s location.</p>\n<p>Services pass <code>&#39;./name.worker.js&#39;</code> to mean &quot;same folder&quot;; <code>new Worker(path)</code>\nwould otherwise resolve it against the process cwd and fail in production.</p>\n</dd>\n</dl>\n\n<a name=\"WorkerService\"></a>\n\n## WorkerService\nSpawns sibling worker threads for CPU-heavy media/document work and serves their output (with a shared stream cache).\n\n**Kind**: global variable  \nsrc: packages/backend/src/services/worker.service.ts:68  \ndist: packages/backend/dist/services/worker.service.js:86 (approx.)\n\n* [WorkerService](#WorkerService)\n    * [.createWorker(filename, options)](#WorkerService+createWorker) ⇒ <code>Promise&lt;Readable&gt;</code>\n    * [.acquireWorkerSlot()](#WorkerService+acquireWorkerSlot) ⇒ <code>Promise&lt;void&gt;</code>\n    * [.keyFor(baseKey, filename, workerData)](#WorkerService+keyFor) ⇒ <code>string</code>\n    * [.persist(key, branch, succeeded)](#WorkerService+persist)\n    * [.releaseWorkerSlot()](#WorkerService+releaseWorkerSlot)\n    * [.touch(key)](#WorkerService+touch) ⇒ <code>Promise&lt;void&gt;</code>\n\n<a name=\"WorkerService+createWorker\"></a>\n\n### workerService.createWorker(filename, options) ⇒ <code>Promise&lt;Readable&gt;</code>\nReturns the processed output. Served from CACHE_DIR when possible,\notherwise produced by a worker thread (and cached while streaming).\n\n**Kind**: instance method of [<code>WorkerService</code>](#WorkerService)  \n**Returns**: <code>Promise&lt;Readable&gt;</code> - Processed output stream.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| filename | <code>string</code> | Worker entry file to run in a worker thread. |\n| options | <code>CreateWorkerOptions</code> | Worker and cache options. |\n\nsrc: packages/backend/src/services/worker.service.ts:94  \ndist: packages/backend/dist/services/worker.service.js:123 (approx.)\n<a name=\"WorkerService+acquireWorkerSlot\"></a>\n\n### workerService.acquireWorkerSlot() ⇒ <code>Promise&lt;void&gt;</code>\nWaits until a worker slot is free, then takes it.\n\n**Kind**: instance method of [<code>WorkerService</code>](#WorkerService)  \nsrc: packages/backend/src/services/worker.service.ts:127  \ndist: packages/backend/dist/services/worker.service.js:151 (approx.)\n<a name=\"WorkerService+keyFor\"></a>\n\n### workerService.keyFor(baseKey, filename, workerData) ⇒ <code>string</code>\nBuilds the cache key: parts joined with NUL so no component can smuggle separators.\n\n**Kind**: instance method of [<code>WorkerService</code>](#WorkerService)  \n**Returns**: <code>string</code> - The composite cache key.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| baseKey | <code>string</code> | Deterministic base key from the request (file signature + query + hash). |\n| filename | <code>string</code> | Worker entry filename mixed into the key. |\n| workerData | <code>unknown</code> | Worker payload mixed into the key. |\n\nsrc: packages/backend/src/services/worker.service.ts:142  \ndist: packages/backend/dist/services/worker.service.js:165 (approx.)\n<a name=\"WorkerService+persist\"></a>\n\n### workerService.persist(key, branch, succeeded)\nPersists the finished branch via StreamCache (atomic tmp+rename, 0o600).\nEmpties are not servable: read path treats size===0 as a miss, so a 0-byte\nentry is simply ignored until the janitor reaps it.\nFailures never affect the client: the entry is unlinked once the worker has settled.\n\n**Kind**: instance method of [<code>WorkerService</code>](#WorkerService)  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| key | <code>string</code> | Cache key. |\n| branch | <code>Readable</code> | Source stream to persist. |\n| succeeded | <code>Promise&lt;boolean&gt;</code> | Worker exit status. |\n\nsrc: packages/backend/src/services/worker.service.ts:163  \ndist: packages/backend/dist/services/worker.service.js:185 (approx.)\n<a name=\"WorkerService+releaseWorkerSlot\"></a>\n\n### workerService.releaseWorkerSlot()\nReleases a worker slot, waking one queued caller if any.\n\n**Kind**: instance method of [<code>WorkerService</code>](#WorkerService)  \nsrc: packages/backend/src/services/worker.service.ts:202  \ndist: packages/backend/dist/services/worker.service.js:217 (approx.)\n<a name=\"WorkerService+touch\"></a>\n\n### workerService.touch(key) ⇒ <code>Promise&lt;void&gt;</code>\nRefreshes the entry's mtime so the janitor's LRU eviction keeps hot entries.\n\n**Kind**: instance method of [<code>WorkerService</code>](#WorkerService)  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| key | <code>string</code> | Cache key of the entry. |\n\nsrc: packages/backend/src/services/worker.service.ts:301  \ndist: packages/backend/dist/services/worker.service.js:307 (approx.)\n<a name=\"WORKER_ENV_KEYS\"></a>\n\n## WORKER\\_ENV\\_KEYS\nEnvironment for spawned worker threads: only what first-party workers need\n(paths, locales, log level, node/tmp dirs). Secrets such as METRICS_TOKEN,\nAUTH_* or ClamAV credentials never cross into a worker.\n\n**Kind**: global constant  \nsrc: packages/backend/src/services/worker.service.ts:26  \ndist: packages/backend/dist/services/worker.service.js:23\n<a name=\"workerEnv\"></a>\n\n## workerEnv() ⇒ <code>Record&lt;string, string&gt;</code>\nBuilds the worker environment from WORKER_ENV_KEYS.\n\n**Kind**: global function  \n**Returns**: <code>Record&lt;string, string&gt;</code> - A fresh env record; FILE_FLY_WORKER is always set to '1'.  \nsrc: packages/backend/src/services/worker.service.ts:48  \ndist: packages/backend/dist/services/worker.service.js:40\n<a name=\"workerPath\"></a>\n\n## workerPath(filename, metaUrl) ⇒ <code>string</code>\nResolves a worker filename relative to the calling module's location.\n\nServices pass `'./name.worker.js'` to mean \"same folder\"; `new Worker(path)`\nwould otherwise resolve it against the process cwd and fail in production.\n\n**Kind**: global function  \n**Returns**: <code>string</code> - Absolute path to the worker file.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| filename | <code>string</code> | Worker filename as declared by the caller (e.g. `'./worker/index.js'`). |\n| metaUrl | <code>string</code> | `import.meta.url` of the module that declared the filename. |\n\nsrc: packages/backend/src/services/worker.service.ts:316  \ndist: packages/backend/dist/services/worker.service.js:324 (approx.)\n","symbols":13,"lastUsed":1795079894493},"tdata:packages/backend/src/utils/buffer.spec.ts":{"doclets":[{"id":"BUFFER_API_SURFACE","longname":"BUFFER_API_SURFACE","name":"BUFFER_API_SURFACE","kind":"constant","scope":"global","description":"Named symbol for the mdaics docs site (see https://github.com/rayenboussayed/mdaics); no runtime use.","meta":{"lineno":28},"order":1,"mdaics":{"src":"packages/backend/src/utils/buffer.spec.ts:35"},"level":0},{"id":"<anonymous>~chunks","longname":"<anonymous>~chunks","name":"chunks","kind":"function","scope":"inner","description":"Yields 21 one-MiB chunks to exceed the 20 MiB cap.","meta":{"lineno":19},"yields":[{"description":"A 1 MiB zero-filled chunk."}],"memberof":"<anonymous>","params":[],"generator":true,"order":0,"mdaics":{"src":"packages/backend/src/utils/buffer.spec.ts:25"},"returns":[{"type":{"names":["Generator<Buffer<ArrayBufferLike>, any, any>"]}}]}],"fp":"4f52241ff2c3606d98cc06e5291265e4f5e010f4f330e9df5ae8f0c3ad6bc79a","issues":[],"kind":"tdata","lastUsed":1795079894131,"symbols":0},"md:packages/backend/src/utils/buffer.spec.ts":{"fp":"1cb3b986fb60f3c2811849fe7b2bdaf5c22081682de581cbde10e9b6d74dda8b","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","markdown":"<a name=\"BUFFER_API_SURFACE\"></a>\n\n## BUFFER\\_API\\_SURFACE\nNamed symbol for the mdaics docs site (see https://github.com/rayenboussayed/mdaics); no runtime use.\n\n**Kind**: global constant  \nsrc: packages/backend/src/utils/buffer.spec.ts:35  \n","symbols":2,"lastUsed":1795079894154},"tdata:packages/backend/src/utils/buffer.ts":{"doclets":[{"id":"MAX_BUFFER_BYTES","longname":"MAX_BUFFER_BYTES","name":"MAX_BUFFER_BYTES","kind":"constant","scope":"global","description":"Maximum number of bytes buffered from a stream (20 MiB).","params":[],"meta":{"lineno":5},"order":0,"mdaics":{"dist":"packages/backend/dist/utils/buffer.js:4","src":"packages/backend/src/utils/buffer.ts:8"},"level":0},{"id":"bufferStream","longname":"bufferStream","name":"bufferStream","kind":"function","scope":"global","description":"Buffers a readable stream into a single Buffer, enforcing a size cap.","params":[{"description":"The readable stream to buffer.","name":"stream","type":{"names":["Readable"]}},{"description":"The maximum number of bytes to accept before throwing.","name":"maxBytes","type":{"names":["number"]}}],"returns":[{"description":"The concatenated buffer contents.","type":{"names":["Promise<Buffer<ArrayBufferLike>>"]}}],"meta":{"lineno":12},"order":1,"mdaics":{"dist":"packages/backend/dist/utils/buffer.js:5","src":"packages/backend/src/utils/buffer.ts:16"},"level":0}],"fp":"faeec6c066c922248bab25ff295729a380972ede19b5725e846b07c4ab72e517","issues":[],"kind":"tdata","lastUsed":1795079894154,"symbols":0},"md:packages/backend/src/utils/buffer.ts":{"fp":"e4b50a002c638325430d200e6a6bb0697fd6c5d7c31fee8144ea8a7f902189ed","issues":[],"kind":"md","markdown":"## Constants\n\n<dl>\n<dt><a href=\"#MAX_BUFFER_BYTES\">MAX_BUFFER_BYTES</a></dt>\n<dd><p>Maximum number of bytes buffered from a stream (20 MiB).</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#bufferStream\">bufferStream(stream, maxBytes)</a> ⇒ <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code></dt>\n<dd><p>Buffers a readable stream into a single Buffer, enforcing a size cap.</p>\n</dd>\n</dl>\n\n<a name=\"MAX_BUFFER_BYTES\"></a>\n\n## MAX\\_BUFFER\\_BYTES\nMaximum number of bytes buffered from a stream (20 MiB).\n\n**Kind**: global constant  \nsrc: packages/backend/src/utils/buffer.ts:8  \ndist: packages/backend/dist/utils/buffer.js:4\n<a name=\"bufferStream\"></a>\n\n## bufferStream(stream, maxBytes) ⇒ <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code>\nBuffers a readable stream into a single Buffer, enforcing a size cap.\n\n**Kind**: global function  \n**Returns**: <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code> - The concatenated buffer contents.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| stream | <code>Readable</code> | The readable stream to buffer. |\n| maxBytes | <code>number</code> | The maximum number of bytes to accept before throwing. |\n\nsrc: packages/backend/src/utils/buffer.ts:16  \ndist: packages/backend/dist/utils/buffer.js:5\n","symbols":2,"lastUsed":1795079894184},"tdata:packages/backend/src/utils/capabilities.spec.ts":{"doclets":[],"fp":"55367577bf8d7453499cbeaba1978057f231b58a27326fae3129bfb54f1acbdc","issues":[],"kind":"tdata","lastUsed":1795079894208,"symbols":0},"md:packages/backend/src/utils/capabilities.spec.ts":{"fp":"1e288f3cbfa425fda7cc6b7ff84689375e4d8011d48f03c286454f2967d84066","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795079894208},"tdata:packages/backend/src/utils/capabilities.ts":{"doclets":[{"id":"OUTPUT_CONTENT_TYPE","longname":"OUTPUT_CONTENT_TYPE","name":"OUTPUT_CONTENT_TYPE","kind":"constant","scope":"global","description":"Content-Type for each streamable output format.","meta":{"lineno":12},"order":0,"mdaics":{"dist":"packages/backend/dist/utils/capabilities.js:12 (approx.)","src":"packages/backend/src/utils/capabilities.ts:16"},"level":0},{"id":"MP4_FRAGMENTED_OPTIONS","longname":"MP4_FRAGMENTED_OPTIONS","name":"MP4_FRAGMENTED_OPTIONS","kind":"constant","scope":"global","description":"Fragmented-MP4 muxer flags for progressive download without re-muxing.","meta":{"lineno":23},"order":1,"mdaics":{"dist":"packages/backend/dist/utils/capabilities.js:20","src":"packages/backend/src/utils/capabilities.ts:28"},"level":0},{"id":"isAllowedOutputFormat","longname":"isAllowedOutputFormat","name":"isAllowedOutputFormat","kind":"function","scope":"global","params":[{"description":"Candidate container/codec format name.","name":"format","type":{"names":["string"]}}