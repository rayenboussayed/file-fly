}[]; textures: { bytes: number; mimeType: string; name: string; }[]; }&gt;</code>\n    * [.metadata(_query)](#ModelController+metadata) ⇒ <code>Promise&lt;{ asset: { generator: string; version: string; }; bounds: { max: [number, number, number]; min: [number, number, number]; }; counts: { accessors: number; animations: number; cameras: number; materials: number; meshes: number; nodes: number; primitives: number; scenes: number; skins: number; textures: number; triangles: number; vertices: number; }; extensionsRequired: string[]; extensionsUsed: string[]; format: string; }&gt;</code>\n    * [.optimize(response, query)](#ModelController+optimize) ⇒ <code>Promise&lt;void&gt;</code>\n\n<a name=\"ModelController+convert\"></a>\n\n### modelController.convert(response, query) ⇒ <code>Promise&lt;void&gt;</code>\nConverts the uploaded GLB between container formats (201).\n\n**Kind**: instance method of [<code>ModelController</code>](#ModelController)  \n**Returns**: <code>Promise&lt;void&gt;</code> - The converted bytes (201).  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| response | <code>FastifyReply&lt;import(&quot;fastify&quot;).RouteGenericInterface, import(&quot;fastify&quot;).RawServerDefault, import(&quot;http&quot;).IncomingMessage, import(&quot;http&quot;).ServerResponse&lt;import(&quot;http&quot;).IncomingMessage&gt;, unknown, import(&quot;fastify&quot;).FastifySchema, import(&quot;fastify&quot;).FastifyTypeProviderDefault, unknown&gt;</code> | Raw reply, streamed as model/gltf-binary or model/gltf+json. |\n| query | <code>{ to: &quot;glb&quot; \\| &quot;gltf&quot;; }</code> | Target container (`glb` or self-contained `gltf`). |\n\nsrc: packages/backend/src/resources/model/model.controller.ts:48  \ndist: packages/backend/dist/resources/model/model.controller.js:28\n<a name=\"ModelController+extract\"></a>\n\n### modelController.extract(_query) ⇒ <code>Promise&lt;{ animations: { channels: number; name: string; samplers: number; }[]; format: string; materials: { alphaMode: import(&quot;@gltf-transform/core&quot;).GLTF.MaterialAlphaMode; baseColorFactor: import(&quot;@gltf-transform/core&quot;).vec4; doubleSided: boolean; emissiveFactor: import(&quot;@gltf-transform/core&quot;).vec3; metallicFactor: number; name: string; roughnessFactor: number; }[]; meshes: { name: string; primitives: { triangles: number; vertices: number; attributes: string[]; material: string; mode: import(&quot;@gltf-transform/core&quot;).GLTF.MeshPrimitiveMode; targets: number; }[]; }[]; scenes: { name: string; nodes: Record&lt;string, unknown&gt;[]; }[]; skins: { joints: number; name: string; }[]; textures: { bytes: number; mimeType: string; name: string; }[]; }&gt;</code>\nExtracts the scene graph, meshes, materials, textures, animations and skins (201).\n\n**Kind**: instance method of [<code>ModelController</code>](#ModelController)  \n**Returns**: <code>Promise&lt;{ animations: { channels: number; name: string; samplers: number; }[]; format: string; materials: { alphaMode: import(&quot;@gltf-transform/core&quot;).GLTF.MaterialAlphaMode; baseColorFactor: import(&quot;@gltf-transform/core&quot;).vec4; doubleSided: boolean; emissiveFactor: import(&quot;@gltf-transform/core&quot;).vec3; metallicFactor: number; name: string; roughnessFactor: number; }[]; meshes: { name: string; primitives: { triangles: number; vertices: number; attributes: string[]; material: string; mode: import(&quot;@gltf-transform/core&quot;).GLTF.MeshPrimitiveMode; targets: number; }[]; }[]; scenes: { name: string; nodes: Record&lt;string, unknown&gt;[]; }[]; skins: { joints: number; name: string; }[]; textures: { bytes: number; mimeType: string; name: string; }[]; }&gt;</code> - The extraction document.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| _query | <code>unknown</code> | Empty query object; junk parameters are rejected with 400. |\n\nsrc: packages/backend/src/resources/model/model.controller.ts:72  \ndist: packages/backend/dist/resources/model/model.controller.js:40\n<a name=\"ModelController+metadata\"></a>\n\n### modelController.metadata(_query) ⇒ <code>Promise&lt;{ asset: { generator: string; version: string; }; bounds: { max: [number, number, number]; min: [number, number, number]; }; counts: { accessors: number; animations: number; cameras: number; materials: number; meshes: number; nodes: number; primitives: number; scenes: number; skins: number; textures: number; triangles: number; vertices: number; }; extensionsRequired: string[]; extensionsUsed: string[]; format: string; }&gt;</code>\nNormalized GLB metadata (201).\n\n**Kind**: instance method of [<code>ModelController</code>](#ModelController)  \n**Returns**: <code>Promise&lt;{ asset: { generator: string; version: string; }; bounds: { max: [number, number, number]; min: [number, number, number]; }; counts: { accessors: number; animations: number; cameras: number; materials: number; meshes: number; nodes: number; primitives: number; scenes: number; skins: number; textures: number; triangles: number; vertices: number; }; extensionsRequired: string[]; extensionsUsed: string[]; format: string; }&gt;</code> - The metadata document.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| _query | <code>unknown</code> | Empty query object; junk parameters are rejected with 400. |\n\nsrc: packages/backend/src/resources/model/model.controller.ts:85  \ndist: packages/backend/dist/resources/model/model.controller.js:43\n<a name=\"ModelController+optimize\"></a>\n\n### modelController.optimize(response, query) ⇒ <code>Promise&lt;void&gt;</code>\nOptimizes the uploaded model (dedup, prune, weld, optional simplify, optional meshopt/draco) (201).\n\n**Kind**: instance method of [<code>ModelController</code>](#ModelController)  \n**Returns**: <code>Promise&lt;void&gt;</code> - The optimized GLB bytes (201).  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| response | <code>FastifyReply&lt;import(&quot;fastify&quot;).RouteGenericInterface, import(&quot;fastify&quot;).RawServerDefault, import(&quot;http&quot;).IncomingMessage, import(&quot;http&quot;).ServerResponse&lt;import(&quot;http&quot;).IncomingMessage&gt;, unknown, import(&quot;fastify&quot;).FastifySchema, import(&quot;fastify&quot;).FastifyTypeProviderDefault, unknown&gt;</code> | Raw reply, streamed as model/gltf-binary. |\n| query | <code>{ compress: &quot;none&quot; \\| &quot;draco&quot; \\| &quot;meshopt&quot;; weld: boolean; simplify?: number; }</code> | Compression codec and simplification options. |\n\nsrc: packages/backend/src/resources/model/model.controller.ts:97  \ndist: packages/backend/dist/resources/model/model.controller.js:46\n","symbols":5,"lastUsed":1795730468104},"tdata:packages/backend/src/resources/model/model.module.ts":{"doclets":[{"id":"ModelModule","longname":"ModelModule","name":"ModelModule","kind":"member","scope":"global","description":"Model feature module: metadata, extract, optimize and convert routes.","params":[],"meta":{"lineno":42},"order":0,"mdaics":{"dist":"packages/backend/dist/resources/model/model.module.js:11","src":"packages/backend/src/resources/model/model.module.ts:15"},"level":0}],"fp":"9a537a748d0c95e5411e554785bcbb537f7bc75f1543bca095cee7d58d38d361","issues":[],"kind":"tdata","lastUsed":1795730468075,"symbols":0},"md:packages/backend/src/resources/model/model.module.ts":{"fp":"846738ba6a13567acb6296e9188da58af85c8671c08031693647da9adb09f84a","issues":[],"kind":"md","markdown":"<a name=\"ModelModule\"></a>\n\n## ModelModule\nModel feature module: metadata, extract, optimize and convert routes.\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/model/model.module.ts:15  \ndist: packages/backend/dist/resources/model/model.module.js:11\n","symbols":1,"lastUsed":1795730468176},"tdata:packages/backend/src/resources/model/model.service.spec.ts":{"doclets":[],"fp":"abc0f9ad4fb897a94b620a82122ce1a2d58e7def1b11ba02277ce1cc1d44d1c0","issues":[],"kind":"tdata","lastUsed":1795730468176,"symbols":0},"md: