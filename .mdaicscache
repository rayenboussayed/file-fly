tring[]; format: string; }>"]}}],"meta":{"lineno":308},"async":true,"order":9,"mdaics":{"dist":"packages/backend/dist/resources/model/model.service.js:308 (approx.)","src":"packages/backend/src/resources/model/model.service.ts:283"},"level":0},{"id":"ModelService#optimize","longname":"ModelService#optimize","name":"optimize","kind":"function","scope":"instance","description":"Optimizes the uploaded model in a worker thread and returns GLB bytes.","memberof":"ModelService","params":[{"description":"Compression codec, simplification ratio and weld.","name":"query","type":{"names":["{ compress: \"none\" | \"draco\" | \"meshopt\"; weld: boolean; simplify?: number; }"]}}],"returns":[{"description":"The optimized GLB bytes.","type":{"names":["Promise<Buffer<ArrayBufferLike>>"]}}],"meta":{"lineno":319},"async":true,"order":10,"mdaics":{"dist":"packages/backend/dist/resources/model/model.service.js:319 (approx.)","src":"packages/backend/src/resources/model/model.service.ts:295"},"level":0}],"fp":"7670c2895fee985c76c95a6a8ac3342de912bd7fff8843fd936f13e4f8c58212","issues":[],"kind":"tdata","symbols":0,"lastUsed":1795079891710},"md:packages/backend/src/resources/model/model.service.ts":{"fp":"ba1cffb53c7c86be44d3af60b567c9f310f3db92c9fcdbcacc3a959420830ec0","issues":["dist sourcemap missing or unmatched — dist line is an approximation"],"kind":"md","markdown":"## Members\n\n<dl>\n<dt><a href=\"#ModelService\">ModelService</a></dt>\n<dd><p>Model feature service: glTF/GLB inspection, extraction, optimization (DRACO/Meshopt) and conversion.</p>\n</dd>\n</dl>\n\n## Constants\n\n<dl>\n<dt><a href=\"#MODE_TRIANGLES\">MODE_TRIANGLES</a></dt>\n<dd><p>glTF primitive mode constants.</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#readBody\">readBody(cls)</a> ⇒ <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code></dt>\n<dd><p>Only the GLB container; .gltf JSON with external resources is out of scope.</p>\n</dd>\n<dt><a href=\"#assertModelSignature\">assertModelSignature(buffer)</a> ⇒ <code>Promise&lt;void&gt;</code></dt>\n<dd><p>Signature must be the GLB magic; closes the renamed-image and JSON-mislabeled holes.</p>\n</dd>\n<dt><a href=\"#boundsOf\">boundsOf(document)</a> ⇒ <code>{ max: [number, number, number]; min: [number, number, number]; }</code></dt>\n<dd><p>Axis-aligned bounding box over every POSITION accessor, or undefined when nothing carries positions.</p>\n</dd>\n<dt><a href=\"#metadataOf\">metadataOf(document)</a> ⇒ <code>{ asset: { generator: string; version: string; }; bounds: { max: [number, number, number]; min: [number, number, number]; }; counts: { accessors: number; animations: number; cameras: number; materials: number; meshes: number; nodes: number; primitives: number; scenes: number; skins: number; textures: number; triangles: number; vertices: number; }; extensionsRequired: string[]; extensionsUsed: string[]; format: string; }</code></dt>\n<dd><p>Normalized metadata payload (used by the metadata route).</p>\n</dd>\n<dt><a href=\"#extractOf\">extractOf(document)</a> ⇒ <code>{ animations: { channels: number; name: string; samplers: number; }[]; format: string; materials: { alphaMode: GLTF.MaterialAlphaMode; baseColorFactor: import(&quot;@gltf-transform/core&quot;).vec4; doubleSided: boolean; emissiveFactor: import(&quot;@gltf-transform/core&quot;).vec3; metallicFactor: number; name: string; roughnessFactor: number; }[]; meshes: { name: string; primitives: { triangles: number; vertices: number; attributes: string[]; material: string; mode: GLTF.MeshPrimitiveMode; targets: number; }[]; }[]; scenes: { name: string; nodes: Record&lt;string, unknown&gt;[]; }[]; skins: { joints: number; name: string; }[]; textures: { bytes: number; mimeType: string; name: string; }[]; }</code></dt>\n<dd><p>Structural extraction payload (used by the extract route).</p>\n</dd>\n<dt><a href=\"#mimeFor\">mimeFor(uri)</a> ⇒ <code>string</code></dt>\n<dd><p>Rewrites resource URIs to data URIs so the .gltf is a single self-contained file.</p>\n</dd>\n<dt><a href=\"#inlineResources\">inlineResources(json, resources)</a></dt>\n<dd><p>Rewrites resource URIs to data URIs so the .gltf is a single self-contained file.</p>\n</dd>\n</dl>\n\n<a name=\"ModelService\"></a>\n\n## ModelService\nModel feature service: glTF/GLB inspection, extraction, optimization (DRACO/Meshopt) and conversion.\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/model/model.service.ts:244  \ndist: packages/backend/dist/resources/model/model.service.js:257 (approx.)\n\n* [ModelService](#ModelService)\n    * [.convert(query)](#ModelService+convert) ⇒ <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code>\n    * [.extract()](#ModelService+extract) ⇒ <code>Promise&lt;{ animations: { channels: number; name: string; samplers: number; }[]; format: string; materials: { alphaMode: GLTF.MaterialAlphaMode; baseColorFactor: import(&quot;@gltf-transform/core&quot;).vec4; doubleSided: boolean; emissiveFactor: import(&quot;@gltf-transform/core&quot;).vec3; metallicFactor: number; name: string; roughnessFactor: number; }[]; meshes: { name: string; primitives: { triangles: number; vertices: number; attributes: string[]; material: string; mode: GLTF.MeshPrimitiveMode; targets: number; }[]; }[]; scenes: { name: string; nodes: Record&lt;string, unknown&gt;[]; }[]; skins: { joints: number; name: string; }[]; textures: { bytes: number; mimeType: string; name: string; }[]; }&gt;</code>\n    * [.metadata()](#ModelService+metadata) ⇒ <code>Promise&lt;{ asset: { generator: string; version: string; }; bounds: { max: [number, number, number]; min: [number, number, number]; }; counts: { accessors: number; animations: number; cameras: number; materials: number; meshes: number; nodes: number; primitives: number; scenes: number; skins: number; textures: number; triangles: number; vertices: number; }; extensionsRequired: string[]; extensionsUsed: string[]; format: string; }&gt;</code>\n    * [.optimize(query)](#ModelService+optimize) ⇒ <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code>\n\n<a name=\"ModelService+convert\"></a>\n\n### modelService.convert(query) ⇒ <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code>\nConverts the uploaded GLB between container formats.\n`glb`: binary container (lossless round-trip). `gltf`: self-contained JSON with data URIs.\n\n**Kind**: instance method of [<code>ModelService</code>](#ModelService)  \n**Returns**: <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code> - The converted bytes.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| query | <code>{ to: &quot;glb&quot; \\| &quot;gltf&quot;; }</code> | Target container. |\n\nsrc: packages/backend/src/resources/model/model.service.ts:256  \ndist: packages/backend/dist/resources/model/model.service.js:283 (approx.)\n<a name=\"ModelService+extract\"></a>\n\n### modelService.extract() ⇒ <code>Promise&lt;{ animations: { channels: number; name: string; samplers: number; }[]; format: string; materials: { alphaMode: GLTF.MaterialAlphaMode; baseColorFactor: import(&quot;@gltf-transform/core&quot;).vec4; doubleSided: boolean; emissiveFactor: import(&quot;@gltf-transform/core&quot;).vec3; metallicFactor: number; name: string; roughnessFactor: number; }[]; meshes: { name: string; primitives: { triangles: number; vertices: number; attributes: string[]; material: string; mode: GLTF.MeshPrimitiveMode; targets: number; }[]; }[]; scenes: { name: string; nodes: Record&lt;string, unknown&gt;[]; }[]; skins: { joints: number; name: string; }[]; textures: { bytes: number; mimeType: string; name: string; }[]; }&gt;</code>\nExtracts the scene graph, meshes, materials, textures, animations and skins.\n\n**Kind**: instance method of [<code>ModelService</code>](#ModelService)  \n**Returns**: <code>Promise&lt;{ animations: { channels: number; name: string; samplers: number; }[]; format: string; materials: { alphaMode: GLTF.MaterialAlphaMode; baseColorFactor: import(&quot;@gltf-transform/core&quot;).vec4; doubleSided: boolean; emissiveFactor: import(&quot;@gltf-transform/core&quot;).vec3; metallicFactor: number; name: string; roughnessFactor: number; }[]; meshes: { name: string; primitives: { triangles: number; vertices: number; attributes: string[]; material: string; mode: GLTF.MeshPrimitiveMode; targets: number; }[]; }[]; scenes: { name: string; nodes: Record&lt;string, unknown&gt;[]; }[]; skins: { joints: number; name: string; }[]; textures: { bytes: number; mimeType: string; name: string; }[]; }&gt;</code> - The structural extraction of the model.  \nsrc: packages/backend/src/resources/model/model.service.ts:272  \ndist: packages/backend/dist/resources/model/model.service.js:298 (approx.)\n<a name=\"ModelService+metadata\"></a>\n\n### modelService.metadata() ⇒ <code>Promise&lt;{ asset: { generator: string; version: string; }; bounds: { max: [number, number, number]; min: [number, number, number]; }; counts: { accessors: number; animations: number; cameras: number; materials: number; meshes: number; nodes: number; primitives: number; scenes: number; skins: number; textures: number; triangles: number; vertices: number; }; extensionsRequired: string[]; extensionsUsed: string[]; format: string; }&gt;</code>\nNormalized GLB metadata for an uploaded model.\n\n**Kind**: instance method of [<code>ModelService</code>](#ModelService)  \n**Returns**: <code>Promise&lt;{ asset: { generator: string; version: string; }; bounds: { max: [number, number, number]; min: [number, number, number]; }; counts: { accessors: number; animations: number; cameras: number; materials: number; meshes: number; nodes: number; primitives: number; scenes: number; skins: number; textures: number; triangles: number; vertices: number; }; extensionsRequired: string[]; extensionsUsed: string[]; format: string; }&gt;</code> - Format, asset descriptor, counts, extensions and bounds.  \nsrc: packages/backend/src/resources/model/model.service.ts:283  \ndist: packages/backend/dist/resources/model/model.service.js:308 (approx.)\n<a name=\"ModelService+optimize\"></a>\n\n### modelService.optimize(query) ⇒ <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code>\nOptimizes the uploaded model in a worker thread and returns GLB bytes.\n\n**Kind**: instance method of [<code>ModelService</code>](#ModelService)  \n**Returns**: <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code> - The optimized GLB bytes.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| query | <code>{ compress: &quot;none&quot; \\| &quot;draco&quot; \\| &quot;meshopt&quot;; weld: boolean; simplify?: number; }</code> | Compression codec, simplification ratio and weld. |\n\nsrc: packages/backend/src/resources/model/model.service.ts:295  \ndist: packages/backend/dist/resources/model/model.service.js:319 (approx.)\n<a name=\"MODE_TRIANGLES\"></a>\n\n## MODE\\_TRIANGLES\nglTF primitive mode constants.\n\n**Kind**: global constant  \nsrc: packages/backend/src/resources/model/model.service.ts:62  \ndist: packages/backend/dist/resources/model/model.service.js:40\n<a name=\"readBody\"></a>\n\n## readBody(cls) ⇒ <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code>\nOnly the GLB container; .gltf JSON with external resources is out of scope.\n\n**Kind**: global function  \n**Returns**: <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code> - The body bytes, capped.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| cls | <code>NormalizedClsService</code> | Normalized request context. |\n\nsrc: packages/backend/src/resources/model/model.service.ts:26  \ndist: packages/backend/dist/resources/model/model.service.js:21\n<a name=\"assertModelSignature\"></a>\n\n## assertModelSignature(buffer) ⇒ <code>Promise&lt;void&gt;</code>\nSignature must be the GLB magic; closes the renamed-image and JSON-mislabeled holes.\n\n**Kind**: global function  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| buffer | <code>Buffer&lt;ArrayBufferLike&gt;</code> | The buffered upload. |\n\nsrc: packages/backend/src/resources/model/model.service.ts:44  \ndist: packages/backend/dist/resources/model/model.service.js:34\n<a name=\"boundsOf\"></a>\n\n## boundsOf(document) ⇒ <code>{ max: [number, number, number]; min: [number, number, number]; }</code>\nAxis-aligned bounding box over every POSITION accessor, or undefined when nothing carries positions.\n\n**Kind**: global function  \n**Returns**: <code>{ max: [number, number, number]; min: [number, number, number]; }</code> - The axis-aligned bounds, or undefined when no primitive carries positions.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| document | <code>Document</code> | The parsed GLB document. |\n\nsrc: packages/backend/src/resources/model/model.service.ts:88  \ndist: packages/backend/dist/resources/model/model.service.js:57\n<a name=\"metadataOf\"></a>\n\n## metadataOf(document) ⇒ <code>{ asset: { generator: string; version: string; }; bounds: { max: [number, number, number]; min: [number, number, number]; }; counts: { accessors: number; animations: number; cameras: number; materials: number; meshes: number; nodes: number; primitives: number; scenes: number; skins: number; textures: number; triangles: number; vertices: number; }; extensionsRequired: string[]; extensionsUsed: string[]; format: string; }</code>\nNormalized metadata payload (used by the metadata route).\n\n**Kind**: global function  \n**Returns**: <code>{ asset: { generator: string; version: string; }; bounds: { max: [number, number, number]; min: [number, number, number]; }; counts: { accessors: number; animations: number; cameras: number; materials: number; meshes: number; nodes: number; primitives: number; scenes: number; skins: number; textures: number; triangles: number; vertices: number; }; extensionsRequired: string[]; extensionsUsed: string[]; format: string; }</code> - The normalized metadata payload.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| document | <code>Document</code> | The parsed GLB document. |\n\nsrc: packages/backend/src/resources/model/model.service.ts:122  \ndist: packages/backend/dist/resources/model/model.service.js:85\n<a name=\"extractOf\"></a>\n\n## extractOf(document) ⇒ <code>{ animations: { channels: number; name: string; samplers: number; }[]; format: string; materials: { alphaMode: GLTF.MaterialAlphaMode; baseColorFactor: import(&quot;@gltf-transform/core&quot;).vec4; doubleSided: boolean; emissiveFactor: import(&quot;@gltf-transform/core&quot;).vec3; metallicFactor: number; name: string; roughnessFactor: number; }[]; meshes: { name: string; primitives: { triangles: number; vertices: number; attributes: string[]; material: string; mode: GLTF.MeshPrimitiveMode; targets: number; }[]; }[]; scenes: { name: string; nodes: Record&lt;string, unknown&gt;[]; }[]; skins: { joints: number; name: string; }[]; textures: { bytes: number; mimeType: string; name: string; }[]; }</code>\nStructural extraction payload (used by the extract route).\n\n**Kind**: global function  \n**Returns**: <code>{ animations: { channels: number; name: string; samplers: number; }[]; format: string; materials: { alphaMode: GLTF.MaterialAlphaMode; baseColorFactor: import(&quot;@gltf-transform/core&quot;).vec4; doubleSided: boolean; emissiveFactor: import(&quot;@gltf-transform/core&quot;).vec3; metallicFactor: number; name: string; roughnessFactor: number; }[]; meshes: { name: string; primitives: { triangles: number; vertices: number; attributes: string[]; material: string; mode: GLTF.MeshPrimitiveMode; targets: number; }[]; }[]; scenes: { name: string; nodes: Record&lt;string, unknown&gt;[]; }[]; skins: { joints: number; name: string; }[]; textures: { bytes: number; mimeType: string; name: string; }[]; }</code> - The structural extraction payload.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| document | <code>Document</code> | The parsed GLB document. |\n\nsrc: packages/backend/src/resources/model/model.service.ts:158  \ndist: packages/backend/dist/resources/model/model.service.js:115\n<a name=\"mimeFor\"></a>\n\n## mimeFor(uri) ⇒ <code>string</code>\nRewrites resource URIs to data URIs so the .gltf is a single self-contained file.\n\n**Kind**: global function  \n**Returns**: <code>string</code> - The best-known MIME type for the resource.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| uri | <code>string</code> | The resource URI. |\n\nsrc: packages/backend/src/resources/model/model.service.ts:330  \ndist: packages/backend/dist/resources/model/model.service.js:354 (approx.)\n<a name=\"inlineResources\"></a>\n\n## inlineResources(json, resources)\nRewrites resource URIs to data URIs so the .gltf is a single self-contained file.\n\n**Kind**: global function  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| json | <code>GLTF.IGLTF</code> | The glTF JSON document to rewrite in place. |\n| resources | <code>{ [s: string]: Uint8Array&lt;ArrayBuffer&gt;; }</code> | The resource map from writeJSON. |\n\nsrc: packages/backend/src/resources/model/model.service.ts:346  \ndist: packages/backend/dist/resources/model/model.service.js:376 (approx.)\n","symbols":13,"lastUsed":1795079891929},"tdata:packages/backend/src/resources/model/schema.ts":{"doclets":[{"id":"compress","longname":"compress","name":"compress","kind":"member","scope":"global","description":"Compression codec for mesh data; `none` keeps uncompressed accessors.","meta":{"lineno":10},"order":3,"mdaics":{"dist":"packages/backend/dist/resources/model/schema.js:6","src":"packages/backend/src/resources/model/schema.ts:13"},"level":0},{"id":"simplify","longname":"simplify","name":"simplify","kind":"member","scope":"global","description":"Lossy simplification ratio in [0, 1]; 1 (default) disables it. Values < 1 force weld on.","meta":{"lineno":12},"order":4,"mdaics":{"dist":"packages/backend/dist/resources/model/schema.js:7","src":"packages/backend/src/resources/model/schema.ts:15"},"level":0},{"id":"weld","longname":"weld","name":"weld","kind":"member","scope":"global","descriptio