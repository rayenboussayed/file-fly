: ReturnType&lt;typeof vi.fn&gt;; }</code> - A writable with a mocked `setHeader`.  \nsrc: packages/backend/src/resources/audio/audio.controller.spec.ts:11  \n","symbols":1,"lastUsed":1795730448678},"tdata:packages/backend/src/resources/audio/audio.controller.ts":{"doclets":[{"id":"AudioController","longname":"AudioController","name":"AudioController","kind":"member","scope":"global","description":"Audio routes: processor, metadata, DNA and stats (binary stream endpoints).","params":[],"meta":{"lineno":45},"order":0,"mdaics":{"dist":"packages/backend/dist/resources/audio/audio.controller.js:22","src":"packages/backend/src/resources/audio/audio.controller.ts:28"},"level":0}],"fp":"2f2049b092e96581f621c71ae7496b5646a11ca5365e8b746799877eb8a7b7b7","issues":[],"kind":"tdata","lastUsed":1795730448655,"symbols":0},"md:packages/backend/src/resources/audio/audio.controller.ts":{"fp":"53cf38eb1b63723eac0c4a8a2d73ec8e88620c9c35bd2b4bb1b93287b3bddd6d","issues":[],"kind":"md","markdown":"<a name=\"AudioController\"></a>\n\n## AudioController\nAudio routes: processor, metadata, DNA and stats (binary stream endpoints).\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/audio/audio.controller.ts:28  \ndist: packages/backend/dist/resources/audio/audio.controller.js:22\n","symbols":1,"lastUsed":1795730448727},"tdata:packages/backend/src/resources/audio/audio.module.ts":{"doclets":[{"id":"AudioModule","longname":"AudioModule","name":"AudioModule","kind":"member","scope":"global","description":"Audio feature module: processor, metadata, DNA and stats routes.","params":[],"meta":{"lineno":42},"order":0,"mdaics":{"dist":"packages/backend/dist/resources/audio/audio.module.js:11","src":"packages/backend/src/resources/audio/audio.module.ts:15"},"level":0}],"fp":"c7a7d7a5301d762e36dda877f1dbe199bfbfc7eba00dc862347c7aad7b45cc3d","issues":[],"kind":"tdata","lastUsed":1795730448678,"symbols":0},"md:packages/backend/src/resources/audio/audio.module.ts":{"fp":"fd850f7203ae463e0e2e6f6928e69f537385e0f2f13a9da4d255ac23837440c2","issues":[],"kind":"md","markdown":"<a name=\"AudioModule\"></a>\n\n## AudioModule\nAudio feature module: processor, metadata, DNA and stats routes.\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/audio/audio.module.ts:15  \ndist: packages/backend/dist/resources/audio/audio.module.js:11\n","symbols":1,"lastUsed":1795730448755},"tdata:packages/backend/src/resources/audio/audio.service.spec.ts":{"doclets":[],"fp":"2fd661de2ea369454adf7a8e15209df62ab63ded12f64e96733b2c39b575fe30","issues":[],"kind":"tdata","lastUsed":1795730448727,"symbols":0},"md:packages/backend/src/resources/audio/audio.service.spec.ts":{"fp":"0909ce0a32e57fdc9fc041de590c926f83adad35b83d6ee58211ca046ef2e70c","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795730448736},"tdata:packages/backend/src/resources/audio/audio.service.ts":{"doclets":[{"id":"AudioService","longname":"AudioService","name":"AudioService","kind":"member","scope":"global","description":"Audio feature service: streams uploads through workers for processing, metadata, DNA fingerprinting and stats.","params":[],"meta":{"lineno":56},"order":1,"mdaics":{"dist":"packages/backend/dist/resources/audio/audio.service.js:22","src":"packages/backend/src/resources/audio/audio.service.ts:31"},"level":0},{"id":"requireInputFormat","longname":"requireInputFormat","name":"requireInputFormat","kind":"function","scope":"global","description":"Resolves the upload's detected signature to an FFmpeg demuxer format,\nthrowing the route's 415 when the signature is missing or unsupported.","params":[{"description":"Normalized request context carrying the file signature.","name":"cls","type":{"names":["NormalizedClsService"]}}],"returns":[{"description":"The resolved demuxer format name.","type":{"names":["string"]}}],"exceptions":[{"type":{"names":["UnsupportedMediaTypeException"]},"description":"When the signature has no demuxer mapping."}],"meta":{"lineno":47},"order":0,"mdaics":{"dist":"packages/backend/dist/resources/audio/audio.service.js:16","src":"packages/backend/src/resources/audio/audio.service.ts:21"},"level":0}],"fp":"b4f5b9738ff795db1eca4a988792b6f0caff4142bc2237cbeb7f30d28c356a83","issues":[],"kind":"tdata","lastUsed":1795730448755,"symbols":0},"md:packages/backend/src/resources/audio/audio.service.ts":{"fp":"79f0848ec2a7743fc37a8b96b628c996dbf62a77902f3580e595e5a2b5e127d6","issues":[],"kind":"md","markdown":"## Members\n\n<dl>\n<dt><a href=\"#AudioService\">AudioService</a></dt>\n<dd><p>Audio feature service: streams uploads through workers for processing, metadata, DNA fingerprinting and stats.</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#requireInputFormat\">requireInputFormat(cls)</a> ⇒ <code>string</code></dt>\n<dd><p>Resolves the upload&#39;s detected signature to an FFmpeg demuxer format,\nthrowing the route&#39;s 415 when the signature is missing or unsupported.</p>\n</dd>\n</dl>\n\n<a name=\"AudioService\"></a>\n\n## AudioService\nAudio feature service: streams uploads through workers for processing, metadata, DNA fingerprinting and stats.\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/audio/audio.service.ts:31  \ndist: packages/backend/dist/resources/audio/audio.service.js:22\n<a name=\"requireInputFormat\"></a>\n\n## requireInputFormat(cls) ⇒ <code>string</code>\nResolves the upload's detected signature to an FFmpeg demuxer format,\nthrowing the route's 415 when the signature is missing or unsupported.\n\n**Kind**: global function  \n**Returns**: <code>string</code> - The resolved demuxer format name.  \n**Throws**:\n\n- <code>UnsupportedMediaTypeException</code> When the signature has no demuxer mapping.\n\n\n| Param | Type | Description |\n| --- | --- | --- |\n| cls | <code>NormalizedClsService</code> | Normalized request context carrying the file signature. |\n\nsrc: packages/backend/src/resources/audio/audio.service.ts:21  \ndist: packages/backend/dist/resources/audio/audio.service.js:16\n","symbols":2,"lastUsed":1795730448806},"tdata:packages/backend/src/resources/audio/audio.worker.spec.ts":{"doclets":[],"fp":"ff772703dfa55904dcf4e665a6f9bc6cb243eeccce3aae5eee77742eb973d516","issues":[],"kind":"tdata","lastUsed":1795730448769,"symbols":0},"md:packages/backend/src/resources/audio/audio.worker.spec.ts":{"fp":"2ed641632a3bd6baa86a861a26b181de4cecc9d676d61704a861e8b04146fd40","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795730448779},"tdata:packages/backend/src/resources/audio/type.ts":{"doclets":[],"fp":"bd826af10fe9767181be3d4af48801d37cb82b81c9a0191926bc6d2d5ed90892","issues":[],"kind":"tdata","lastUsed":1795730448806,"symbols":0},"md:packages/backend/src/resources/audio/type.ts":{"fp":"3c46d905cd57270dc17aa3455e9f6e8be0a25fb230b18dd5216e72a8701aaa47","issues":[],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795730448811},"tdata:packages/backend/src/resources/audio/schema.ts":{"doclets":[{"id":"AudioProcessorSchema","longname":"AudioProcessorSchema","name":"AudioProcessorSchema","kind":"constant","scope":"global","description":"Query parameters for `/audio/processor`, `/audio/metadata`, `/audio/dna` and `/audio/stats` uploads.","meta":{"lineno":9},"order":0,"mdaics":{"dist":"packages/backend/dist/resources/audio/schema.js:6","src":"packages/backend/src/resources/audio/schema.ts:12"},"level":0}],"fp":"663585c80d6b314cf9c2b24b15fb310655aa831ecb3cbebfb58f3e12a9a1bc65","issues":[],"kind":"tdata","lastUsed":1795730448779,"symbols":0},"md:packages/backend/src/resources/audio/schema.ts":{"fp":"066dbec6631ca055e500c9168accb310912772d4c325a50c8a7daadd4bf65273","issues":[],"kind":"md","markdown":"<a name=\"AudioProcessorSchema\"></a>\n\n## AudioProcessorSchema\nQuery parameters for `/audio/processor`, `/audio/metadata`, `/audio/dna` and `/audio/stats` uploads.\n\n**Kind**: global constant  \n