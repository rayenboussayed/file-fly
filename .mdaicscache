ion's status/response accessors.","type":{"names":["{ getResponse: () => unknown; getStatus: () => number; }"]}}],"meta":{"lineno":147},"order":5,"mdaics":{"src":"packages/backend/src/services/anti-virus.service.spec.ts:150"},"level":0},{"id":"branchOf","longname":"branchOf","name":"branchOf","kind":"function","scope":"global","description":"Builds a fresh branch stream carrying the given number of bytes.","params":[{"description":"The payload size in bytes.","name":"bytes","type":{"names":["number"]}}],"returns":[{"description":"A readable branch.","type":{"names":["Readable"]}}],"meta":{"lineno":163},"order":6,"mdaics":{"src":"packages/backend/src/services/anti-virus.service.spec.ts:172"},"level":0},{"id":"catchException","longname":"catchException","name":"catchException","kind":"function","scope":"global","description":"Awaits a scan expected to reject and returns the thrown exception.","params":[{"description":"The scan promise.","name":"promise","type":{"names":["Promise<unknown>"]}}],"returns":[{"description":"The thrown HTTP exception.","type":{"names":["Promise<{ getResponse: () => unknown; getStatus: () => number; }>"]}}],"meta":{"lineno":171},"async":true,"order":7,"mdaics":{"src":"packages/backend/src/services/anti-virus.service.spec.ts:181"},"level":0},{"id":"createService","longname":"createService","name":"createService","kind":"function","scope":"global","description":"Builds a fresh `AntiVirusService` wired to a real `NormalizedClsService`\nover a stubbed `ClsService`, isolating the module graph per test.","params":[],"returns":[{"description":"The service, the CLS backing map and the source-stream destroy spy.","type":{"names":["Promise<{ cls: { get: <T>(key: symbol) => T; set: (key: symbol, value: unknown) => Map<symbol, unknown>; }; normalizedCls: import(\"./normalized-cls.service.js\").NormalizedClsService; service: import(\"./anti-virus.service.js\").AntiVirusService; sourceDestroy: import(\"vitest\").Mock<import(\"@vitest/spy\").Procedure>; st