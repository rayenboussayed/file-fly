eenshots.\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/video/video.service.ts:17  \ndist: packages/backend/dist/resources/video/video.service.js:41 (approx.)\n","symbols":1,"lastUsed":1795079893251},"tdata:packages/backend/src/resources/video/worker/codecs.spec.ts":{"doclets":[],"fp":"0f450ee15e4c25b6b30800c9cfef62403cfb81c960ece79e016c5fac7ee0cbdd","issues":[],"kind":"tdata","lastUsed":1795079893028,"symbols":0},"md:packages/backend/src/resources/video/worker/codecs.spec.ts":{"fp":"948c5cf7ae12f623103e5b4b4f545c1ec5f55d193fe20a65e39b378ef600e33c","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795079893028},"tdata:packages/backend/src/resources/video/worker/codecs.ts":{"doclets":[{"id":"parseBitrate","longname":"parseBitrate","name":"parseBitrate","kind":"function","scope":"global","description":"Parses a video bitrate literal (`1200k`, `5M`) into bits per second.","params":[{"description":"The bitrate literal from the query (e.g. '2500k').","name":"value","type":{"names":["string"]}}],"returns":[{"description":"The bitrate in bits per second, defaulting to 2 000 000 when unparsable.","type":{"names":["number"]}}],"meta":{"lineno":7},"order":0,"mdaics":{"dist":"packages/backend/dist/resources/video/worker/codecs.js:2","src":"packages/backend/src/resources/video/worker/codecs.ts:14"},"level":0},{"id":"videoEncoderConstant","longname":"videoEncoderConstant","name":"videoEncoderConstant","kind":"function","scope":"global","description":"Maps the public codec name to the node-av FFmpeg encoder constant.","params":[{"description":"The codec from the query (`vp9` | `av1` | `x264`-family).","name":"codec"}],"returns":[{"description":"The FFmpeg encoder constant for passing to the output stream.","type":{"names":["import(\"node-av\").FFVideoEncoder<\"libvpx-vp9\"> | import(\"node-av\").FFVideoEncoder<\"libaom-av1\"> | import(\"node-av\").FFVideoEncoder<\"libx264\">"]}}],"meta":{"lineno":20},"order":1,"mdaics":{"dist":"packages/backend/dist/resources/video/worker/codecs.js:10","src":"packages/backend/src/resources/video/worker/codecs.ts:27"},"level":0}],"fp":"5a47168bddd9ece0952426509f0f667928bfda26750a38db2935e2326d4bcb5b","issues":[],"kind":"tdata","lastUsed":1795079893028,"symbols":0},"md:packages/backend/src/resources/video/worker/codecs.ts":{"fp":"1f59d7e29180b7c0432fbd77156832bbd35938a7603dc5769d5310ef7b76d84b","issues":[],"kind":"md","markdown":"## Functions\n\n<dl>\n<dt><a href=\"#parseBitrate\">parseBitrate(value)</a> ⇒ <code>number</code></dt>\n<dd><p>Parses a video bitrate literal (<code>1200k</code>, <code>5M</code>) into bits per second.</p>\n</dd>\n<dt><a href=\"#videoEncoderConstant\">videoEncoderConstant(codec)</a> ⇒ <code>import(&quot;node-av&quot;).FFVideoEncoder&lt;&quot;libvpx-vp9&quot;&gt; | import(&quot;node-av&quot;).FFVideoEncoder&lt;&quot;libaom-av1&quot;&gt; | import(&quot;node-av&quot;).FFVideoEncoder&lt;&quot;libx264&quot;&gt;</code></dt>\n<dd><p>Maps the public codec name to the node-av FFmpeg encoder constant.</p>\n</dd>\n</dl>\n\n<a name=\"parseBitrate\"></a>\n\n## parseBitrate(value) ⇒ <code>number</code>\nParses a video bitrate literal (`1200k`, `5M`) into bits per second.\n\n**Kind**: global function  \n**Returns**: <code>number</code> - The bitrate in bits per second, defaulting to 2 000 000 when unparsable.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| value | <code>string</code> | The bitrate literal from the query (e.g. '2500k'). |\n\nsrc: packages/backend/src/resources/video/worker/codecs.ts:14  \ndist: packages/backend/dist/resources/video/worker/codecs.js:2\n<a name=\"videoEncoderConstant\"></a>\n\n## videoEncoderConstant(codec) ⇒ <code>import(&quot;node-av&quot;).FFVideoEncoder&lt;&quot;libvpx-vp9&quot;&gt; \\| import(&quot;node-av&quot;).FFVideoEncoder&lt;&quot;libaom-av1&quot;&gt; \\| import(&quot;node-av&quot;).FFVideoEncoder&lt;&quot;libx264&quot;&gt;</code>\nMaps the public codec name to the node-av FFmpeg encoder constant.\n\n**Kind**: global function  \n**Returns**: <code>import(&quot;node-av&quot;).FFVideoEncoder&lt;&quot;libvpx-vp9&quot;&gt; \\| import(&quot;node-av&quot;).FFVideoEncoder&lt;&quot;libaom-av1&quot;&gt; \\| import(&quot;node-av&quot;).FFVideoEncoder&lt;&quot;libx264&quot;&gt;</code> - The FFmpeg encoder constant for passing to the output stream.  \n\n| Param | Description |\n| --- | --- |\n| codec | The codec from the query (`vp9` | `av1` | `x264`-family). |\n\nsrc: packages/backend/src/resources/video/worker/codecs.ts:27  \ndist: packages/backend/dist/resources/video/worker/codecs.js:10\n","symbols":2,"lastUsed":1795079893064},"tdata:packages/backend/src/resources/video/worker/dna.ts":{"doclets":[{"id":"dna","longname":"dna","name":"dna","kind":"function","scope":"global","description":"Computes a sequence of PDQ perceptual hashes for the video on stdin,\nsampled at 2 fps and normalized to 512px-wide RGB frames.\n\nThe decoder runs to EOF so stdin is usually fully consumed, but the\nremainder is still drained in the `finally` block: on early failure\n(e.g. no video stream) the unread HTTP upload must be discarded or\nthe client stalls mid-send.","returns":[{"description":"Resolves after the DNA JSON line is written to stdout.","type":{"names":["Promise<void>"]}}],"meta":{"lineno":70},"order":0,"mdaics":{"dist":"packages/backend/dist/resources/video/worker/dna.js:60","src":"packages/backend/src/resources/video/worker/dna.ts:23"},"level":0}],"fp":"d55aceca80241bb92d8dc712db8b4dc6af8dec36cc3f4a8c667d50b9cdaef6f0","issues":[],"kind":"tdata","lastUsed":1795079893036,"symbols":0},"md:packages/backend/src/resources/video/worker/dna.ts":{"fp":"7cb09eaee9b6bfb3f15afcdf9e248962047ffa52e7b142a0d4cec3270923f537","issues":[],"kind":"md","markdown":"<a name=\"dna\"></a>\n\n## dna() ⇒ <code>Promise&lt;void&gt;</code>\nComputes a sequence of PDQ perceptual hashes for the video on stdin,\nsampled at 2 fps and normalized to 512px-wide RGB frames.\n\nThe decoder runs to EOF so stdin is usually fully consumed, but the\nremainder is still drained in the `finally` block: on early failure\n(e.g. no video stream) the unread HTTP upload must be discarded or\nthe client stalls mid-send.\n\n**Kind**: global function  \n**Returns**: <code>Promise&lt;void&gt;</code> - Resolves after the DNA JSON line is written to stdout.  \nsrc: packages/backend/src/resources/video/worker/dna.ts:23  \ndist: packages/backend/dist/resources/video/worker/dna.js:60\n","symbols":1,"lastUsed":1795079893090},"tdata:packages/backend/src/resources/video/worker/filters.ts":{"doclets":[{"id":"buildAudioFilters","longname":"buildAudioFilters","name":"buildAudioFilters","kind":"function","scope":"global","description":"Builds the audio filter chain for a transcode (channel mix, resample, loudnorm).","params":[{"description":"The validated video processor options.","name":"payload"}],"returns":[{"description":"The filters to apply on the audio stream, in order.","type":{"names":["FilterAPI[]"]}}],"meta":{"lineno":7},"order":0,"mdaics":{"dist":"packages/backend/dist/resources/video/worker/filters.js:2","src":"packages/backend/src/resources/video/worker/filters.ts:10"},"level":0},{"id":"buildVideoFilters","longname":"buildVideoFilters","name":"buildVideoFilters","kind":"function","scope":"global","description":"Builds the video filter chain (trim, deinterlace, scale, fps, denoise, ...).","params":[{"description":"The validated video processor options.","name":"payload"}],"returns":[{"description":"The filters to apply on the video stream, in order.","type":{"names":["FilterAPI[]"]}}],"meta":{"lineno":22},"order":1,"mdaics":{"dist":"packages/backend/dist/resources/video/worker/filters.js:12","src":"packages/backend/src/resources/video/worker/filters.ts:23"},"level":0}],"fp":"391622fde45685c607ba7dfe14d67f87462e7f75250a32a2cf1f90bd7942a20e","issues":[],"kind":"tdata","lastUsed":1795079893107,"symbols":0},"md:packages/backend/src/resources/video/worker/filters.ts":{"fp":"51c0ab87bad50fcb1d8666e4c490d621c0695979a190e71e279e287f9e0ded04","issues":[],"kind":"md","markdown":"## Functions\n\n<dl>\n<dt><a href=\"#buildAudioFilters\">buildAudioFilters(payload)</a> ⇒ <code>FilterAPI[]</code></dt>\n<dd><p>Builds the audio filter chain for a transcode (channel mix, resample, loudnorm).</p>\n</dd>\n<dt><a href=\"#buildVideoFilters\">buildVideoFilters(payload)</a> ⇒ <code>FilterAPI[]</code></dt>\n<dd><p>Builds the video filter chain (trim, deinterlace, scale, fps, denoise, ...).</p>\n</dd>\n</dl>\n\n<a name=\"buildAudioFilters\"></a>\n\n## buildAudioFilters(payload) ⇒ <code>FilterAPI[]</code>\nBuilds the audio filter chain for a transcode (channel mix, resample, loudnorm).\n\n**Kind**: global function  \n**Returns**: <code>FilterAPI[]</code> - The filters to apply on the audio stream, in order.  \n\n| Param | Description |\n| --- | --- |\n| payload | The validated video processor options. |\n\nsrc: packages/backend/src/resources/video/worker/filters.ts:10  \ndist: packages/backend/dist/resources/video/worker/filters.js:2\n<a name=\"buildVideoFilters\"></a>\n\n## buildVideoFilters(payload) ⇒ <code>FilterAPI[]</code>\nBuilds the video filter chain (trim, deinterlace, scale, fps, denoise, ...).\n\n**Kind**: global function  \n**Returns**: <code>FilterAPI[]</code> - The filters to apply on the video stream, in order.  \n\n| Param | Description |\n| --- | --- |\n| payload | The validated video processor options. |\n\nsrc: packages/backend/src/resources/video/worker/filters.ts:23  \ndist: packages/backend/dist/resources/video/worker/filters.js:12\n","symbols":2,"lastUsed":1795079893218},"tdata:packages/backend/src/resources/video/worker/filters.spec.ts":{"doclets":[],"fp":"4ec18ba2485cf3b85d10fb64a8ce935f4ebdbd6aa0ccbc89a7c9d6cd43570583","issues":[],"kind":"tdata","lastUsed":1795079893097,"symbols":0},"md:packages/backend/src/resources/video/worker/filters.spec.ts":{"fp":"00367f82c4d063d56ded70885320054b6e24a563b9ca4b34179abc0170299cac","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795079893098},"tdata:packages/backend/src/resources/video/worker/index.ts":{"doclets":[{"id":"finishWorker","longname":"finishWorker","name":"finishWorker","kind":"function","scope":"global","description":"Ends the worker process once the job is done: drops the stdin handle so\nthe event loop drains naturally, with a short backstop if native handles linger.","params":[{"description":"Exit code for the worker process.","name":"code","type":{"names":["number"]}}],"meta":{"lineno":14},"order":0,"mdaics":{"dist":"packages/backend/dist/resources/video/worker/index.js:9","src":"packages/backend/src/resources/video/worker/index.ts:20"},"level":0},{"id":"run","longname":"run","name":"run","kind":"function","scope":"global","description":"Dispatches the requested video operation (processor/metadata/dna/stats/screenshot).","params":[],"meta":{"lineno":21},"async":true,"order":1,"mdaics":{"dist":"packages/backend/dist/resources/video/worker/index.js:14","src":"packages/backend/src/resources/video/worker/index.ts:28"},"returns":[{"type":{"names":["Promise<void>"]}}],"level":0},{"id":"startVideoWorker","longname":"startVideoWorker","name":"startVideoWorker","kind":"function","scope":"global","description":"Runs the worker job and, only inside a spawned worker thread, finishes the process.","params":[],"returns":[{"description":"The job (with exit-code handling attached when running as a worker thread).","type":{"names":["Promise<any>"]}}],"meta":{"lineno":44},"order":2,"mdaics":{"dist":"packages/backend/dist/resources/video/worker/index.js:33","src":"packages/backend/src/resources/video/worker/index.ts:52"},"level":0}],"fp":"6c3a438e1f9cdd72eeda82a4bc8a9bbaec39a1ed6224183ca22a244c1d3fa535","issues":[],"kind":"tdata","lastUsed":1795079893137,"symbols":0},"md:packages/backend/src/resources/video/worker/index.ts":{"fp":"9f7459fb6b88021b9f3b3cb2d3a6b4cae4722880639bc0d72ec87904e5e1949f","issues":[],"kind":"md","markdown":"## Functions\n\n<dl>\n<dt><a href=\"#finishWorker\">finishWorker(code)</a></dt>\n<dd><p>Ends the worker process once the job is done: drops the stdin handle so\nthe event loop drains naturally, with a short backstop if native handles linger.</p>\n</dd>\n<dt><a href=\"#run\">run()</a> ⇒ <code>Promise&lt;void&gt;</code></dt>\n<dd><p>Dispatches the requested video operation (processor/metadata/dna/stats/screenshot).</p>\n</dd>\n<dt><a href=\"#startVideoWorker\">startVideoWorker()</a> ⇒ <code>Promise&lt;any&gt;</code></dt>\n<dd><p>Runs the worker job and, only inside a spawned worker thread, finishes the process.</p>\n</dd>\n</dl>\n\n<a name=\"finishWorker\"></a>\n\n## finishWorker(code)\nEnds the worker process once the job is done: drops the stdin handle so\nthe event loop drains naturally, with a short backstop if native handles linger.\n\n**Kind**: global function  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| code | <code>number</code> | Exit code for the worker process. |\n\nsrc: packages/backend/src/resources/video/worker/index.ts:20  \ndist: packages/backend/dist/resources/video/worker/index.js:9\n<a name=\"run\"></a>\n\n## run() ⇒ <code>Promise&lt;void&gt;</code>\nDispatches the requested video operation (processor/metadata/dna/stats/screenshot).\n\n**Kind**: global function  \nsrc: packages/backend/src/resources/video/worker/index.ts:28  \ndist: packages/backend/dist/resources/video/worker/index.js:14\n<a name=\"startVideoWorker\"></a>\n\n## startVideoWorker() ⇒ <code>Promise&lt;any&gt;</code>\nRuns the worker job and, only inside a spawned worker thread, finishes the process.\n\n**Kind**: global function  \n**Returns**: <code>Promise&lt;any&gt;</code> - The job (with exit-code handling attached when running as a worker thread).  \nsrc: packages/backend/src/resources/video/worker/index.ts:52  \ndist: packages/backend/dist/resources/video/worker/index.js:33\n","symbols":3,"lastUsed":1795079893188},"tdata:packages/backend/src/resources/video/worker/inspect.ts":{"doclets":[],"fp":"cfbc9375a7a7c1d417fab03e219f85aad170e1808b9d1fcfbb34ac1d0dda6829","issues":[],"kind":"tdata","lastUsed":1795079893191,"symbols":0},"md:packages/backend/src/resources/video/worker/inspect.ts":{"fp":"096a3ac25babaa810bc60d244fd6b8aa9b2bb73e4a580c53c6992d3b110afb36","issues":[],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795079893220},"tdata:packages/backend/src/resources/video/worker/screenshot.ts":{"doclets":[{"id":"screenshot","longname":"screenshot","name":"screenshot","kind":"function","scope":"global","description":"Extracts one JPEG frame per requested timestamp as a multipart/mixed stream.","params":[{"description":"Requested timestamps in seconds (sorted, deduplicated).","name":"frames","type":{"names":["number[]"]}}],"meta":{"lineno":69},"order":0,"mdaics":{"dist":"packages/backend/dist/resources/video/worker/screenshot.js:65","src":"packages/backend/src/resources/video/worker/screenshot.ts:24"},"returns":[{"type":{"names":["Promise<void>"]}}],"level":0}],"fp":"6450d6347db783ea317140520c701fe3437d2b583a49c711634ca6ae292d94e9","issues":[],"kind":"tdata","lastUsed":1795079893276,"symbols":0},"md:packages/backend/src/resources/video/worker/screenshot.ts":{"fp":"c69fb955e031dbb2fa0c6f8ff8df8f0fcd399168eed114aa8b201973fbc182aa","issues":[],"kind":"md","markdown":"<a name=\"screenshot\"></a>\n\n## screenshot(frames) ⇒ <code>Promise&lt;void&gt;</code>\nExtracts one JPEG frame per requested timestamp as a multipart/mixed stream.\n\n**Kind**: global function  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| frames | <code>number[]</code> | Requested timestamps in seconds (sorted, deduplicated). |\n\nsrc: packages/backend/src/resources/video/worker/screenshot.ts:24  \ndist: packages/backend/dist/resources/video/worker/screenshot.js:65\n","symbols":1,"lastUsed":1795079893366},"tdata:packages/backend/src/resources/video/worker/processor.ts":{"doclets":[{"id":"processMedia","longname":"processMedia","name":"processMedia","kind":"function","scope":"global","description":"Transcodes the upload stdin into the requested format/codec and streams it out.","params":[{"description":"The validated video processor options (format, codec, bitrate, filters...).","name":"payload"}],"meta":{"lineno":67},"order":0,"mdaics":{"dist":"packages/backend/dist/resources/video/worker/processor.js:62","src":"packages/backend/src/resources/video/worker/processor.ts:33"},"returns":[{"type":{"names":["Promise<void>"]}}],"level":0},{"id":"hasAudioTranscoding","longname":"hasAudioTranscoding","name":"hasAudioTranscoding","kind":"function","scope":"global","description":"Whether any audio-side option forces a transcode of the audio stream.","params":[{"description":"The validated video processor options.","name":"payload"}],"returns":[{"description":"True when the audio stream must be re-encoded.","type":{"names":["boolean"]}}],"meta":{"lineno":185},"order":1,"mdaics":{"dist":"packages/backend/dist/resources/video/worker/processor.js:185 (approx.)","src":"packages/backend/src/resources/video/worker/processor.ts:150"},"level":0},{"id":"hasVideoTranscoding","longname":"hasVideoTranscoding","name":"hasVideoTranscoding","kind":"function","scope":"global","description":"Whether any video-side option forces a transcode of the video stream.","params":[{"description":"The validated video processor options.","name":"payload"}],"returns":[{"description":"True when the video stream must be re-encoded.","type":{"names":["boolean"]}}],"meta":{"lineno":193},"order":2,"mdaics":{"dist":"packages/backend/dist/resources/video/worker/processor.js:193 (approx.)","src":"packages/backend/src/resources/video/worker/processor.ts:159"},"level":0}],"fp":"d6be475ce599cf9eec20a1f47848bcfbdfd3d533fb70599f0b67f4bfd6f0154f","issues":[],"kind":"tdata","lastUsed":1795079893258,"symbols":0},"md:packages/backend/src/resources/video/worker/processor.ts":{"fp":"c1ba1bfedc7d37bd445f4bb0bb10ade61e3d714055a3c27bc6bdd4c841eebb34","issues":["dist sourcemap missing or unmatched — dist line is an approximation"],"kind":"md","markdown":"## Functions\n\n<dl>\n<dt><a href=\"#processMedia\">processMedia(payload)</a> ⇒ <code>Promise&lt;void&gt;</code></dt>\n<dd><p>Transcodes the upload stdin into the requested format/codec and streams it out.</p>\n</dd>\n<dt><a href=\"#hasAudioTranscoding\">hasAudioTranscoding(payload)</a> ⇒ <code>boolean</code></dt>\n<dd><p>Whether any audio-side option forces a transcode of the audio stream.</p>\n</dd>\n<dt><a href=\"#hasVideoTranscoding\">hasVideoTranscoding(payload)</a> ⇒ <code>boolean</code></dt>\n<dd><p>Whether any video-side option forces a transcode of the video stream.</p>\n</dd>\n</dl>\n\n<a name=\"processMedia\"></a>\n\n## processMedia(payload) ⇒ <code>Promise&lt;void&gt;</code>\nTranscodes the upload stdin into the requested format/codec and streams it out.\n\n**Kind**: global function  \n\n| Param | Description |\n| --- | --- |\n| payload | The validated video processor options (format, codec, bitrate, filters...). |\n\nsrc: packages/backend/src/resources/video/worker/processor.ts:33  \ndist: packages/backend/dist/resources/video/worker/processor.js:62\n<a name=\"hasAudioTranscoding\"></a>\n\n## hasAudioTranscoding(payload) ⇒ <code>boolean</code>\nWhether any audio-side option forces a transcode of the audio stream.\n\n**Kind**: global function  \n**Returns**: <code>boolean</code> - True when the audio stream must be re-encoded.  \n\n| Param | Description |\n| --- | --- |\n| payload | The validated video processor options. |\n\nsrc: packages/backend/src/resources/video/worker/processor.ts:150  \ndist: packages/backend/dist/resources/video/worker/processor.js:185 (approx.)\n<a name=\"hasVideoTranscoding\"></a>\n\n## hasVideoTranscoding(payload) ⇒ <code>boolean</code>\nWhether any video-side option forces a transcode of the video stream.\n\n**Kind**: global function  \n**Returns**: <code>boolean</code> - True when the video stream must be re-encoded.  \n\n| Param | Description |\n| --- | --- |\n| payload | The validated video processor options. |\n\nsrc: packages/backend/src/resources/video/worker/processor.ts:159  \ndist: packages/backend/dist/resources/video/worker/processor.js:193 (approx.)\n","symbols":3,"lastUsed":1795079893346},"tdata:packages/backend/src/resources/video/worker/worker.spec.ts":{"doclets":[{"id":"stubStdin","longname":"stubStdin","name":"stubStdin","kind":"function","scope":"global","description":"Replaces process.stdin with a replay of the fixture.","params":[{"description":"Bytes to replay (defaults to the tiny video fixture).","name":"bytes","type":{"names":["Buffer<ArrayBufferLike>"]}}],"meta":{"lineno":16},"order":0,"mdaics":{"src":"packages/backend/src/resources/video/worker/worker.spec.ts:21"},"level":0},{"id":"stubStdout","longname":"stubStdout","name":"stubStdout","kind":"function","scope":"global","description":"Replaces process.stdout with a sink; returns the collected chunks.","params":[],"returns":[{"description":"The collected stdout chunks.","type":{"names":["Buffer<ArrayBufferLike>[]"]}}],"meta":{"lineno":23},"order":1,"mdaics":{"src":"packages/backend/src/resources/video/worker/worker.spec.ts:29"},"level":0},{"id":"importWorker","longname":"importWorker","name":"importWorker","kind":"function","scope":"global","description":"Imports the worker module fresh with the given workerData.","params":[{"description":"The worker payload (operation + inputFormat).","name":"workerData","type":{"names":["Record<string, unknown>"]}}],"meta":{"lineno":41},"async":true,"order":2,"mdaics":{"src":"packages/backend/src/resources/video/worker/worker.spec.ts:50"},"returns":[{"type":{"names":["Promise<void>"]}}],"level":0}],"fp":"7b96d7b581b7b4fd4dd34fcdd8ca2c0972f57f8acbe41338ab20ea510b607d7e","issues":[],"kind":"tdata","lastUsed":1795079893276,"symbols":0},"md:packages/backend/src/resources/video/worker/worker.spec.ts":{"fp":"fbe0678f2babdf4892377956080b93ab69a0f6b94adb65b7d29b02ea01718577","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","markdown":"## Functions\n\n<dl>\n<dt><a href=\"#stubStdin\">stubStdin(bytes)</a></dt>\n<dd><p>Replaces process.stdin with a replay of the fixture.</p>\n</dd>\n<dt><a href=\"#stubStdout\">stubStdout()</a> ⇒ <code>Buffer&lt;ArrayBufferLike&gt;[]</code></dt>\n<dd><p>Replaces process.stdout with a sink; returns the collected chunks.</p>\n</dd>\n<dt><a href=\"#importWorker\">importWorker(workerData)</a> ⇒ <code>Promise&lt;void&gt;</code></dt>\n<dd><p>Imports the worker module fresh with the given workerData.</p>\n</dd>\n</dl>\n\n<a name=\"stubStdin\"></a>\n\n## stubStdin(bytes)\nReplaces process.stdin with a replay of the fixture.\n\n**Kind**: global function  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| bytes | <code>Buffer&lt;ArrayBufferLike&gt;</code> | Bytes to replay (defaults to the tiny video fixture). |\n\nsrc: packages/backend/src/resources/video/worker/worker.spec.ts:21  \n<a name=\"stubStdout\"></a>\n\n## stubStdout() ⇒ <code>Buffer&lt;ArrayBufferLike&gt;[]</code>\nReplaces process.stdout with a sink; returns the collected chunks.\n\n**Kind**: global function  \n**Returns**: <code>Buffer&lt;ArrayBufferLike&gt;[]</code> - The collected stdout chunks.  \nsrc: packages/backend/src/resources/video/worker/worker.spec.ts:29  \n<a name=\"importWorker\"></a>\n\n## importWorker(workerData) ⇒ <code>Promise&lt;void&gt;</code>\nImports the worker module fresh with the given workerData.\n\n**Kind**: global function  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| workerData | <code>Record&lt;string, unknown&gt;</code> | The worker payload (operation + inputFormat). |\n\nsrc: packages/backend/src/resources/video/worker/worker.spec.ts:50  \n","symbols":3,"lastUsed":1795079893308},"tdata:packages/backend/src/resources/xlsx/schema.ts":{"doclets":[{"id":"autofilter","longname":"autofilter","name":"autofilter","kind":"member","scope":"global","description":"Auto filter range, e.g. A1:C10.","meta":{"lineno":27},"order":1,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/schema.js:24","src":"packages/backend/src/resources/xlsx/schema.ts:30"},"level":0},{"id":"cellDates","longname":"cellDates","name":"cellDates","kind":"member","scope":"global","description":"Write Date cells (type `d`) instead of numeric serials when true.","meta":{"lineno":32},"order":2,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/schema.js:25","src":"packages/backend/src/resources/xlsx/schema.ts:36"},"level":0},{"id":"cols","longname":"cols","name":"cols","kind":"member","scope":"global","description":"Column properties written to `!cols` (width wpx/wch, hidden, outline level).","meta":{"lineno":34},"order":3,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/schema.js:26","src":"packages/backend/src/resources/xlsx/schema.ts:38"},"level":0},{"id":"columns","longname":"columns","name":"columns","kind":"member","scope":"global","description":"Object rows only: lock the column order (default: first-appearance order).","meta":{"lineno":47},"order":4,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/schema.js:38","src":"packages/backend/src/resources/xlsx/schema.ts:53"},"level":0},{"id":"merges","longname":"merges","name":"merges","kind":"member","scope":"global","description":"Merge ranges, e.g. A1:C2.","meta":{"lineno":49},"order":5,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/schema.js:39","src":"packages/backend/src/resources/xlsx/schema.ts:55"},"level":0},{"id":"name","longname":"name","name":"name","kind":"member","scope":"global","description":"Sheet name (1-31 chars, Excel charset); duplicates auto-uniquify. `date1904` workbooks are refused on write (SheetJS serializes 1904-flagged Date cells with the 1900 epoch).","meta":{"lineno":54},"order":6,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/schema.js:40","src":"packages/backend/src/resources/xlsx/schema.ts:63"},"level":0},{"id":"rows","longname":"rows","name":"rows","kind":"member","scope":"global","description":"Rows: objects map keys to cells; arrays emit positional cells. At least one row.","meta":{"lineno":61},"order":7,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/schema.js:45","src":"packages/backend/src/resources/xlsx/schema.ts:72"},"level":0},{"id":"sheetVisibility","longname":"sheetVisibility","name":"sheetVisibility","kind":"member","scope":"global","description":"0 visible, 1 hidden, 2 very hidden.","meta":{"lineno":65},"order":8,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/schema.js:48","src":"packages/backend/src/resources/xlsx/schema.ts:76"},"level":0},{"id":"Names","longname":"Names","name":"Names","kind":"member","scope":"global","description":"Workbook-global defined names (`x` in expressions, scoped via `Sheet`).","meta":{"lineno":75},"order":10,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/schema.js:56","src":"packages/backend/src/resources/xlsx/schema.ts:89"},"level":0},{"id":"header","longname":"header","name":"header","kind":"member","scope":"global","description":"1 = AOA rows, `A` = column-letter keys, or comma-separated custom headers.","meta":{"lineno":122},"order":12,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/schema.js:98","src":"packages/backend/src/resources/xlsx/schema.ts:141"},"level":0},{"id":"maxCells","longname":"maxCells","name":"maxCells","kind":"member","scope":"global","description":"Reject packages whose worksheets carry more cells than this; bounds parse cost.","meta":{"lineno":124},"order":13,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/schema.js:99","src":"packages/backend/src/resources/xlsx/schema.ts:143"},"level":0},{"id":"sheet","longname":"sheet","name":"sheet","kind":"member","scope":"global","description":"Sheet name or 0-based index.","meta":{"lineno":127},"order":14,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/schema.js:101","src":"packages/backend/src/resources/xlsx/schema.ts:146"},"level":0},{"id":"maxCells","longname":"maxCells","name":"maxCells","kind":"member","scope":"global","description":"Reject archives whose cells exceed this count (checked before SheetJS parses).","meta":{"lineno":133},"order":16,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/schema.js:105","src":"packages/backend/src/resources/xlsx/schema.ts:155"},"level":0},{"id":"cellSchema","longname":"cellSchema","name":"cellSchema","kind":"constant","scope":"global","description":"One cell in a build payload: primitive or a SheetJS `CellObject`.","params":[],"meta":{"lineno":4},"order":0,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/schema.js:3","src":"packages/backend/src/resources/xlsx/schema.ts:6"},"level":0},{"id":"XlsxBuildSchema","longname":"XlsxBuildSchema","name":"XlsxBuildSchema","kind":"constant","scope":"global","description":"Body of `POST /xlsx/build`.","meta":{"lineno":69},"order":9,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/schema.js:51","src":"packages/backend/src/resources/xlsx/schema.ts:83"},"level":0},{"id":"XlsxExtractSchema","longname":"XlsxExtractSchema","name":"XlsxExtractSchema","kind":"constant","scope":"global","description":"Flat query parameters for `POST /xlsx/extract`.\nThe raw .xlsx travels in the body; everything here is a reader option.","meta":{"lineno":118},"order":11,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/schema.js:95","src":"packages/backend/src/resources/xlsx/schema.ts:137"},"level":0},{"id":"XlsxMetadataSchema","longname":"XlsxMetadataSchema","name":"XlsxMetadataSchema","kind":"constant","scope":"global","description":"Flat query parameters for `POST /xlsx/metadata`.","meta":{"lineno":131},"order":15,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/schema.js:104","src":"packages/backend/src/resources/xlsx/schema.ts:153"},"level":0}],"fp":"a9a46684354be7ef86d72ec6013e3184388fcac77c113e6474b0cbacb14e8902","issues":[],"kind":"tdata","lastUsed":1795079893318,"symbols":0},"md:packages/backend/src/resources/xlsx/schema.ts":{"fp":"fc97e5d61b89ea89111eee0c4f1349bc4071a7051a0a17908ff7a9c6aec042b8","issues":[],"kind":"md","markdown":"## Members\n\n<dl>\n<dt><a href=\"#autofilter\">autofilter</a></dt>\n<dd><p>Auto filter range, e.g. A1:C10.</p>\n</dd>\n<dt><a href=\"#cellDates\">cellDates</a></dt>\n<dd><p>Write Date cells (type <code>d</code>) instead of numeric serials when true.</p>\n</dd>\n<dt><a href=\"#cols\">cols</a></dt>\n<dd><p>Column properties written to <code>!cols</code> (width wpx/wch, hidden, outline level).</p>\n</dd>\n<dt><a href=\"#columns\">columns</a></dt>\n<dd><p>Object rows only: lock the column order (default: first-appearance order).</p>\n</dd>\n<dt><a href=\"#merges\">merges</a></dt>\n<dd><p>Merge ranges, e.g. A1:C2.</p>\n</dd>\n<dt><a href=\"#name\">name</a></dt>\n<dd><p>Sheet name (1-31 chars, Excel charset); duplicates auto-uniquify. <code>date1904</code> workbooks are refused on write (SheetJS serializes 1904-flagged Date cells with the 1900 epoch).</p>\n</dd>\n<dt><a href=\"#rows\">rows</a></dt>\n<dd><p>Rows: objects map keys to cells; arrays emit positional cells. At least one row.</p>\n</dd>\n<dt><a href=\"#sheetVisibility\">sheetVisibility</a></dt>\n<dd><p>0 visible, 1 hidden, 2 very hidden.</p>\n</dd>\n<dt><a href=\"#Names\">Names</a></dt>\n<dd><p>Workbook-global defined names (<code>x</code> in expressions, scoped via <code>Sheet</code>).</p>\n</dd>\n<dt><a href=\"#header\">header</a></dt>\n<dd><p>1 = AOA rows, <code>A</code> = column-letter keys, or comma-separated custom headers.</p>\n</dd>\n<dt><a href=\"#maxCells\">maxCells</a></dt>\n<dd><p>Reject packages whose worksheets carry more cells than this; bounds parse cost.</p>\n</dd>\n<dt><a href=\"#sheet\">sheet</a></dt>\n<dd><p>Sheet name or 0-based index.</p>\n</dd>\n<dt><a href=\"#maxCells\">maxCells</a></dt>\n<dd><p>Reject archives whose cells exceed this count (checked before SheetJS parses).</p>\n</dd>\n</dl>\n\n## Constants\n\n<dl>\n<dt><a href=\"#cellSchema\">cellSchema</a></dt>\n<dd><p>One cell in a build payload: primitive or a SheetJS <code>CellObject</code>.</p>\n</dd>\n<dt><a href=\"#XlsxBuildSchema\">XlsxBuildSchema</a></dt>\n<dd><p>Body of <code>POST /xlsx/build</code>.</p>\n</dd>\n<dt><a href=\"#XlsxExtractSchema\">XlsxExtractSchema</a></dt>\n<dd><p>Flat query parameters for <code>POST /xlsx/extract</code>.\nThe raw .xlsx travels in the body; everything here is a reader option.</p>\n</dd>\n<dt><a href=\"#XlsxMetadataSchema\">XlsxMetadataSchema</a></dt>\n<dd><p>Flat query parameters for <code>POST /xlsx/metadata</code>.</p>\n</dd>\n</dl>\n\n<a name=\"autofilter\"></a>\n\n## autofilter\nAuto filter range, e.g. A1:C10.\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/xlsx/schema.ts:30  \ndist: packages/backend/dist/resources/xlsx/schema.js:24\n<a name=\"cellDates\"></a>\n\n## cellDates\nWrite Date cells (type `d`) instead of numeric serials when true.\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/xlsx/schema.ts:36  \ndist: packages/backend/dist/resources/xlsx/schema.js:25\n<a name=\"cols\"></a>\n\n## cols\nColumn properties written to `!cols` (width wpx/wch, hidden, outline level).\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/xlsx/schema.ts:38  \ndist: packages/backend/dist/resources/xlsx/schema.js:26\n<a name=\"columns\"></a>\n\n## columns\nObject rows only: lock the column order (default: first-appearance order).\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/xlsx/schema.ts:53  \ndist: packages/backend/dist/resources/xlsx/schema.js:38\n<a name=\"merges\"></a>\n\n## merges\nMerge ranges, e.g. A1:C2.\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/xlsx/schema.ts:55  \ndist: packages/backend/dist/resources/xlsx/schema.js:39\n<a name=\"name\"></a>\n\n## name\nSheet name (1-31 chars, Excel charset); duplicates auto-uniquify. `date1904` workbooks are refused on write (SheetJS serializes 1904-flagged Date cells with the 1900 epoch).\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/xlsx/schema.ts:63  \ndist: packages/backend/dist/resources/xlsx/schema.js:40\n<a name=\"rows\"></a>\n\n## rows\nRows: objects map keys to cells; arrays emit positional cells. At least one row.\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/xlsx/schema.ts:72  \ndist: packages/backend/dist/resources/xlsx/schema.js:45\n<a name=\"sheetVisibility\"></a>\n\n## sheetVisibility\n0 visible, 1 hidden, 2 very hidden.\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/xlsx/schema.ts:76  \ndist: packages/backend/dist/resources/xlsx/schema.js:48\n<a name=\"Names\"></a>\n\n## Names\nWorkbook-global defined names (`x` in expressions, scoped via `Sheet`).\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/xlsx/schema.ts:89  \ndist: packages/backend/dist/resources/xlsx/schema.js:56\n<a name=\"header\"></a>\n\n## header\n1 = AOA rows, `A` = column-letter keys, or comma-separated custom headers.\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/xlsx/schema.ts:141  \ndist: packages/backend/dist/resources/xlsx/schema.js:98\n<a name=\"maxCells\"></a>\n\n## maxCells\nReject packages whose worksheets carry more cells than this; bounds parse cost.\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/xlsx/schema.ts:143  \ndist: packages/backend/dist/resources/xlsx/schema.js:99\n<a name=\"sheet\"></a>\n\n## sheet\nSheet name or 0-based index.\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/xlsx/schema.ts:146  \ndist: packages/backend/dist/resources/xlsx/schema.js:101\n<a name=\"maxCells\"></a>\n\n## maxCells\nReject archives whose cells exceed this count (checked before SheetJS parses).\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/xlsx/schema.ts:155  \ndist: packages/backend/dist/resources/xlsx/schema.js:105\n<a name=\"cellSchema\"></a>\n\n## cellSchema\nOne cell in a build payload: primitive or a SheetJS `CellObject`.\n\n**Kind**: global constant  \nsrc: packages/backend/src/resources/xlsx/schema.ts:6  \ndist: packages/backend/dist/resources/xlsx/schema.js:3\n<a name=\"XlsxBuildSchema\"></a>\n\n## XlsxBuildSchema\nBody of `POST /xlsx/build`.\n\n**Kind**: global constant  \nsrc: packages/backend/src/resources/xlsx/schema.ts:83  \ndist: packages/backend/dist/resources/xlsx/schema.js:51\n<a name=\"XlsxExtractSchema\"></a>\n\n## XlsxExtractSchema\nFlat query parameters for `POST /xlsx/extract`.\nThe raw .xlsx travels in the body; everything here is a reader option.\n\n**Kind**: global constant  \nsrc: packages/backend/src/resources/xlsx/schema.ts:137  \ndist: packages/backend/dist/resources/xlsx/schema.js:95\n<a name=\"XlsxMetadataSchema\"></a>\n\n## XlsxMetadataSchema\nFlat query parameters for `POST /xlsx/metadata`.\n\n**Kind**: global constant  \nsrc: packages/backend/src/resources/xlsx/schema.ts:153  \ndist: packages/backend/dist/resources/xlsx/schema.js:104\n","symbols":17,"lastUsed":1795079893395},"tdata:packages/backend/src/resources/xlsx/xlsx.controller.spec.ts":{"doclets":[{"id":"rawSink","longname":"rawSink","name":"rawSink","kind":"function","scope":"global","description":"Creates a Writable raw sink with `setHeader` mocks for assertions.","params":[],"returns":[{"description":"A writable with a mocked `setHeader`.","type":{"names":["Writable & { setHeader: ReturnType<typeof vi.fn>; }"]}}],"meta":{"lineno":8},"order":0,"mdaics":{"src":"packages/backend/src/resources/xlsx/xlsx.controller.spec.ts:10"},"level":0}],"fp":"2c8d0cd3a85cb735f188def834b1f189bd14045ff0443ed7dee5d8b486bb9758","issues":[],"kind":"tdata","lastUsed":1795079893418,"symbols":0},"md:packages/backend/src/resources/xlsx/xlsx.controller.spec.ts":{"fp":"8277ea7042b16169ac55096b42b4b567d2d9da99c680163fb94a24770c59724b","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","markdown":"<a name=\"rawSink\"></a>\n\n## rawSink() ⇒ <code>Writable &am