0\" | \"horzStripe\" | \"vertStripe\" | \"diagStripe\" | \"diagCross\" | \"horzCross\"; }; spacing?: { after?: number; before?: number; line?: number; lineRule?: \"auto\" | \"atLeast\" | \"exact\"; }; tabStops?: { alignment: \"left\" | \"center\" | \"right\" | \"decimal\" | \"bar\"; leader: \"none\" | \"dot\" | \"hyphen\" | \"underscore\" | \"middleDot\"; position: number; }[]; }[]; id: number; }[]; metadata?: { category?: string; creator?: string; description?: string; keywords?: string; lastModifiedBy?: string; revision?: number; subject?: string; title?: string; }; numbering?: { [x: string]: any; levels: { format: \"none\" | \"decimal\" | \"upperRoman\" | \"lowerRoman\" | \"upperLetter\" | \"lowerLetter\" | \"bullet\"; level: number; alignment?: \"left\" | \"center\" | \"right\"; start?: number; text?: string; }[]; }[]; }"]}}],"returns":[{"description":"The .docx bytes.","type":{"names":["Promise<Buffer<ArrayBufferLike>>"]}}],"meta":{"lineno":380},"async":true,"order":10,"mdaics":{"dist":"packages/backend/dist/resources/docx/docx.service.js:277","src":"packages/backend/src/resources/docx/docx.service.ts:364"},"level":0},{"id":"DocxService#extract","longname":"DocxService#extract","name":"extract","kind":"function","scope":"instance","description":"Extracts text and structure from an uploaded .docx.","memberof":"DocxService","params":[],"returns":[{"description":"The parsed metadata, structure summary and full body text.","type":{"names":["Promise<{ format: string; metadata: any; structure: { headings: { level: number; text: string; }[]; hyperlinks: any; images: { alts: string[]; count: number; }; lists: number; tables: any; }; text: string; }>"]}}],"meta":{"lineno":404},"async":true,"order":11,"mdaics":{"dist":"packages/backend/dist/resources/docx/docx.service.js:296","src":"packages/backend/src/resources/docx/docx.service.ts:388"},"level":0},{"id":"DocxService#metadata","longname":"DocxService#metadata","name":"metadata","kind":"function","scope":"instance","description":"Normalized OOXML metadata for an uploaded .docx.","memberof":"DocxService","params":[],"returns":[{"description":"Format plus the parsed properties.","type":{"names":["Promise<any>"]}}],"meta":{"lineno":425},"async":true,"order":12,"mdaics":{"dist":"packages/backend/dist/resources/docx/docx.service.js:313","src":"packages/backend/src/resources/docx/docx.service.ts:415"},"level":0}],"fp":"006e69898fb2ffe609cfd2d8c8d1caf332bcd15ce1b38248b3eaee43f16ff6c6","issues":[],"kind":"tdata","lastUsed":1795730452253,"symbols":0},"md:packages/backend/src/resources/docx/docx.service.ts":{"fp":"be9d147db4cf2f31f78e319e38cec82e9d616317bb0845102bf1a690a89f326d","issues":[],"kind":"md","markdown":"## Members\n\n<dl>\n<dt><a href=\"#DocxService\">DocxService</a></dt>\n<dd><p>DOCX feature service: builds documents and parses/metadata-inspects uploads.</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#readPartsCapped\">readPartsCapped(buffer, limits)</a> ⇒</dt>\n<dd><p>Maps the shared OOXML reader&#39;s cap violations to HTTP errors (413 for size, 400 otherwise).</p>\n</dd>\n<dt><a href=\"#readBody\">readBody(cls)</a> ⇒ <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code></dt>\n<dd><p>Opens the uploaded body, bounded by the scanner cap.\nThe scanner only opens the source when ClamAV is enabled, so the service must too.</p>\n</dd>\n<dt><a href=\"#assertDocxSignature\">assertDocxSignature(buffer)</a> ⇒ <code>Promise&lt;void&gt;</code></dt>\n<dd><p>Signature must be the plain docx mime; closes the renamed-image and .docm/.dotx holes.</p>\n</dd>\n<dt><a href=\"#assertUniqueIds\">assertUniqueIds(body)</a> ⇒ <code>{ commentIds: Set&lt;number&gt;; endnoteIds: Set&lt;number&gt;; noteIds: Set&lt;number&gt;; }</code></dt>\n<dd><p>Collects and rejects duplicate note/comment ids.</p>\n</dd>\n<dt><a href=\"#assertBuildPayload\">assertBuildPayload(body)</a></dt>\n<dd><p>Validates build-payload cross-field rules the schema cannot express:\nsvg images must carry a fallback raster, hyperlinks need an allowed url or an anchor,\nnote/comment references must exist, ids must be unique, row spans must fit,\nand the element count is capped to bound memory.</p>\n</dd>\n<dt><a href=\"#tables\">tables(body)</a> ⇒ <code>Record&lt;string, unknown&gt;[]</code></dt>\n<dd><p>Collects every table element anywhere in the payload.</p>\n</dd>\n<dt><a href=\"#validateRowSpan\">validateRowSpan(table)</a></dt>\n<dd><p>Rejects rowSpan values exceeding the rows remaining in the table.</p>\n</dd>\n<dt><a href=\"#reportNoteReferences\">reportNoteReferences(body, noteIds, endnoteIds, commentIds)</a></dt>\n<dd><p>Rejects note/comment references that are not declared.</p>\n</dd>\n<dt><a href=\"#checkNoteReference\">checkNoteReference(record, noteIds, endnoteIds, commentIds)</a></dt>\n<dd><p>Rejects one record&#39;s note/comment references when they are not declared.</p>\n</dd>\n</dl>\n\n<a name=\"DocxService\"></a>\n\n## DocxService\nDOCX feature service: builds documents and parses/metadata-inspects uploads.\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/docx/docx.service.ts:351  \ndist: packages/backend/dist/resources/docx/docx.service.js:270\n\n* [DocxService](#DocxService)\n    * [.build(body)](#DocxService+build) ⇒ <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code>\n    * [.extract()](#DocxService+extract) ⇒ <code>Promise&lt;{ format: string; metadata: any; structure: { headings: { level: number; text: string; }[]; hyperlinks: any; images: { alts: string[]; count: number; }; lists: number; tables: any; }; text: string; }&gt;</code>\n    * [.metadata()](#DocxService+metadata) ⇒ <code>Promise&lt;any&gt;</code>\n\n<a name=\"DocxService+build\"></a>\n\n### docxService.build(body) ⇒ <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code>\nBuilds a .docx from the payload in a worker thread and returns the bytes.\nBuffers before returning so a worker failure answers 500, never a truncated 201.\nThe cache key is the payload hash, so repeated builds are served from the document cache.\n\n**Kind**: instance method of [<code>DocxService</code>](#DocxService)  \n**Returns**: <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code> - The .docx bytes.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| body | <code>{ sections: { children: ({ runs: { [x: string]: any; text: string; allCaps?: boolean; bold?: boolean; break?: number; doubleStrike?: boolean; endnote?: number; footnote?: number; highlight?: &quot;black&quot; \\| &quot;blue&quot; \\| &quot;cyan&quot; \\| &quot;darkBlue&quot; \\| &quot;darkCyan&quot; \\| &quot;darkGray&quot; \\| &quot;darkGreen&quot; \\| &quot;darkMagenta&quot; \\| &quot;darkRed&quot; \\| &quot;darkYellow&quot; \\| &quot;green&quot; \\| &quot;lightGray&quot; \\| &quot;magenta&quot; \\| &quot;none&quot; \\| &quot;red&quot; \\| &quot;white&quot; \\| &quot;yellow&quot;; italics?: boolean; language?: string; smallCaps?: boolean; strike?: boolean; subScript?: boolean; superScript?: boolean; type?: &quot;run&quot;; underline?: true \\| { [x: string]: any; type: &quot;none&quot; \\| &quot;single&quot; \\| &quot;words&quot; \\| &quot;double&quot; \\| &quot;thick&quot; \\| &quot;dotted&quot; \\| &quot;dottedHeavy&quot; \\| &quot;dash&quot; \\| &quot;dashedHeavy&quot; \\| &quot;dashLong&quot; \\| &quot;dashLongHeavy&quot; \\| &quot;dotDash&quot; \\| &quot;dashDotHeavy&quot; \\| &quot;dotDotDash&quot; \\| &quot;dashDotDotHeavy&quot; \\| &quot;wave&quot; \\| &quot;wavyHeavy&quot; \\| &quot;wavyDouble&quot;; }; vanish?: boolean; }[]; type: &quot;paragraph&quot;; alignment?: &quot;both&quot; \\| &quot;left&quot; \\| &quot;center&quot; \\| &quot;right&quot;; heading?: 1 \\| 2 \\| 3 \\| 4 \\| 6 \\| 5 \\| &quot;title&quot;; indent?: { firstLine?: number; hanging?: number; left?: number; right?: number; }; keepLines?: boolean; keepWithNext?: boolean; numbering?: { [x: string]: any; level: number; }; outlineLevel?: number; pageBreakBefore?: boolean; shading?: { [x: string]: any; type: &quot;clear&quot; \\| &quot;solid&quot; \\| &quot;nil&quot; \\| &quot;pct5&quot; \\| &quot;pct10&quot; \\| &quot;pct25&quot; \\| &quot;pct50&quot; \\| &quot;horzStripe&quot; \\| &quot;vertStripe&quot; \\| &quot;diagStripe&quot; \\| &quot;diagCross&quot; \\| &quot;horzCross&quot;; }; spacing?: { after?: number; before?: number; line?: number; lineRule?: &quot;auto&quot; \\| &quot;atLeast&quot; \\| &quot;exact&quot;; }; tabStops?: { alignment: &quot;left&quot; \\| &quot;center&quot; \\| &quot;right&quot; \\| &quot;decimal&quot; \\| &quot;bar&quot;; leader: &quot;none&quot; \\| &quot;dot&quot; \\| &quot;hyphen&quot; \\| &quot;underscore&quot; \\| &quot;middleDot&quot;; position: number; }[]; } \\| { data: string; height: number; imageType: &quot;png&quot; \\| &quot;jpg&quot; \\| &quot;gif&quot; \\| &quot;bmp&quot; \\| &quot;svg&quot;; type: &quot;image&quot;; width: number; altText?: string; fallback?: { data: string; imageType: &quot;png&quot; \\| &quot;jpg&quot; \\| &quot;gif&quot; \\| &quot;bmp&quot;; }; } \\| { runs: { [x: string]: any; text: string; allCaps?: boolean; bold?: boolean; break?: number; doubleStrike?: boolean; endnote?: number; footnote?: number; highlight?: &quot;black&quot; \\| &quot;blue&quot; \\| &quot;cyan&quot; \\| &quot;darkBlue&quot; \\| &quot;darkCyan&quot; \\| &quot;darkGray&quot; \\| &quot;darkGreen&quot; \\| &quot;darkMagenta&quot; \\| &quot;darkRed&quot; \\| &quot;darkYellow&quot; \\| &quot;green&quot; \\| &quot;lightGray&quot; \\| &quot;magenta&quot; \\| &quot;none&quot; \\| &quot;red&quot; \\| &quot;white&quot; \\| &quot;yellow&quot;; italics?: boolean; language?: string; smallCaps?: boolean; strike?: boolean; subScript?: boolean; superScript?: boolean; type?: &quot;run&quot;; underline?: true \\| { [x: string]: any; type: &quot;none&quot; \\| &quot;single&quot; \\| &quot;words&quot; \\| &quot;double&quot; \\| &quot;thick&quot; \\| &quot;dotted&quot; \\| &quot;dottedHeavy&quot; \\| &quot;dash&quot; \\| &quot;dashedHeavy&quot; \\| &quot;dashLon