ly, streamed as .pptx. |\n| body | <code>{ layout: &quot;LAYOUT\\_16x9&quot; \\| &quot;LAYOUT\\_16x10&quot; \\| &quot;LAYOUT\\_4x3&quot; \\| &quot;LAYOUT\\_WIDE&quot;; slides: { elements: ({ h: number; w: number; x: number; y: number; chartType: &quot;line&quot; \\| &quot;bar&quot; \\| &quot;pie&quot; \\| &quot;bar3d&quot; \\| &quot;doughnut&quot; \\| &quot;area&quot; \\| &quot;scatter&quot; \\| &quot;radar&quot;; series: { labels: string[]; values: number[]; name?: string; }[]; type: &quot;chart&quot;; chartColors?: any[]; showLegend?: boolean; showValue?: boolean; title?: string; } \\| { h: number; w: number; x: number; y: number; runs: { [x: string]: any; text: string; bold?: boolean; breakLine?: boolean; bullet?: boolean \\| { code?: string; }; fontFace?: string; fontSize?: number; hyperlink?: { slide?: number; url?: string; }; indentLevel?: number; italic?: boolean; lang?: string; strike?: boolean; subScript?: boolean; superScript?: boolean; underline?: boolean; }[]; type: &quot;text&quot;; align?: &quot;left&quot; \\| &quot;center&quot; \\| &quot;right&quot; \\| &quot;justify&quot;; bullet?: boolean \\| { code?: string; }; fill?: { [x: string]: any; }; fit?: &quot;none&quot; \\| &quot;resize&quot; \\| &quot;shrink&quot;; indentLevel?: number; line?: { [x: string]: any; width?: number; }; lineSpacing?: number; margin?: number; rotation?: number; rtl?: boolean; valign?: &quot;bottom&quot; \\| &quot;top&quot; \\| &quot;middle&quot;; } \\| { h: number; w: number; x: number; y: number; shape: &quot;wave&quot; \\| &quot;diagStripe&quot; \\| &quot;line&quot; \\| &quot;doubleWave&quot; \\| &quot;frame&quot; \\| &quot;rect&quot; \\| &quot;ellipse&quot; \\| &quot;accentBorderCallout1&quot; \\| &quot;accentBorderCallout2&quot; \\| &quot;accentBorderCallout3&quot; \\| &quot;accentCallout1&quot; \\| &quot;accentCallout2&quot; \\| &quot;accentCallout3&quot; \\| &quot;actionButtonBackPrevious&quot; \\| &quot;actionButtonBeginning&quot; \\| &quot;actionButtonBlank&quot; \\| &