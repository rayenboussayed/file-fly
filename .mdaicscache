rvice.ts:46"},"level":0},{"id":"readBody","longname":"readBody","name":"readBody","kind":"function","scope":"global","description":"Reads the uploaded workbook into memory, bounded by the scanner cap.\nThe scanner only opens the source when ClamAV is enabled, so the service must too.\nApplies the OOXML zip-bomb caps and a worksheet cell ceiling before SheetJS sees a byte.","params":[{"description":"Normalized request context (source stream accessors).","name":"cls","type":{"names":["NormalizedClsService"]}},{"description":"Reject archives whose worksheets carry more cells than this.","name":"maxCells","type":{"names":["number"]}}],"returns":[{"description":"The workbook bytes, capped.","type":{"names":["Promise<Buffer<ArrayBufferLike>>"]}}],"exceptions":[{"type":{"names":["UnsupportedMediaTypeException"]},"description":"For over-broad mimes or wrong signatures."},{"type":{"names":["BadRequestException"]},"description":"For zip structures exceeding the OOXML caps."},{"type":{"names":["PayloadTooLargeException"]},"description":"For archives with too many cells."}],"meta":{"lineno":89},"async":true,"order":4,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/xlsx.service.js:38","src":"packages/backend/src/resources/xlsx/xlsx.service.ts:67"},"level":0},{"id":"toBadRequest","longname":"toBadRequest","name":"toBadRequest","kind":"function","scope":"global","description":"Maps a SheetJS failure to a 400.","params":[{"description":"The error thrown by SheetJS.","name":"error","type":{"names":["unknown"]}}],"returns":[{"description":"A 400 exception carrying the message.","type":{"names":["BadRequestException"]}}],"meta":{"lineno":120},"order":5,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/xlsx.service.js:63","src":"packages/backend/src/resources/xlsx/xlsx.service.ts:101"},"level":0},{"id":"assertSafeCells","longname":"assertSafeCells","name":"assertSafeCells","kind":"function","scope":"global","description":"Walks every cell once and rejects unsafe formulas.",