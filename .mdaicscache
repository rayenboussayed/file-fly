job (with exit-code handling attached when running as a worker thread).  \nsrc: packages/backend/src/resources/image/worker/index.ts:39  \ndist: packages/backend/dist/resources/image/worker/index.js:24\n","symbols":2,"lastUsed":1795730467860},"tdata:packages/backend/src/resources/image/tesseract.service.ts":{"doclets":[{"id":"TesseractService","longname":"TesseractService","name":"TesseractService","kind":"member","scope":"global","description":"Bounded pool of tesseract.js workers for `/image/ocr`; terminated on shutdown.","params":[],"meta":{"lineno":61},"order":1,"mdaics":{"dist":"packages/backend/dist/resources/image/tesseract.service.js:16","src":"packages/backend/src/resources/image/tesseract.service.ts:43"},"level":0},{"id":"SINGLE_LANG_REGEX","longname":"SINGLE_LANG_REGEX","name":"SINGLE_LANG_REGEX","kind":"constant","scope":"global","description":"ISO 639-2 language code with an optional script suffix — tesseract's on-disk layout (`<code>.traineddata`).","params":[],"meta":{"lineno":47},"order":0,"mdaics":{"dist":"packages/backend/dist/resources/image/tesseract.service.js:15","src":"packages/backend/src/resources/image/tesseract.service.ts:20"},"level":0},{"id":"TesseractService#onModuleDestroy","longname":"TesseractService#onModuleDestroy","name":"onModuleDestroy","kind":"function","scope":"instance","description":"Terminates every worker on shutdown and wakes pending acquire() callers\nso they fail fast with 503 instead of waiting for a slot forever.","memberof":"TesseractService","params":[],"meta":{"lineno":98},"async":true,"order":2,"mdaics":{"dist":"packages/backend/dist/resources/image/tesseract.service.js:36","src":"packages/backend/src/resources/image/tesseract.service.ts:68"},"returns":[{"type":{"names":["Promise<void>"]}}],"level":0},{"id":"TesseractService#onModuleInit","longname":"TesseractService#onModuleInit","name":"onModuleInit","kind":"function","scope":"instance","description":"Prepares the cache directory and warms the configured preload languages.","memberof":"TesseractService","params":[],"meta":{"lineno":109},"async":true,"order":3,"mdaics":{"dist":"packages/backend/dist/resources/image/tesseract.service.js:44","src":"packages/backend/src/resources/image/tesseract.service.ts:79"},"returns":[{"type":{"names":["Promise<void>"]}}],"level":0},{"id":"TesseractService#recognize","longname":"TesseractService#recognize","name":"recognize","kind":"function","scope":"instance","description":"Recognizes text in the given image buffer.","memberof":"TesseractService","params":[{"description":"Preprocessed (PNG) image bytes.","name":"buffer","type":{"names":["Buffer<ArrayBufferLike>"]}},{"description":"Language codes to use (already normalized).","name":"langs","type":{"names":["string[]"]}}],"returns":[{"description":"Text with a per-line breakdown, normalized languages, confidence and wall time.","type":{"names":["Promise<ImageOcrResult>"]}}],"meta":{"lineno":132},"async":true,"order":4,"mdaics":{"dist":"packages/backend/dist/resources/image/tesseract.service.js:60","src":"packages/backend/src/resources/image/tesseract.service.ts:103"},"level":0},{"id":"TesseractService#retire","longname":"TesseractService#retire","name":"retire","kind":"function","scope":"instance","description":"Terminates a slot and removes it from the pool, then wakes one waiter.","memberof":"TesseractService","params":[{"description":"Pool slot whose worker is being retired.","name":"slot","type":{"names":["Slot"]}}],"meta":{"lineno":173},"async":true,"order":5,"mdaics":{"dist":"packages/backend/dist/resources/image/tesseract.service.js:95","src":"packages/backend/src/resources/image/tesseract.service.ts:149"},"returns":[{"type":{"names":["Promise<void>"]}}],"level":0}],"fp":"78e93f1d7275bbb3a91d86502c7d86e94e2910c1b7cdba4f1fce782b11c663a9","issues":[],"kind":"tdata","symbols":0,"lastUsed":1795730468155},"md:packages/backend/src/resources/image/tesseract.service.ts":{"fp":"d12af91aa6fd19ad7f85c9c21dbf7f89ace551e9006a0287cb355380d2a342f3","issues":[],"kind":"md","markdown":"## Members\n\n<dl>\n<dt><a href=\"#TesseractService\">TesseractService</a></dt>\n<dd><p>Bounded pool of tesseract.js workers for <code>/image/ocr</code>; terminated on shutdown.</p>\n</dd>\n</dl>\n\n## Constants\n\n<dl>\n<dt><a href=\"#SINGLE_LANG_REGEX\">SINGLE_LANG_REGEX</a></dt>\n<dd><p>ISO 639-2 language code with an optional script suffix — tesseract&#39;s on-disk layout (<code>&lt;code&gt;.traineddata</code>).</p>\n</dd>\n</dl>\n\n<a name=\"TesseractService\"></a>\n\n## TesseractService\nBounded pool of tesseract.js workers for `/image/ocr`; terminated on shutdown.\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/image/tesseract.service.ts:43  \ndist: packages/backend/dist/resources/image/tesseract.service.js:16\n\n* [TesseractService](#TesseractService)\n    * [.onModuleDestroy()](#TesseractService+onModuleDestroy) ⇒ <code>Promise&lt;void&gt;</code>\n    * [.onModuleInit()](#TesseractService+onModuleInit) ⇒ <code>Promise&lt;void&gt;</code>\n    * [.recognize(buffer, langs)](#TesseractService+recognize) ⇒ <code>Promise&lt;ImageOcrResult&gt;</code>\n    * [.retire(slot)](#TesseractService+retire) ⇒ <code>Promise&lt;void&gt;</code>\n\n<a name=\"TesseractService+onModuleDestroy\"></a>\n\n### tesseractService.onModuleDestroy() ⇒ <code>Promise&lt;void&gt;</code>\nTerminates every worker on shutdown and wakes pending acquire() callers\nso they fail fast with 503 instead of waiting for a slot forever.\n\n**Kind**: instance method of [<code>TesseractService</code>](#TesseractService)  \nsrc: packages/backend/src/resources/image/tesseract.service.ts:68  \ndist: packages/backend/dist/resources/image/tesseract.service.js:36\n<a name=\"TesseractService+onModuleInit\"></a>\n\n### tesseractService.onModuleInit() ⇒ <code>Promise&lt;void&gt;</code>\nPrepares the cache directory and warms the configured preload languages.\n\n**Kind**: instance method of [<code>TesseractService</code>](#TesseractService)  \nsrc: packages/backend/src/resources/image/tesseract.service.ts:79  \ndist: packages/backend/dist/resources/image/tesseract.service.js:44\n<a name=\"TesseractService+recognize\"></a>\n\n### tesseractService.recognize(buffer, langs) ⇒ <code>Promise&lt;ImageOcrResult&gt;</code>\nRecognizes text in the given image buffer.\n\n**Kind**: instance method of [<code>TesseractService</code>](#TesseractService)  \n**Returns**: <code>Promise&lt;ImageOcrResult&gt;</code> - Text with a per-line breakdown, normalized languages, confidence and wall time.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| buffer | <code>Buffer&lt;ArrayBufferLike&gt;</code> | Preprocessed (PNG) image bytes. |\n| langs | <code>string[]</code> | Language codes to use (already normalized). |\n\nsrc: packages/backend/src/resources/image/tesseract.service.ts:103  \ndist: packages/backend/dist/resources/image/tesseract.service.js:60\n<a name=\"TesseractService+retire\"></a>\n\n### tesseractService.retire(slot) ⇒ <code>Promise&lt;void&gt;</code>\nTerminates a slot and removes it from the pool, then wakes one waiter.\n\n**Kind**: instance method of [<code>TesseractService</code>](#TesseractService)  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| slot | <code>Slot</code> | Pool slot whose worker is being retired. |\n\nsrc: packages/backend/src/resources/image/tesseract.service.ts:149  \ndist: packages/backend/dist/resources/image/tesseract.service.js:95\n<a name=\"SINGLE_LANG_REGEX\"></a>\n\n## SINGLE\\_LANG\\_REGEX\nISO 639-2 language code with an optional script suffix — tesseract's on-disk layout (`<code>.traineddata`).\n\n**Kind**: global constant  \nsrc: packages/backend/src/resources/image/tesseract.service.ts:20  \ndist: packages/backend/dist/resources/image/tesseract.service.js:15\n","symbols":6,"lastUsed":1795730468258},"tdata:packages/backend/src/resources/image/worker/inspect.ts":{"doclets":[{"id":"Discard","longname":"Discard","name":"Discard","kind":"class","scope":"global","description":"A Writable that discards everything written to it, used to consume an image\nstream while sharp gathers metadata/stats (so the image bytes never reach stdout).","meta":{"lineno":8},"order":0,"mdaics":{"dist":"packages/backend/dist/resources/image/worker/inspect.js:4","src":"packages/backend/src/resources/image/worker/inspect.ts:9"},"level":0},{"id":"metadata","longname":"metadata","name":"metadata","kind":"function","scope":"global","description":"Reads image metadata from stdin via sharp and writes it as JSON to stdout.","meta":{"lineno":16},"order":1,"mdaics":{"dist":"packages/backend/dist/resources/image/worker/inspect.js:9","src":"packages/backend/src/resources/image/worker/inspect.ts:18"},"returns":[{"type":{"names":["Promise<void>"]}}],"level":0},{"id":"stats","longname":"stats","name":"stats","kind":"function","scope":"global","description":"Reads image statistics from stdin via sharp and writes them as JSON to stdout.","meta":{"lineno":28},"order":2,"mdaics":{"dist":"packages/backend/dist/resources/image/worker/inspect.js:18","src":"packages/backend/src/resources/image/worker/inspect.ts:33"},"returns":[{"type":{"names":["Promise<void>"]}}],"level":0}],"fp":"9af2930d8cb16cfd24ab5f76f87ac78d3d6859f96e3e3139d0188c33c1230482","issues":[],"kind":"tdata","lastUsed":1795730467868,"symbols":0},"md:packages/backend/src/resources/image/worker/inspect.ts":{"fp":"514a19e0b86d2d43ef92fadba08140ce34eef81aef41e4bae412a770cc6053d0","issues":[],"kind":"md","markdown":"## Classes\n\n<dl>\n<dt><a href=\"#Discard\">Discard</a></dt>\n<dd><p>A Writable that discards everything written to it, used to consume an image\nstream while sharp gathers metadata/stats (so the image bytes never reach stdout).</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#metadata\">metadata()</a> ⇒ <code>Promise&lt;void&gt;</code></dt>\n<dd><p>Reads image metadata from stdin via sharp and writes it as JSON to stdout.</p>\n</dd>\n<dt><a href=\"#stats\">stats()</a> ⇒ <code>Promise&lt;void&gt;</code></dt>\n<dd><p>Reads image statistics from stdin via sharp and writes them as JSON to stdout.</p>\n</dd>\n</dl>\n\n<a name=\"Discard\"></a>\n\n## Discard\nA Writable that discards everything written to it, used to consume an image\nstream while sharp gathers metadata/stats (so the image bytes never reach stdout).\n\n**Kind**: global class  \nsrc: packages/backend/src/resources/image/worker/inspect.ts:9  \ndist: packages/backend/dist/resources/image/worker/inspect.js:4\n<a name=\"metadata\"></a>\n\n## metadata() ⇒ <code>Promise&lt;void&gt;</code>\nReads image metadata from stdin via sharp and writes it as JSON to stdout.\n\n**Kind**: global function  \nsrc: packages/backend/src/resources/image/worker/inspect.ts:18  \ndist: packages/backend/dist/resources/image/worker/inspect.js:9\n<a name=\"stats\"></a>\n\n## stats() ⇒ <code>Promise&lt;void&gt;</code>\nReads image statistics from stdin via sharp and writes them as JSON to stdout.\n\n**Kind**: global function  \nsrc: packages/backend/src/resources/image/worker/inspect.ts:33  \ndist: packages/backend/dist/resources/image/worker/inspect.js:18\n","symbols":3,"lastUsed":1795730467899},"tdata:packages/backend/src/resources/image/worker/processor.spec.ts":{"doclets":[],"fp":"4d51819e79e354f96a2b67c8025c6620999359f3710a59af954d1a18bd8d59d5","issues":[],"kind":"tdata","lastUsed":1795730467909,"symbols":0},"md:packages/backend/src/resources/image/worker/processor.spec.ts":{"fp":"f5f826a6fe4c5a8ed452ea0e9dc56c6b50c7d80e9ea049112cca037cf2778c47","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795730467909},"tdata:packages/backend/src/resources/image/worker/processor.ts":{"doclets":[],"fp":"e0d634165457496cde7115c5afc292a3051bbd4f08a97046a08942b4ec372271","issues":[],"kind":"tdata","lastUsed":1795730467923,"symbols":0},"md:packages/backend/src/resources/image/worker/processor.ts":{"fp":"8fc2f64fa717bc0ae5857a44d24e10b678b83935c8c6d1a7b557f0e763b1ae6e","