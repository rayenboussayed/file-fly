 \"teardrop\" | \"trapezoid\" | \"triangle\" | \"upArrow\" | \"upArrowCallout\" | \"upDownArrow\" | \"upDownArrowCallout\" | \"uturnArrow\" | \"verticalScroll\" | \"wedgeEllipseCallout\" | \"wedgeRectCallout\" | \"wedgeRoundRectCallout\"; type: \"shape\"; fill?: { [x: string]: any; }; line?: { [x: string]: any; width?: number; }; rotation?: number; text?: { [x: string]: any; text: string; bold?: boolean; breakLine?: boolean; bullet?: boolean | { code?: string; }; fontFace?: string; fontSize?: number; hyperlink?: { slide?: number; url?: string; }; indentLevel?: number; italic?: boolean; lang?: string; strike?: boolean; subScript?: boolean; superScript?: boolean; underline?: boolean; }[]; } | { h: number; w: number; x: number; y: number; rows: { text: string; colSpan?: number; fill?: { [x: string]: any; }; options?: { colspan?: number; fill?: { [x: string]: any; }; margin?: number; rowspan?: number; valign?: \"bottom\" | \"top\" | \"middle\"; }; rowSpan?: number; }[][]; type: \"table\"; margin?: number; } | { h: number; w: number; x: number; y: number; data: string; imageType: \"png\" | \"jpg\" | \"gif\" | \"bmp\"; type: \"image\"; altText?: string; sizing?: { h: number; type: \"contain\" | \"cover\" | \"crop\"; w: number; }; transparency?: number; })[]; background?: { [x: string]: any; }; notes?: string; }[]; metadata?: { author?: string; company?: string; revision?: string; subject?: string; title?: string; }; theme?: { bodyFontFace?: string; headFontFace?: string; }; }"]}}],"returns":[{"description":"The .pptx bytes.","type":{"names":["Promise<Buffer<ArrayBufferLike>>"]}}],"meta":{"lineno":298},"async":true,"order":8,"mdaics":{"dist":"packages/backend/dist/resources/pptx/pptx.service.js:214","src":"packages/backend/src/resources/pptx/pptx.service.ts:264"},"level":0},{"id":"PptxService#extract","longname":"PptxService#extract","name":"extract","kind":"function","scope":"instance","description":"Extracts text and structure from an uploaded .pptx.","memberof":"PptxService","params":[],"returns":[{"description":"The parsed metadata, slide texts, notes and full body text.","type":{"names":["Promise<{ format: string; metadata: any; structure: { notes: string[]; slides: { index: number; part: string; texts: any[]; }[]; text: string; }; }>"]}}],"meta":{"lineno":322},"async":true,"order":9,"mdaics":{"dist":"packages/backend/dist/resources/pptx/pptx.service.js:233","src":"packages/backend/src/resources/pptx/pptx.service.ts:288"},"level":0},{"id":"PptxService#metadata","longname":"PptxService#metadata","name":"metadata","kind":"function","scope":"instance","description":"Normalized OOXML metadata for an uploaded .pptx.","memberof":"PptxService","params":[],"returns":[{"description":"Format plus the parsed properties.","type":{"names":["Promise<any>"]}}],"meta":{"lineno":342},"async":true,"order":10,"mdaics":{"dist":"packages/backend/dist/resources/pptx/pptx.service.js:249","src":"packages/backend/src/resources/pptx/pptx.service.ts:309"},"level":0}],"fp":"473dab585c7a723231dbfb0b2d76f78f6ba6a27c97aff62ae305a589439a2cf3","issues":[],"kind":"tdata","lastUsed":1795730468998,"symbols":0},"md:packages/backend/src/resources/pptx/pptxgenjs.ts":{"fp":"9b2efd76c427b13f0cb2e26d0649ffbfd7f290231ed2a00cddebc5687d95135a","issues":[],"kind":"md","markdown":"<a name=\"PptxGenJs\"></a>\n\n## PptxGenJs\nThe pptxgenjs class. Its UMD types do not interop with nodenext ESM, so we\nkeep a narrow structural interface; the runtime default export is the class.\n\n**Kind**: global constant  \nsrc: packages/backend/src/resources/pptx/pptxgenjs.ts:177  \ndist: packages/backend/dist/resources/pptx/pptxgenjs.js:2\n","symbols":1,"lastUsed":1795730469147},"md:packages/backend/src/resources/pptx/pptx.service.ts":{"fp":"cb80f70d6713a2d7cdbbbf99f37dd72732bacd8dcba959f5a15b24a03f525c87","issues":[],"kind":"md","markdown":"## Members\n\n<dl>\n<dt><a href=\"#PptxService\">PptxService</a></dt>\n<dd><p>PPTX feature service: builds decks and parses/metadata-inspects uploads.</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#readPartsCapped\">readPartsCapped(buffer, limits)</a> ⇒</dt>\n<dd><p>Maps the shared OOXML reader&#39;s cap violations to HTTP errors (413 for size, 400 otherwise).</p>\n</dd>\n<dt><a href=\"#assertHyperlinkScheme\">assertHyperlinkScheme(record)</a></dt>\n<dd><p>Validates the run-level hyperlink allowlist.</p>\n</dd>\n<dt><a href=\"#assertBuildPayload\">assertBuildPayload(body)</a></dt>\n<dd><p>Rejects payloads whose serialized size or element count could exhaust memory.</p>\n</dd>\n<dt><a href=\"#readBody\">readBody(cls)</a> ⇒ <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code></dt>\n<dd><p>Opens the uploaded body, bounded by the scanner cap.</p>\n</dd>\n<dt><a href=\"#assertPptxSignature\">assertPptxSignature(buffer)</a> ⇒ <code>Promise&lt;void&gt;</code></dt>\n<dd><p>Signature must be the plain pptx mime; closes the renamed-image and .potm/.pptm holes.</p>\n</dd>\n<dt><a href=\"#extractPptx\">extractPptx(parts)</a> ⇒ <code>{ slides: { index: number; part: string; texts: any[]; }[]; }</code></dt>\n<dd><p>Extracts every slide&#39;s shape text, in presentation order.</p>\n</dd>\n<dt><a href=\"#collectNotes\">collectNotes(parts)</a> ⇒ <code>string[]</code></dt>\n<dd><p>Notes text per notes slide, sorted by the numeric suffix. The slide-number\nplaceholder shape (<code>ph type=&quot;sldNum&quot;</code>) is excluded, so cached slide numbers\ndo not leak into the notes.</p>\n</dd>\n</dl>\n\n<a name=\"PptxService\"></a>\n\n## PptxService\nPPTX feature service: builds decks and parses/metadata-inspects uploads.\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/pptx/pptx.service.ts:252  \ndist: packages/backend/dist/resources/pptx/pptx.service.js:207\n\n* [PptxService](#PptxService)\n    * [.build(body)](#PptxService+build) ⇒ <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code>\n    * [.extract()](#PptxService+extract) ⇒ <code>Promise&lt;{ format: string; metadata: any; structure: { notes: string[]; slides: { index: number; part: string; texts: any[]; }[]; text: string; }; }&gt;</code>\n    * [.metadata()](#PptxService+metadata) ⇒ <code>Promise&lt;any&gt;</code>\n\n<a name=\"PptxService+build\"></a>\n\n### pptxService.build(body) ⇒ <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code>\nBuilds a .pptx from the payload in a worker thread and returns the bytes.\nBuffers before returning so a worker failure answers 500, never a truncated 201.\n\n**Kind**: instance method of [<code>PptxService</code>](#PptxService)  \n**Returns**: <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code> - The .pptx bytes.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| body | <code>{ layout: &quot;LAYOUT\\_16x9&quot; \\| &quot;LAYOUT\\_16x10&quot; \\| &quot;LAYOUT\\_4x3&quot; \\| &quot;LAYOUT\\_WIDE&quot;; slides: { elements: ({ h: number; w: number; x: number; y: number; chartType: &quot;line&quot; \\| &quot;bar&quot; \\| &quot;pie&quot; \\| &quot;bar3d&quot; \\| &quot;doughnut&quot; \\| &quot;area&quot; \\| &quot;scatter&quot; \\| &quot;radar&quot;; series: { labels: string[]; values: number[]; name?: string; }[]; type: &quot;chart&quot;; chartColors?: any[]; showLegend?: boolean; showValue?: boolean; title?: string; } \\| { h: number; w: number; x: number; y: number; runs: { [x: string]: any; text: string; bold?: boolean; breakLine?: boolean; bullet?: boolean \\| { code?: string; }; fontFace?: string; fontSize?: number; hyperlink?: { slide?: number; url?: string; }; indentLevel?: number; italic?: boolean; lang?: string; strike?: boolean; subScript?: boolean; superScript?: boolean; underline?: boolean; }[]; type: &quot;text&quot;; align?: &quot;left&quot; \\| &quot;center&quot; \\| &quot;right&quot; \\| &quot;justify&quot;; bullet?: boolean \\| { code?: string; }; fill?: { [x: string]: any; }; fit?: &quot;none&quot; \\| &quot;resize&quot; \\| &quot;shrink&quot;; indentLevel?: number; line?: { [x: string]: any; width?: number; }; lineSpacing?: number; margin?: number; rotation?: number; rtl?: boolean; valign?: &quot;bottom&quot; \\| &quot;top&quot; \\| &quot;middle&quot;; } \\| { h: number; w: number; x: number; y: number; shape: &quot;wave&quot; \\| &quot;diagStripe&quot; \\| &quot;line&quot; \\| &quot;doubleWave&quot; \\| &quot;frame&quot; \\| &quot;rect&quot; \\| &quot;ellipse&quot; \\| &quot;accentBorderCallout1&quot; \\| &quot;accentBorderCallout2&quot; \\| &quot;accentBorderCallout3&quot; \\| &quot;accentCallout1&quot; \\| &quot;accentCallout2&quot; \\| &quot;accentCallout3&quot; \\| &quot;actionButtonBackPrevious&quot; \\| &quot;actionButtonBeginning&quot; \\| &quot;actionButtonBlank&quot; \\| &quot;actionButtonDocument&quot; \\| &quot;actionButtonEnd&quot; \\| &quot;actionButtonForwardNext&quot; \\| &quot;actionButtonHelp&quot; \\| &quot;actionButtonHome&quot; \\| &quot;actionButtonInformation&quot; \\| &quot;actionButtonMovie&quot; \\| &quot;actionButtonReturn&quot; \\| &quot;actionButtonSound&quot; \\| &quot;arc&quot; \\| &quot;bentArrow&quot; \\| &quot;bentUpArrow&quot; \\| &quot;bevel&quot; \\| &quot;blockArc&quot; \\| &quot;borderCallout1&quot; \\| &quot;borderCallout2&quot; \\| &quot;borderCallout3&quot; \\| &quot;bracePair&quot; \\| &quot;bracketPair&quot; \\| &quot;callout1&quot; \\| &quot;callout2&quot; \\| &quot;callout3&quot; \\| &quot;can&quot; \\| &quot;chartPlus&quot; \\| &quot;chartStar&quot; \\| &quot;chartX&quot; \\| &quot;chevron&quot; \\| &quot;chord&quot; \\| &quot;circularArrow&quot; \\| &quot;cloud&quot; \\| &quot;cloudCallout&quot; \\| &quot;corner&quot; \\| &quot;cornerTabs&quot; \\| &quot;cube&quot; \\| &quot;curvedDownArrow&quot; \\| &quot;curvedLeftArrow&quot; \\| &quot;curvedRightArrow&quot; \\| &quot;curvedUpArrow&quot; \\| &quot;custGeom&quot; \\| &quot;decagon&quot; \\| &quot;diamond&quot; \\| &quot;dodecagon&quot; \\| &quot;donut&quot; \\| &quot;downArrow&quot; \\| &quot;downArrowCallout&quot; \\| &quot;ellipseRibbon&quot; \\| &quot;ellipseRibbon2&quot; \\| &quot;flowChartAl