},"level":0},{"id":"METRICS_DIR","longname":"METRICS_DIR","name":"METRICS_DIR","kind":"member","scope":"global","description":"Directory holding `metrics.db`; created at startup. Kept out of `CACHE_DIR` on purpose.","meta":{"lineno":116},"order":23,"mdaics":{"dist":"packages/backend/dist/environment.js:39","src":"packages/backend/src/environment.ts:139"},"level":0},{"id":"METRICS_FLUSH_INTERVAL_MS","longname":"METRICS_FLUSH_INTERVAL_MS","name":"METRICS_FLUSH_INTERVAL_MS","kind":"member","scope":"global","description":"Flush interval for the in-memory metric deltas; invalid values fall back to 1s (0 is not accepted here).","meta":{"lineno":120},"order":24,"mdaics":{"dist":"packages/backend/dist/environment.js:40","src":"packages/backend/src/environment.ts:143"},"level":0},{"id":"METRICS_RETENTION_DAYS","longname":"METRICS_RETENTION_DAYS","name":"METRICS_RETENTION_DAYS","kind":"member","scope":"global","description":"Retention for the metrics tables; invalid values fall back to 35 days.","meta":{"lineno":124},"order":25,"mdaics":{"dist":"packages/backend/dist/environment.js:41","src":"packages/backend/src/environment.ts:147"},"level":0},{"id":"METRICS_TOKEN","longname":"METRICS_TOKEN","name":"METRICS_TOKEN","kind":"member","scope":"global","description":"Bearer token for `GET /metrics`; production refuses requests without it. Unset in development = open.","meta":{"lineno":128},"order":26,"mdaics":{"dist":"packages/backend/dist/environment.js:42","src":"packages/backend/src/environment.ts:151"},"level":0},{"id":"OTEL_METRICS_PORT","longname":"OTEL_METRICS_PORT","name":"OTEL_METRICS_PORT","kind":"member","scope":"global","description":"Port the Prometheus host-metrics exporter serves on (9464 is the conventional Prometheus exposition port; 8888 is the reference example's port and often already taken).","meta":{"lineno":133},"order":27,"mdaics":{"dist":"packages/backend/dist/environment.js:44","src":"packages/backend/src/environment.ts:158"},"level":0},{"id":"OTEL_TRACE_EXPORTER_URL","longname":"OTEL_TRACE_EXPORTER_URL","name":"OTEL_TRACE_EXPORTER_URL","kind":"member","scope":"global","description":"OTLP/HTTP traces endpoint for OpenTelemetry (`/v1/traces` appended when only the base is given). Blank/unset ⇒ tracing disabled. The standard `OTEL_EXPORTER_OTLP_TRACES_ENDPOINT` is also honored.","meta":{"lineno":137},"order":28,"mdaics":{"dist":"packages/backend/dist/environment.js:45","src":"packages/backend/src/environment.ts:162"},"level":0},{"id":"TESSERACT_DIR","longname":"TESSERACT_DIR","name":"TESSERACT_DIR","kind":"member","scope":"global","description":"Language data for tesseract.js; defaults to `<CACHE_DIR>/tesseract`.","meta":{"lineno":141},"order":29,"mdaics":{"dist":"packages/backend/dist/environment.js:46","src":"packages/backend/src/environment.ts:171"},"level":0},{"id":"TRUST_PROXY","longname":"TRUST_PROXY","name":"TRUST_PROXY","kind":"member","scope":"global","description":"Honor `X-Forwarded-For` for `request.ip` (set only behind a trusted proxy).","meta":{"lineno":149},"order":30,"mdaics":{"dist":"packages/backend/dist/environment.js:51","src":"packages/backend/src/environment.ts:179"},"level":0},{"id":"zCatch","longname":"zCatch","name":"zCatch","kind":"constant","scope":"global","description":"Alias avoiding unicorn/prefer-await on zod's `.catch()` (a non-promise method).","params":[],"meta":{"lineno":6},"order":0,"mdaics":{"dist":"packages/backend/dist/environment.js:3","src":"packages/backend/src/environment.ts:7"},"level":0},{"id":"DEFAULT_CACHE_DIR","longname":"DEFAULT_CACHE_DIR","name":"DEFAULT_CACHE_DIR","kind":"constant","scope":"global","description":"Absolute default cache root, used when `CACHE_DIR` is unset or blank.","params":[],"meta":{"lineno":10},"order":1,"mdaics":{"dist":"packages/backend/dist/environment.js:4","src":"packages/backend/src/environment.ts:12"},"level":0},{"id":"DEFAULT_METRICS_DIR","longname":"DEFAULT_METRICS_DIR","name":"DEFAULT_METRICS_DIR","kind":"constant","scope":"global","description":"Absolute default metrics root, used when `METRICS_DIR` is unset or blank.","params":[],"meta":{"lineno":14},"order":2,"mdaics":{"dist":"packages/backend/dist/environment.js:5","src":"packages/backend/src/environment.ts:16"},"level":0},{"id":"DEFAULT_DASHBOARD_DIR","longname":"DEFAULT_DASHBOARD_DIR","name":"DEFAULT_DASHBOARD_DIR","kind":"constant","scope":"global","description":"Default static root for the dashboard build output, used when `DASHBOARD_DIR` is unset or blank.","params":[],"meta":{"lineno":18},"order":3,"mdaics":{"dist":"packages/backend/dist/environment.js:6","src":"packages/backend/src/environment.ts:20"},"level":0},{"id":"trimmedString","longname":"trimmedString","name":"trimmedString","kind":"constant","scope":"global","description":"Whitespace-trimmed string used as the base of the comma-separated list schemas.","params":[],"meta":{"lineno":31},"order":5,"mdaics":{"dist":"packages/backend/dist/environment.js:8","src":"packages/backend/src/environment.ts:40"},"level":0},{"id":"egressHost","longname":"egressHost","name":"egressHost","kind":"constant","scope":"global","description":"One `EGRESS_ALLOWLIST` host entry, kept separate to limit call nesting.","params":[],"meta":{"lineno":35},"order":6,"mdaics":{"dist":"packages/backend/dist/environment.js:9","src":"packages/backend/src/environment.ts:44"},"level":0},{"id":"corsOrigin","longname":"corsOrigin","name":"corsOrigin","kind":"constant","scope":"global","description":"One `CORS_ORIGIN` URL entry, kept separate to limit call nesting.","params":[],"meta":{"lineno":39},"order":7,"mdaics":{"dist":"packages/backend/dist/environment.js:10","src":"packages/backend/src/environment.ts:48"},"level":0},{"id":"environment","longname":"environment","name":"environment","kind":"constant","scope":"global","description":"Validated process environment; parsed once at import time (fail-fast on invalid values).","meta":{"lineno":170},"order":31,"mdaics":{"dist":"packages/backend/dist/environment.js:68","src":"packages/backend/src/environment.ts:203"},"level":0},{"id":"isProduction","longname":"isProduction","name":"isProduction","kind":"constant","scope":"global","description":"True when `NODE_ENV=production`.","meta":{"lineno":174},"order":32,"mdaics":{"dist":"packages/backend/dist/environment.js:69","src":"packages/backend/src/environment.ts:208"},"level":0},{"id":"numericFromEnvironment","longname":"numericFromEnvironment","name":"numericFromEnvironment","kind":"function","scope":"global","description":"Numeric env var handling:\n- blank strings (whitespace included) are treated as unset, matching `process.env.X || fallback` ergonomics\n  (`Number('') === 0` would otherwise silently pass),\n- non-numeric and non-positive values fall back instead of throwing.","params":[{"description":"Value used when the env var is unset, blank or invalid.","name":"fallback","type":{"names":["number"]}}],"returns":[{"description":"Zod schema coercing to a positive integer with the fallback applied.","type":{"names":["z.ZodPreprocess<z.ZodCatch<z.ZodCoercedNumber<unknown>>, unknown>"]}}],"meta":{"lineno":27},"order":4,"mdaics":{"dist":"packages/backend/dist/environment.js:7","src":"packages/backend/src/environment.ts:30"},"level":0}],"fp":"dfef5d5449b69a467bd8078b066dabc9670af6ce2e016d49edb9050693e4df32","issues":[],"kind":"tdata","lastUsed":1795730447782,"symbols":0},"md:packages/backend/src/environment.ts":{"fp":"14cf6fa6a527bfdd476a3c97ce7ece6126ce7368011cca426737596f5de0d7d0","issues":[],"kind":"md","markdown":"## Members\n\n<dl>\n<dt><a href=\"#AUTH_PASSWORD\">AUTH_PASSWORD</a></dt>\n<dd><p>Basic-auth credentials; enforced only when BOTH are set (both-or-neither).</p>\n</dd>\n<dt><a href=\"#AUTH_USERNAME\">AUTH_USERNAME</a></dt>\n<dd><p>Basic-auth credentials; enforced only when BOTH are set (both-or-neither).</p>\n</dd>\n<dt><a href=\"#CACHE_DIR\">CACHE_DIR</a></dt>\n<dd><p>Cache root; the directory is created at startup.</p>\n</dd>\n<dt><a href=\"#CACHE_MAX_BYTES\">CACHE_MAX_BYTES</a></dt>\n<dd><p>Soft cap for the whole cache dir; oldest-used entries are evicted first.</p>\n</dd>\n<dt><a href=\"#CACHE_SWEEP_INTERVAL_MS\">CACHE_SWEEP_INTERVAL_MS</a></dt>\n<dd><p>How often the cache janitor sweeps.</p>\n</dd>\n<dt><a href=\"#CACHE_TMP_MAX_AGE_MS\">CACHE_TMP_MAX_AGE_MS</a></dt>\n<dd><p>Orphaned *.tmp files (crashed writers) older than this are removed.</p>\n</dd>\n<dt><a href=\"#CACHE_TTL_MS\">CACHE_TTL_MS</a></dt>\n<dd><p>Entries not used for this long are evicted.</p>\n</dd>\n<dt><a href=\"#CLAMAV_HOST\">CLAMAV_HOST</a></dt>\n<dd><p>Host of the clamd daemon; unset = virus scanning skipped with a warning.</p>\n</dd>\n<dt><a href=\"#CLAMAV_MAX_BYTES\">CLAMAV_MAX_BYTES</a></dt>\n<dd><p>Bodies larger than this are rejected 413 before scanning so clamd&#39;s INSTREAM size limit is never hit; raise together with clamd.conf StreamMaxLength.</p>\n</dd>\n<dt><a href=\"#CLAMAV_PORT\">CLAMAV_PORT</a></dt>\n<dd><p>Port of the clamd daemon; must be set together with CLAMAV_HOST.</p>\n</dd>\n<dt><a href=\"#CLAMAV_TIMEOUT_MS\">CLAMAV_TIMEOUT_MS</a></dt>\n<dd><p>Clamd socket connect timeout passed to clamdscan.</p>\n</dd>\n<dt><a href=\"#CORS_ORIGIN\">CORS_ORIGIN</a></dt>\n<dd><p>Allowed origins in production; comma-separated URLs (a bare string is accepted as a single origin).</p>\n</dd>\n<dt><a href=\"#DASHBOARD_DIR\">DASHBOARD_DIR</a></dt>\n<dd><p>Static root for the dashboard build (<code>packages/dashboard/dist</code>); missing dir = dashboard not served.</p>\n</dd>\n<dt><a href=\"#EGRESS_ALLOWLIST\">EGRESS_ALLOWLIST</a></dt>\n<dd><p>Comma-separated bare hostnames the <code>source=</code> media download may fetch (dotted suffixes allowed for subdomains); unset = only the built-in scheme and private-literal rules apply.</p>\n</dd>\n<dt><a href=\"#LOG_LEVEL\">LOG_LEVEL</a></dt>\n<dd><p>pino log level; unset (or blank) = <code>info</code> in production, <code>debug</code> otherwise. Invalid values are rejected at boot.</p>\n</dd>\n<dt><a href=\"#METRICS_DIR\">METRICS_DIR</a></dt>\n<dd><p>Directory holding <code>metrics.db</code>; created at startup. Kept out of <code>CACHE_DIR</code> on purpose.</p>\n</dd>\n<dt><a href=\"#METRICS_FLUSH_INTERVAL_MS\">METRICS_FLUSH_INTERVAL_MS</a></dt>\n<dd><p>Flush interval for the in-memory metric deltas; invalid values fall back to 1s (0 is not accepted here).</p>\n</dd>\n<dt><a href=\"#METRICS_RETENTION_DAYS\">METRICS_RETENTION_DAYS</a></dt>\n<dd><p>Retention for the metrics tables; invalid values fall back to 35 days.</p>\n</dd>\n<dt><a href=\"#METRICS_TOKEN\">METRICS_TOKEN</a></dt>\n<dd><p>Bearer token for <code>GET /metrics</code>; production refuses requests without it. Unset in development = open.</p>\n</dd>\n<dt><a href=\"#OTEL_METRICS_PORT\">OTEL_METRICS_PORT</a></dt>\n<dd><p>Port the Prometheus host-metrics exporter serves on (9464 is the conventional Prometheus exposition port; 8888 is the reference example&#39;s port and often already taken).</p>\n</dd>\n<dt><a href=\"#OTEL_TRACE_EXPORTER_URL\">OTEL_TRACE_EXPORTER_URL</a></dt>\n<dd><p>OTLP/HTTP traces endpoint for OpenTelemetry (<code>/v1/traces</code> appended when only the base is given). Blank/unset ⇒ tracing disabled. The standard <code>OTEL_EXPORTER_OTLP_TRACES_ENDPOINT</code> is also honored.</p>\n</dd>\n<dt><a href=\"#TESSERACT_DIR\">TESSERACT_DIR</a></dt>\n<dd><p>Language data for tesseract.js; defaults to <code>&lt;CACHE_DIR&gt;/tesseract</code>.</p>\n</dd>\n<dt><a href=\"#TRUST_PROXY\">TRUST_PROXY</a></dt>\n<dd><p>Honor <code>X-Forwarded-For</code> for <code>request.ip</code> (set only behind a trusted proxy).</p>\n</dd>\n</dl>\n\n## Constants\n\n<dl>\n<dt><a href=\"#zCatch\">zCatch</a></dt>\n<dd><p>Alias avoiding unicorn/prefer-await on zod&#39;s <code>.catch()</code> (a non-promise method).</p>\n</dd>\n<dt><a href=\"#DEFAULT_CACHE_DIR\">DEFAULT_CACHE_DIR</a></dt>\n<dd><p>Absolute default cache root, used when <code>CACHE_DIR</code> is unset or blank.</p>\n</dd>\n<dt><a href=\"#DEFAULT_METRICS_DIR\">DEFAULT_METRICS_DIR</a></dt>\n<dd><p>Absolute default metrics root, used when <code>METRICS_DIR</code> is unset or blank.</p>\n</dd>\n<dt><a href=\"#DEFAULT_DASHBOARD_DIR\">DEFAULT_DASHBOARD_DIR</a></dt>\n<dd><p>Default static root for the dashboard build output, used when <code>DASHBOARD_DIR</code> is unset or blank.</p>\n</dd>\n<dt><a href=\"#trimmedString\">trimmedString</a></dt>\n<dd><p>Whitespace-trimmed string used as the base of the comma-separated list schemas.</p>\n</dd>\n<dt><a href=\"#egressHost\">egressHost</a></dt>\n<dd><p>One <code>EGRESS_ALLOWLIST</code> host entry, kept separate to limit call nesting.</p>\n</dd>\n<dt><a href=\"#corsOrigin\">corsOrigin</a></dt>\n<dd><p>One <code>CORS_ORIGIN</code> URL entry, kept separate to limit call nesting.</p>\n</dd>\n<dt><a href=\"#environment\">environment</a></dt>\n<dd><p>Validated process environment; parsed once at import time (fail-fast on invalid values).</p>\n</dd>\n<dt><a href=\"#isProduction\">isProduction</a></dt>\n<dd><p>True when <code>NODE_ENV=production</code>.</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#numericFromEnvironment\">numericFromEnvironment(fallback)</a> ⇒ <code>z.ZodPreprocess&lt;z.ZodCatch&lt;z.ZodCoercedNumber&lt;unknown&gt;&gt;, unknown&gt;</code></dt>\n<dd><p>Numeric env var handling:</p>\n<ul>\n<li>blank strings (whitespace included) are treated as unset, matching <code>process.env.X || fallback</code> ergonomics\n(<code>Number(&#39;&#39;) === 0</code> would otherwise silently pass),</li>\n<li>non-numeric and non-positive values fall back instead of throwing.</li>\n</ul>\n</dd>\n</dl>\n\n<a name=\"AUTH_PASSWORD\"></a>\n\n## AUTH\\_PASSWORD\nBasic-auth credentials; enforced only when BOTH are set (both-or-neither).\n\n**Kind**: global variable  \nsrc: packages/backend/src/environment.ts:55  \ndist: packages/backend/dist/environment.js:13\n<a name=\"AUTH_USERNAME\"></a>\n\n## AUTH\\_USERNAME\nBasic-auth credentials; enforced only when BOTH are set (both-or-neither).\n\n**Kind**: global variable  \nsrc: packages/backend/src/environment.ts:59  \ndist: packages/backend/dist/environment.js:14\n<a name=\"CACHE_DIR\"></a>\n\n## CACHE\\_DIR\nCache root; the directory is created at startup.\n\n**Kind**: global variable  \nsrc: packages/backend/src/environment.ts:64  \ndist: packages/backend/dist/environment.js:15\n<a name=\"CACHE_MAX_BYTES\"></a>\n\n## CACHE\\_MAX\\_BYTES\nSoft cap for the whole cache dir; oldest-used entries are evicted first.\n\n**Kind**: global variable  \nsrc: packages/backend/src/environment.ts:68  \ndist: packages/backend/dist/environment.js:16\n<a name=\"CACHE_SWEEP_INTERVAL_MS\"></a>\n\n## CACHE\\_SWEEP\\_INTERVAL\\_MS\nHow often the cache janitor sweeps.\n\n**Kind**: global variable  \nsrc: packages/backend/src/environment.ts:72  \ndist: packages/backend/dist/environment.js:17\n<a name=\"CACHE_TMP_MAX_AGE_MS\"></a>\n\n## CACHE\\_TMP\\_MAX\\_AGE\\_MS\nOrphaned *.tmp files (crashed writers) older than this are removed.\n\n**Kind**: global variable  \nsrc: packages/backend/src/environment.ts:76  \ndist: packages/backend/dist/environment.js:18\n<a name=\"CACHE_TTL_MS\"></a>\n\n## CACHE\\_TTL\\_MS\nEntries not used for this long are evicted.\n\n**Kind**: global variable  \nsrc: packages/backend/src/environment.ts:81  \ndist: packages/backend/dist/environment.js:19\n<a name=\"CLAMAV_HOST\"></a>\n\n## CLAMAV\\_HOST\nHost of the clamd daemon; unset = virus scanning skipped with a warning.\n\n**Kind**: global variable  \nsrc: packages/backend/src/environment.ts:85  \ndist: packages/backend/dist/environment.js:20\n<a name=\"CLAMAV_MAX_BYTES\"></a>\n\n## CLAMAV\\_MAX\\_BYTES\nBodies larger than this are rejected 413 before scanning so clamd's INSTREAM size limit is never hit; raise together with clamd.conf StreamMaxLength.\n\n**Kind**: global variable  \nsrc: packages/backend/src/environment.ts:89  \ndist: packages/backend/dist/environment.js:21\n<a name=\"CLAMAV_PORT\"></a>\n\n## CLAMAV\\_PORT\nPort of the clamd daemon; must be set together with CLAMAV_HOST.\n\n**Kind**: global variable  \nsrc: packages/backend/src/environment.ts:93  \ndist: packages/backend/dist/environment.js:22\n<a name=\"CLAMAV_TIMEOUT_MS\"></a>\n\n## CLAMAV\\_TIMEOUT\\_MS\nClamd socket connect timeout passed to clamdscan.\n\n**Kind**: global variable  \nsrc: packages/backend/src/environment.ts:97  \ndist: packages/backend/dist/environment.js:23\n<a name=\"CORS_ORIGIN\"></a>\n\n## CORS\\_ORIGIN\nAllowed origins in production; comma-separated URLs (a bare string is accepted as a single origin).\n\n**Kind**: global variable  \nsrc: packages/backend/src/environment.ts:102  \ndist: packages/backend/dist/environment.js:24\n<a name=\"DASHBOARD_DIR\"></a>\n\n## DASHBOARD\\_DIR\nStatic root for the dashboard build (`packages/dashboard/dist`); missing dir = dashboard not served.\n\n**Kind**: global variable  \nsrc: packages/backend/src/environment.ts:114  \ndist: packages/backend/dist/environment.js:30\n<a name=\"EGRESS_ALLOWLIST\"></a>\n\n## EGRESS\\_ALLOWLIST\nComma-separated bare hostnames the `source=` media download may fetch (dotted suffixes allowed for subdomains); unset = only the built-in scheme and private-literal rules apply.\n\n**Kind**: global variable  \nsrc: packages/backend/src/environment.ts:118  \ndist: packages/backend/dist/environment.js:31\n<a name=\"LOG_LEVEL\"></a>\n\n## LOG\\_LEVEL\npino log level; unset (or blank) = `info` in production, `debug` otherwise. Invalid values are rejected at boot.\n\n**Kind**: global variable  \nsrc: packages/backend/src/environment.ts:131  \ndist: packages/backend/dist/environment.js:38\n<a name=\"METRICS_DIR\"></a>\n\n## METRICS\\_DIR\nDirectory holding `metrics.db`; created at startup. Kept out of `CACHE_DIR` on purpose.\n\n**Kind**: global variable  \nsrc: packages/backend/src/environment.ts:139  \ndist: packages/backend/dist/environment.js:39\n<a name=\"METRICS_FLUSH_INTERVAL_MS\"></a>\n\n## METRICS\\_FLUSH\\_INTERVAL\\_MS\nFlush interval for the in-memory metric deltas; invalid values fall back to 1s (0 is not accepted here).\n\n**Kind**: global variable  \nsrc: packages/backend/src/environment.ts:143  \ndist: packages/backend/dist/environment.js:40\n<a name=\"METRICS_RETENTION_DAYS\"></a>\n\n## METRICS\\_RETENTION\\_DAYS\nRetention for the metrics tables; invalid values fall back to 35 days.\n\n**Kind**: global variable  \nsrc: packages/backend/src/environment.ts:147  \ndist: packages/backend/dist/environment.js:41\n<a name=\"METRICS_TOKEN\"></a>\n\n## METRICS\\_TOKEN\nBearer token for `GET /metrics`; production refuses requests without it. Unset in development = open.\n\n**Kind**: global variable  \nsrc: packages/backend/src/environment.ts:151  \ndist: packages/backend/dist/environment.js:42\n<a name=\"OTEL_METRICS_PORT\"></a>\n\n## OTEL\\_METRICS\\_PORT\nPort the Prometheus host-metrics exporter serves on (9464 is the conventional Prometheus exposition port; 8888 is the reference example's port and often already taken).\n\n**Kind**: global variable  \nsrc: packages/backend/src/environment.ts:158  \ndist: packages/backend/dist/environment.js:44\n<a name=\"OTEL_TRACE_EXPORTER_URL\"></a>\n\n## OTEL\\_TRACE\\_EXPORTER\\_URL\nOTLP/HTTP traces endpoint for OpenTelemetry (`/v1/traces` appended when only the base is given). Blank/unset ⇒ tracing disabled. The standard `OTEL_EXPORTER_OTLP_TRACES_ENDPOINT` is also honored.\n\n**Kind**: global variable  \nsrc: packages/backend/src/environment.ts:162  \ndist: packages/backend/dist/environment.js:45\n<a name=\"TESSERACT_DIR\"></a>\n\n## TESSERACT\\_DIR\nLanguage data for tesseract.js; defaults to `<CACHE_DIR>/tesseract`.\n\n**Kind**: global variable  \nsrc: packages/backend/src/environment.ts:171  \ndist: packages/backend/dist/environment.js:46\n<a name=\"TRUST_PROXY\"></a>\n\n## TRUST\\_PROXY\nHonor `X-Forwarded-For` for `request.ip` (set only behind a trusted proxy).\n\n**Kind**: global variable  \nsrc: packages/backend/src/environment.ts:179  \ndist: packages/backend/dist/environment.js:51\n<a name=\"zCatch\"></a>\n\n## zCatch\nAlias avoiding unicorn/prefer-await on zod's `.catch()` (a non-promise method).\n\n**Kind**: global constant  \nsrc: packages/backend/src/environment.ts:7  \ndist: packages/backend/dist/environment.js:3\n<a name=\"DEFAULT_CACHE_DIR\"></a>\n\n## DEFAULT\\_CACHE\\_DIR\nAbsolute default cache root, used when `CACHE_DIR` is unset or blank.\n\n**Kind**: global constant  \nsrc: packages/backend/src/environment.ts:12  \ndist: packages/backend/dist/environment.js:4\n<a name=\"DEFAULT_METRICS_DIR\"></a>\n\n## DEFAULT\\_METRICS\\_DIR\nAbsolute default metrics root, used when `METRICS_DIR` is unset or blank.\n\n**Kind**: global constant  \nsrc: packages/backend/src/environment.ts:16  \ndist: packages/backend/dist/environment.js:5\n<a name=\"DEFAULT_DASHBOARD_DIR\"></a>\n\n## DEFAULT\\_DASHBOARD\\_DIR\nDefault static root for the dashboard build output, used when `DASHBOARD_DIR` is unset or blank.\n\n**Kind**: global constant  \nsrc: packages/backend/src/environment.ts:20  \ndist: packages/backend/dist/environment.js:6\n<a name=\"trimmedString\"></a>\n\n## trimmedString\nWhitespace-trimmed string used as the base of the comma-separated list schemas.\n\n**Kind**: global constant  \nsrc: packages/backend/src/environment.ts:40  \ndist: packages/backend/dist/environment.js:8\n<a name=\"egressHost\"></a>\n\n## egressHost\nOne `EGRESS_ALLOWLIST` host entry, kept separate to limit call nesting.\n\n**Kind**: global constant  \nsrc: packages/backend/src/environment.ts:44  \ndist: packages/backend/dist/environment.js:9\n<a name=\"corsOrigin\"></a>\n\n## corsOrigin\nOne `CORS_ORIGIN` URL entry, kept separate to limit call nesting.\n\n**Kind**: global constant  \nsrc: packages/backend/src/environment.ts:48  \ndist: packages/backend/dist/environment.js:10\n<a name=\"environment\"></a>\n\n## environment\nValidated process environment; parsed once at import time (fail-fast on invalid values).\n\n**Kind**: global constant  \nsrc: packages/backend/src/environment.ts:203  \ndist: packages/backend/dist/environment.js:68\n<a name=\"isProduction\"></a>\n\n## isProduction\nTrue when `NODE_ENV=production`.\n\n**Kind**: global constant  \nsrc: packages/backend/src/environment.ts:208  \ndist: packages/backend/dist/environment.js:69\n<a name=\"numericFromEnvironment\"></a>\n\n## numericFromEnvironment(fallback) ⇒ <code>z.ZodPreprocess&lt;z.ZodCatch&lt;z.ZodCoercedNumber&lt;unknown&gt;&gt;, unknown&gt;</code>\nNumeric env var handling:\n- blank strings (whitespace included) are treated as unset, matching `process.env.X || fallback` ergonomics\n  (`Number('') === 0` would otherwise silently pass),\n- non-numeric and non-positive values fall back instead of throwing.\n\n**Kind**: global function  \n**Returns**: <code>z.ZodPreprocess&lt;z.ZodCatch&lt;z.ZodCoercedNumber&lt;unknown&gt;&gt;, unknown&gt;</code> - Zod schema coercing to a positive integer with the fallback applied.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| fallback | <code>number</code> | Value used when the env var is unset, blank or invalid. |\n\nsrc: packages/backend/src/environment.ts:30  \ndist: packages/backend/dist/environment.js:7\n","symbols":33,"lastUsed":1795730447881},"tdata:packages/backend/src/environment.spec.ts":{"doclets":[],"fp":"95111b5da603df55088b4f2ee21028d798b0c87a6a47fc4e74ac66debf97ca19","issues":[],"kind":"tdata","lastUsed":1795730447723,"symbols":0},"md:packages/backend/src/environment.spec.ts":{"fp":"187fb4030278aab4ed9dc99ef7171b2d8e5ce9ab98ffe17ec4fa8ccef3f6da5a","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795730447723},"tdata:packages/backend/src/interceptors/file-parser.interceptor.spec.ts":{"doclets":[],"fp":"4ac7eccd3b809afc0f368e1968af82b95030769f5440bc36bfe61f9ed7655550","issues":[],"kind":"tdata","lastUsed":1795730447793,"symbols":0},"md:packages/backend/src/interceptors/file-parser.interceptor.spec.ts":{"fp":"9d2779374114a2f89c2ff68263973d187ef2580b8643229527111ff22645ac42","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795730447827},"tdata:packages/backend/src/interceptors/file-parser.interceptor.ts":{"doclets":[{"id":"FileParserInterceptor","longname":"FileParserInterceptor","name":"FileParserInterceptor","kind":"member","scope":"global","description":"Probes the upload’s file signature, stamps the CLS store (signature, hash, cache key) and publishes the probe.","params":[],"meta":{"lineno":89},"order":3,"mdaics":{"dist":"packages/backend/dist/interceptors/file-parser.interceptor.js:46","src":"packages/backend/src/interceptors/file-parser.interceptor.ts:77"},"level":0},{"id":"generateCacheKey","longname":"generateCacheKey","name":"generateCacheKey","kind":"function","scope":"global","description":"Hashes an arbitrary value into a deterministic, url/fs-safe cache key.","params":[{"description":"Value to hash (upload base key parts or download base key parts).","name":"options","type":{"names":["unknown"]}}],"returns":[{"description":"The cache key.","type":{"names":["string"]}}],"meta":{"lineno":50},"order":0,"mdaics":{"dist":"packages/backend/dist/interceptors/file-parser.interceptor.js:22","src":"packages/backend/src/interceptors/file-parser.interceptor.ts:27"},"level":0},{"id":"parseHeaderInteger","longname":"parseHeaderInteger","name":"parseHeaderInteger","kind":"function","scope":"global","description":"Parses a content-length header with explicit radix. Kept behind a parameter so\nparseInt semantics survive: `Number('42abc')` is NaN while\n`parseInt('42abc', 10)` is 42, and the cache key depends on that value.","params":[{"description":"Raw header value.","name":"value","type":{"names":["string"]}},{"description":"Numeric base, always 10 at the call site.","name":"radix","type":{"names":["number"]}}],"returns":[{"description":"The parsed integer.","type":{"names":["number"]}}],"meta":{"lineno":59},"order":1,"mdaics":{"dist":"packages/backend/dist/interceptors/file-parser.interceptor.js:23","src":"packages/backend/src/interceptors/file-parser.interceptor.ts:38"},"level":0},{"id":"buildCacheKey","longname":"buildCacheKey","name":"buildCacheKey","kind":"function","scope":"global","description":"Builds and stores the cache key for the scanned upload or download.","params":[{"description":"CLS facade carrying the request, signature and hash.","name":"cls","type":{"names":["NormalizedClsService"]}}],"meta":{"lineno":64},"async":true,"order":2,"mdaics":{"dist":"packages/backend/dist/interceptors/file-parser.interceptor.js:24","src":"packages/backend/src/interceptors/file-parser.interceptor.ts:45"},"returns":[{"type":{"names":["Promise<void>"]}}],"level":0},{"id":"prefixHash","longname":"prefixHash","name":"prefixHash","kind":"function","scope":"global","description":"Hashes the first `size` bytes of the stream (or all of it when smaller).\n\nThe branch is consumed with plain listeners, never an async iterator, so\nit is not destroyed at the end: the probe branch of the request's tee must\nstay intact for its sibling branch. Chunks beyond the prefix are discarded\nin the same pass. Resolves as soon as the prefix is hashed (or EOF is\nreached); the full remainder is dropped without resolving the caller.","params":[{"description":"The readable branch to hash (left intact).","name":"stream","type":{"names":["Readable"]}},{"description":"Maximum number of bytes to hash.","name":"size","type":{"names":["number"]}}],"returns":[{"description":"SHA-512 hex of the hashed prefix (or entire) bytes.","type":{"names":["Promise<string>"]}}],"meta":{"lineno":137},"async":true,"order":4,"mdaics":{"dist":"packages/backend/dist/interceptors/file-parser.interceptor.js:71","src":"packages/backend/src/interceptors/file-parser.interceptor.ts:111"},"level":0}],"fp":"cfb219b189380ff3050f441f74ba84b82df50dc65d7f80a099d84355c212511d","issues":[],"kind":"tdata","symbols":0,"lastUsed":1795730448195},"md:packages/backend/src/interceptors/file-parser.interceptor.ts":{"fp":"d06ded0d868116ae99c8010f939375fe14d34282938556e07bfeb4d837bfc4ae","issues":[],"kind":"md","markdown":"## Members\n\n<dl>\n<dt><a href=\"#FileParserInterceptor\">FileParserInterceptor</a></dt>\n<dd><p>Probes the upload’s file signature, stamps the CLS store (signature, hash, cache key) and publishes the probe.</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#generateCacheKey\">generateCacheKey(options)</a> ⇒ <code>string</code></dt>\n<dd><p>Hashes an arbitrary value into a deterministic, url/fs-safe cache key.</p>\n</dd>\n<dt><a href=\"#parseHeaderInteger\">parseHeaderInteger(value, radix)</a> ⇒ <code>number</code></dt>\n<dd><p>Parses a content-length header with explicit radix. Kept behind a parameter so\nparseInt semantics survive: <code>Number(&#39;42abc&#39;)</code> is NaN while\n<code>parseInt(&#39;42abc&#39;, 10)</code> is 42, and the cache key depends on that value.</p>\n</dd>\n<dt><a href=\"#buildCacheKey\">buildCacheKey(cls)</a> ⇒ <code>Promise&lt;void&gt;</code></dt>\n<dd><p>Builds and stores the cache key for the scanned upload or download.</p>\n</dd>\n<dt><a href=\"#prefixHash\">prefixHash(stream, size)</a> ⇒ <code>Promise&lt;string&gt;</code></dt>\n<dd><p>Hashes the first <code>size</code> bytes of the stream (or all of it when smaller).</p>\n<p>The branch is consumed with plain listeners, never an async iterator, so\nit is not destroyed at the end: the probe branch of the request&#39;s tee must\nstay intact for its sibling branch. Chunks beyond the prefix are discarded\nin the same pass. Resolves as soon as the prefix is hashed (or EOF is\nreached); the full remainder is dropped without resolving the caller.</p>\n</dd>\n</dl>\n\n<a name=\"FileParserInterceptor\"></a>\n\n## FileParserInterceptor\nProbes the upload’s file signature, stamps the CLS store (signature, hash, cache key) and publishes the probe.\n\n**Kind**: global variable  \nsrc: packages/backend/src/interceptors/file-parser.interceptor.ts:77  \ndist: packages/backend/dist/interceptors/file-parser.interceptor.js:46\n<a name=\"generateCacheKey\"></a>\n\n## generateCacheKey(options) ⇒ <code>string</code>\nHashes an arbitrary value into a deterministic, url/fs-safe cache key.\n\n**Kind**: global function  \n**Returns**: <code>string</code> - The cache key.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| options | <code>unknown</code> | Value to hash (upload base key parts or download base key parts). |\n\nsrc: packages/backend/src/interceptors/file-parser.interceptor.ts:27  \ndist: packages/backend/dist/interceptors/file-parser.interceptor.js:22\n<a name=\"parseHeaderInteger\"></a>\n\n## parseHeaderInteger(value, radix) ⇒ <code>number</code>\nParses a content-length header with explicit radix. Kept behind a parameter so\nparseInt semantics survive: `Number('42abc')` is NaN while\n`parseInt('42abc', 10)` is 42, and the cache key depends on that value.\n\n**Kind**: global function  \n**Returns**: <code>number</code> - The parsed integer.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| value | <code>string</code> | Raw header value. |\n| radix | <code>number</code> | Numeric base, always 10 at the call site. |\n\nsrc: packages/backend/src/interceptors/file-parser.interceptor.ts:38  \ndist: packages/backend/dist/interceptors/file-parser.interceptor.js:23\n<a name=\"buildCacheKey\"></a>\n\n## buildCacheKey(cls) ⇒ <code>Promise&lt;void&gt;</code>\nBuilds and stores the cache key for the scanned upload or download.\n\n**Kind**: global function  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| cls | <code>NormalizedClsService</code> | CLS facade carrying the request, signature and hash. |\n\nsrc: packages/backend/src/interceptors/file-parser.interceptor.ts:45  \ndist: packages/backend/dist/interceptors/file-parser.interceptor.js:24\n<a name=\"prefixHash\"></a>\n\n## prefixHash(stream, size) ⇒ <code>Promise&lt;string&gt;</code>\nHashes the first `size` bytes of the stream (or all of it when smaller).\n\nThe branch is consumed with plain listeners, never an async iterator, so\nit is not destroyed at the end: the probe branch of the request's tee must\nstay intact for its sibling branch. Chunks beyond the prefix are discarded\nin the same pass. Resolves as soon as the prefix is hashed (or EOF is\nreached); the full remainder is dropped without resolving the caller.\n\n**Kind**: global function  \n**Returns**: <code>Promise&lt;string&gt;</code> - SHA-512 hex of the hashed prefix (or entire) bytes.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| stream | <code>Readable</code> | The readable branch to hash (left intact). |\n| size | <code>number</code> | Maximum number of bytes to hash. |\n\nsrc: packages/backend/src/interceptors/file-parser.interceptor.ts:111  \ndist: packages/backend/dist/interceptors/file-parser.interceptor.js:71\n","symbols":5,"lastUsed":1795730448265},"tdata:packages/backend/src/interceptors/file-scanner.interceptor.ts":{"doclets":[{"id":"FileScannerInterceptor","longname":"FileScannerInterceptor","name":"FileScannerInterceptor","kind":"member","scope":"global","description":"Scans the incoming media stream for viruses before the parser runs.\n\nMust be bound BEFORE `FileParserInterceptor` (and before any other consumer\nof the source stream) so an infected upload is rejected with `422` before\nthe signature probe ever sees a byte of it.\n\nCLS open-source contract: this interceptor opens the source itself through\n`openMediaSource`, which is idempotent — binding it before the parser means\nthe parser's own open is a no-op. When the virus scanner is disabled (no\n`CLAMAV_HOST`/`CLAMAV_PORT` configured) this interceptor passes media\nthrough untouched, after logging a single warning per instance.\n\nFailure semantics: `AntiVirusService.scan` rejects with a `413` when the\npayload exceeds `CLAMAV_MAX_BYTES`, a `422` when the stream is infected,\nand a `503` when clamd is unreachable or errors; those statuses are set by\nthe service and propagate out of this interceptor as-is. `next.handle()` is\nnever reached for rejected media, so no downstream interceptor or handler\nruns on a failed scan.\n\nThe scan buffers the (capped) payload in memory and replaces the CLS\nsource with a replay `Readable`, so the pipeline downstream reads the same\nbytes as if nothing happened.","params":[],"meta":{"lineno":61},"order":0,"mdaics":{"dist":"packages/backend/dist/interceptors/file-scanner.interceptor.js:15","src":"packages/backend/src/interceptors/file-scanner.interceptor.ts:39"},"level":0}],"fp":"6377148b06e4ad027e94e37a89ae261dc001eb0c8d6d31d6a1f9da5d2b531398","issues":[],"kind":"tdata","lastUsed":1795730447960,"symbols":0},"md:packages/backend/src/interceptors/file-scanner.interceptor.ts":{"fp":"409edaefeda0bab220b7f838c4eba34ccb7a1dca19c0516b05bc21abe3ee5cab","issues":[],"kind":"md","markdown":"<a name=\"FileScannerInterceptor\"></a>\n\n## FileScannerInterceptor\nScans the incoming media stream for viruses before the parser runs.\n\nMust be bound BEFORE `FileParserInterceptor` (and before any other consumer\nof the source stream) so an infected upload is rejected with `422` before\nthe signature probe ever sees a byte of it.\n\nCLS open-source contract: this interceptor opens the source itself through\n`openMediaSource`, which is idempotent — binding it before the parser means\nthe parser's own open is a no-op. When the virus scanner is disabled (no\n`CLAMAV_HOST`/`CLAMAV_PORT` configured) this interceptor passes media\nthrough untouched, after logging a single warning per instance.\n\nFailure semantics: `AntiVirusService.scan` rejects with a `413` when the\npayload exceeds `CLAMAV_MAX_BYTES`, a `422` when the stream is infected,\nand a `503` when clamd is unreachable or errors; those statuses are set by\nthe service and propagate out of this interceptor as-is. `next.handle()` is\nnever reached for rejected media, so no downstream interceptor or handler\nruns on a failed scan.\n\nThe scan buffers the (capped) payload in memory and replaces the CLS\nsource with a replay `Readable`, so the pipeline downstream reads the same\nbytes as if nothing happened.\n\n**Kind**: global variable  \nsrc: packages/backend/src/interceptors/file-scanner.interceptor.ts:39  \ndist: packages/backend/dist/interceptors/file-scanner.interceptor.js:15\n","symbols":1,"lastUsed":1795730448006},"tdata:packages/backend/src/interceptors/file-scanner.interceptor.spec.ts":{"doclets":[],"fp":"5f5188eee157506cdeca7fddb650597880d898908dec0b64e282574850081017","issues":[],"kind":"tdata","lastUsed":1795730447945,"symbols":0},"md:packages/backend/src/interceptors/file-scanner.interceptor.spec.ts":{"fp":"06485d00512103803d5c7c0e752e5d944aed962b022c807955b7e0db782cb0c2","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795730447946},"tdata:packages/backend/src/logging/bootstrap-logger.ts":{"doclets":[{"id":"bootstrapLogger","longname":"bootstrapLogger","name":"bootstrapLogger","kind":"constant","scope":"global","description":"Process-level logger for fatal paths that run before Nest's dependency injection\nexists (unhandled rejections, uncaught exceptions). Always raw JSON to stdout;\nnever pretty-printed, so early fatals are machine-parseable.","meta":{"lineno":9},"order":0,"mdaics":{"dist":"packages/backend/dist/logging/bootstrap-logger.js:4","src":"packages/backend/src/logging/bootstrap-logger.ts:11"},"level":0}],"fp":"950618eadfd564cb62cea3a46c0a947d4afe1e1143af1581f8bfc6d046fd8291","issues":[],"kind":"tdata","lastUsed":1795730448043,"symbols":0},"md:packages/backend/src/logging/bootstrap-logger.ts":{"fp":"a92d345c47fff9a57ef2256c972eba3b6fa5406539c0c9042917fddf4f83206a","issues":[],"kind":"md","markdown":"<a name=\"bootstrapLogger\"></a>\n\n## bootstrapLogger\nProcess-level logger for fatal paths that run before Nest's dependency injection\nexists (unhandled rejections, uncaught exceptions). Always raw JSON to stdout;\nnever pretty-printed, so early fatals are machine-parseable.\n\n**Kind**: global constant  \nsrc: packages/backend/src/logging/bootstrap-logger.ts:11  \ndist: packages/backend/dist/logging/bootstrap-logger.js:4\n","symbols":1,"lastUsed":1795730448083},"tdata:packages/backend/src/logging/pino-options.spec.ts":{"doclets":[],"fp":"d1c700a11491297055d342cba37fb9934cc30042ee80c4cbf6f1fea4584569e1","issues":[],"kind":"tdata","lastUsed":1795730448052,"symbols":0},"md:packages/backend/src/logging/pino-options.spec.ts":{"fp":"6e5b9607b786d3596253a9d2d83122f1e34731f014c75e4729f55ac071b1f031","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795730448052},"tdata:packages/backend/src/logging/worker-logger.spec.ts":{"doclets":[],"fp":"c1af788ea81eba3219fb636096c5d0300888c16d4eb9d8f82b502fad63884625","issues":[],"kind":"tdata","lastUsed":1795730448083,"symbols":0},"md:packages/backend/src/logging/worker-logger.spec.ts":{"fp":"86effcb2ce2fa5673880042f70b8c9975c736cfec2fa854d54e18179ae2a2ece","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795730448084},"tdata:packages/backend/src/logging/pino-options.ts":{"doclets":[{"id":"redactPaths","longname":"redactPaths","name":"redactPaths","kind":"constant","scope":"global","description":"Paths censored from any nested request/response object pino sees.","meta":{"lineno":18},"order":1,"mdaics":{"dist":"packages/backend/dist/logging/pino-options.js:9","src":"packages/backend/src/logging/pino-options.ts:40"},"level":0},{"id":"stripQuery","longname":"stripQuery","name":"stripQuery","kind":"function","scope":"global","description":"Removes the query string from a URL.\nMedia `source` parameters may embed signed remote URLs, so the query must never reach the logs.","params":[{"description":"The raw request URL.","name":"url","type":{"names":["string"]}}],"returns":[{"description":"The path portion, or `undefined` when the URL was missing.","type":{"names":["string"]}}],"meta":{"lineno":8},"order":0,"mdaics":{"dist":"packages/backend/dist/logging/pino-options.js:2","src":"packages/backend/src/logging/pino-options.ts:29"},"level":0},{"id":"serializeRequest","longname":"serializeRequest","name":"serializeRequest","kind":"function","scope":"global","description":"Request serializer: id, method and path only. Headers and query strings are dropped by design.","params":[{"description":"The raw Node request.","name":"request","type":{"names":["IncomingMessage & { id?: number | string; }"]}}],"returns":[{"description":"A minimal log object with id, method and path only.","type":{"names":["{ id: string | number; method: string; url: string; }"]}}],"meta":{"lineno":30},"order":2,"mdaics":{"dist":"packages/backend/dist/logging/pino-options.js:16","src":"packages/backend/src/logging/pino-options.ts:53"},"level":0},{"id":"serializeResponse","longname":"serializeResponse","name":"serializeResponse","kind":"function","scope":"global","description":"Response serializer: status code only.","params":[{"description":"The raw Node response.","name":"response","type":{"names":["ServerResponse<IncomingMessage>"]}}],"returns":[{"description":"A minimal log object with the status code only.","type":{"names":["{ statusCode: number; }"]}}],"meta":{"lineno":40},"order":3,"mdaics":{"dist":"packages/backend/dist/logging/pino-options.js:21","src":"packages/backend/src/logging/pino-options.ts:66"},"level":0},{"id":"buildPinoHttpOptions","longname":"buildPinoHttpOptions","name":"buildPinoHttpOptions","kind":"function","scope":"global","description":"Builds the pino-http options used by nestjs-pino. Adds request auto-logging\n(excluding `/health`) and pretty output in development.","params":[{"description":"Runtime inputs; see {@link PinoEnvironment}.","name":"environment","type":{"names":["PinoEnvironment"]}}],"returns":[{"description":"Options passed to `LoggerModule.forRoot()` as `pinoHttp`.","type":{"names":["PinoHttpOptions<IncomingMessage, ServerResponse<IncomingMessage>, never>"]}}],"meta":{"lineno":50},"order":4,"mdaics":{"dist":"packages/backend/dist/logging/pino-options.js:25","src":"packages/backend/src/logging/pino-options.ts:79"},"level":0},{"id":"buildPinoOptions","longname":"buildPinoOptions","name":"buildPinoOptions","kind":"function","scope":"global","description":"Builds the base pino options shared by the bootstrap logger and the request logger.","params":[{"description":"Runtime inputs; see {@link PinoEnvironment}.","name":"environment","type":{"names":["PinoEnvironment"]}}],"returns":[{"description":"Options passed straight to `pino()`.","type":{"names":["LoggerOptions<never, boolean>"]}}],"meta":{"lineno":63},"order":5,"mdaics":{"dist":"packages/backend/dist/logging/pino-options.js:33","src":"packages/backend/src/logging/pino-options.ts:95"},"level":0}],"fp":"f2733c84bc593adab71a03a99dd3e7fd6f7aa0b84b94401dda9fc228b277dab2","issues":[],"kind":"tdata","lastUsed":1795730448059,"symbols":0},"md:packages/backend/src/logging/pino-options.ts":{"fp":"85120e65b73b2bbc7bbf3f3eca7bcc6cee1fe75e5c71fd47393872a82dd8b929","issues":[],"kind":"md","markdown":"## Constants\n\n<dl>\n<dt><a href=\"#redactPaths\">redactPaths</a></dt>\n<dd><p>Paths censored from any nested request/response object pino sees.</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#stripQuery\">stripQuery(url)</a> ⇒ <code>string</code></dt>\n<dd><p>Removes the query string from a URL.\nMedia <code>source</code> parameters may embed signed remote URLs, so the query must never reach the logs.</p>\n</dd>\n<dt><a href=\"#serializeRequest\">serializeRequest(request)</a> ⇒ <code>{ id: string | number; method: string; url: string; }</code></dt>\n<dd><p>Request serializer: id, method and path only. Headers and query strings are dropped by design.</p>\n</dd>\n<dt><a href=\"#serializeResponse\">serializeResponse(response)</a> ⇒ <code>{ statusCode: number; }</code></dt>\n<dd><p>Response serializer: status code only.</p>\n</dd>\n<dt><a href=\"#buildPinoHttpOptions\">buildPinoHttpOptions(environment)</a> ⇒ <code>PinoHttpOptions&lt;IncomingMessage, ServerResponse&lt;IncomingMessage&gt;, never&gt;</code></dt>\n<dd><p>Builds the pino-http options used by nestjs-pino. Adds request auto-logging\n(excluding <code>/health</code>) and pretty output in development.</p>\n</dd>\n<dt><a href=\"#buildPinoOptions\">buildPinoOptions(environment)</a> ⇒ <code>LoggerOptions&lt;never, boolean&gt;</code></dt>\n<dd><p>Builds the base pino options shared by the bootstrap logger and the request logger.</p>\n</dd>\n</dl>\n\n<a name=\"redactPaths\"></a>\n\n## redactPaths\nPaths censored from any nested request/response object pino sees.\n\n**Kind**: global constant  \nsrc: packages/backend/src/logging/pino-options.ts:40  \ndist: packages/backend/dist/logging/pino-options.js:9\n<a name=\"stripQuery\"></a>\n\n## stripQuery(url) ⇒ <code>string</code>\nRemoves the query string from a URL.\nMedia `source` parameters may embed signed remote URLs, so the query must never reach the logs.\n\n**Kind**: global function  \n**Returns**: <code>string</code> - The path portion, or `undefined` when the URL was missing.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| url | <code>string</code> | The raw request URL. |\n\nsrc: packages/backend/src/logging/pino-options.ts:29  \ndist: packages/backend/dist/logging/pino-options.js:2\n<a name=\"serializeRequest\"></a>\n\n## serializeRequest(request) ⇒ <code>{ id: string \\| number; method: string; url: string; }</code>\nRequest serializer: id, method and path only. Headers and query strings are dropped by design.\n\n**Kind**: global function  \n**Returns**: <code>{ id: string \\| number; method: string; url: string; }</code> - A minimal log object with id, method and path only.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| request | <code>IncomingMessage &amp; { id?: number \\| string; }</code> | The raw Node request. |\n\nsrc: packages/backend/src/logging/pino-options.ts:53  \ndist: packages/backend/dist/logging/pino-options.js:16\n<a name=\"serializeResponse\"></a>\n\n## serializeResponse(response) ⇒ <code>{ statusCode: number; }</code>\nResponse serializer: status code only.\n\n**Kind**: global function  \n**Returns**: <code>{ statusCode: number; }</code> - A minimal log object with the status code only.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| response | <code>ServerResponse&lt;IncomingMessage&gt;</code> | The raw Node response. |\n\nsrc: packages/backend/src/logging/pino-options.ts:66  \ndist: packages/backend/dist/logging/pino-options.js:21\n<a name=\"buildPinoHttpOptions\"></a>\n\n## buildPinoHttpOptions(environment) ⇒ <code>PinoHttpOptions&lt;IncomingMessage, ServerResponse&lt;IncomingMessage&gt;, never&gt;</code>\nBuilds the pino-http options used by nestjs-pino. Adds request auto-logging\n(excluding `/health`) and pretty output in development.\n\n**Kind**: global function  \n**Returns**: <code>PinoHttpOptions&lt;IncomingMessage, ServerResponse&lt;IncomingMessage&gt;, never&gt;</code> - Options passed to `LoggerModule.forRoot()` as `pinoHttp`.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| environment | <code>PinoEnvironment</code> | Runtime inputs; see [PinoEnvironment](PinoEnvironment). |\n\nsrc: packages/backend/src/logging/pino-options.ts:79  \ndist: packages/backend/dist/logging/pino-options.js:25\n<a name=\"buildPinoOptions\"></a>\n\n## buildPinoOptions(environment) ⇒ <code>LoggerOptions&lt;never, boolean&gt;</code>\nBuilds the base pino options shared by the bootstrap logger and the request logger.\n\n**Kind**: global function  \n**Returns**: <code>LoggerOptions&lt;never, boolean&gt;</code> - Options passed straight to `pino()`.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| environment | <code>PinoEnvironment</code> | Runtime inputs; see [PinoEnvironment](PinoEnvironment). |\n\nsrc: packages/backend/src/logging/pino-options.ts:95  \ndist: packages/backend/dist/logging/pino-options.js:33\n","symbols":6,"lastUsed":1795730448119},"tdata:packages/backend/src/logging/worker-logger.ts":{"doclets":[{"id":"createWorkerLogger","longname":"createWorkerLogger","name":"createWorkerLogger","kind":"function","scope":"global","description":"Creates the logger for worker threads. Worker stdout is the byte channel for\ngenerated media and documents, so all worker logs go to stderr only.","params":[{"description":"Stream to write JSON lines to; defaults to `process.stderr`.","name":"destination","type":{"names":["Writable"]}}],"returns":[{"description":"A pino instance emitting one JSON object per line.","type":{"names":["pino.Logger"]}}],"meta":{"lineno":9},"order":0,"mdaics":{"dist":"packages/backend/dist/logging/worker-logger.js:3","src":"packages/backend/src/logging/worker-logger.ts:13"},"level":0}],"fp":"be850aeee8453a0a84ed29d02412cdac8fbaf1f12e588c1bb3404bde962cab03","issues":[],"kind":"tdata","lastUsed":1795730448122,"symbols":0},"md:packages/backend/src/logging/worker-logger.ts":{"fp":"af203585d15e37576700014d32b65034ebfba21128c44e107e4f84be489bc208","issues":[],"kind":"md","markdown":"<a name=\"createWorkerLogger\"></a>\n\n## createWorkerLogger(destination) ⇒ <code>pino.Logger</code>\nCreates the logger for worker threads. Worker stdout is the byte channel for\ngenerated media and documents, so all worker logs go to stderr only.\n\n**Kind**: global function  \n**Returns**: <code>pino.Logger</code> - A pino instance emitting one JSON object per line.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| destination | <code>Writable</code> | Stream to write JSON lines to; defaults to `process.stderr`. |\n\nsrc: packages/backend/src/logging/worker-logger.ts:13  \ndist: packages/backend/dist/logging/worker-logger.js:3\n","symbols":1,"lastUsed":1795730448155},"tdata:packages/backend/src/main.ts":{"doclets":[{"id":"bootstrap","longname":"bootstrap","name":"bootstrap","kind":"function","scope":"global","description":"Boots the Nest application: OpenTelemetry first (when configured), then pino logging, metrics shutdown hooks, CORS/security headers in production, Swagger, and the listener.","params":[],"meta":{"lineno":25},"async":true,"order":0,"mdaics":{"dist":"packages/backend/dist/main.js:21","src":"packages/backend/src/main.ts:39"},"returns":[{"type":{"names":["Promise<void>"]}}],"level":0},{"id":"swagger","longname":"swagger","name":"swagger","kind":"function","scope":"global","description":"Mounts Swagger/OpenAPI docs at `/api` with a zod-to-OpenAPI schema converter.","params":[{"description":"The Nest application instance.","name":"app","type":{"names":["NestFastifyApplication<import(\"fastify\").RawServerDefault>"]}}],"meta":{"lineno":55},"order":1,"mdaics":{"dist":"packages/backend/dist/main.js:38","src":"packages/backend/src/main.ts:78"},"level":0}],"fp":"bb3712e8a30587c1a04419a78bbbc37e6a44ce3dc12358c7661a1791f51152ec","issues":[],"kind":"tdata","lastUsed":1795730448131,"symbols":0},"md:packages/backend/src/main.ts":{"fp":"91643c55e6bd92e70c7e6eb0a8d6f7c2436967fa5973e8fcc15013dfca49fd9e","issues":[],"kind":"md","markdown":"## Functions\n\n<dl>\n<dt><a href=\"#bootstrap\">bootstrap()</a> ⇒ <code>Promise&lt;void&gt;</code></dt>\n<dd><p>Boots the Nest application: OpenTelemetry first (when configured), then pino logging, metrics shutdown hooks, CORS/security headers in production, Swagger, and the listener.</p>\n</dd>\n<dt><a href=\"#swagger\">swagger(app)</a></dt>\n<dd><p>Mounts Swagger/OpenAPI docs at <code>/api</code> with a zod-to-OpenAPI schema converter.</p>\n</dd>\n</dl>\n\n<a name=\"bootstrap\"></a>\n\n## bootstrap() ⇒ <code>Promise&lt;void&gt;</code>\nBoots the Nest application: OpenTelemetry first (when configured), then pino logging, metrics shutdown hooks, CORS/security headers in production, Swagger, and the listener.\n\n**Kind**: global function  \nsrc: packages/backend/src/main.ts:39  \ndist: packages/backend/dist/main.js:21\n<a name=\"swagger\"></a>\n\n## swagger(app)\nMounts Swagger/OpenAPI docs at `/api` with a zod-to-OpenAPI schema converter.\n\n**Kind**: global function  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| app | <code>NestFastifyApplication&lt;import(&quot;fastify&quot;).RawServerDefault&gt;</code> | The Nest application instance. |\n\nsrc: packages/backend/src/main.ts:78  \ndist: packages/backend/dist/main.js:38\n","symbols":2,"lastUsed":1795730448194},"tdata:packages/backend/src/metrics/metrics.controller.spec.ts":{"doclets":[],"fp":"bfe124fd490e5033fbd8d74177b8d11a548722e2b5a6f39cdde8055225d71ada","issues":[],"kind":"tdata","lastUsed":1795730448165,"symbols":0},"md:packages/backend/src/metrics/metrics.controller.spec.ts":{"fp":"90b3ce40f6d8268557523d9e865ee68ecb892e8522d52fdab99406738e37d4eb","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795730448165},"tdata:packages/backend/src/metrics/metrics.controller.ts":{"doclets":[{"id":"MetricsController","longname":"MetricsController","name":"MetricsController","kind":"member","scope":"global","description":"Read-only metrics and liveness endpoints for the dashboard.","params":[],"meta":{"lineno":52},"order":1,"mdaics":{"dist":"packages/backend/dist/metrics/metrics.controller.js:22","src":"packages/backend/src/metrics/metrics.controller.ts:31"},"level":0},{"id":"isBearerTokenMatch","longname":"isBearerTokenMatch","name":"isBearerTokenMatch","kind":"function","scope":"global","description":"Constant-time comparison of bearer tokens.","params":[{"description":"The `Authorization` header sent by the client, if any.","name":"actual","type":{"names":["string"]}},{"description":"The token the server requires.","name":"expected","type":{"names":["string"]}}],"returns":[{"description":"True when both strings are byte-equal.","type":{"names":["boolean"]}}],"meta":{"lineno":45},"order":0,"mdaics":{"dist":"packages/backend/dist/metrics/metrics.controller.js:18","src":"packages/backend/src/metrics/metrics.controller.ts:21"},"level":0},{"id":"MetricsController#healthGet","longname":"MetricsController#healthGet","name":"healthGet","kind":"function","scope":"instance","description":"Liveness probe for Docker HEALTHCHECK and uptime checks.","memberof":"MetricsController","params":[],"returns":[{"description":"Status, uptime in seconds and the current timestamp.","type":{"names":["{ status: string; timestamp: string; uptimeSeconds: number; }"]}}],"meta":{"lineno":81},"order":2,"mdaics":{"dist":"packages/backend/dist/metrics/metrics.controller.js:27","src":"packages/backend/src/metrics/metrics.controller.ts:39"},"level":0},{"id":"MetricsController#metricsGet","longname":"MetricsController#metricsGet","name":"metricsGet","kind":"function","scope":"instance","description":"Full metrics payload for the dashboard.\n\nRequires `METRICS_TOKEN` as a bearer token; in production, a missing\n`METRICS_TOKEN` disables the route (503) so per-IP data is never public.","memberof":"MetricsController","params":[{"description":"The `Authorization` header, if present.","name":"authorization","type":{"names":["string"]}}],"returns":[{"description":"The aggregated metrics snapshot.","type":{"names":["MetricsSnapshot"]}}],"exceptions":[{"description":"ServiceUnavailableException Production is missing `METRICS_TOKEN`."},{"description":"UnauthorizedException The bearer token is missing or wrong."}],"meta":{"lineno":98},"order":3,"mdaics":{"dist":"packages/backend/dist/metrics/metrics.controller.js:34","src":"packages/backend/src/metrics/metrics.controller.ts:58"},"level":0}],"fp":"12942f9399cc96a1de53347e7b09318edb88cf05f0c6d68c8c70b868c1a51dae","issues":[],"kind":"tdata","lastUsed":1795730448204,"symbols":0},"md:packages/backend/src/metrics/metrics.controller.ts":{"fp":"24e907ccfa74d0f15f015ab0f205bbd20a84fdf8fde42b536d7a72e47ad431e6","issues":[],"kind":"md","markdown":"## Members\n\n<dl>\n<dt><a href=\"#MetricsController\">MetricsController</a></dt>\n<dd><p>Read-only metrics and liveness endpoints for the dashboard.</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#isBearerTokenMatch\">isBearerTokenMatch(actual, expected)</a> ⇒ <code>boolean</code></dt>\n<dd><p>Constant-time comparison of bearer tokens.</p>\n</dd>\n</dl>\n\n<a name=\"MetricsController\"></a>\n\n## MetricsController\nRead-only metrics and liveness endpoints for the dashboard.\n\n**Kind**: global variable  \nsrc: packages/backend/src/metrics/metrics.controller.ts:31  \ndist: packages/backend/dist/metrics/metrics.controller.js:22\n\n* [MetricsController](#MetricsController)\n    * [.healthGet()](#MetricsController+healthGet) ⇒ <code>{ status: string; timestamp: string; uptimeSeconds: number; }</code>\n    * [.metricsGet(authorization)](#MetricsController+metricsGet) ⇒ <code>MetricsSnapshot</code>\n\n<a name=\"MetricsController+healthGet\"></a>\n\n### metricsController.healthGet() ⇒ <code>{ status: string; timestamp: string; uptimeSeconds: number; }</code>\nLiveness probe for Docker HEALTHCHECK and uptime checks.\n\n**Kind**: instance method of [<code>MetricsController</code>](#MetricsController)  \n**Returns**: <code>{ status: string; timestamp: string; uptimeSeconds: number; }</code> - Status, uptime in seconds and the current timestamp.  \nsrc: packages/backend/src/metrics/metrics.controller.ts:39  \ndist: packages/backend/dist/metrics/metrics.controller.js:27\n<a name=\"MetricsController+metricsGet\"></a>\n\n### metricsController.metricsGet(authorization) ⇒ <code>MetricsSnapshot</code>\nFull metrics payload for the dashboard.\n\nRequires `METRICS_TOKEN` as a bearer token; in production, a missing\n`METRICS_TOKEN` disables the route (503) so per-IP data is never public.\n\n**Kind**: instance method of [<code>MetricsController</code>](#MetricsController)  \n**Returns**: <code>MetricsSnapshot</code> - The aggregated metrics snapshot.  \n**Throws**:\n\n- ServiceUnavailableException Production is missing `METRICS_TOKEN`.\n- UnauthorizedException The bearer token is missing or wrong.\n\n\n| Param | Type | Description |\n| --- | --- | --- |\n| authorization | <code>string</code> | The `Authorization` header, if present. |\n\nsrc: packages/backend/src/metrics/metrics.controller.ts:58  \ndist: packages/backend/dist/metrics/metrics.controller.js:34\n<a name=\"isBearerTokenMatch\"></a>\n\n## isBearerTokenMatch(actual, expected) ⇒ <code>boolean</code>\nConstant-time comparison of bearer tokens.\n\n**Kind**: global function  \n**Returns**: <code>boolean</code> - True when both strings are byte-equal.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| actual | <code>string</code> | The `Authorization` header sent by the client, if any. |\n| expected | <code>string</code> | The token the server requires. |\n\nsrc: packages/backend/src/metrics/metrics.controller.ts:21  \ndist: packages/backend/dist/metrics/metrics.controller.js:18\n","symbols":4,"lastUsed":1795730448329},"tdata:packages/backend/src/metrics/metrics.interceptor.spec.ts":{"doclets":[{"id":"makeStub","longname":"makeStub","name":"makeStub","kind":"function","scope":"global","description":"Minimal Fastify-ish request/reply and CLS stand-ins for the interceptor.","params":[{"description":"Fixture overrides; all optional.","name":"options","type":{"names":["{ antiVirusEnabled?: boolean; bytesIn?: number; bytesOut?: number; cacheOutcome?: \"hit\" | \"miss\"; files?: 0 | 1; fileScan?: { isInfected: boolean; }; headers?: Record<string, string | string[]>; responseContentLength?: string; routeUrl?: string; statusCode?: number; }"]}},{"description":"Route template to expose on `routeOptions`; omit for an unmatched route.","name":"options.routeUrl"},{"description":"Request headers.","name":"options.headers"},{"description":"Status code for the raw response.","name":"options.statusCode"},{"description":"Value returned by `getHeader('content-length')`.","name":"options.responseContentLength"},{"description":"Whether the AV integration is configured; defaults to true.","name":"options.antiVirusEnabled"},{"description":"Cumulative bytes-in counter stored on CLS.","name":"options.bytesIn"},{"description":"Cumulative bytes-out counter stored on CLS.","name":"options.bytesOut"},{"description":"`1` when a media source was opened, `0` otherwise.","name":"options.files"},{"description":"Cache verdict stored on CLS.","name":"options.cacheOutcome"},{"description":"Virus-scan verdict stored on CLS.","name":"options.fileScan"},{"description":"True when ClamAV flagged the payload.","name":"options.fileScan.isInfected"}],"returns":[{"description":"The stub bundle (context, CLS, metrics mocks, raw).","type":{"names":["Stub"]}}],"meta":{"lineno":21},"order":0,"mdaics":{"src":"packages/backend/src/metrics/metrics.interceptor.spec.ts:43"},"level":0},{"id":"fire","longname":"fire","name":"fire","kind":"function","scope":"global","description":"Runs one request through the interceptor and returns the record passed to metrics.","params":[{"description":"Stub bundle from `makeStub`.","name":"stub","type":{"names":["Stub"]}}],"returns":[{"description":"The argument passed to `metrics.record`.","type":{"names":["Record<string, unknown>"]}}],"meta":{"lineno":64},"order":1,"mdaics":{"src":"packages/backend/src/metrics/metrics.interceptor.spec.ts:103"},"level":0}],"fp":"63ae8b083e82e9d051ad97f511f97f17fc2f7aa2bee1fa1f8df54100349d21d5","issues":[],"kind":"tdata","lastUsed":1795730448220,"symbols":0},"md:packages/backend/src/metrics/metrics.interceptor.spec.ts":{"fp":"2ce230cf747dc66ed46f8f627cca00b94451ab13e20a6265a45b7fa26241f0d9","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","markdown":"## Functions\n\n<dl>\n<dt><a href=\"#makeStub\">makeStub(options)</a> ⇒ <code>Stub</code></dt>\n<dd><p>Minimal Fastify-ish request/reply and CLS stand-ins for the interceptor.</p>\n</dd>\n<dt><a href=\"#fire\">fire(stub)</a> ⇒ <code>Record&lt;string, unknown&gt;</code></dt>\n<dd><p>Runs one request through the interceptor and returns the record passed to metrics.</p>\n</dd>\n</dl>\n\n<a name=\"makeStub\"></a>\n\n## makeStub(options) ⇒ <code>Stub</code>\nMinimal Fastify-ish request/reply and CLS stand-ins for the interceptor.\n\n**Kind**: global function  \n**Returns**: <code>Stub</code> - The stub bundle (context, CLS, metrics mocks, raw).  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| options | <code>{ antiVirusEnabled?: boolean; bytesIn?: number; bytesOut?: number; cacheOutcome?: &quot;hit&quot; \\| &quot;miss&quot;; files?: 0 \\| 1; fileScan?: { isInfected: boolean; }; headers?: Record&lt;string, string \\| string[]&gt;; responseContentLength?: string; routeUrl?: string; statusCode?: number; }</code> | Fixture overrides; all optional. |\n| options.routeUrl |  | Route template to expose on `routeOptions`; omit for an unmatched route. |\n| options.headers |  | Request headers. |\n| options.statusCode |  | Status code for the raw response. |\n| options.responseContentLength |  | Value returned by `getHeader('content-length')`. |\n| options.antiVirusEnabled |  | Whether the AV integration is configured; defaults to true. |\n| options.bytesIn |  | Cumulative bytes-in counter stored on CLS. |\n| options.bytesOut |  | Cumulative bytes-out counter stored on CLS. |\n| options.files |  | `1` when a media source was opened, `0` otherwise. |\n| options.cacheOutcome |  | Cache verdict stored on CLS. |\n| options.fileScan |  | Virus-scan verdict stored on CLS. |\n| options.fileScan.isInfected |  | True when ClamAV flagged the payload. |\n\nsrc: packages/backend/src/metrics/metrics.interceptor.spec.ts:43  \n<a name=\"fire\"></a>\n\n## fire(stub) ⇒ <code>Record&lt;string, unknown&gt;</code>\nRuns one request through the interceptor and returns the record passed to metrics.\n\n**Kind**: global function  \n**Returns**: <code>Record&lt;string, unknown&gt;</code> - The argument passed to `metrics.record`.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| stub | <code>Stub</code> | Stub bundle from `makeStub`. |\n\nsrc: packages/backend/src/metrics/metrics.interceptor.spec.ts:103  \n","symbols":2,"lastUsed":1795730448295},"tdata:packages/backend/src/metrics/metrics.interceptor.ts":{"doclets":[{"id":"MetricsInterceptor","longname":"MetricsInterceptor","name":"MetricsInterceptor","kind":"member","scope":"global","description":"Records one metric per completed HTTP request.\n\nBytes are taken from CLS (written by the stream meters) and fall back to the\n`content-length` headers otherwise; an empty streamed response still counts\nas a file out (the meter records 0 bytes, not a missing value). `filesOut`\ntherefore keys off the CLS meter being installed, not the byte count.\nSelf-instrumenting routes (`/metrics`, `/health`) are skipped. Registered\nafter `ClsInterceptor`, so the CLS context exists.","params":[],"meta":{"lineno":79},"order":3,"mdaics":{"dist":"packages/backend/dist/metrics/metrics.interceptor.js:30","src":"packages/backend/src/metrics/metrics.interceptor.ts:64"},"level":0},{"id":"EXCLUDED_ROUTES","longname":"EXCLUDED_ROUTES","name":"EXCLUDED_ROUTES","kind":"constant","scope":"global","description":"Routes excluded from instrumentation to avoid self-observation feedback.","params":[],"meta":{"lineno":39},"order":0,"mdaics":{"dist":"packages/backend/dist/metrics/metrics.interceptor.js:14","src":"packages/backend/src/metrics/metrics.interceptor.ts:19"},"level":0},{"id":"headerNumber","longname":"headerNumber","name":"headerNumber","kind":"function","scope":"global","description":"Turns a comma-separated or single-value header into a non-negative integer.","params":[{"description":"Raw header value from a Fastify request or reply.","name":"value","type":{"names":["string | number | string[]"]}}],"returns":[{"description":"Parsed size in bytes, or 0 when absent or invalid.","type":{"names":["number"]}}],"meta":{"lineno":45},"order":1,"mdaics":{"dist":"packages/backend/dist/metrics/metrics.interceptor.js:15","src":"packages/backend/src/metrics/metrics.interceptor.ts:26"},"level":0},{"id":"scanOutcome","longname":"scanOutcome","name":"scanOutcome","kind":"function","scope":"global","description":"Derives the scan verdict from the data already on CLS and the status code.","params":[{"description":"The scan verdict recorded on CLS, when present.","name":"fileScan","type":{"names":["{ isInfected: boolean; }"]}},{"description":"Whether the scanner perimeter is active.","name":"isAntiVirusEnabled","type":{"names":["boolean"]}},{"description":"Status code sent to the client.","name":"status","type":{"names":["number"]}}],"returns":[{"description":"The verdict to record, or undefined for non-scanner routes.","type":{"names":["\"blocked\" | \"clean\" | \"infected\""]}}],"meta":{"lineno":62},"order":2,"mdaics":{"dist":"packages/backend/dist/metrics/metrics.interceptor.js:23","src":"packages/backend/src/metrics/metrics.interceptor.ts:43"},"level":0}],"fp":"90ff18fb664ae6d8c597ece3be7609a15e46726c154377f298f4520ef802da43","issues":[],"kind":"tdata","lastUsed":1795730448266,"symbols":0},"md:packages/backend/src/metrics/metrics.interceptor.ts":{"fp":"f8a4147961388a3713374d08b8a972461f3e416e36fa8e5bcf84f16acf2e09f1","issues":[],"kind":"md","markdown":"## Members\n\n<dl>\n<dt><a href=\"#MetricsInterceptor\">MetricsInterceptor</a></dt>\n<dd><p>Records one metric per completed HTTP request.</p>\n<p>Bytes are taken from CLS (written by the stream meters) and fall back to the\n<code>content-length</code> headers otherwise; an empty streamed response still counts\nas a file out (the meter records 0 bytes, not a missing value). <code>filesOut</code>\ntherefore keys off the CLS meter being installed, not the byte count.\nSelf-instrumenting routes (<code>/metrics</code>, <code>/health</code>) are skipped. Registered\nafter <code>ClsInterceptor</code>, so the CLS context exists.</p>\n</dd>\n</dl>\n\n## Constants\n\n<dl>\n<dt><a href=\"#EXCLUDED_ROUTES\">EXCLUDED_ROUTES</a></dt>\n<dd><p>Routes excluded from instrumentation to avoid self-observation feedback.</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#headerNumber\">headerNumber(value)</a> ⇒ <code>number</code></dt>\n<dd><p>Turns a comma-separated or single-value header into a non-negative integer.</p>\n</dd>\n<dt><a href=\"#scanOutcome\">scanOutcome(fileScan, isAntiVirusEnabled, status)</a> ⇒ <code>&quot;blocked&quot; | &quot;clean&quot; | &quot;infected&quot;</code></dt>\n<dd><p>Derives the scan verdict from the data already on CLS and the status code.</p>\n</dd>\n</dl>\n\n<a name=\"MetricsInterceptor\"></a>\n\n## MetricsInterceptor\nRecords one metric per completed HTTP request.\n\nBytes are taken from CLS (written by the stream meters) and fall back to the\n`content-length` headers otherwise; an empty streamed response still counts\nas a file out (the meter records 0 bytes, not a missing value). `filesOut`\ntherefore keys off the CLS meter being installed, not the byte count.\nSelf-instrumenting routes (`/metrics`, `/health`) are skipped. Registered\nafter `ClsInterceptor`, so the CLS context exists.\n\n**Kind**: global variable  \nsrc: packages/backend/src/metrics/metrics.interceptor.ts:64  \ndist: packages/backend/dist/metrics/metrics.interceptor.js:30\n<a name=\"EXCLUDED_ROUTES\"></a>\n\n## EXCLUDED\\_ROUTES\nRoutes excluded from instrumentation to avoid self-observation feedback.\n\n**Kind**: global constant  \nsrc: packages/backend/src/metrics/metrics.interceptor.ts:19  \ndist: packages/backend/dist/metrics/metrics.interceptor.js:14\n<a name=\"headerNumber\"></a>\n\n## headerNumber(value) ⇒ <code>number</code>\nTurns a comma-separated or single-value header into a non-negative integer.\n\n**Kind**: global function  \n**Returns**: <code>number</code> - Parsed size in bytes, or 0 when absent or invalid.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| value | <code>string \\| number \\| string[]</code> | Raw header value from a Fastify request or reply. |\n\nsrc: packages/backend/src/metrics/metrics.interceptor.ts:26  \ndist: packages/backend/dist/metrics/metrics.interceptor.js:15\n<a name=\"scanOutcome\"></a>\n\n## scanOutcome(fileScan, isAntiVirusEnabled, status) ⇒ <code>&quot;blocked&quot; \\| &quot;clean&quot; \\| &quot;infected&quot;</code>\nDerives the scan verdict from the data already on CLS and the status code.\n\n**Kind**: global function  \n**Returns**: <code>&quot;blocked&quot; \\| &quot;clean&quot; \\| &quot;infected&quot;</code> - The verdict to record, or undefined for non-scanner routes.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| fileScan | <code>{ isInfected: boolean; }</code> | The scan verdict recorded on CLS, when present. |\n| isAntiVirusEnabled | <code>boolean</code> | Whether the scanner perimeter is active. |\n| status | <code>number</code> | Status code sent to the client. |\n\nsrc: packages/backend/src/metrics/metrics.interceptor.ts:43  \ndist: packages/backend/dist/metrics/metrics.interceptor.js:23\n","symbols":4,"lastUsed":1795730448366},"tdata:packages/backend/src/metrics/metrics.module.ts":{"doclets":[{"id":"MetricsModule","longname":"MetricsModule","name":"MetricsModule","kind":"member","scope":"global","description":"Metrics module: counters/histograms to SQLite and the `GET /metrics` endpoint.","params":[],"meta":{"lineno":41},"order":0,"mdaics":{"dist":"packages/backend/dist/metrics/metrics.module.js:10","src":"packages/backend/src/metrics/metrics.module.ts:14"},"level":0}],"fp":"f3ca3ee081d5fa3b67b575edc4995cb0766b645821c9b34153f8843001a76a4e","issues":[],"kind":"tdata","lastUsed":1795730448337,"symbols":0},"md:packages/backend/src/metrics/metrics.module.ts":{"fp":"9e9cf96e85cb824960d1e07257f68ca526d4db0f864daf48e5e5c22107d8844f","issues":[],"kind":"md","markdown":"<a name=\"MetricsModule\"></a>\n\n## MetricsModule\nMetrics module: counters/histograms to SQLite and the `GET /metrics` endpoint.\n\n**Kind**: global variable  \nsrc: packages/backend/src/metrics/metrics.module.ts:14  \ndist: packages/backend/dist/metrics/metrics.module.js:10\n","symbols":1,"lastUsed":1795730448480},"tdata:packages/backend/src/metrics/metrics.service.spec.ts":{"doclets":[{"id":"record","longname":"record","name":"record","kind":"function","scope":"global","description":"Convenience record with overridable fields.","params":[{"description":"Fields to override in the fixture record.","name":"overrides","type":{"names":["Partial<MetricsRecord>"]}}],"returns":[{"description":"A fully-populated record with defaults applied.","type":{"names":["MetricsRecord"]}}],"meta":{"lineno":24},"order":0,"mdaics":{"src":"packages/backend/src/metrics/metrics.service.spec.ts:28"},"level":0},{"id":"indexNames","longname":"indexNames","name":"indexNames","kind":"function","scope":"global","description":"Lists the hot-path indexes present in a metrics database.","params":[{"description":"Path to the temporary test database.","name":"databasePath","type":{"names":["string"]}}],"returns":[{"description":"The names of the indexes created by the service.","type":{"names":["string[]"]}}],"meta":{"lineno":48},"order":1,"mdaics":{"src":"packages/backend/src/metrics/metrics.service.spec.ts:53"},"level":0},{"id":"queryPlan","longname":"queryPlan","name":"queryPlan","kind":"function","scope":"global","description":"Returns the plan detail lines for a statement against a temporary store.","params":[{"description":"Path to the temporary test database.","name":"databasePath","type":{"names":["string"]}},{"description":"Statement to explain.","name":"sql","type":{"names":["string"]}}],"returns":[{"description":"The plan detail lines, in SQLite's order.","type":{"names":["string[]"]}}],"meta":{"lineno":74},"order":2,"mdaics":{"src":"packages/backend/src/metrics/metrics.service.spec.ts:80"},"level":0}],"fp":"c019629f634a6b89a36e3b1a26482584860457a5924799f8e23c7e327338b527","issues":[],"kind":"tdata","lastUsed":1795730448411,"symbols":0},"md:packages/backend/src/metrics/metrics.service.spec.ts":{"fp":"640257f1aaee21f75d0bfd8568660374454552b3c123ff61ea2a900dde26290c","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","markdown":"## Functions\n\n<dl>\n<dt><a href=\"#record\">record(overrides)</a> ⇒ <code>MetricsRecord</code></dt>\n<dd><p>Convenience record with overridable fields.</p>\n</dd>\n<dt><a href=\"#indexNames\">indexNames(databasePath)</a> ⇒ <code>string[]</code></dt>\n<dd><p>Lists the hot-path indexes present in a metrics database.</p>\n</dd>\n<dt><a href=\"#queryPlan\">queryPlan(databasePath, sql)</a> ⇒ <code>string[]</code></dt>\n<dd><p>Returns the plan detail lines for a statement against a temporary store.</p>\n</dd>\n</dl>\n\n<a name=\"record\"></a>\n\n## record(overrides) ⇒ <code>MetricsRecord</code>\nConvenience record with overridable fields.\n\n**Kind**: global function  \n**Returns**: <code>MetricsRecord</code> - A fully-populated record with defaults applied.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| overrides | <code>Partial&lt;MetricsRecord&gt;</code> | Fields to override in the fixture record. |\n\nsrc: packages/backend/src/metrics/metrics.service.spec.ts:28  \n<a name=\"indexNames\"></a>\n\n## indexNames(databasePath) ⇒ <code>string[]</code>\nLists the hot-path indexes present in a metrics database.\n\n**Kind**: global function  \n**Returns**: <code>string[]</code> - The names of the indexes created by the service.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| databasePath | <code>string</code> | Path to the temporary test database. |\n\nsrc: packages/backend/src/metrics/metrics.service.spec.ts:53  \n<a name=\"queryPlan\"></a>\n\n## queryPlan(databasePath, sql) ⇒ <code>string[]</code>\nReturns the plan detail lines for a statement against a temporary store.\n\n**Kind**: global function  \n**Returns**: <code>string[]</code> - The plan detail lines, in SQLite's order.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| databasePath | <code>string</code> | Path to the temporary test database. |\n| sql | <code>string</code> | Statement to explain. |\n\nsrc: packages/backend/src/metrics/metrics.service.spec.ts:80  \n","symbols":3,"lastUsed":1795730448516},"tdata:packages/backend/src/metrics/out-meter.ts":{"doclets":[{"id":"createOutMeter","longname":"createOutMeter","name":"createOutMeter","kind":"function","scope":"global","description":"Creates the pass-through meter counting streamed response bytes into CLS.\n\nThe transform forwards chunks unchanged (no copies) and stores the cumulative\nbyte count in CLS; the metrics interceptor reads it once the client closes.","params":[{"description":"CLS service carrying the request context.","name":"cls","type":{"names":["NormalizedClsService"]}}],"returns":[{"description":"A Transform placed between the source stream and the raw response.","type":{"names":["import(\"stream\").Transform"]}}],"meta":{"lineno":10},"order":0,"mdaics":{"dist":"packages/backend/dist/metrics/out-meter.js:2","src":"packages/backend/src/metrics/out-meter.ts:13"},"level":0}],"fp":"b08ad06c8e8d3ddbfe906b1f23667808abcaf4b54cac52d566eac7d02d288f5d","issues":[],"kind":"tdata","lastUsed":1795730448487,"symbols":0},"md:packages/backend/src/metrics/out-meter.ts":{"fp":"2cfaf134a5af6445a212ea9cea350e943cf9653da131ebdabf026f38e0e6d9db","issues":[],"kind":"md","markdown":"<a name=\"createOutMeter\"></a>\n\n## createOutMeter(cls) ⇒ <code>import(&quot;stream&quot;).Transform</code>\nCreates the pass-through meter counting streamed response bytes into CLS.\n\nThe transform forwards chunks unchanged (no copies) and stores the cumulative\nbyte count in CLS; the metrics interceptor reads it once the client closes.\n\n**Kind**: global function  \n**Returns**: <code>import(&quot;stream&quot;).Transform</code> - A Transform placed between the source stream and the raw response.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| cls | <code>NormalizedClsService</code> | CLS service carrying the request context. |\n\nsrc: packages/backend/src/metrics/out-meter.ts:13  \ndist: packages/backend/dist/metrics/out-meter.js:2\n","symbols":1,"lastUsed":1795730448596},"tdata:packages/backend/src/modules.spec.ts":{"doclets":[],"fp":"c5557470efdb571032399197ed1ecdf264a6b92d936e0297578254a13b5a9b51","issues":[],"kind":"tdata","lastUsed":1795730448573,"symbols":0},"md:packages/backend/src/modules.spec.ts":{"fp":"0d68d31f64720011c4bb5f46478a50de4c70623b29c1d74dd37859be9f4e95c5","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795730448596},"tdata:packages/backend/src/metrics/metrics.service.ts":{"doclets":[{"id":"MetricsService","longname":"MetricsService","name":"MetricsService","kind":"member","scope":"global","description":"Persistent, coalesced metrics store.\n\nWrites never happen on the request path: `record()` bumps in-memory delta\nmaps, and a timer (created in `onApplicationBootstrap`) drains them into a\nsingle transaction every `flushIntervalMs`. Reads merge pending deltas over\nthe persisted rows, so the payload is always fresh. A failed store logs and\ndisables itself; media serving is never affected.","params":[],"meta":{"lineno":118},"order":4,"mdaics":{"dist":"packages/backend/dist/metrics/metrics.service.js:73","src":"packages/backend/src/metrics/metrics.service.ts:307"},"level":0},{"id":"SCHEMA_VERSION","longname":"SCHEMA_VERSION","name":"SCHEMA_VERSION","kind":"constant","scope":"global","description":"Current schema version; kept in sync with the DDL below.","params":[],"meta":{"lineno":44},"order":0,"mdaics":{"dist":"packages/backend/dist/metrics/metrics.service.js:19","src":"packages/backend/src/metrics/metrics.service.ts:18"},"level":0},{"id":"HISTOGRAM_LE","longname":"HISTOGRAM_LE","name":"HISTOGRAM_LE","kind":"constant","scope":"global","description":"Latency histogram upper bounds, in seconds; 999999 is the open-ended bucket.","params":[],"customTags":[{"tag":"remarks","value":"Chosen to stay readable on a linear axis for a media service."}],"meta":{"lineno":49},"order":1,"mdaics":{"dist":"packages/backend/dist/metrics/metrics.service.js:20","src":"packages/backend/src/metrics/metrics.service.ts:24"},"level":0},{"id":"INDEX_DDL","longname":"INDEX_DDL","name":"INDEX_DDL","kind":"constant","scope":"global","description":"Indexes for the retention sweep (bucket prefix) and the name-keyed rollups.\nIdempotent so an existing version-1 database gains them on the next open.","params":[],"meta":{"lineno":79},"order":2,"mdaics":{"dist":"packages/backend/dist/metrics/metrics.service.js:46","src":"packages/backend/src/metrics/metrics.service.ts:56"},"level":0},{"id":"MAX_DELTA_KEYS","longname":"MAX_DELTA_KEYS","name":"MAX_DELTA_KEYS","kind":"constant","scope":"global","description":"Bounded delta buffers: a persistently failing store drops counts rather than grow memory without limit.","params":[],"meta":{"lineno":92},"order":3,"mdaics":{"dist":"packages/backend/dist/metrics/metrics.service.js:56","src":"packages/backend/src/metrics/metrics.service.ts:266"},"level":0},{"id":"allRows","longname":"allRows","name":"allRows","kind":"function","scope":"global","description":"Runs a prepared statement and returns every row typed as `T`.\n\nnode:sqlite types `StatementSync.all()` as `Record<string, SQLOutputValue>[]`,\nwhich is not assignable to a row-specific shape without an intermediate\n`unknown`, so the single cast below is unavoidable.","params":[{"description":"Open SQLite database.","name":"database","type":{"names":["DatabaseSync"]}},{"description":"SQL text to prepare (passed through verbatim).","name":"sql","type":{"names":["string"]}},{"description":"Bound parameters for the statement.","name":"parameters","variable":true,"type":{"names":["import(\"node:sqlite\").SQLInputValue[]"]}}],"returns":[{"description":"All result rows as `T[]`.","type":{"names":["T[]"]}}],"meta":{"lineno":657},"order":13,"mdaics":{"dist":"packages/backend/dist/metrics/metrics.service.js:552","src":"packages/backend/src/metrics/metrics.service.ts:825"},"level":0},{"id":"MetricsService#flush","longname":"MetricsService#flush","name":"flush","kind":"function","scope":"instance","description":"Drains all pending deltas into a single transaction.","memberof":"MetricsService","params":[],"meta":{"lineno":162},"order":5,"mdaics":{"dist":"packages/backend/dist/metrics/metrics.service.js:99","src":"packages/backend/src/metrics/metrics.service.ts:344"},"level":0},{"id":"MetricsService#inflightDec","longname":"MetricsService#inflightDec","name":"inflightDec","kind":"function","scope":"instance","description":"Decrements the live in-flight counter.","memberof":"MetricsService","params":[],"meta":{"lineno":202},"order":6,"mdaics":{"dist":"packages/backend/dist/metrics/metrics.service.js:135","src":"packages/backend/src/metrics/metrics.service.ts:385"},"level":0},{"id":"MetricsService#inflightInc","longname":"MetricsService#inflightInc","name":"inflightInc","kind":"function","scope":"instance","description":"Increments the live in-flight counter.","memberof":"MetricsService","params":[],"meta":{"lineno":208},"order":7,"mdaics":{"dist":"packages/backend/dist/metrics/metrics.service.js:138","src":"packages/backend/src/metrics/metrics.service.ts:392"},"level":0},{"id":"MetricsService#onApplicationBootstrap","longname":"MetricsService#onApplicationBootstrap","name":"onApplicationBootstrap","kind":"function","scope":"instance","description":"Starts the flush and retention timers; never in unit tests.","memberof":"MetricsService","params":[],"meta":{"lineno":214},"order":8,"mdaics":{"dist":"packages/backend/dist/metrics/metrics.service.js:141","src":"packages/backend/src/metrics/metrics.service.ts:399"},"level":0},{"id":"MetricsService#onApplicationShutdown","longname":"MetricsService#onApplicationShutdown","name":"onApplicationShutdown","kind":"function","scope":"instance","description":"Stops timers, flushes the last deltas and closes the database.","memberof":"MetricsService","params":[],"meta":{"lineno":234},"order":9,"mdaics":{"dist":"packages/backend/dist/metrics/metrics.service.js:158","src":"packages/backend/src/metrics/metrics.service.ts:420"},"level":0},{"id":"MetricsService#record","longname":"MetricsService#record","name":"record","kind":"function","scope":"instance","description":"Records one completed request.","memberof":"MetricsService","params":[{"description":"Normalized request data from the interceptor.","name":"record","type":{"names":["MetricsRecord"]}}],"meta":{"lineno":244},"order":10,"mdaics":{"dist":"packages/backend/dist/metrics/metrics.service.js:164","src":"packages/backend/src/metrics/metrics.service.ts:431"},"level":0},{"id":"MetricsService#snapshot","longname":"MetricsService#snapshot","name":"snapshot","kind":"function","scope":"instance","description":"Builds the aggregated payload the dashboard consumes. Persisted rows are\nkey-scoped and pending deltas are merged on every call, so the live fields\nstay current without a cache layer that could go stale between polls.","memberof":"MetricsService","params":[],"returns":[{"description":"The current snapshot.","type":{"names":["MetricsSnapshot"]}}],"meta":{"lineno":275},"order":11,"mdaics":{"dist":"packages/backend/dist/metrics/metrics.service.js:189","src":"packages/backend/src/metrics/metrics.service.ts:456"},"level":0},{"id":"MetricsService#sweep","longname":"MetricsService#sweep","name":"sweep","kind":"function","scope":"instance","description":"Deletes hourly/daily rows older than `retentionDays`.","memberof":"MetricsService","params":[{"description":"Days to keep; rows older than this are deleted.","name":"retentionDays","type":{"names":["number"]}}],"meta":{"lineno":301},"order":12,"mdaics":{"dist":"packages/backend/dist/metrics/metrics.service.js:211","src":"packages/backend/src/metrics/metrics.service.ts:483"},"level":0}],"fp":"95197671ab39bd1e82f16401ad9c7f0389180f191ecb6e3e36ecc3004579ce7d","issues":[],"kind":"tdata","lastUsed":1795730448484,"symbols":0},"md:packages/backend/src/metrics/metrics.service.ts":{"fp":"f65a993d23de085840f2b3fcf7fc6901499f693994416adc0fe4cb4aedf497fb","issues":[],"kind":"md","markdown":"## Members\n\n<dl>\n<dt><a href=\"#MetricsService\">MetricsService</a></dt>\n<dd><p>Persistent, coalesced metrics store.</p>\n<p>Writes never happen on the request path: <code>record()</code> bumps in-memory delta\nmaps, and a timer (created in <code>onApplicationBootstrap</code>) drains them into a\nsingle transaction every <code>flushIntervalMs</code>. Reads merge pending deltas over\nthe persisted rows, so the payload is always fresh. A failed store logs and\ndisables itself; media serving is never affected.</p>\n</dd>\n</dl>\n\n## Constants\n\n<dl>\n<dt><a href=\"#SCHEMA_VERSION\">SCHEMA_VERSION</a></dt>\n<dd><p>Current schema version; kept in sync with the DDL below.</p>\n</dd>\n<dt><a href=\"#HISTOGRAM_LE\">HISTOGRAM_LE</a></dt>\n<dd><p>Latency histogram upper bounds, in seconds; 999999 is the open-ended bucket.</p>\n</dd>\n<dt><a href=\"#INDEX_DDL\">INDEX_DDL</a></dt>\n<dd><p>Indexes for the retention sweep (bucket prefix) and the name-keyed rollups.\nIdempotent so an existing version-1 database gains them on the next open.</p>\n</dd>\n<dt><a href=\"#MAX_DELTA_KEYS\">MAX_DELTA_KEYS</a></dt>\n<dd><p>Bounded delta buffers: a persistently failing store drops counts rather than grow memory without limit.</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#allRows\">allRows(database, sql, ...parameters)</a> ⇒ <code>T[]</code></dt>\n<dd><p>Runs a prepared statement and returns every row typed as <code>T</code>.</p>\n<p>node:sqlite types <code>StatementSync.all()</code> as <code>Record&lt;string, SQLOutputValue&gt;[]</code>,\nwhich is not assignable to a row-specific shape without an intermediate\n<code>unknown</code>, so the single cast below is unavoidable.</p>\n</dd>\n</dl>\n\n<a name=\"MetricsService\"></a>\n\n## MetricsService\nPersistent, coalesced metrics store.\n\nWrites never happen on the request path: `record()` bumps in-memory delta\nmaps, and a timer (created in `onApplicationBootstrap`) drains them into a\nsingle transaction every `flushIntervalMs`. Reads merge pending deltas over\nthe persisted rows, so the payload is always fresh. A failed store logs and\ndisables itself; media serving is never affected.\n\n**Kind**: global variable  \nsrc: packages/backend/src/metrics/metrics.service.ts:307  \ndist: packages/backend/dist/metrics/metrics.service.js:73\n\n* [MetricsService](#MetricsService)\n    * [.flush()](#MetricsService+flush)\n    * [.inflightDec()](#MetricsService+inflightDec)\n    * [.inflightInc()](#MetricsService+inflightInc)\n    * [.onApplicationBootstrap()](#MetricsService+onApplicationBootstrap)\n    * [.onApplicationShutdown()](#MetricsService+onApplicationShutdown)\n    * [.record(record)](#MetricsService+record)\n    * [.snapshot()](#MetricsService+snapshot) ⇒ <code>MetricsSnapshot</code>\n    * [.sweep(retentionDays)](#MetricsService+sweep)\n\n<a name=\"MetricsService+flush\"></a>\n\n### metricsService.flush()\nDrains all pending deltas into a single transaction.\n\n**Kind**: instance method of [<code>MetricsService</code>](#MetricsService)  \nsrc: packages/backend/src/metrics/metrics.service.ts:344  \ndist: packages/backend/dist/metrics/metrics.service.js:99\n<a name=\"MetricsService+inflightDec\"></a>\n\n### metricsService.inflightDec()\nDecrements the live in-flight counter.\n\n**Kind**: instance method of [<code>MetricsService</code>](#MetricsService)  \nsrc: packages/backend/src/metrics/metrics.service.ts:385  \ndist: packages/backend/dist/metrics/metrics.service.js:135\n<a name=\"MetricsService+inflightInc\"></a>\n\n### metricsService.inflightInc()\nIncrements the live in-flight counter.\n\n**Kind**: instance method of [<code>MetricsService</code>](#MetricsService)  \nsrc: packages/backend/src/metrics/metrics.service.ts:392  \ndist: packages/backend/dist/metrics/metrics.service.js:138\n<a name=\"MetricsService+onApplicationBootstrap\"></a>\n\n### metricsService.onApplicationBootstrap()\nStarts the flush and retention timers; never in unit tests.\n\n**Kind**: instance method of [<code>MetricsService</code>](#MetricsService)  \nsrc: packages/backend/src/metrics/metrics.service.ts:399  \ndist: packages/backend/dist/metrics/metrics.service.js:141\n<a name=\"MetricsService+onApplicationShutdown\"></a>\n\n### metricsService.onApplicationShutdown()\nStops timers, flushes the last deltas and closes the database.\n\n**Kind**: instance method of [<code>MetricsService</code>](#MetricsService)  \nsrc: packages/backend/src/metrics/metrics.service.ts:420  \ndist: packages/backend/dist/metrics/metrics.service.js:158\n<a name=\"MetricsService+record\"></a>\n\n### metricsService.record(record)\nRecords one completed request.\n\n**Kind**: instance method of [<code>MetricsService</code>](#MetricsService)  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| record | <code>MetricsRecord</code> | Normalized request data from the interceptor. |\n\nsrc: packages/backend/src/metrics/metrics.service.ts:431  \ndist: packages/backend/dist/metrics/metrics.service.js:164\n<a name=\"MetricsService+snapshot\"></a>\n\n### metricsService.snapshot() ⇒ <code>MetricsSnapshot</code>\nBuilds the aggregated payload the dashboard consumes. Persisted rows are\nkey-scoped and pending deltas are merged on every call, so the live fields\nstay current without a cache layer that could go stale between polls.\n\n**Kind**: instance method of [<code>MetricsService</code>](#MetricsService)  \n**Returns**: <code>MetricsSnapshot</code> - The current snapshot.  \nsrc: packages/backend/src/metrics/metrics.service.ts:456  \ndist: packages/backend/dist/metrics/metrics.service.js:189\n<a name=\"MetricsService+sweep\"></a>\n\n### metricsService.sweep(retentionDays)\nDeletes hourly/daily rows older than `retentionDays`.\n\n**Kind**: instance method of [<code>MetricsService</code>](#MetricsService)  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| retentionDays | <code>number</code> | Days to keep; rows older than this are deleted. |\n\nsrc: packages/backend/src/metrics/metrics.service.ts:483  \ndist: packages/backend/dist/metrics/metrics.service.js:211\n<a name=\"SCHEMA_VERSION\"></a>\n\n## SCHEMA\\_VERSION\nCurrent schema version; kept in sync with the DDL below.\n\n**Kind**: global constant  \nsrc: packages/backend/src/metrics/metrics.service.ts:18  \ndist: packages/backend/dist/metrics/metrics.service.js:19\n<a name=\"HISTOGRAM_LE\"></a>\n\n## HISTOGRAM\\_LE\nLatency histogram upper bounds, in seconds; 999999 is the open-ended bucket.\n\n**Kind**: global constant  \n**Remarks**: Chosen to stay readable on a linear axis for a media service.  \nsrc: packages/backend/src/metrics/metrics.service.ts:24  \ndist: packages/backend/dist/metrics/metrics.service.js:20\n<a name=\"INDEX_DDL\"></a>\n\n## INDEX\\_DDL\nIndexes for the retention sweep (bucket prefix) and the name-keyed rollups.\nIdempotent so an existing version-1 database gains them on the next open.\n\n**Kind**: global constant  \nsrc: packages/backend/src/metrics/metrics.service.ts:56  \ndist: packages/backend/dist/metrics/metrics.service.js:46\n<a name=\"MAX_DELTA_KEYS\"></a>\n\n## MAX\\_DELTA\\_KEYS\nBounded delta buffers: a persistently failing store drops counts rather than grow memory without limit.\n\n**Kind**: global constant  \nsrc: packages/backend/src/metrics/metrics.service.ts:266  \ndist: packages/backend/dist/metrics/metrics.service.js:56\n<a name=\"allRows\"></a>\n\n## allRows(database, sql, ...parameters) ⇒ <code>T[]</code>\nRuns a prepared statement and returns every row typed as `T`.\n\nnode:sqlite types `StatementSync.all()` as `Record<string, SQLOutputValue>[]`,\nwhich is not assignable to a row-specific shape without an intermediate\n`unknown`, so the single cast below is unavoidable.\n\n**Kind**: global function  \n**Returns**: <code>T[]</code> - All result rows as `T[]`.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| database | <code>DatabaseSync</code> | Open SQLite database. |\n| sql | <code>string</code> | SQL text to prepare (passed through verbatim). |\n| ...parameters | <code>import(&quot;node:sqlite&quot;).SQLInputValue[]</code> | Bound parameters for the statement. |\n\nsrc: packages/backend/src/metrics/metrics.service.ts:825  \ndist: packages/backend/dist/metrics/metrics.service.js:552\n","symbols":14,"lastUsed":1795730448561},"tdata:packages/backend/src/resources/audio/audio-dna.worker.spec.ts":{"doclets":[{"id":"captureStdout","longname":"captureStdout","name":"captureStdout","kind":"function","scope":"global","description":"Replaces process.stdout with a capturing Writable; returns collected chunks.","params":[],"returns":[{"description":"The array collecting written chunks.","type":{"names":["Buffer<ArrayBufferLike>[]"]}}],"meta":{"lineno":11},"order":0,"mdaics":{"src":"packages/backend/src/resources/audio/audio-dna.worker.spec.ts:22"},"level":0},{"id":"runDna","longname":"runDna","name":"runDna","kind":"function","scope":"global","description":"Runs the audio DNA worker over the 6 s fixture and parses its stdout JSON line.","params":[],"returns":[{"description":"The parsed DNA result.","type":{"names":["Promise<AudioDnaResult>"]}}],"meta":{"lineno":27},"async":true,"order":1,"mdaics":{"src":"packages/backend/src/resources/audio/audio-dna.worker.spec.ts:39"},"level":0}],"fp":"a2a4e481e4d99ebaf08040f77e9ee27950935d45e1908bfdf3f8f77992e560dc","issues":[],"kind":"tdata","lastUsed":1795730448573,"symbols":0},"md:packages/backend/src/resources/audio/audio-dna.worker.spec.ts":{"fp":"e4b93b09284377c49eea37008d0f50cdb4092a4badc4d08dae7b81c8ebe05da0","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","markdown":"## Functions\n\n<dl>\n<dt><a href=\"#captureStdout\">captureStdout()</a> ⇒ <code>Buffer&lt;ArrayBufferLike&gt;[]</code></dt>\n<dd><p>Replaces process.stdout with a capturing Writable; returns collected chunks.</p>\n</dd>\n<dt><a href=\"#runDna\">runDna()</a> ⇒ <code>Promise&lt;AudioDnaResult&gt;</code></dt>\n<dd><p>Runs the audio DNA worker over the 6 s fixture and parses its stdout JSON line.</p>\n</dd>\n</dl>\n\n<a name=\"captureStdout\"></a>\n\n## captureStdout() ⇒ <code>Buffer&lt;ArrayBufferLike&gt;[]</code>\nReplaces process.stdout with a capturing Writable; returns collected chunks.\n\n**Kind**: global function  \n**Returns**: <code>Buffer&lt;ArrayBufferLike&gt;[]</code> - The array collecting written chunks.  \nsrc: packages/backend/src/resources/audio/audio-dna.worker.spec.ts:22  \n<a name=\"runDna\"></a>\n\n## runDna() ⇒ <code>Promise&lt;AudioDnaResult&gt;</code>\nRuns the audio DNA worker over the 6 s fixture and parses its stdout JSON line.\n\n**Kind**: global function  \n**Returns**: <code>Promise&lt;AudioDnaResult&gt;</code> - The parsed DNA result.  \nsrc: packages/backend/src/resources/audio/audio-dna.worker.spec.ts:39  \n","symbols":2,"lastUsed":1795730448624},"tdata:packages/backend/src/resources/audio/audio-signature.interceptor.spec.ts":{"doclets":[],"fp":"16b35e40f8412c449dba800c0b0cabfb8d10bdb7d46284a71dd92ebd639c82eb","issues":[],"kind":"tdata","lastUsed":1795730448633,"symbols":0},"md:packages/backend/src/resources/audio/audio-signature.interceptor.spec.ts":{"fp":"0d786a22a18d0928ea5ad7a5fd4b125ea870bd8576f1c20fe1676bbecab9a316","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795730448639},"tdata:packages/backend/src/resources/audio/audio-signature.interceptor.ts":{"doclets":[{"id":"AudioSignatureInterceptor","longname":"AudioSignatureInterceptor","name":"AudioSignatureInterceptor","kind":"member","scope":"global","description":"Rejects /audio requests whose probed signature is not an audio mime (runs after the signature scan).","params":[],"meta":{"lineno":40},"order":0,"mdaics":{"dist":"packages/backend/dist/resources/audio/audio-signature.inte