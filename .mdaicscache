turns the detected signature of the scanned file (POST).","memberof":"AppController","params":[],"returns":[{"description":"The file signature's extension and MIME type.","type":{"names":["{ ext: any; mime: any; }"]}}],"meta":{"lineno":106},"order":4,"mdaics":{"dist":"packages/backend/dist/app.controller.js:33","src":"packages/backend/src/app.controller.ts:60"},"level":0},{"id":"AppController#virusScanGet","longname":"AppController#virusScanGet","name":"virusScanGet","kind":"function","scope":"instance","description":"Returns the antivirus scan result for the scanned file (GET).","memberof":"AppController","params":[],"returns":[{"description":"Whether the file is infected and the list of detected viruses.","type":{"names":["{ isInfected: any; viruses: any; }"]}}],"meta":{"lineno":113},"order":5,"mdaics":{"dist":"packages/backend/dist/app.controller.js:36","src":"packages/backend/src/app.controller.ts:70"},"level":0},{"id":"AppController#virusScanPost","longname":"AppController#virusScanPost","name":"virusScanPost","kind":"function","scope":"instance","description":"Returns the antivirus scan result for the scanned file (POST).","memberof":"AppController","params":[],"returns":[{"description":"Whether the file is infected and the list of detected viruses.","type":{"names":["{ isInfected: any; viruses: any; }"]}}],"meta":{"lineno":120},"order":6,"mdaics":{"dist":"packages/backend/dist/app.controller.js:39","src":"packages/backend/src/app.controller.ts:80"},"level":0}],"fp":"6c3ccb20511eda9979b5321ce5cb334983a5b704f8d5bc3c61253cae6cdf1ab4","issues":[],"kind":"tdata","lastUsed":1795730447133,"symbols":0},"tdata:packages/backend/src/app.module.ts":{"doclets":[{"id":"OtelShutdownService","longname":"OtelShutdownService","name":"OtelShutdownService","kind":"member","scope":"global","description":"Flushes pending spans and host metrics when Nest closes on SIGTERM; a no-op when telemetry is disabled.","params":[],"meta":{"lineno":63},"order":0,"mdaics":{"dist":"packages/backend/dist/app.module.js:32","src":"packages/backend/src/app.module.ts:35"},"level":0},{"id":"AppModule","longname":"AppModule","name":"AppModule","kind":"member","scope":"global","description":"Root module: imports every feature module, global metrics/logging and the static dashboard.","params":[],"meta":{"lineno":91},"order":2,"mdaics":{"dist":"packages/backend/dist/app.module.js:42","src":"packages/backend/src/app.module.ts:108"},"level":0},{"id":"OtelShutdownService#onApplicationShutdown","longname":"OtelShutdownService#onApplicationShutdown","name":"onApplicationShutdown","kind":"function","scope":"instance","memberof":"OtelShutdownService","params":[],"returns":[{"description":"Settles once the OpenTelemetry SDK has flushed and released resources.","type":{"names":["Promise<void>"]}}],"meta":{"lineno":80},"async":true,"order":1,"mdaics":{"dist":"packages/backend/dist/app.module.js:33","src":"packages/backend/src/app.module.ts:39"},"level":0}],"fp":"51c2600be2e95a798aba9aa7ccc7cab3cbfcb85c4d018ba819a6b2d1fac131cd","issues":[],"kind":"tdata","lastUsed":1795730447133,"symbols":0},"md:packages/backend/src/app.module.ts":{"fp":"cf163da7ccd5338e1bf93bcb2ab95e1a9ae17fca327dad850e101165c94744ec","issues":[],"kind":"md","markdown":"## Members\n\n<dl>\n<dt><a href=\"#OtelShutdownService\">OtelShutdownService</a></dt>\n<dd><p>Flushes pending spans and host metrics when Nest closes on SIGTERM; a no-op when telemetry is disabled.</p>\n</dd>\n<dt><a href=\"#AppModule\">AppModule</a></dt>\n<dd><p>Root module: imports every feature module, global metrics/logging and the static dashboard.</p>\n</dd>\n</dl>\n\n<a name=\"OtelShutdownService\"></a>\n\n## OtelShutdownService\nFlushes pending spans and host metrics when Nest closes on SIGTERM; a no-op when telemetry is disabled.\n\n**Kind**: global variable  \nsrc: packages/backend/src/app.module.ts:35  \ndist: packages/backend/dist/app.module.js:32\n<a name=\"OtelShutdownService+onApplicationShutdown\"></a>\n\n### otelShutdownService.onApplicationShutdown() ⇒ <code>Promise&lt;void&gt;</code>\n**Kind**: instance method of [<code>OtelShutdownService</code>](#OtelShutdownService)  \n**Returns**: <code>Promise&lt;void&gt;</code> - Settles once the OpenTelemetry SDK has flushed and released resources.  \nsrc: packages/backend/src/app.module.ts:39  \ndist: packages/backend/dist/app.module.js:33\n<a name=\"AppModule\"></a>\n\n## AppModule\nRoot module: imports every feature module, global metrics/logging and the static dashboard.\n\n**Kind**: global variable  \nsrc: packages/backend/src/app.module.ts:108  \ndist: packages/backend/dist/app.module.js:42\n","symbols":3,"lastUsed":1795730447398},"md:packages/backend/src/app.controller.ts":{"fp":"c93a72ff5582c925cb20c486e19c364aab2d21171e97781e146095afd51e1483","issues":[],"kind":"md","markdown":"## Members\n\n<dl>\n<dt><a href=\"#AppController\">AppController</a></dt>\n<dd><p>Root routes: signature and antivirus verdicts for scanned payloads.</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#signatureOf\">signatureOf(normalizedCls)</a> ⇒ <code>{ ext: any; mime: any; }</code></dt>\n<dd><p>Reads the file signature from CLS.</p>\n</dd>\n<dt><a href=\"#virusScanOf\">virusScanOf(normalizedCls)</a> ⇒ <code>{ isInfected: any; viruses: any; }</code></dt>\n<dd><p>Reads the antivirus scan result from CLS.</p>\n</dd>\n</dl>\n\n<a name=\"AppController\"></a>\n\n## AppController\nRoot routes: signature and antivirus verdicts for scanned payloads.\n\n**Kind**: global variable  \nsrc: packages/backend/src/app.controller.ts:39  \ndist: packages/backend/dist/app.controller.js:25\n\n* [AppController](#AppController)\n    * [.signatureGet()](#AppController+signatureGet) ⇒ <code>{ ext: any; mime: any; }</code>\n    * [.signaturePost()](#AppController+signaturePost) ⇒ <code>{ ext: any; mime: any; }</code>\n    * [.virusScanGet()](#AppController+virusScanGet) ⇒ <code>{ isInfected: any; viruses: any; }</code>\n    * [.virusScanPost()](#AppController+virusScanPost) ⇒ <code>{ isInfected: any; viruses: any; }</code>\n\n<a name=\"AppController+signatureGet\"></a>\n\n### appController.signatureGet() ⇒ <code>{ ext: any; mime: any; }</code>\nReturns the detected signature of the scanned file (GET).\n\n**Kind**: instance method of [<code>AppController</code>](#AppController)  \n**Returns**: <code>{ ext: any; mime: any; }</code> - The file signature's extension and MIME type.  \nsrc: packages/backend/src/app.controller.ts:50  \ndist: packages/backend/dist/app.controller.js:30\n<a name=\"AppController+signaturePost\"></a>\n\n### appController.signaturePost() ⇒ <code>{ ext: any; mime: any; }</code>\nReturns the detected signature of the scanned file (POST).\n\n**Kind**: instance method of [<code>AppController</code>](#AppController)  \n**Returns**: <code>{ ext: any; mime: any; }</code> - The file signature's extension and MIME type.  \nsrc: packages/backend/src/app.controller.ts:60  \ndist: packages/backend/dist/app.controller.js:33\n<a name=\"AppController+virusScanGet\"></a>\n\n### appController.virusScanGet() ⇒ <code>{ isInfected: any; viruses: any; }</code>\nReturns the antivirus scan result for the scanned file (GET).\n\n**Kind**: instance method of [<code>AppController</code>](#AppController)  \n**Returns**: <code>{ isInfected: any; viruses: any; }</code> - Whether the file is infected and the list of detected viruses.  \nsrc: packages/backend/src/app.controller.ts:70  \ndist: packages/backend/dist/app.controller.js:36\n<a name=\"AppController+virusScanPost\"></a>\n\n### appController.virusScanPost() ⇒ <code>{ isInfected: any; viruses: any; }</code>\nReturns the antivirus scan result for the scanned file (POST).\n\n**Kind**: instance method of [<code>AppController</code>](#AppController)  \n**Returns**: <code>{ isInfected: any; viruses: any; }</code> - Whether the file is infected and the list of detected viruses.  \nsrc: packages/backend/src/app.controller.ts:80  \ndist: packages/backend/dist/app.controller.js:39\n<a name=\"signatureOf\"></a>\n\n## signatureOf(normalizedCls) ⇒ <code>{ ext: any; mime: any; }</code>\nReads the file signature from CLS.\n\n**Kind**: global function  \n**Returns**: <code>{ ext: any; mime: any; }</code> - The file signature's extension and MIME type.  \n**Throws**:\n\n- ServiceUnavailableException When no file signature is available in CLS.\n\n\n| Param | Type | Description |\n| --- | --- | --- |\n| normalizedCls | <code>NormalizedClsService</code> | CLS facade carrying the scanned request's signature. |\n\nsrc: packages/backend/src/app.controller.ts:17  \ndist: packages/backend/dist/app.controller.js:13\n<a name=\"virusScanOf\"></a>\n\n## virusScanOf(normalizedCls) ⇒ <code>{ isInfected: any; viruses: any; }</code>\nReads the antivirus scan result from CLS.\n\n**Kind**: global function  \n**Returns**: <code>{ isInfected: any; viruses: any; }</code> - Whether the file is infected and the list of detected viruses.  \n**Throws**:\n\n- ServiceUnavailableException When no scan result is available in CLS (antivirus not configured).\n\n\n| Param | Type | Description |\n| --- | --- | --- |\n| normalizedCls | <code>NormalizedClsService</code> | CLS facade carrying the scan verdict. |\n\nsrc: packages/backend/src/app.controller.ts:29  \ndist: packages/backend/dist/app.controller.js:19\n","symbols":7,"lastUsed":1795730447304},"tdata:packages/backend/src/constants/cls.ts":{"doclets":[{"id":"CLS_CACHE_OUTCOME","longname":"CLS_CACHE_OUTCOME","name":"CLS_CACHE_OUTCOME","kind":"constant","scope":"global","description":"Outcome of the worker cache lookup for this request (`hit` | `miss`).","meta":{"lineno":4},"order":0,"mdaics":{"dist":"packages/backend/dist/constants/cls.js:1","src":"packages/backend/src/constants/cls.ts:4"},"level":0},{"id":"CLS_BYTES_IN","longname":"CLS_BYTES_IN","name":"CLS_BYTES_IN","kind":"constant","scope":"global","description":"Count of bytes received for this request (signature/file-hash path or download meter).","meta":{"lineno":8},"order":1,"mdaics":{"dist":"packages/backend/dist/constants/cls.js:2","src":"packages/backend/src/constants/cls.ts:9"},"level":0},{"id":"CLS_BYTES_OUT","longname":"CLS_BYTES_OUT","name":"CLS_BYTES_OUT","kind":"constant","scope":"global","description":"Count of bytes streamed to the client for this request (via the out meter).","meta":{"lineno":12},"order":2,"mdaics":{"dist":"packages/backend/dist/constants/cls.js:3","src":"packages/backend/src/constants/cls.ts:14"},"level":0},{"id":"CLS_CACHE_KEY","longname":"CLS_CACHE_KEY","name":"CLS_CACHE_KEY","kind":"constant","scope":"global","description":"Deterministic cache key for this request (file hash + query, or body digest).","meta":{"lineno":16},"order":3,"mdaics":{"dist":"packages/backend/dist/constants/cls.js:4","src":"packages/backend/src/constants/cls.ts:19"},"level":0},{"id":"CLS_FILE_HASH","longname":"CLS_FILE_HASH","name":"CLS_FILE_HASH","kind":"constant","scope":"global","description":"SHA-512 of the uploaded bytes (or its first FILE_HASH_HEADER_SIZE bytes).","meta":{"lineno":20},"order":4,"mdaics":{"dist":"packages/backend/dist/constants/cls.js:5","src":"packages/backend/src/constants/cls.ts:24"},"level":0},{"id":"CLS_FILE_SCAN","longname":"CLS_FILE_SCAN","name":"CLS_FILE_SCAN","kind":"constant","scope":"global","description":"Result of the virus scan for this request, when scanning is enabled.","meta":{"lineno":24},"order":5,"mdaics":{"dist":"packages/backend/dist/constants/cls.js:6","src":"packages/backend/src/constants/cls.ts:29"},"level":0},{"id":"CLS_FILE_SIGNATURE","longname":"CLS_FILE_SIGNATURE","name":"CLS_FILE_SIGNATURE","kind":"constant","scope":"global","description":"Detected file-type signature of the upload, when probed.","meta":{"lineno":28},"order":6,"mdaics":{"dist":"packages/backend/dist/constants/cls.js:7","src":"packages/backend/src/constants/cls.ts:34"},"level":0},{"id":"CLS_SOURCE_DIRECTION","longname":"CLS_SOURCE_DIRECTION","name":"CLS_SOURCE_DIRECTION","kind":"constant","scope":"global","description":"Direction of the media source: `upload` (POST body) or `download` (`source=` URL).","meta":{"lineno":32},"order":7,"mdaics":{"dist":"packages/backend/dist/constants/cls.js:8","src":"packages/backend/src/constants/cls.ts:39"},"level":0},{"id":"CLS_SOURCE_STREAM","longname":"CLS_SOURCE_STREAM","name":"CLS_SOURCE_STREAM","kind":"constant","scope":"global","description":"The (possibly capped) media stream for this request, set by the scanner/parser.","meta":{"lineno":36},"order":8,"mdaics":{"dist":"packages/backend/dist/constants/cls.js:9","src":"packages/backend/src/constants/cls.ts:44"},"level":0}],"fp":"0bfb48cd9f6b68c435c1946c4d7d04df3e2c8aa86b42551318d7c80535f47f31","issues":[],"kind":"tdata","lastUsed":1795730447476,"symbols":0},"md:packages/backend/src/constants/cls.ts":{"fp":"86210f9b2f98226a1828642b2994549f84732b788a241899b67a25b28abd4e24","issues":[],"kind":"md","markdown":"## Constants\n\n<dl>\n<dt><a href=\"#CLS_CACHE_OUTCOME\">CLS_CACHE_OUTCOME</a></dt>\n<dd><p>Outcome of the worker cache lookup for this request (<code>hit</code> | <code>miss</code>).</p>\n</dd>\n<dt><a href=\"#CLS_BYTES_IN\">CLS_BYTES_IN</a></dt>\n<dd><p>Count of bytes received for this request (signature/file-hash path or download meter).</p>\n</dd>\n<dt><a href=\"#CLS_BYTES_OUT\">CLS_BYTES_OUT</a></dt>\n<dd><p>Count of bytes streamed to the client for this request (via the out meter).</p>\n</dd>\n<dt><a href=\"#CLS_CACHE_KEY\">CLS_CACHE_KEY</a></dt>\n<dd><p>Deterministic cache key for this request (file hash + query, or body digest).</p>\n</dd>\n<dt><a href=\"#CLS_FILE_HASH\">CLS_FILE_HASH</a></dt>\n<dd><p>SHA-512 of the uploaded bytes (or its first FILE_HASH_HEADER_SIZE bytes).</p>\n</dd>\n<dt><a href=\"#CLS_FILE_SCAN\">CLS_FILE_SCAN</a></dt>\n<dd><p>Result of the virus scan for this request, when scanning is enabled.</p>\n</dd>\n<dt><a href=\"#CLS_FILE_SIGNATURE\">CLS_FILE_SIGNATURE</a></dt>\n<dd><p>Detected file-type signature of the upload, when probed.</p>\n</dd>\n<dt><a href=\"#CLS_SOURCE_DIRECTION\">CLS_SOURCE_DIRECTION</a></dt>\n<dd><p>Direction of the media source: <code>upload</code> (POST body) or <code>download</code> (<code>source=</code> URL).</p>\n</dd>\n<dt><a href=\"#CLS_SOURCE_STREAM\">CLS_SOURCE_STREAM</a></dt>\n<dd><p>The (possibly capped) media stream for this request, set by the scanner/parser.</p>\n</dd>\n</dl>\n\n<a name=\"CLS_CACHE_OUTCOME\"></a>\n\n## CLS\\_CACHE\\_OUTCOME\nOutcome of the worker cache lookup for this request (`hit` | `miss`).\n\n**Kind**: global constant  \nsrc: packages/backend/src/constants/cls.ts:4  \ndist: packages/backend/dist/constants/cls.js:1\n<a name=\"CLS_BYTES_IN\"></a>\n\n## CLS\\_BYTES\\_IN\nCount of bytes received for this request (signature/file-hash path or download meter).\n\n**Kind**: global constant  \nsrc: packages/backend/src/constants/cls.ts:9  \ndist: packages/backend/dist/constants/cls.js:2\n<a name=\"CLS_BYTES_OUT\"></a>\n\n## CLS\\_BYTES\\_OUT\nCount of bytes streamed to the client for this request (via the out meter).\n\n**Kind**: global constant  \nsrc: packages/backend/src/constants/cls.ts:14  \ndist: packages/backend/dist/constants/cls.js:3\n<a name=\"CLS_CACHE_KEY\"></a>\n\n## CLS\\_CACHE\\_KEY\nDeterministic cache key for this request (file hash + query, or body digest).\n\n**Kind**: global constant  \nsrc: packages/backend/src/constants/cls.ts:19  \ndist: packages/backend/dist/constants/cls.js:4\n<a name=\"CLS_FILE_HASH\"></a>\n\n## CLS\\_FILE\\_HASH\nSHA-512 of the uploaded bytes (or its first FILE_HASH_HEADER_SIZE bytes).\n\n**Kind**: global constant  \nsrc: packages/backend/src/constants/cls.ts:24  \ndist: packages/backend/dist/constants/cls.js:5\n<a name=\"CLS_FILE_SCAN\"></a>\n\n## CLS\\_FILE\\_SCAN\nResult of the virus scan for this request, when scanning is enabled.\n\n**Kind**: global constant  \nsrc: packages/backend/src/constants/cls.ts:29  \ndist: packages/backend/dist/constants/cls.js:6\n<a name=\"CLS_FILE_SIGNATURE\"></a>\n\n## CLS\\_FILE\\_SIGNATURE\nDetected file-type signature of the upload, when probed.\n\n**Kind**: global constant  \nsrc: packages/backend/src/constants/cls.ts:34  \ndist: packages/backend/dist/constants/cls.js:7\n<a name=\"CLS_SOURCE_DIRECTION\"></a>\n\n## CLS\\_SOURCE\\_DIRECTION\nDirection of the media source: `upload` (POST body) or `download` (`source=` URL).\n\n**Kind**: global constant  \nsrc: packages/backend/src/constants/cls.ts:39  \ndist: packages/backend/dist/constants/cls.js:8\n<a name=\"CLS_SOURCE_STREAM\"></a>\n\n## CLS\\_SOURCE\\_STREAM\nThe (possibly capped) media stream for this request, set by the scanner/parser.\n\n**Kind**: global constant  \nsrc: packages/backend/src/constants/cls.ts:44  \ndist: packages/backend/dist/constants/cls.js:9\n","symbols":9,"lastUsed":1795730447551},"tdata:packages/backend/src/constants/fs.ts":{"doclets":[{"id":"CACHE_DIR","longname":"CACHE_DIR","name":"CACHE_DIR","kind":"constant","scope":"global","description":"Cache root (absolute); processed media output and the undici cache live here.","meta":{"lineno":6},"order":0,"mdaics":{"dist":"packages/backend/dist/constants/fs.js:3","src":"packages/backend/src/constants/fs.ts:8"},"level":0},{"id":"CACHE_TTL_MS","longname":"CACHE_TTL_MS","name":"CACHE_TTL_MS","kind":"constant","scope":"global","description":"Entries not used for this long are evicted.","meta":{"lineno":13},"order":1,"mdaics":{"dist":"packages/backend/dist/constants/fs.js:5","src":"packages/backend/src/constants/fs.ts:15"},"level":0},{"id":"CACHE_MAX_BYTES","longname":"CACHE_MAX_BYTES","name":"CACHE_MAX_BYTES","kind":"constant","scope":"global","description":"Soft cap for output entries; the undici store is excluded from the sweep.","meta":{"lineno":17},"order":2,"mdaics":{"dist":"packages/backend/dist/constants/fs.js:6","src":"packages/backend/src/constants/fs.ts:19"},"level":0},{"id":"UNDICI_CACHE_FILE","longname":"UNDICI_CACHE_FILE","name":"UNDICI_CACHE_FILE","kind":"constant","scope":"global","description":"File backing undici's HTTP cache. Its WAL sidecars share this prefix.","meta":{"lineno":21},"order":3,"mdaics":{"dist":"packages/backend/dist/constants/fs.js:7","src":"packages/backend/src/constants/fs.ts:23"},"level":0},{"id":"CACHE_SWEEP_INTERVAL_MS","longname":"CACHE_SWEEP_INTERVAL_MS","name":"CACHE_SWEEP_INTERVAL_MS","kind":"constant","scope":"global","description":"How often the cache janitor sweeps.","meta":{"lineno":25},"order":4,"mdaics":{"dist":"packages/backend/dist/constants/fs.js:8","src":"packages/backend/src/constants/fs.ts:27"},"level":0},{"id":"CACHE_TMP_MAX_AGE_MS","longname":"CACHE_TMP_MAX_AGE_MS","name":"CACHE_TMP_MAX_AGE_MS","kind":"constant","scope":"global","description":"Orphaned *.tmp files (crashed writers) older than this are removed.","meta":{"lineno":29},"order":5,"mdaics":{"dist":"packages/backend/dist/constants/fs.js:9","src":"packages/backend/src/constants/fs.ts:31"},"level":0},{"id":"TESSERACT_DIR","longname":"TESSERACT_DIR","name":"TESSERACT_DIR","kind":"constant","scope":"global","description":"Directory where tesseract.js stores its (gzipped) language data.","meta":{"lineno":33},"order":6,"mdaics":{"dist":"packages/backend/dist/constants/fs.js:10","src":"packages/backend/src/constants/fs.ts:35"},"level":0}],"fp":"2f7935aa49a93b15aaf83f8f8df670cd16050ab1e1aae95b376005ba5a915aba","issues":[],"kind":"tdata","lastUsed":1795730447556,"symbols":0},"md:packages/backend/src/constants/fs.ts":{"fp":"6be9d54b10716642337fe6aadbe6c2c1d3f659a18c96e0e6880ce397c5064eed","issues":[],"kind":"md","markdown":"## Constants\n\n<dl>\n<dt><a href=\"#CACHE_DIR\">CACHE_DIR</a></dt>\n<dd><p>Cache root (absolute); processed media output and the undici cache live here.</p>\n</dd>\n<dt><a href=\"#CACHE_TTL_MS\">CACHE_TTL_MS</a></dt>\n<dd><p>Entries not used for this long are evicted.</p>\n</dd>\n<dt><a href=\"#CACHE_MAX_BYTES\">CACHE_MAX_BYTES</a></dt>\n<dd><p>Soft cap for output entries; the undici store is excluded from the sweep.</p>\n</dd>\n<dt><a href=\"#UNDICI_CACHE_FILE\">UNDICI_CACHE_FILE</a></dt>\n<dd><p>File backing undici&#39;s HTTP cache. Its WAL sidecars share this prefix.</p>\n</dd>\n<dt><a href=\"#CACHE_SWEEP_INTERVAL_MS\">CACHE_SWEEP_INTERVAL_MS</a></dt>\n<dd><p>How often the cache janitor sweeps.</p>\n</dd>\n<dt><a href=\"#CACHE_TMP_MAX_AGE_MS\">CACHE_TMP_MAX_AGE_MS</a></dt>\n<dd><p>Orphaned *.tmp files (crashed writers) older than this are removed.</p>\n</dd>\n<dt><a href=\"#TESSERACT_DIR\">TESSERACT_DIR</a></dt>\n<dd><p>Directory where tesseract.js stores its (gzipped) language data.</p>\n</dd>\n</dl>\n\n<a name=\"CACHE_DIR\"></a>\n\n## CACHE\\_DIR\nCache root (absolute); processed media output and the undici cache live here.\n\n**Kind**: global constant  \nsrc: packages/backend/src/constants/fs.ts:8  \ndist: packages/backend/dist/constants/fs.js:3\n<a name=\"CACHE_TTL_MS\"></a>\n\n## CACHE\\_TTL\\_MS\nEntries not used for this long are evicted.\n\n**Kind**: global constant  \nsrc: packages/backend/src/constants/fs.ts:15  \ndist: packages/backend/dist/constants/fs.js:5\n<a name=\"CACHE_MAX_BYTES\"></a>\n\n## CACHE\\_MAX\\_BYTES\nSoft cap for output entries; the undici store is excluded from the sweep.\n\n**Kind**: global constant  \nsrc: packages/backend/src/constants/fs.ts:19  \ndist: packages/backend/dist/constants/fs.js:6\n<a name=\"UNDICI_CACHE_FILE\"></a>\n\n## UNDICI\\_CACHE\\_FILE\nFile backing undici's HTTP cache. Its WAL sidecars share this prefix.\n\n**Kind**: global constant  \nsrc: packages/backend/src/constants/fs.ts:23  \ndist: packages/backend/dist/constants/fs.js:7\n<a name=\"CACHE_SWEEP_INTERVAL_MS\"></a>\n\n## CACHE\\_SWEEP\\_INTERVAL\\_MS\nHow often the cache janitor sweeps.\n\n**Kind**: global constant  \nsrc: packages/backend/src/constants/fs.ts:27  \ndist: packages/backend/dist/constants/fs.js:8\n<a name=\"CACHE_TMP_MAX_AGE_MS\"></a>\n\n## CACHE\\_TMP\\_MAX\\_AGE\\_MS\nOrphaned *.tmp files (crashed writers) older than this are removed.\n\n**Kind**: global constant  \nsrc: packages/backend/src/constants/fs.ts:31  \ndist: packages/backend/dist/constants/fs.js:9\n<a name=\"TESSERACT_DIR\"></a>\n\n## TESSERACT\\_DIR\nDirectory where tesseract.js stores its (gzipped) language data.\n\n**Kind**: global constant  \nsrc: packages/backend/src/constants/fs.ts:35  \ndist: packages/backend/dist/constants/fs.js:10\n","symbols":7,"lastUsed":1795730447592},"tdata:packages/backend/src/constants/header.ts":{"doclets":[{"id":"HEADER_X_FILE_HASH","longname":"HEADER_X_FILE_HASH","name":"HEADER_X_FILE_HASH","kind":"constant","scope":"global","description":"Hint on upload requests: the client-supplied SHA-512 of the body, mixed into the cache key.","meta":{"lineno":4},"order":0,"mdaics":{"dist":"packages/backend/dist/constants/header.js:1","src":"packages/backend/src/constants/header.ts:4"},"level":0},{"id":"HEADER_X_FONT_SUBSET","longname":"HEADER_X_FONT_SUBSET","name":"HEADER_X_FONT_SUBSET","kind":"constant","scope":"global","description":"Hint on the /font/subset response: the payload is a minimal sfnt for PDF embedding.","meta":{"lineno":8},"order":1,"mdaics":{"dist":"packages/backend/dist/constants/header.js:2","src":"packages/backend/src/constants/header.ts:9"},"level":0},{"id":"HEADER_X_AUTH_USERNAME","longname":"HEADER_X_AUTH_USERNAME","name":"HEADER_X_AUTH_USERNAME","kind":"constant","scope":"global","description":"Username header for the basic-auth perimeter.","meta":{"lineno":12},"order":2,"mdaics":{"dist":"packages/backend/dist/constants/header.js:3","src":"packages/backend/src/constants/header.ts:14"},"level":0},{"id":"HEADER_X_AUTH_PASSWORD","longname":"HEADER_X_AUTH_PASSWORD","name":"HEADER_X_AUTH_PASSWORD","kind":"constant","scope":"global","description":"Password header for the basic-auth perimeter.","meta":{"lineno":16},"order":3,"mdaics":{"dist":"packages/backend/dist/constants/header.js:4","src":"packages/backend/src/constants/header.ts:19"},"level":0}],"fp":"3c14a00223959d873947019b4314a3a15a89caeab6a919d74ba74058d07681b8","issues":[],"kind":"tdata","lastUsed":1795730447557,"symbol