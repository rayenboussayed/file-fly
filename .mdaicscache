":{"dist":"packages/backend/dist/resources/csv/csv.service.js:21","src":"packages/backend/src/resources/csv/csv.service.ts:31"},"level":0},{"id":"readBody","longname":"readBody","name":"readBody","kind":"function","scope":"global","description":"Opens (idempotently) and reads the uploaded CSV body, bounded by the scanner cap.\nThe scanner opens the source only when ClamAV is enabled, so the service must too.\nOnly `text/csv` and `application/octet-stream` bodies are accepted.","params":[{"description":"The normalized request context (source stream accessors).","name":"cls","type":{"names":["NormalizedClsService"]}}],"returns":[{"description":"The body bytes, capped.","type":{"names":["Promise<Buffer<ArrayBufferLike>>"]}}],"exceptions":[{"type":{"names":["UnsupportedMediaTypeException"]},"description":"For any other content type."}],"meta":{"lineno":70},"async":true,"order":3,"mdaics":{"dist":"packages/backend/dist/resources/csv/csv.service.js:31","src":"packages/backend/src/resources/csv/csv.service.ts:51"},"level":0},{"id":"kindOf","longname":"kindOf","name":"kindOf","kind":"function","scope":"global","description":"Classifies a cast csv-parse value. `empty` covers null/undefined and empty strings;\nexact `true`/`false` strings count as boolean (csv-parse does not cast them).","params":[{"description":"One cast field value.","name":"value","type":{"names":["unknown"]}}],"returns":[{"description":"The census key for the value.","type":{"names":["\"string\" | \"number\" | \"boolean\" | \"date\" | \"empty\""]}}],"meta":{"lineno":204},"order":8,"mdaics":{"dist":"packages/backend/dist/resources/csv/csv.service.js:204 (approx.)","src":"packages/backend/src/resources/csv/csv.service.ts:172"},"level":0},{"id":"CsvService#buildCsv","longname":"CsvService#buildCsv","name":"buildCsv","kind":"function","scope":"instance","description":"Builds the CSV response stream for `POST /csv/build`.\n`escape_formulas` defaults to true: cells starting with `= + - @ TAB CR` are prefixed with `'`.","memberof":"CsvService","params":[{"description":"Validated build payload (rows plus csv-stringify options).","name":"body","type":{"names":["{ records: (Record<string, unknown> | unknown[])[]; options?: { [x: string]: any; bom?: boolean; columns?: (string | { key: string; header?: string; })[]; eof?: boolean; escape?: string; escape_formulas?: boolean; header?: boolean; header_as_comment?: boolean; quote?: string | false; quote_record_delimiter?: boolean; quoted?: boolean; quoted_empty?: boolean; quoted_string?: boolean; }; }"]}}],"returns":[{"description":"The readable CSV byte stream (201 by POST convention).","type":{"names":["Readable"]}}],"meta":{"lineno":109},"order":5,"mdaics":{"dist":"packages/backend/dist/resources/csv/csv.service.js:109 (approx.)","src":"packages/backend/src/resources/csv/csv.service.ts:77"},"level":0},{"id":"CsvService#extract","longname":"CsvService#extract","name":"extract","kind":"function","scope":"instance","description":"Parses the uploaded CSV into typed JSON records.\nFunction-valued csv-parse options are not exposed over HTTP. At most\n{@link MAX_RECORDS} records are materialized; larger files answer 413.\nThe first record is treated as data (no header semantics here).","memberof":"CsvService","params":[{"description":"Validated, flat csv-parse options (file travels in the body).","name":"query","type":{"names":["{ [x: string]: any; bom?: boolean; cast?: boolean; cast_date?: boolean; columns?: boolean | string[] | any[]; comment?: string; comment_no_infix?: boolean; delimiter_auto?: boolean; encoding?: \"ascii\" | \"utf8\" | \"utf16le\" | \"ucs2\" | \"base64\" | \"latin1\" | \"binary\" | \"hex\"; escape?: string; from?: number; from_line?: number; group_columns_by_name?: boolean; ignore_last_delimiters?: boolean; ltrim?: boolean; max_record_size?: number; quote?: string | false; relax_column_count?: boolean; relax_column_count_less?: boolean; relax_column_count_more?: boolean; relax_quotes?: boolean; rtrim?: boolean; skip_empty_lines?: boolean; skip_records_with_empty_values?: boolean; skip_records_with_error?: boolean; to?: number; to_line?: number; trim?: boolean; }"]}}],"returns":[{"description":"The parsed records.","type":{"names":["Promise<{ records: unknown[]; }>"]}}],"meta":{"lineno":121},"async":true,"order":6,"mdaics":{"dist":"packages/backend/dist/resources/csv/csv.service.js:121 (approx.)","src":"packages/backend/src/resources/csv/csv.service.ts:90"},"level":0},{"id":"CsvService#metadata","longname":"CsvService#metadata","name":"metadata","kind":"function","scope":"instance","description":"Computes structural metadata for an uploaded CSV. One streaming pass.\n`maxRows` limits the per-column type census; row/column counting always scans everything.\nThe first record counts as a data row (header or not). `delimiter_auto`\ndefaults on unless `delimiter` is given; the reported delimiter is the\nsupplied value, or `auto` when none was (csv-parse does not hand the\nwinning value back).","memberof":"CsvService","params":[{"description":"Validated, flat csv-parse options plus `maxRows`.","name":"query","type":{"names":["{ [x: string]: any; maxRows: number; trim?: boolean; bom?: boolean; escape?: string; quote?: string | false; cast_date?: boolean; comment?: string; comment_no_infix?: boolean; delimiter_auto?: boolean; encoding?: \"ascii\" | \"utf8\" | \"utf16le\" | \"ucs2\" | \"base64\" | \"latin1\" | \"binary\" | \"hex\"; max_record_size?: number; relax_column_count?: boolean; relax_column_count_less?: boolean; relax_column_count_more?: boolean; relax_quotes?: boolean; skip_empty_lines?: boolean; }"]}}],"returns":[{"description":"Rows, columns, delimiter handed over (`auto` unless given), and per-column type counts.","type":{"names":["Promise<{ bom: boolean; columns: number; delimiter: string | string[] | Buffer<ArrayBufferLike> | Buffer<ArrayBufferLike>[]; maxRows: number; perColumn: { index: number; types: Record<\"string\" | \"number\" | \"boolean\" | \"date\" | \"empty\", number>; }[]; recordDelimiter: string | string[] | Buffer<ArrayBufferLike> | Buffer<ArrayBufferLike>[]; rows: number; truncatedTypes: boolean; }>"]}}],"meta":{"lineno":149},"async":true,"order":7,"mdaics":{"dist":"packages/backend/dist/resources/csv/csv.service.js:149 (approx.)","src":"packages/backend/src/resources/csv/csv.service.ts:118"},"level":0}],"fp":"3b86c4d465232888666b8aaffd4f4a9cb578aa3401bac9844b339b53fbaefe41","issues":[],"kind":"tdata","symbols":0,"lastUsed":1795079878098},"md:packages/backend/src/resources/csv/csv.service.ts":{"fp":"9c7901eb294bfb3d46cae8abb3db1b989f08540e8747be80509b62a667f51e35","issues":["dist sourcemap missing or unmatched — dist line is an approximation"],"kind":"md","markdown":"## Classes\n\n<dl>\n<dt><a href=\"#RecordCapError\">RecordCapError</a></dt>\n<dd><p>Error thrown when a record cap is exceeded; maps to 413 at the boundary.</p>\n</dd>\n</dl>\n\n## Members\n\n<dl>\n<dt><a href=\"#CsvService\">CsvService</a></dt>\n<dd><p>CSV feature service: builds CSV from rows and parses/metadata-inspects uploads.</p>\n</dd>\n</dl>\n\n## Constants\n\n<dl>\n<dt><a href=\"#MAX_RECORDS\">MAX_RECORDS</a></dt>\n<dd><p>Hard cap on parsed records; beyond it the response would exhaust memory.</p>\n</dd>\n<dt><a href=\"#toBadRequest\">toBadRequest</a> ⇒ <code>BadRequestException</code></dt>\n<dd><p>Maps a csv-parse/csv-stringify failure to a 400 with the library&#39;s error code.</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#readBody\">readBody(cls)</a> ⇒ <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code></dt>\n<dd><p>Opens (idempotently) and reads the uploaded CSV body, bounded by the scanner cap.\nThe scanner opens the source only when ClamAV is enabled, so the service must too.\nOnly <code>text/csv</code> and <code>application/octet-stream</code> bodies are accepted.</p>\n</dd>\n<dt><a href=\"#kindOf\">kindOf(value)</a> ⇒ <code>&quot;string&quot; | &quot;number&quot; | &quot;boolean&quot; | &quot;date&quot; | &quot;empty&quot;</code></dt>\n<dd><p>Classifies a cast csv-parse value. <code>empty</code> covers null/undefined and empty strings;\nexact <code>true</code>/<code>false</code> strings count as boolean (csv-parse does not cast them).</p>\n</dd>\n</dl>\n\n<a name=\"RecordCapError\"></a>\n\n## RecordCapError\nError thrown when a record cap is exceeded; maps to 413 at the boundary.\n\n**Kind**: global class  \nsrc: packages/backend/src/resources/csv/csv.service.ts:24  \ndist: packages/backend/dist/resources/csv/csv.service.js:19\n<a name=\"CsvService\"></a>\n\n## CsvService\nCSV feature service: builds CSV from rows and parses/metadata-inspects uploads.\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/csv/csv.service.ts:68  \ndist: packages/backend/dist/resources/csv/csv.service.js:85 (approx.)\n\n* [CsvService](#CsvService)\n    * [.buildCsv(body)](#CsvService+buildCsv) ⇒ <code>Readable</code>\n    * [.extract(query)](#CsvService+extract) ⇒ <code>Promise&lt;{ records: unknown[]; }&gt;</code>\n    * [.metadata(query)](#CsvService+metadata) ⇒ <code>Promise&lt;{ bom: boolean; columns: number; delimiter: string \\| string[] \\| Buffer&lt;ArrayBufferLike&gt; \\| Buffer&lt;ArrayBufferLike&gt;[]; maxRows: number; perColumn: { index: number; types: Record&lt;&quot;string&quot; \\| &quot;number&quot; \\| &quot;boolean&quot; \\| &quot;date&quot; \\| &quot;empty&quot;, number&gt;; }[]; recordDelimiter: string \\| string[] \\| Buffer&lt;ArrayBufferLike&gt; \\| Buffer&lt;ArrayBufferLike&gt;[]; rows: number; truncatedTypes: boolean; }&gt;</code>\n\n<a name=\"CsvService+buildCsv\"></a>\n\n### csvService.buildCsv(body) ⇒ <code>Readable</code>\nBuilds the CSV response stream for `POST /csv/build`.\n`escape_formulas` defaults to true: cells starting with `= + - @ TAB CR` are prefixed with `'`.\n\n**Kind**: instance method of [<code>CsvService</code>](#CsvService)  \n**Returns**: <code>Readable</code> - The readable CSV byte stream (201 by POST convention).  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| body | <code>{ records: (Record&lt;string, unknown&gt; \\| unknown[])[]; options?: { [x: string]: any; bom?: boolean; columns?: (string \\| { key: string; header?: string; })[]; eof?: boolean; escape?: string; escape\\_formulas?: boolean; header?: boolean; header\\_as\\_comment?: boolean; quote?: string \\| false; quote\\_record\\_delimiter?: boolean; quoted?: boolean; quoted\\_empty?: boolean; quoted\\_string?: boolean; }; }</code> | Validated build payload (rows plus csv-stringify options). |\n\nsrc: packages/backend/src/resources/csv/csv.service.ts:77  \ndist: packages/backend/dist/resources/csv/csv.service.js:109 (approx.)\n<a name=\"CsvService+extract\"></a>\n\n### csvService.extract(query) ⇒ <code>Promise&lt;{ records: unknown[]; }&gt;</code>\nParses the uploaded CSV into typed JSON records.\nFunction-valued csv-parse options are not exposed over HTTP. At most\n[MAX_RECORDS](#MAX_RECORDS) records are materialized; larger files answer 413.\nThe first record is treated as data (no header semantics here).\n\n**Kind**: instance method of [<code>CsvService</code>](#CsvService)  \n**Returns**: <code>Promise&lt;{ records: unknown[]; }&gt;</code> - The parsed records.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| query | <code>{ [x: string]: any; bom?: boolean; cast?: boolean; cast\\_date?: boolean; columns?: boolean \\| string[] \\| any[]; comment?: string; comment\\_no\\_infix?: boolean; delimiter\\_auto?: boolean; encoding?: &quot;ascii&quot; \\| &quot;utf8&quot; \\| &quot;utf16le&quot; \\| &quot;ucs2&quot; \\| &quot;base64&quot; \\| &quot;latin1&quot; \\| &quot;binary&quot; \\| &quot;hex&quot;; escape?: string; from?: number; from\\_line?: number; group\\_columns\\_by\\_name?: boolean; ignore\\_last\\_delimiters?: boolean; ltrim?: boolean; max\\_record\\_size?: number; quote?: string \\| false; relax\\_column\\_count?: boolean; relax\\_column\\_count\\_less?: boolean; relax\\_column\\_count\\_more?: boolean; relax\\_quotes?: boolean; rtrim?: boolean; skip\\_empty\\_lines?: boolean; skip\\_records\\_with\\_empty\\_values?: boolean; skip\\_records\\_with\\_error?: boolean; to?: number; to\\_line?: number; trim?: boolean; }</code> | Validated, flat csv-parse options (file travels in the body). |\n\nsrc: packages/backend/src/resources/csv/csv.service.ts:90  \ndist: packages/backend/dist/resources/csv/csv.service.js:121 (approx.)\n<a name=\"CsvService+metadata\"></a>\n\n### csvService.metadata(query) ⇒ <code>Promise&lt;{ bom: boolean; columns: number; delimiter: string \\| string[] \\| Buffer&lt;ArrayBufferLike&gt; \\| Buffer&lt;ArrayBufferLike&gt;[]; maxRows: number; perColumn: { index: number; types: Record&lt;&quot;string&quot; \\| &quot;number&quot; \\| &quot;boolean&quot; \\| &quot;date&quot; \\| &quot;empty&quot;, number&gt;; }[]; recordDelimiter: string \\| string[] \\| Buffer&lt;ArrayBufferLike&gt; \\| Buffer&lt;ArrayBufferLike&gt;[]; rows: number; truncatedTypes: boolean; }&gt;</code>\nComputes structural metadata for an uploaded CSV. One streaming pass.\n`maxRows` limits the per-column type census; row/column counting always scans everything.\nThe first record counts as a data row (header or not). `delimiter_auto`\ndefaults on unless `delimiter` is given; the reported delimiter is the\nsupplied value, or `auto` when none was (csv-parse does not hand the\nwinning value back).\n\n**Kind**: instance method of [<code>CsvService</code>](#CsvService)  \n**Returns**: <code>Promise&lt;{ bom: boolean; columns: number; delimiter: string \\| string[] \\| Buffer&lt;ArrayBufferLike&gt; \\| Buffer&lt;ArrayBufferLike&gt;[]; maxRows: number; perColumn: { index: number; types: Record&lt;&quot;string&quot; \\| &quot;number&quot; \\| &quot;boolean&quot; \\| &quot;date&quot; \\| &quot;empty&quot;, number&gt;; }[]; recordDelimiter: string \\| string[] \\| Buffer&lt;ArrayBufferLike&gt; \\| Buffer&lt;ArrayBufferLike&gt;[]; rows: number; truncatedTypes: boolean; }&gt;</code> - Rows, columns, delimiter handed over (`auto` unless given), and per-column type counts.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| query | <code>{ [x: string]: any; maxRows: number; trim?: boolean; bom?: boolean; escape?: string; quote?: string \\| false; cast\\_date?: boolean; comment?: string; comment\\_no\\_infix?: boolean; delimiter\\_auto?: boolean; encoding?: &quot;ascii&quot; \\| &quot;utf8&quot; \\| &quot;utf16le&quot; \\| &quot;ucs2&quot; \\| &quot;base64&quot; \\| &quot;latin1&quot; \\| &quot;binary&quot; \\| &quot;hex&quot;; max\\_record\\_size?: number; relax\\_column\\_count?: boolean; relax\\_column\\_count\\_less?: boolean; relax\\_column\\_count\\_more?: boolean; relax\\_quotes?: boolean; skip\\_empty\\_lines?: boolean; }</code> | Validated, flat csv-parse options plus `maxRows`. |\n\nsrc: packages/backend/src/resources/csv/csv.service.ts:118  \ndist: packages/backend/dist/resources/csv/csv.service.js:149 (approx.)\n<a name=\"MAX_RECORDS\"></a>\n\n## MAX\\_RECORDS\nHard cap on parsed records; beyond it the response would exhaust memory.\n\n**Kind**: global constant  \nsrc: packages/backend/src/resources/csv/csv.service.ts:21  \ndist: packages/backend/dist/resources/csv/csv.service.js:18\n<a name=\"toBadRequest\"></a>\n\n## toBadRequest ⇒ <code>BadRequestException</code>\nMaps a csv-parse/csv-stringify failure to a 400 with the library's error code.\n\n**Kind**: global constant  \n**Returns**: <code>BadRequestException</code> - A 400 exception carrying the library's code and message.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| error | <code>unknown</code> | The library error (carries `code` and `message`). |\n\nsrc: packages/backend/src/resources/csv/csv.service.ts:31  \ndist: packages/backend/dist/resources/csv/csv.service.js:21\n<a name=\"readBody\"></a>\n\n## readBody(cls) ⇒ <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code>\nOpens (idempotently) and reads the uploaded CSV body, bounded by the scanner cap.\nThe scanner opens the source only when ClamAV is enabled, so the service must too.\nOnly `text/csv` and `application/octet-stream` bodies are accepted.\n\n**Kind**: global function  \n**Returns**: <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code> - The body bytes, capped.  \n**Throws**:\n\n- <code>UnsupportedMediaTypeException</code> For any other content type.\n\n\n| Param | Type | Description |\n| --- | --- | --- |\n| cls | <code>NormalizedClsService</code> | The normalized request context (source stream accessors). |\n\nsrc: packages/backend/src/resources/csv/csv.service.ts:51  \ndist: packages/backend/dist/resources/csv/csv.service.js:31\n<a name=\"kindOf\"></a>\n\n## kindOf(value) ⇒ <code>&quot;string&quot; \\| &quot;number&quot; \\| &quot;boolean&quot; \\| &quot;date&quot; \\| &quot;empty&quot;</code>\nClassifies a cast csv-parse value. `empty` covers null/undefined and empty strings;\nexact `true`/`false` strings count as boolean (csv-parse does not cast them).\n\n**Kind**: global function  \n**Returns**: <code>&quot;string&quot; \\| &quot;number&quot; \\| &quot;boolean&quot; \\| &quot;date&quot; \\| &quot;empty&quot;</code> - The census key for the value.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| value | <code>unknown</code> | One cast field value. |\n\nsrc: packages/backend/src/resources/csv/csv.service.ts:172  \ndist: packages/backend/dist/resources/csv/csv.service.js:204 (approx.)\n","symbols":9,"lastUsed":1795079878221},"tdata:packages/backend/src/resources/csv/schema.ts":{"doclets":[{"id":"options","longname":"options","name":"options","kind":"member","scope":"global","description":"csv-stringify options (names kept as in the library). `escape_formulas` defaults to true.","meta":{"lineno":10},"order":1,"mdaics":{"dist":"packages/backend/dist/resources/csv/schema.js:5","src":"packages/backend/src/resources/csv/schema.ts:12"},"level":0},{"id":"records","longname":"records","name":"records","kind":"member","scope":"global","description":"Rows to serialize; objects map keys to cells, arrays emit positional cells.","meta":{"lineno":37},"order":2,"mdaics":{"dist":"packages/backend/dist/resources/csv/schema.js:31","src":"packages/backend/src/resources/csv/schema.ts:41"},"level":0},{"id":"CsvBuildSchema","longname":"CsvBuildSchema","name":"CsvBuildSchema","kind":"constant","scope":"global","description":"JSON body for `POST /csv/build`: rows in, CSV bytes out.\nElements may be row objects or arrays of cell values.","meta":{"lineno":7},"order":0,"mdaics":{"dist":"packages/backend/dist/resources/csv/schema.js:3","src":"packages/backend/src/resources/csv/schema.ts:9"},"level":0},{"id":"csvParseOptions","longname":"csvParseOptions","name":"csvParseOptions","kind":"constant","scope":"global","description":"csv-parse options shared by `/csv/extract` and `/csv/metadata` (function-valued options excluded).","params":[],"meta":{"lineno":41},"order":3,"mdaics":{"dist":"packages/backend/dist/resources/csv/schema.js:34","src":"packages/backend/src/resources/csv/schema.ts:50"},"level":0},{"id":"CsvExtractSchema","longname":"CsvExtractSchema","name":"CsvExtractSchema","kind":"constant","scope":"global","description":"Flat query parameters for `POST /csv/extract`.\nThe raw CSV travels in the request body; everything here is csv-parse options.","meta":{"lineno":85},"order":4,"mdaics":{"dist":"packages/backend/dist/resources/csv/schema.js:74","src":"packages/backend/src/resources/csv/schema.ts:95"},"level":0},{"id":"CsvMetadataSchema","longname":"CsvMetadataSchema","name":"CsvMetadataSchema","kind":"constant","scope":"global","description":"Flat query parameters for `POST /csv/metadata`.\n`maxRows` caps the per-cell type census; row and column counting always scans the whole file.","meta":{"lineno":109},"order":5,"mdaics":{"dist":"packages/backend/dist/resources/csv/schema.js:94","src":"packages/backend/src/resources/csv/schema.ts:123"},"level":0}],"fp":"e889725e5b063a1f7064a5591b6a71bace199c5b5551c365d48eb57ae441bff8","issues":[],"kind":"tdata","lastUsed":1795079874977,"symbols":0},"md:packages/backend/src/resources/csv/schema.ts":{"fp":"b219a04808c19ab7cc04e86f4715e0e769a55369a8f813747dbd24d84d15e163","issues":[],"kind":"md","markdown":"## Members\n\n<dl>\n<dt><a href=\"#options\">options</a></dt>\n<dd><p>csv-stringify options (names kept as in the library). <code>escape_formulas</code> defaults to true.</p>\n</dd>\n<dt><a href=\"#records\">records</a></dt>\n<dd><p>Rows to serialize; objects map keys to cells, arrays emit positional cells.</p>\n</dd>\n</dl>\n\n## Constants\n\n<dl>\n<dt><a href=\"#CsvBuildSchema\">CsvBuildSchema</a></dt>\n<dd><p>JSON body for <code>POST /csv/build</code>: rows in, CSV bytes out.\nElements may be row objects or arrays of cell values.</p>\n</dd>\n<dt><a href=\"#csvParseOptions\">csvParseOptions</a></dt>\n<dd><p>csv-parse options shared by <code>/csv/extract</code> and <code>/csv/metadata</code> (function-valued options excluded).</p>\n</dd>\n<dt><a href=\"#CsvExtractSchema\">CsvExtractSchema</a></dt>\n<dd><p>Flat query parameters for <code>POST /csv/extract</code>.\nThe raw CSV travels in the request body; everything here is csv-parse options.</p>\n</dd>\n<dt><a href=\"#CsvMetadataSchema\">CsvMetadataSchema</a></dt>\n<dd><p>Flat query parameters for <code>POST /csv/metadata</code>.\n<code>maxRows</code> caps the per-cell type census; row and column counting always scans the whole file.</p>\n</dd>\n</dl>\n\n<a name=\"options\"></a>\n\n## options\ncsv-stringify options (names kept as in the library). `escape_formulas` defaults to true.\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/csv/schema.ts:12  \ndist: packages/backend/dist/resources/csv/schema.js:5\n<a name=\"records\"></a>\n\n## records\nRows to serialize; objects map keys to cells, arrays emit positional cells.\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/csv/schema.ts:41  \ndist: packages/backend/dist/resources/csv/schema.js:31\n<a name=\"CsvBuildSchema\"></a>\n\n## CsvBuildSchema\nJSON body for `POST /csv/build`: rows in, CSV bytes out.\nElements may be row objects or arrays of cell values.\n\n**Kind**: global constant  \nsrc: packages/backend/src/resources/csv/schema.ts:9  \ndist: packages/backend/dist/resources/csv/schema.js:3\n<a name=\"csvParseOptions\"></a>\n\n## csvParseOptions\ncsv-parse options shared by `/csv/extract` and `/csv/metadata` (function-valued options excluded).\n\n**Kind**: global constant  \nsrc: packages/backend/src/resources/csv/schema.ts:50  \ndist: packages/backend/dist/resources/csv/schema.js:34\n<a name=\"CsvExtractSchema\"></a>\n\n## CsvExtractSchema\nFlat query parameters for `POST /csv/extract`.\nThe raw CSV travels in the request body; everything here is csv-parse options.\n\n**Kind**: global constant  \nsrc: packages/backend/src/resources/csv/schema.ts:95  \ndist: packages/backend/dist/resources/csv/schema.js:74\n<a name=\"CsvMetadataSchema\"></a>\n\n## CsvMetadataSchema\nFlat query parameters for `POST /csv/metadata`.\n`maxRows` caps the per-cell type census; row and column counting always scans the whole file.\n\n**Kind**: global constant  \nsrc: packages/backend/src/resources/csv/schema.ts:123  \ndist: packages/backend/dist/resources/csv/schema.js:94\n","symbols":6,"lastUsed":1795079875020},"tdata:packages/backend/src/resources/docx/docx.controller.spec.ts":{"doclets":[{"id":"rawSink","longname":"rawSink","name":"rawSink","kind":"function","scope":"global","description":"Creates a Writable raw sink with `setHeader` mocks for assertions.","params":[],"returns":[{"description":"A writable with a mocked `setHeader`.","type":{"names":["Writable & { setHeader: ReturnType<typeof vi.fn>; }"]}}],"meta":{"lineno":8},"order":0,"mdaics":{"src":"packages/backend/src/resources/docx/docx.controller.spec.ts:10"},"level":0}],"fp":"ebbbd07ce92f1a157354f2053e89fb4810b0f5ef48db86e5d5d5ee97a6ded138","issues":[],"kind":"tdata","lastUsed":1795079875020,"symbols":0},"tdata:packages/backend/src/resources/docx/docx.controller.ts":{"doclets":[{"id":"DocxController","longname":"DocxController","name":"DocxController","kind":"member","scope":"global","description":"DOCX routes. `/docx/build` consumes JSON and bypasses the media\ninterceptors by design (JSON bodies are never virus-scanned or signature-probed);\n`/docx/extract` and `/docx/metadata` take the binary upload and are ClamAV-scanned.","params":[],"meta":{"lineno":46},"order":0,"mdaics":{"dist":"packages/backend/dist/resources/docx/docx.controller.js:21","src":"packages/backend/src/resources/docx/docx.controller.ts:29"},"level":0},{"id":"DocxController#build","longname":"DocxController#build","name":"build","kind":"function","scope":"instance","description":"Builds a .docx from the JSON payload (201).","memberof":"DocxController","params":[{"description":"Raw reply, streamed as .docx.","name":"response","type":{"names":["FastifyReply<import(\"fastify\").RouteGenericInterface, import(\"fastify\").RawServerDefault, import(\"http\").IncomingMessage, import(\"http\").ServerResponse<import(\"http\").IncomingMessage>, unknown, import(\"fastify\").FastifySchema, import(\"fastify\").FastifyTypeProviderDefault, unknown>"]}},{"description":"Sections, blocks, metadata, numbering, notes, comments.","name":"body","type":{"names":["{ sections: { children: ({ runs: { [x: string]: any; text: string; allCaps?: boolean; bold?: boolean; break?: number; doubleStrike?: boolean; endnote?: number; footnote?: number; highlight?: \"black\" | \"blue\" | \"cyan\" | \"darkBlue\" | \"darkCyan\" | \"darkGray\" | \"darkGreen\" | \"darkMagenta\" | \"darkRed\" | \"darkYellow\" | \"green\" | \"lightGray\" | \"magenta\" | \"none\" | \"red\" | \"white\" | \"yellow\"; italics?: boolean; language?: string; smallCaps?: boolean; strike?: boolean; subScript?: boolean; superScript?: boolean; type?: \"run\"; underline?: true | { [x: string]: any; type: \"none\" | \"single\" | \"words\" | \"double\" | \"thick\" | \"dotted\" | \"dottedHeavy\" | \"dash\" | \"