s/__root.tsx:24"},"level":0},{"id":"RootComponent","longname":"RootComponent","name":"RootComponent","kind":"function","scope":"global","description":"Root layout: the app shell with the top navigation and routed content.","params":[],"returns":[{"description":"The shell element.","type":{"names":["import(\"react\").JSX.Element"]}}],"meta":{"lineno":25},"order":1,"mdaics":{"src":"packages/dashboard/src/routes/__root.tsx:37"},"level":0}],"fp":"e3b1e7ae485187103f064805d2a62235441b739d2b42c7b424c2151e2d94be90","issues":[],"kind":"tdata","lastUsed":1795079894956,"symbols":0},"md:packages/dashboard/src/routes/__root.tsx":{"fp":"333cfd4972f4dee6afc3f2f656428aa8e3d9c8960945aea48232fe11ca153e5f","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","markdown":"## Functions\n\n<dl>\n<dt><a href=\"#NotFound\">NotFound()</a> ⇒ <code>import(&quot;react&quot;).JSX.Element</code></dt>\n<dd><p>Fallback for unknown paths.</p>\n</dd>\n<dt><a href=\"#RootComponent\">RootComponent()</a> ⇒ <code>import(&quot;react&quot;).JSX.Element</code></dt>\n<dd><p>Root layout: the app shell with the top navigation and routed content.</p>\n</dd>\n</dl>\n\n<a name=\"NotFound\"></a>\n\n## NotFound() ⇒ <code>import(&quot;react&quot;).JSX.Element</code>\nFallback for unknown paths.\n\n**Kind**: global function  \n**Returns**: <code>import(&quot;react&quot;).JSX.Element</code> - The not-found element.  \nsrc: packages/dashboard/src/routes/__root.tsx:24  \n<a name=\"RootComponent\"></a>\n\n## RootComponent() ⇒ <code>import(&quot;react&quot;).JSX.Element</code>\nRoot layout: the app shell with the top navigation and routed content.\n\n**Kind**: global function  \n**Returns**: <code>import(&quot;react&quot;).JSX.Element</code> - The shell element.  \nsrc: packages/dashboard/src/routes/__root.tsx:37  \n","symbols":2,"lastUsed":1795079894990},"tdata:packages/dashboard/src/routes/ip.$ip.tsx":{"doclets":[{"id":"Route","longname":"Route","name":"Route","kind":"constant","scope":"global","description":"File-based route for the per-IP detail page.","meta":{"lineno":4},"order":0,"mdaics":{"src":"packages/dashboard/src/routes/ip.$ip.tsx:6"},"level":0},{"id":"RouteComponent","longname":"RouteComponent","name":"RouteComponent","kind":"function","scope":"global","description":"Reads the route param and renders the IP detail page.","params":[],"returns":[{"description":"The IP detail page element.","type":{"names":["import(\"react\").JSX.Element"]}}],"meta":{"lineno":11},"order":1,"mdaics":{"src":"packages/dashboard/src/routes/ip.$ip.tsx:14"},"level":0}],"fp":"9eabc1c1b6ec17af0c3c31b73e00f9cb7b56b874dda3f0a79d6fa6f63b87e573","issues":[],"kind":"tdata","lastUsed":1795079894964,"symbols":0},"md:packages/dashboard/src/routes/ip.$ip.tsx":{"fp":"a104bde7edbf4d244f2843f678869cee90ccf43649dbc360d349b28cd105e140","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","markdown":"## Constants\n\n<dl>\n<dt><a href=\"#Route\">Route</a></dt>\n<dd><p>File-based route for the per-IP detail page.</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#RouteComponent\">RouteComponent()</a> ⇒ <code>import(&quot;react&quot;).JSX.Element</code></dt>\n<dd><p>Reads the route param and renders the IP detail page.</p>\n</dd>\n</dl>\n\n<a name=\"Route\"></a>\n\n## Route\nFile-based route for the per-IP detail page.\n\n**Kind**: global constant  \nsrc: packages/dashboard/src/routes/ip.$ip.tsx:6  \n<a name=\"RouteComponent\"></a>\n\n## RouteComponent() ⇒ <code>import(&quot;react&quot;).JSX.Element</code>\nReads the route param and renders the IP detail page.\n\n**Kind**: global function  \n**Returns**: <code>import(&quot;react&quot;).JSX.Element</code> - The IP detail page element.  \nsrc: packages/dashboard/src/routes/ip.$ip.tsx:14  \n","symbols":2,"lastUsed":1795079895038},"tdata:packages/dashboard/src/routeTree.gen.ts":{"doclets":[],"fp":"99f093921fd24570df27c9566f16365f745f8c4260b7b17eb4bb0374b1d87711","issues":[],"kind":"tdata","lastUsed":1795079895012,"symbols":0},"md:packages/dashboard/src/routeTree.gen.ts":{"fp":"178ddb7dc7a6721ca2298d6613d85276a7c007b06f23a39994c0d57c4ad54235","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795079895012},"md:packages/backend/src/resources/image/image.service.ts":{"fp":"c7825d680dd9710d98b7bfaff5d8d2f7b76e54a7a4b61b4622862a662c81d8d6","issues":["dist sourcemap missing or unmatched — dist line is an approximation"],"kind":"md","markdown":"<a name=\"ImageService\"></a>\n\n## ImageService\nImage feature service: streams uploads through sharp workers for processing, metadata, DNA, stats and OCR.\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/image/image.service.ts:20  \ndist: packages/backend/dist/resources/image/image.service.js:42 (approx.)\n\n* [ImageService](#ImageService)\n    * [.parseLangs(raw)](#ImageService+parseLangs) ⇒ <code>string[]</code>\n    * [.preprocess(input)](#ImageService+preprocess) ⇒ <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code>\n\n<a name=\"ImageService+parseLangs\"></a>\n\n### imageService.parseLangs(raw) ⇒ <code>string[]</code>\nNormalizes the `lang` query value: splits on `+` or `,`, lowercases,\ntrims, dedupes, sorts; defaults to `['eng']`, caps at 4 codes.\n\n**Kind**: instance method of [<code>ImageService</code>](#ImageService)  \n**Returns**: <code>string[]</code> - Sorted, deduped language codes.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| raw | <code>string</code> | Raw `lang` query parameter (already regex-validated). |\n\nsrc: packages/backend/src/resources/image/image.service.ts:110  \ndist: packages/backend/dist/resources/image/image.service.js:138 (approx.)\n<a name=\"ImageService+preprocess\"></a>\n\n### imageService.preprocess(input) ⇒ <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code>\nPreprocesses an image for OCR: auto-orient, downscale to at most 2000 px\nwithout enlarging, greyscale, normalize, sharpen; encoded as PNG.\nPixel bombs are rejected via `limitInputPixels`; undecodable or malicious\ninput surfaces as [UnsupportedMediaTypeException](UnsupportedMediaTypeException) instead of a 500.\n\n**Kind**: instance method of [<code>ImageService</code>](#ImageService)  \n**Returns**: <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code> - PNG bytes ready for tesseract.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| input | <code>Buffer&lt;ArrayBufferLike&gt;</code> | Raw (signature-verified) image bytes. |\n\nsrc: packages/backend/src/resources/image/image.service.ts:131  \ndist: packages/backend/dist/resources/image/image.service.js:157 (approx.)\n","symbols":3,"lastUsed":1795079890909}},"version":1}