, waking one queued caller if any.","memberof":"WorkerService","params":[],"meta":{"lineno":233},"order":10,"mdaics":{"dist":"packages/backend/dist/services/worker.service.js:130","src":"packages/backend/src/services/worker.service.ts:218"},"level":0},{"id":"WorkerService#touch","longname":"WorkerService#touch","name":"touch","kind":"function","scope":"instance","description":"Refreshes the entry's mtime so the janitor's LRU eviction keeps hot entries.","memberof":"WorkerService","params":[{"description":"Cache key of the entry.","name":"key","type":{"names":["string"]}}],"meta":{"lineno":325},"async":true,"order":12,"mdaics":{"dist":"packages/backend/dist/services/worker.service.js:205","src":"packages/backend/src/services/worker.service.ts:319"},"returns":[{"type":{"names":["Promise<void>"]}}],"level":0},{"id":"<anonymous>~succeeded","longname":"<anonymous>~succeeded","name":"succeeded","kind":"constant","scope":"inner","description":"Resolves true only for a clean exit (code 0, nothing on stderr as error).","memberof":"<anonymous>","params":[],"meta":{"lineno":275},"order":11,"mdaics":{"dist":"packages/backend/dist/services/worker.service.js:167","src":"packages/backend/src/services/worker.service.ts:265"}}],"fp":"99182b3f9e43738abcfdf803ab34afffc288c4e93a4a77aef1a631e3046ba921","issues":[],"kind":"tdata","lastUsed":1795730470585,"symbols":0},"md:packages/backend/src/services/worker.service.ts":{"fp":"c294c479624d4fde715565f8c2f4922439b2c8ef70910caf5ae28ea315d18586","issues":[],"kind":"md","markdown":"## Members\n\n<dl>\n<dt><a href=\"#WorkerService\">WorkerService</a></dt>\n<dd><p>Spawns sibling worker threads for CPU-heavy media/document work and serves their output (with a shared stream cache).</p>\n</dd>\n</dl>\n\n## Constants\n\n<dl>\n<dt><a href=\"#WORKER_ENV_KEYS\">WORKER_ENV_KEYS</a></dt>\n<dd><p>Environment for spawned worker threads: only what first-party workers need\n(paths, locales, log level, node/tmp dirs). Secrets such as METRICS_TOKEN,\nAUTH_* or ClamAV credentials never cross into a worker.</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#workerEnvironment\">workerEnvironment()</a> ⇒ <code>Record&lt;string, string&gt;</code></dt>\n<dd><p>Builds the worker environment from WORKER_ENV_KEYS.</p>\n</dd>\n<dt><a href=\"#workerPath\">workerPath(filename, metaUrl)</a> ⇒ <code>string</code></dt>\n<dd><p>Resolves a worker filename relative to the calling module&#39;s location.</p>\n<p>Services pass <code>&#39;./name.worker.js&#39;</code> to mean &quot;same folder&quot;; <code>new Worker(path)</code>\nwould otherwise resolve it against the process cwd and fail in production.</p>\n</dd>\n</dl>\n\n<a name=\"WorkerService\"></a>\n\n## WorkerService\nSpawns sibling worker threads for CPU-heavy media/document work and serves their output (with a shared stream cache).\n\n**Kind**: global variable  \nsrc: packages/backend/src/services/worker.service.ts:73  \ndist: packages/backend/dist/services/worker.service.js:51\n\n* [WorkerService](#WorkerService)\n    * [.createWorker(filename, options)](#WorkerService+createWorker) ⇒ <code>Promise&lt;Readable&gt;</code>\n    * [.acquireWorkerSlot()](#WorkerService+acquireWorkerSlot) ⇒ <code>Promise&lt;void&gt;</code>\n    * [.finishPersist(key, branch, succeeded)](#WorkerService+finishPersist) ⇒ <code>Promise&lt;void&gt;</code>\n    * [.keyFor(baseKey, filename, workerData)](#WorkerService+keyFor) ⇒ <code>string</code>\n    * [.persist(key, branch, succeeded)](#WorkerService+persist)\n    * [.releaseWorkerSlot()](#WorkerService+releaseWorkerSlot)\n    * [.touch(key)](#WorkerService+touch) ⇒ <code>Promise&lt;void&gt;</code>\n\n<a name=\"WorkerService+createWorker\"></a>\n\n### workerService.createWorker(filename, options) ⇒ <code>Promise&lt;Readable&gt;</code>\nReturns the processed output. Served from CACHE_DIR when possible,\notherwise produced by a worker thread (and cached while streaming).\n\n**Kind**: instance method of [<code>WorkerService</code>](#WorkerService)  \n**Returns**: <code>Promise&lt;Readable&gt;</code> - Processed output stream.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| filename | <code>string</code> | Worker entry file to run in a worker thread. |\n| options | <code>CreateWorkerOptions</code> | Worker and cache options. |\n\nsrc: packages/backend/src/services/worker.service.ts:103  \ndist: packages/backend/dist/services/worker.service.js:66\n<a name=\"WorkerService+acquireWorkerSlot\"></a>\n\n### workerService.acquireWorkerSlot() ⇒ <code>Promise&lt;void&gt;</code>\nWaits until a worker slot is free, then takes it.\n\n**Kind**: instance method of [<code>WorkerService</code>](#WorkerService)  \nsrc: packages/backend/src/services/worker.service.ts:136  \ndist: packages/backend/dist/services/worker.service.js:90\n<a name=\"WorkerService+finishPersist\"></a>\n\n### workerService.finishPersist(key, branch, succeeded) ⇒ <code>Promise&lt;void&gt;</code>\nWaits for the worker and the cache fill, then unlinks failed entries.\nNever rejects: a cache failure only destroys the unused tee branch.\n\n**Kind**: instance method of [<code>WorkerService</code>](#WorkerService)  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| key | <code>string</code> | Cache key. |\n| branch | <code>Readable</code> | Source stream to persist. |\n| succeeded | <code>Promise&lt;boolean&gt;</code> | Worker exit status. |\n\nsrc: packages/backend/src/services/worker.service.ts:152  \ndist: packages/backend/dist/services/worker.service.js:98\n<a name=\"WorkerService+keyFor\"></a>\n\n### workerService.keyFor(baseKey, filename, workerData) ⇒ <code>string</code>\nBuilds the cache key: parts joined with NUL so no component can smuggle separators.\n\n**Kind**: instance method of [<code>WorkerService</code>](#WorkerService)  \n**Returns**: <code>string</code> - The composite cache key.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| baseKey | <code>string</code> | Deterministic base key from the request (file signature + query + hash). |\n| filename | <code>string</code> | Worker entry filename mixed into the key. |\n| workerData | <code>unknown</code> | Worker payload mixed into the key. |\n\nsrc: packages/backend/src/services/worker.service.ts:185  \ndist: packages/backend/dist/services/worker.service.js:118\n<a name=\"WorkerService+persist\"></a>\n\n### workerService.persist(key, branch, succeeded)\nPersists the finished branch via StreamCache (atomic tmp+rename, 0o600).\nEmpties are not servable: read path treats size===0 as a miss, so a 0-byte\nentry is simply ignored until the janitor reaps it.\nFailures never affect the client: the entry is unlinked once the worker has settled.\n\n**Kind**: instance method of [<code>WorkerService</code>](#WorkerService)  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| key | <code>string</code> | Cache key. |\n| branch | <code>Readable</code> | Source stream to persist. |\n| succeeded | <code>Promise&lt;boolean&gt;</code> | Worker exit status. |\n\nsrc: packages/backend/src/services/worker.service.ts:206  \ndist: packages/backend/dist/services/worker.service.js:126\n<a name=\"WorkerService+releaseWorkerSlot\"></a>\n\n### workerService.releaseWorkerSlot()\nReleases a worker slot, waking one queued caller if any.\n\n**Kind**: instance method of [<code>WorkerService</code>](#WorkerService)  \nsrc: packages/backend/src/services/worker.service.ts:218  \ndist: packages/backend/dist/services/worker.service.js:130\n<a name=\"WorkerService+touch\"></a>\n\n### workerService.touch(key) ⇒ <code>Promise&lt;void&gt;</code>\nRefreshes the entry's mtime so the janitor's LRU eviction keeps hot entries.\n\n**Kind**: instance method of [<code>WorkerService</code>](#WorkerService)  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| key | <code>string</code> | Cache key of the entry. |\n\nsrc: packages/backend/src/services/worker.service.ts:319  \ndist: packages/backend/dist/services/worker.service.js:205\n<a name=\"WORKER_ENV_KEYS\"></a>\n\n## WORKER\\_ENV\\_KEYS\nEnvironment for spawned worker threads: only what first-party workers need\n(paths, locales, log level, node/tmp dirs). Secrets such as METRICS_TOKEN,\nAUTH_* or ClamAV credentials never cross into a worker.\n\n**Kind**: global constant  \nsrc: packages/backend/src/services/worker.service.ts:26  \ndist: packages/backend/dist/services/worker.service.js:23\n<a name=\"workerEnvironment\"></a>\n\n## workerEnvironment() ⇒ <code>Record&lt;string, string&gt;</code>\nBuilds the worker environment from WORKER_ENV_KEYS.\n\n**Kind**: global function  \n**Returns**: <code>Record&lt;string, string&gt;</code> - A fresh env record; FILE_FLY_WORKER is always set to '1'.  \nsrc: packages/backend/src/services/worker.service.ts:48  \ndist: packages/backend/dist/services/worker.service.js:40\n<a name=\"workerPath\"></a>\n\n## workerPath(filename, metaUrl) ⇒ <code>string</code>\nResolves a worker filename relative to the calling module's location.\n\nServices pass `'./name.worker.js'` to mean \"same folder\"; `new Worker(path)`\nwould otherwise resolve it against the process cwd and fail in production.\n\n**Kind**: global function  \n**Returns**: <code>string</code> - Absolute path to the worker file.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| filename | <code>string</code> | Worker filename as declared by the caller (e.g. `'./worker/index.js'`). |\n| metaUrl | <code>string</code> | `import.meta.url` of the module that declared the filename. |\n\nsrc: packages/backend/src/services/worker.service.ts:334  \ndist: packages/backend/dist/services/worker.service.js:215\n","symbols":14,"lastUsed":1795730470688},"tdata:packages/backend/src/utils/buffer.spec.ts":{"doclets":[{"id":"BUFFER_API_SURFACE","longname":"BUFFER_API_SURFACE","name":"BUFFER_API_SURFACE","kind":"constant","scope":"global","description":"Named symbol for the mdaics docs site (see https://github.com/rayenboussayed/mdaics); no runtime use.","meta":{"lineno":63},"order":1,"mdaics":{"src":"packages/backend/src/utils/buffer.spec.ts:75"},"level":0},{"id":"chunks","longname":"chunks","name":"chunks","kind":"function","scope":"global","description":"Yields 21 one-MiB chunks to exceed the 20 MiB cap.","params":[],"meta":{"lineno":9},"yields":[{"description":"A 1 MiB zero-filled chunk."}],"generator":true,"order":0,"mdaics":{"src":"packages/backend/src/utils/buffer.spec.ts:11"},"returns":[{"type":{"names":["Generator<Buffer<ArrayBufferLike>, any, any>"]}}],"level":0}],"fp":"eb9b76ef222d414c4cb7ecdc3ce39f2c40642ae6302095d733e7773c2bfa626a","issues":[],"kind":"tdata","lastUsed":1795730470722,"symbols":0},"md:packages/backend/src/utils/buffer.spec.ts":{"fp":"39ee45fa86d9f46d913ae6f898380f1438d257efe7ca40b3d74e8b31ca679466","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","markdown":"## Constants\n\n<dl>\n<dt><a href=\"#BUFFER_API_SURFACE\">BUFFER_API_SURFACE</a></dt>\n<dd><p>Named symbol for the mdaics docs site (see <a href=\"https://github.com/rayenboussayed/mdaics\">https://github.com/rayenboussayed/mdaics</a>); no runtime use.</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#chunks\">chunks()</a> ⇒ <code>Generator&lt;Buffer&lt;ArrayBufferLike&gt;, any, any&gt;</code></dt>\n<dd><p>Yields 21 one-MiB chunks to exceed the 20 MiB cap.</p>\n</dd>\n</dl>\n\n<a name=\"BUFFER_API_SURFACE\"></a>\n\n## BUFFER\\_API\\_SURFACE\nNamed symbol for the mdaics docs site (see https://github.com/rayenboussayed/mdaics); no runtime use.\n\n**Kind**: global constant  \nsrc: packages/backend/src/utils/buffer.spec.ts:75  \n<a name=\"chunks\"></a>\n\n## chunks() ⇒ <code>Generator&lt;Buffer&lt;ArrayBufferLike&gt;, any, any&gt;</code>\nYields 21 one-MiB chunks to exceed the 20 MiB cap.\n\n**Kind**: global function  \nsrc: packages/backend/src/utils/buffer.spec.ts:11  \n","symbols":2,"lastUsed":1795730470751},"tdata:packages/backend/src/utils/buffer.ts":{"doclets":[{"id":"ByteCapTransform()","longname":"ByteCapTransform","name":"ByteCapTransform","kind":"constructor","memberof":"ByteCapTransform","params":[{"description":"Maximum bytes to accept before destroying the stream.","name":"maxBytes","type":{"names":["number"]}}],"order":3,"returns":[{"type":{"names":["ByteCapTransform"]}}],"level":0},{"id":"ByteCapTransform","longname":"ByteCapTransform","name":"ByteCapTransform","kind":"class","scope":"global","description":"Passes stream chunks through while rejecting anything past a byte budget.","meta":{"lineno":16},"order":2,"mdaics":{"dist":"packages/backend/dist/utils/buffer.js:7","src":"packages/backend/src/utils/buffer.ts:20"},"level":0},{"id":"MAX_BUFFER_BYTES","longname":"MAX_BUFFER_BYTES","name":"MAX_BUFFER_BYTES","kind":"constant","scope":"global","description":"Maximum number of bytes buffered from a stream (20 MiB).","params":[],"meta":{"lineno":8},"order":0,"mdaics":{"dist":"packages/backend/dist/utils/buffer.js:5","src":"packages/backend/src/utils/buffer.ts:11"},"level":0},{"id":"WORKER_JSON_MAX_BYTES","longname":"WORKER_JSON_MAX_BYTES","name":"WORKER_JSON_MAX_BYTES","kind":"constant","scope":"global","description":"Maximum JSON payload a worker may write to stdout (8 MiB).","params":[],"meta":{"lineno":12},"order":1,"mdaics":{"dist":"packages/backend/dist/utils/buffer.js:6","src":"packages/backend/src/utils/buffer.ts:15"},"level":0},{"id":"bufferStream","longname":"bufferStream","name":"bufferStream","kind":"function","scope":"global","description":"Buffers a readable stream into a single Buffer, enforcing a size cap.","params":[{"description":"The readable stream to buffer.","name":"stream","type":{"names":["Readable"]}},{"description":"The maximum number of bytes to accept before throwing.","name":"maxBytes","type":{"names":["number"]}}],"returns":[{"description":"The concatenated buffer contents.","type":{"names":["Promise<Buffer<ArrayBufferLike>>"]}}],"meta":{"lineno":41},"order":4,"mdaics":{"dist":"packages/backend/dist/utils/buffer.js:23","src":"packages/backend/src/utils/buffer.ts:46"},"level":0},{"id":"parseJsonBuffer","longname":"parseJsonBuffer","name":"parseJsonBuffer","kind":"function","scope":"global","description":"Parses a small JSON payload emitted by a worker.","params":[{"description":"UTF-8 encoded JSON bytes.","name":"buffer","type":{"names":["Buffer<ArrayBufferLike>"]}}],"returns":[{"description":"The parsed JSON value.","type":{"names":["unknown"]}}],"meta":{"lineno":62},"order":5,"mdaics":{"dist":"packages/backend/dist/utils/buffer.js:38","src":"packages/backend/src/utils/buffer.ts:71"},"level":0},{"id":"readWorkerJson","longname":"readWorkerJson","name":"readWorkerJson","kind":"function","scope":"global","description":"Buffers and parses the small JSON payload a worker writes to stdout.","params":[{"description":"The worker's stdout stream.","name":"stdout","type":{"names":["Readable"]}}],"returns":[{"description":"The parsed JSON value.","type":{"names":["Promise<unknown>"]}}],"meta":{"lineno":70},"order":6,"mdaics":{"dist":"packages/backend/dist/utils/buffer.js:41","src":"packages/backend/src/utils/buffer.ts:80"},"level":0}],"fp":"7be07993682606395797df82421e55bfa845e6e2bfa52ad50fe337844e3a29e6","issues":[],"kind":"tdata","lastUsed":1795730470722,"symbols":0},"md:packages/backend/src/utils/buffer.ts":{"fp":"4913e4a94d45604d7e43e396833775275419477c02cea93bc8f3598c9d649c9f","issues":[],"kind":"md","markdown":"## Classes\n\n<dl>\n<dt><a href=\"#ByteCapTransform\">ByteCapTransform</a></dt>\n<dd><p>Passes stream chunks through while rejecting anything past a byte budget.</p>\n</dd>\n</dl>\n\n## Constants\n\n<dl>\n<dt><a href=\"#MAX_BUFFER_BYTES\">MAX_BUFFER_BYTES</a></dt>\n<dd><p>Maximum number of bytes buffered from a stream (20 MiB).</p>\n</dd>\n<dt><a href=\"#WORKER_JSON_MAX_BYTES\">WORKER_JSON_MAX_BYTES</a></dt>\n<dd><p>Maximum JSON payload a worker may write to stdout (8 MiB).</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#bufferStream\">bufferStream(stream, maxBytes)</a> ⇒ <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code></dt>\n<dd><p>Buffers a readable stream into a single Buffer, enforcing a size cap.</p>\n</dd>\n<dt><a href=\"#parseJsonBuffer\">parseJsonBuffer(buffer)</a> ⇒ <code>unknown</code></dt>\n<dd><p>Parses a small JSON payload emitted by a worker.</p>\n</dd>\n<dt><a href=\"#readWorkerJson\">readWorkerJson(stdout)</a> ⇒ <code>Promise&lt;unknown&gt;</code></dt>\n<dd><p>Buffers and parses the small JSON payload a worker writes to stdout.</p>\n</dd>\n</dl>\n\n<a name=\"ByteCapTransform\"></a>\n\n## ByteCapTransform\nPasses stream chunks through while rejecting anything past a byte budget.\n\n**Kind**: global class  \nsrc: packages/backend/src/utils/buffer.ts:20  \ndist: packages/backend/dist/utils/buffer.js:7\n<a name=\"new_ByteCapTransform_new\"></a>\n\n### new ByteCapTransform(maxBytes)\n\n| Param | Type | Description |\n| --- | --- | --- |\n| maxBytes | <code>number</code> | Maximum bytes to accept before destroying the stream. |\n\n<a name=\"MAX_BUFFER_BYTES\"></a>\n\n## MAX\\_BUFFER\\_BYTES\nMaximum number of bytes buffered from a stream (20 MiB).\n\n**Kind**: global constant  \nsrc: packages/backend/src/utils/buffer.ts:11  \ndist: packages/backend/dist/utils/buffer.js:5\n<a name=\"WORKER_JSON_MAX_BYTES\"></a>\n\n## WORKER\\_JSON\\_MAX\\_BYTES\nMaximum JSON payload a worker may write to stdout (8 MiB).\n\n**Kind**: global constant  \nsrc: packages/backend/src/utils/buffer.ts:15  \ndist: packages/backend/dist/utils/buffer.js:6\n<a name=\"bufferStream\"></a>\n\n## bufferStream(stream, maxBytes) ⇒ <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code>\nBuffers a readable stream into a single Buffer, enforcing a size cap.\n\n**Kind**: global function  \n**Returns**: <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code> - The concatenated buffer contents.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| stream | <code>Readable</code> | The readable stream to buffer. |\n| maxBytes | <code>number</code> | The maximum number of bytes to accept before throwing. |\n\nsrc: packages/backend/src/utils/buffer.ts:46  \ndist: packages/backend/dist/utils/buffer.js:23\n<a name=\"parseJsonBuffer\"></a>\n\n## parseJsonBuffer(buffer) ⇒ <code>unknown</code>\nParses a small JSON payload emitted by a worker.\n\n**Kind**: global function  \n**Returns**: <code>unknown</code> - The parsed JSON value.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| buffer | <code>Buffer&lt;ArrayBufferLike&gt;</code> | UTF-8 encoded JSON bytes. |\n\nsrc: packages/backend/src/utils/buffer.ts:71  \ndist: packages/backend/dist/utils/buffer.js:38\n<a name=\"readWorkerJson\"></a>\n\n## readWorkerJson(stdout) ⇒ <code>Promise&lt;unknown&gt;</code>\nBuffers and parses the small JSON payload a worker writes to stdout.\n\n**Kind**: global function  \n**Returns**: <code>Promise&lt;unknown&gt;</code> - The parsed JSON value.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| stdout | <code>Readable</code> | The worker's stdout stream. |\n\nsrc: packages/backend/src/utils/buffer.ts:80  \ndist: packages/backend/dist/utils/buffer.js:41\n","symbols":7,"lastUsed":1795730470787},"tdata:packages/backend/src/utils/capabilities.spec.ts":{"doclets":[],"fp":"55367577bf8d7453499cbeaba1978057f231b58a27326fae3129bfb54f1acbdc","issues":[],"kind":"tdata","lastUsed":1795730470722,"symbols":0},"md:packages/backend/src/utils/capabilities.spec.ts":{"fp":"8516f4fd28dac5335a3e7ad1f32428296ea4d3b13713ebef69e85b35c3cfe586","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795730470722},"tdata:packages/backend/src/utils/capabilities.ts":{"doclets":[{"id":"OUTPUT_CONTENT_TYPE","longname":"OUTPUT_CONTENT_TYPE","name":"OUTPUT_CONTENT_TYPE","kind":"constant","scope":"global","description":"Content-Type for each streamable output format.","meta":{"lineno":14},"order":0,"mdaics":{"dist":"packages/backend/dist/utils/capabilities.js:11","src":"packages/backend/src/utils/capabilities.ts:20"},"level"