nize calls for assertions.  \n\n| Param | Type | Default | Description |\n| --- | --- | --- | --- |\n| signature | <code>unknown</code> |  | File signature returned by the stubbed CLS store. |\n| source | <code>() &#x3D;&gt; Readable</code> |  | Factory opening a fresh input stream per call. |\n| isImage | <code>boolean</code> | <code>true</code> | Whether the stubbed file-type check passes. |\n\nsrc: packages/backend/src/resources/image/image.service.spec.ts:32  \n","symbols":2,"lastUsed":1795730467682},"tdata:packages/backend/src/resources/image/image.service.ts":{"doclets":[{"id":"ImageService","longname":"ImageService","name":"ImageService","kind":"member","scope":"global","description":"Image feature service: streams uploads through sharp workers for processing, metadata, DNA, stats and OCR.","params":[],"meta":{"lineno":90},"order":2,"mdaics":{"dist":"packages/backend/dist/resources/image/image.service.js:49","src":"packages/backend/src/resources/image/image.service.ts:71"},"level":0},{"id":"parseLangs","longname":"parseLangs","name":"parseLangs","kind":"function","scope":"global","description":"Normalizes the `lang` query value: splits on `+` or `,`, lowercases,\ntrims, dedupes, sorts; defaults to `['eng']`, caps at 4 codes.","params":[{"description":"Raw `lang` query parameter (already regex-validated).","name":"raw","type":{"names":["string"]}}],"returns":[{"description":"Sorted, deduped language codes.","type":{"names":["string[]"]}}],"meta":{"lineno":49},"order":0,"mdaics":{"dist":"packages/backend/dist/resources/image/image.service.js:22","src":"packages/backend/src/resources/image/image.service.ts:27"},"level":0},{"id":"preprocess","longname":"preprocess","name":"preprocess","kind":"function","scope":"global","description":"Preprocesses an image for OCR: auto-orient, downscale to at most 2000 px\nwithout enlarging, greyscale, normalize, sharpen; encoded as PNG.\nPixel bombs are rejected via `limitInputPixels`; undecodable or malicious\ninput surfaces as