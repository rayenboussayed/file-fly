idate container/codec format name. |\n\nsrc: packages/backend/src/utils/capabilities.ts:36  \ndist: packages/backend/dist/utils/capabilities.js:30 (approx.)\n","symbols":3,"lastUsed":1795079894247},"tdata:packages/backend/src/utils/cp1252.spec.ts":{"doclets":[],"fp":"232d7f810b9a4f7faf23db6846a19461839682df24b3c4af977c4122af6c5505","issues":[],"kind":"tdata","lastUsed":1795079894217,"symbols":0},"md:packages/backend/src/utils/cp1252.spec.ts":{"fp":"8d70d9b465ead05444935dde6cae11185df9595aedf91a53eb7564ee3d2682c4","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795079894218},"tdata:packages/backend/src/utils/cp1252.ts":{"doclets":[{"id":"WINANSI","longname":"WINANSI","name":"WINANSI","kind":"constant","scope":"global","description":"The set of unicode code points representable in WinAnsiEncoding.","params":[],"meta":{"lineno":8},"order":0,"mdaics":{"dist":"packages/backend/dist/utils/cp1252.js:1","src":"packages/backend/src/utils/cp1252.ts:9"},"level":0},{"id":"findUnencodableWinAnsi","longname":"findUnencodableWinAnsi","name":"findUnencodableWinAnsi","kind":"function","scope":"global","description":"Lists the distinct unencodable characters of a text, capped for error reporting.","params":[{"description":"The text to probe.","name":"text","type":{"names":["string"]}},{"description":"Maximum number of distinct offending characters to report (default 10).","name":"limit","type":{"names":["number"]}}],"returns":[{"description":"Up to `limit` distinct characters (with code points) that WinAnsi cannot encode.","type":{"names":["{ char: string; codePoint: number; }[]"]}}],"meta":{"lineno":51},"order":1,"mdaics":{"dist":"packages/backend/dist/utils/cp1252.js:37","src":"packages/backend/src/utils/cp1252.ts:52"},"level":0}],"fp":"4f61c970e3accfb112d2ae7dd31d4f630f33018b3ce2bf30d8cb0ca9d99d3438","issues":[],"kind":"tdata","lastUsed":1795079894218,"symbols":0},"md:packages/backend/src/utils/cp1252.ts":{"fp":"987851df54ac200f74774ac58c25c8d7e5f6155b2d94aebf50fa89078b1867e1","issues":[],"kind":"md","markdown":"## Constants\n\n<dl>\n<dt><a href=\"#WINANSI\">WINANSI</a></dt>\n<dd><p>The set of unicode code points representable in WinAnsiEncoding.</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#findUnencodableWinAnsi\">findUnencodableWinAnsi(text, limit)</a> ⇒ <code>{ char: string; codePoint: number; }[]</code></dt>\n<dd><p>Lists the distinct unencodable characters of a text, capped for error reporting.</p>\n</dd>\n</dl>\n\n<a name=\"WINANSI\"></a>\n\n## WINANSI\nThe set of unicode code points representable in WinAnsiEncoding.\n\n**Kind**: global constant  \nsrc: packages/backend/src/utils/cp1252.ts:9  \ndist: packages/backend/dist/utils/cp1252.js:1\n<a name=\"findUnencodableWinAnsi\"></a>\n\n## findUnencodableWinAnsi(text, limit) ⇒ <code>{ char: string; codePoint: number; }[]</code>\nLists the distinct unencodable characters of a text, capped for error reporting.\n\n**Kind**: global function  \n**Returns**: <code>{ char: string; codePoint: number; }[]</code> - Up to `limit` distinct characters (with code points) that WinAnsi cannot encode.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| text | <code>string</code> | The text to probe. |\n| limit | <code>number</code> | Maximum number of distinct offending characters to report (default 10). |\n\nsrc: packages/backend/src/utils/cp1252.ts:52  \ndist: packages/backend/dist/utils/cp1252.js:37\n","symbols":2,"lastUsed":1795079894275},"tdata:packages/backend/src/utils/drain.ts":{"doclets":[{"id":"drainStream","longname":"drainStream","name":"drainStream","kind":"function","scope":"global","description":"Discards the unread remainder of a stream without buffering it.\n\nCallers always consume to EOF, which is why this uses an async iterator:\na `'data'` listener cannot drain streams that are paused with pending read\nrequests (e.g. `process.stdin` inside a worker after Demuxer reads). The\niterator's implicit `return()` destroys the stream only at EOF, after\n`source` has ended — late enough that any sibling tee branch is done.","params":[{"description":"Stream to drop to EOF.","name":"stream","type":{"names":["Readable"]}}],"returns":[{"description":"The number of bytes discarded.","type":{"names":["Promise<number>"]}}],"meta":{"lineno":13},"order":0,"mdaics":{"dist":"packages/backend/dist/utils/drain.js:2","src":"packages/backend/src/utils/drain.ts:16"},"level":0}],"fp":"f202912d20ade29c1a82c5b2c7c84b91e23e188aa86e8e31dce8ea1652be34c9","issues":[],"kind":"tdata","lastUsed":1795079894247,"symbols":0},"md:packages/backend/src/utils/drain.ts":{"fp":"6d166d4736138a837a90e45a564a149e3c85ecdf883d2303f29459db2275017a","issues":[],"kind":"md","markdown":"<a name=\"drainStream\"></a>\n\n## drainStream(stream) ⇒ <code>Promise&lt;number&gt;</code>\nDiscards the unread remainder of a stream without buffering it.\n\nCallers always consume to EOF, which is why this uses an async iterator:\na `'data'` listener cannot drain streams that are paused with pending read\nrequests (e.g. `process.stdin` inside a worker after Demuxer reads). The\niterator's implicit `return()` destroys the stream only at EOF, after\n`source` has ended — late enough that any sibling tee branch is done.\n\n**Kind**: global function  \n**Returns**: <code>Promise&lt;number&gt;</code> - The number of bytes discarded.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| stream | <code>Readable</code> | Stream to drop to EOF. |\n\nsrc: packages/backend/src/utils/drain.ts:16  \ndist: packages/backend/dist/utils/drain.js:2\n","symbols":1,"lastUsed":1795079894298},"tdata:packages/backend/src/utils/fork-source.spec.ts":{"doclets":[],"fp":"9508fbce6de783d3926ff9c810169c0b039e5447ade5ed1fb349f996781c2c05","issues":[],"kind":"tdata","lastUsed":1795079894301,"symbols":0},"md:packages/backend/src/utils/fork-source.spec.ts":{"fp":"8a0ed2230df2e549be8bcf8b6ffac7b36dc336fa8cd9756d9d39f4e9de4244db","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795079894303},"tdata:packages/backend/src/utils/fork-source.ts":{"doclets":[{"id":"forkSource","longname":"forkSource","name":"forkSource","kind":"function","scope":"global","description":"Splits the current source stream into two branches: returns one branch and\nkeeps the other as the source on the CLS store.","params":[{"description":"The normalized CLS service carrying the current request context.","name":"cls","type":{"names":["NormalizedClsService"]}}],"returns":[{"description":"One branch of the teed source stream.","type":{"names":["Readable"]}}],"meta":{"lineno":8},"order":0,"mdaics":{"dist":"packages/backend/dist/utils/fork-source.js:2","src":"packages/backend/src/utils/fork-source.ts:13"},"level":0}],"fp":"ba9b0ea1676cdc3560618990e2c0cdb8cd0d9c146c638c7f73d9b176899edc59","issues":[],"kind":"tdata","lastUsed":1795079894303,"symbols":0},"md:packages/backend/src/utils/fork-source.ts":{"fp":"0e113424546c3eb9751d942f600bb70122c9546b59bcd2f6ea6e292cff16c2a9","issues":[],"kind":"md","markdown":"<a name=\"forkSource\"></a>\n\n## forkSource(cls) ⇒ <code>Readable</code>\nSplits the current source stream into two branches: returns one branch and\nkeeps the other as the source on the CLS store.\n\n**Kind**: global function  \n**Returns**: <code>Readable</code> - One branch of the teed source stream.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| cls | <code>NormalizedClsService</code> | The normalized CLS service carrying the current request context. |\n\nsrc: packages/backend/src/utils/fork-source.ts:13  \ndist: packages/backend/dist/utils/fork-source.js:2\n","symbols":1,"lastUsed":1795079894329},"tdata:packages/backend/src/utils/hyperlinks.ts":{"doclets":[{"id":"ALLOWED_URL_SCHEMES","longname":"ALLOWED_URL_SCHEMES","name":"ALLOWED_URL_SCHEMES","kind":"constant","scope":"global","description":"URL schemes allowed for hrefs written into generated documents (Word/PowerPoint open these).","params":[],"meta":{"lineno":2},"order":0,"mdaics":{"dist":"packages/backend/dist/utils/hyperlinks.js:1","src":"packages/backend/src/utils/hyperlinks.ts:2"},"level":0},{"id":"hyperlinkUrlOk","longname":"hyperlinkUrlOk","name":"hyperlinkUrlOk","kind":"function","scope":"global","description":"Whether a URL uses one of the allowed schemes (http, https, mailto).\nGenerated documents opened by Word/PowerPoint will follow `javascript:` and `file:` links,\nso anything else is rejected at the boundary.","params":[{"description":"The absolute URL to check.","name":"url","type":{"names":["string"]}}],"returns":[{"description":"True for http, https and mailto links.","type":{"names":["boolean"]}}],"meta":{"lineno":10},"order":1,"mdaics":{"dist":"packages/backend/dist/utils/hyperlinks.js:2","src":"packages/backend/src/utils/hyperlinks.ts:11"},"level":0}],"fp":"50d485d8acef8ea3b86c1e7a88241b6b1e7bbe9bf059dbcdc6912acbf8992129","issues":[],"kind":"tdata","lastUsed":1795079894308,"symbols":0},"md:packages/backend/src/utils/hyperlinks.ts":{"fp":"54025f5c060b8d28c1a7e88835704948f54da11fffb867d89ce88c210ed8accb","issues":[],"kind":"md","markdown":"## Constants\n\n<dl>\n<dt><a href=\"#ALLOWED_URL_SCHEMES\">ALLOWED_URL_SCHEMES</a></dt>\n<dd><p>URL schemes allowed for hrefs written into generated documents (Word/PowerPoint open these).</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#hyperlinkUrlOk\">hyperlinkUrlOk(url)</a> ⇒ <code>boolean</code></dt>\n<dd><p>Whether a URL uses one of the allowed schemes (http, https, mailto).\nGenerated documents opened by Word/PowerPoint will follow <code>javascript:</code> and <code>file:</code> links,\nso anything else is rejected at the boundary.</p>\n</dd>\n</dl>\n\n<a name=\"ALLOWED_URL_SCHEMES\"></a>\n\n## ALLOWED\\_URL\\_SCHEMES\nURL schemes allowed for hrefs written into generated documents (Word/PowerPoint open these).\n\n**Kind**: global constant  \nsrc: packages/backend/src/utils/hyperlinks.ts:2  \ndist: packages/backend/dist/utils/hyperlinks.js:1\n<a name=\"hyperlinkUrlOk\"></a>\n\n## hyperlinkUrlOk(url) ⇒ <code>boolean</code>\nWhether a URL uses one of the allowed schemes (http, https, mailto).\nGenerated documents opened by Word/PowerPoint will follow `javascript:` and `file:` links,\nso anything else is rejected at the boundary.\n\n**Kind**: global function  \n**Returns**: <code>boolean</code> - True for http, https and mailto links.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| url | <code>string</code> | The absolute URL to check. |\n\nsrc: packages/backend/src/utils/hyperlinks.ts:11  \ndist: packages/backend/dist/utils/hyperlinks.js:2\n","symbols":2,"lastUsed":1795079894362},"tdata:packages/backend/src/utils/input-format.spec.ts":{"doclets":[],"fp":"32970da7852756844a25446119b29e93227841fd7f4aae5b6c1ff8ad1cee91a4","issues":[],"kind":"tdata","lastUsed":1795079894308,"symbols":0},"md:packages/backend/src/utils/input-format.spec.ts":{"fp":"d8afa3839950f91bda9a6198e0c3798e31d4494ecaf6801eb87d66393625f334","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795079894308},"tdata:packages/backend/src/utils/input-format.ts":{"doclets":[{"id":"EXT_TO_DEMUXER","longname":"EXT_TO_DEMUXER","name":"EXT_TO_DEMUXER","kind":"constant","scope":"global","description":"Maps a detected file signature to an FFmpeg demuxer format name.\n\nfile-type reports short extensions (e.g. `mkv`, `mts`), while FFmpeg's\ndemuxer names occasionally differ (e.g. `matroska`, `mpegts`). This table\nbridges that gap so callers never have to pass `inputFormat` manually.","params":[],"meta":{"lineno":9},"order":0,"mdaics":{"dist":"packages/backend/dist/utils/input-format.js:2","src":"packages/backend/src/utils/input-format.ts:12"},"level":0},{"id":"toDemuxerFormat","longname":"toDemuxerFormat","name":"toDemuxerFormat","kind":"function","scope":"global","description":"Resolve a detected file signature to an FFmpeg demuxer format name.","params":[{"description":"Detected file-type signature of the upload.","name":"signature","type":{"names":["FileTypeResult"]}}],"returns":[{"description":"The FFmpeg demuxer format name, or undefined when unknown.","type":{"names":["string"]}}],"meta":{"lineno":98},"order":1,"mdaics":{"dist":"packages/backend/dist/utils/input-format.js:86","src":"packages/backend/src/utils/input-format.ts:104"},"level":0}],"fp":"92b64ca607de04817252af194c17cd6f3e8ad7c3101bdc8ae9361930fb4f4076","issues":[],"kind":"tdata","lastUsed":1795079894335,"symbols":0},"md:packages/backend/src/utils/input-format.ts":{"fp":"45f79ce5aa14482ab65a1b6428d2602d7c7b36370666b092f0fe1eaf751ad755","issues":[],"kind":"md","markdown":"## Constants\n\n<dl>\n<dt><a href=\"#EXT_TO_DEMUXER\">EXT_TO_DEMUXER</a></dt>\n<dd><p>Maps a detected file signature to an FFmpeg demuxer format name.</p>\n<p>file-type reports short extensions (e.g. <code>mkv</code>, <code>mts</code>), while FFmpeg&#39;s\ndemuxer names occasionally differ (e.g. <code>matroska</code>, <code>mpegts</code>). This table\nbridges that gap so callers never have to pass <code>inputFormat</code> manually.</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#toDemuxerFormat\">toDemuxerFormat(signature)</a> ⇒ <code>string</code></dt>\n<dd><p>Resolve a detected file signature to an FFmpeg demuxer format name.</p>\n</dd>\n</dl>\n\n<a name=\"EXT_TO_DEMUXER\"></a>\n\n## EXT\\_TO\\_DEMUXER\nMaps a detected file signature to an FFmpeg demuxer format name.\n\nfile-type reports short extensions (e.g. `mkv`, `mts`), while FFmpeg's\ndemuxer names occasionally differ (e.g. `matroska`, `mpegts`). This table\nbridges that gap so callers never have to pass `inputFormat` manually.\n\n**Kind**: global constant  \nsrc: packages/backend/src/utils/input-format.ts:12  \ndist: packages/backend/dist/utils/input-format.js:2\n<a name=\"toDemuxerFormat\"></a>\n\n## toDemuxerFormat(signature) ⇒ <code>string</code>\nResolve a detected file signature to an FFmpeg demuxer format name.\n\n**Kind**: global function  \n**Returns**: <code>string</code> - The FFmpeg demuxer format name, or undefined when unknown.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| signature | <code>FileTypeResult</code> | Detected file-type signature of the upload. |\n\nsrc: packages/backend/src/utils/input-format.ts:104  \ndist: packages/backend/dist/utils/input-format.js:86\n","symbols":2,"lastUsed":1795079894413},"tdata:packages/backend/src/utils/open-source.spec.ts":{"doclets":[{"id":"makeGetHarness","longname":"makeGetHarness","name":"makeGetHarness","kind":"function","scope":"global","description":"Builds a CLS stub whose request is a GET carrying a source query.","params":[],"returns":[{"description":"The stub and the backing state.","type":{"names":["Harness"]}}],"meta":{"lineno":18},"order":0,"mdaics":{"src":"packages/backend/src/utils/open-source.spec.ts:26"},"level":0},{"id":"collect","longname":"collect","name":"collect","kind":"function","scope":"global","description":"Reads a stream to EOF, returning its concatenated bytes.","params":[{"description":"Stream to consume.","name":"stream","type":{"names":["Readable"]}}],"returns":[{"description":"The concatenated buffer.","type":{"names":["Promise<Buffer<ArrayBufferLike>>"]}}],"meta":{"lineno":47},"async":true,"order":1,"mdaics":{"src":"packages/backend/src/utils/open-source.spec.ts:56"},"level":0},{"id":"makeGetHarnessWith","longname":"makeGetHarnessWith","name":"makeGetHarnessWith","kind":"function","scope":"global","description":"Builds a GET CLS stub with a custom source URL and request headers.","params":[{"description":"The user-supplied source URL under test.","name":"source","type":{"names":["string"]}},{"description":"Headers a browser client might carry.","name":"headers","type":{"names":["Record<string, string>"]}}],"returns":[{"description":"The stub and the backing state.","type":{"names":["Harness"]}}],"meta":{"lineno":62},"order":2,"mdaics":{"src":"packages/backend/src/utils/open-source.spec.ts:72"},"level":0}],"fp":"a3122bac0e693fd9ce1adf3e4587bbe1503ce13e3af1bf7e87b9b0fd3260f45b","issues":[],"kind":"tdata","lastUsed":1795079894385,"symbols":0},"md:packages/backend/src/utils/open-source.spec.ts":{"fp":"751489083d47548ddc3e542f7d36be0d479e9bef231796c892aaa97a29be7066","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","markdown":"## Functions\n\n<dl>\n<dt><a href=\"#makeGetHarness\">makeGetHarness()</a> ⇒ <code>Harness</code></dt>\n<dd><p>Builds a CLS stub whose request is a GET carrying a source query.</p>\n</dd>\n<dt><a href=\"#collect\">collect(stream)</a> ⇒ <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code></dt>\n<dd><p>Reads a stream to EOF, returning its concatenated bytes.</p>\n</dd>\n<dt><a href=\"#makeGetHarnessWith\">makeGetHarnessWith(source, headers)</a> ⇒ <code>Harness</code></dt>\n<dd><p>Builds a GET CLS stub with a custom source URL and request headers.</p>\n</dd>\n</dl>\n\n<a name=\"makeGetHarness\"></a>\n\n## makeGetHarness() ⇒ <code>Harness</code>\nBuilds a CLS stub whose request is a GET carrying a source query.\n\n**Kind**: global function  \n**Returns**: <code>Harness</code> - The stub and the backing state.  \nsrc: packages/backend/src/utils/open-source.spec.ts:26  \n<a name=\"collect\"></a>\n\n## collect(stream) ⇒ <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code>\nReads a stream to EOF, returning its concatenated bytes.\n\n**Kind**: global function  \n**Returns**: <code>Promise&lt;Buffer&lt;ArrayBufferLike&gt;&gt;</code> - The concatenated buffer.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| stream | <code>Readable</code> | Stream to consume. |\n\nsrc: packages/backend/src/utils/open-source.spec.ts:56  \n<a name=\"makeGetHarnessWith\"></a>\n\n## makeGetHarnessWith(source, headers) ⇒ <code>Harness</code>\nBuilds a GET CLS stub with a custom source URL and request headers.\n\n**Kind**: global function  \n**Returns**: <code>Harness</code> - The stub and the backing state.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| source | <code>string</code> | The user-supplied source URL under test. |\n| headers | <code>Record&lt;string, string&gt;</code> | Headers a browser client might carry. |\n\nsrc: packages/backend/src/utils/open-source.spec.ts:72  \n","symbols":3,"lastUsed":1795079894453},"tdata:packages/backend/src/utils/pdq.spec.ts":{"doclets":[{"id":"diagonalGradient","longname":"diagonalGradient","name":"diagonalGradient","kind":"function","scope":"global","description":"Builds a deterministic 64x64 RGB test image (seeded diagonal gradient).","params":[],"returns":[{"description":"The raw RGB pixel bytes.","type":{"names":["Uint8Array<ArrayBufferLike>"]}}],"meta":{"lineno":7},"order":0,"mdaics":{"src":"packages/backend/src/utils/pdq.spec.ts:9"},"level":0}],"fp":"e042c9f6b881ae62ed39595fb3691a6f06f98ab63685db01c59e78e1c5e3d348","issues":[],"kind":"tdata","lastUsed":1795079894499,"symbols":0},"md:packages/backend/src/utils/pdq.spec.ts":{"fp":"74eb7dbdd711455e2c2f40dbb6539e72a4230678da7e98bde8f350b8736a57a0","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","markdown":"<a name=\"diagonalGradient\"></a>\n\n## diagonalGradient() ⇒ <code>Uint8Array&lt;ArrayBufferLike&gt;</code>\nBuilds a deterministic 64x64 RGB test image (seeded diagonal gradient).\n\n**Kind**: global function  \n**Returns**: <code>Uint8Array&lt;ArrayBufferLike&gt;</code> - The raw RGB pixel bytes.  \nsrc: packages/backend/src/utils/pdq.spec.ts:9  \n","symbols":1,"lastUsed":1795079894563},"tdata:packages/backend/src/utils/open-source.ts":{"doclets":[{"id":"ByteCapTransform()","longname":"ByteCapTransform","name":"ByteCapTransform","kind":"constructor","memberof":"ByteCapTransform","params":[{"description":"Maximum bytes to accept before destroying the stream.","name":"maxBytes","type":{"names":["number"]}}],"order":8,"returns":[{"type":{"names":["ByteCapTransform"]}}],"level":0},{"id":"ByteCapTransform","longname":"ByteCapTransform","name":"ByteCapTransform","kind":"class","scope":"global","description":"Streams bytes through while counting them; self-destructs with a\n`PayloadTooLargeException` once the running total exceeds `maxBytes`.","meta":{"lineno":97},"order":7,"mdaics":{"dist":"packages/backend/dist/utils/open-source.js:61","src":"packages/backend/src/utils/open-source.ts:115"},"level":0},{"id":"FORWARDABLE_HEADERS","longname":"FORWARDABLE_HEADERS","name":"FORWARDABLE_HEADERS","kind":"constant","scope":"global","description":"Headers safe to forward to the remote origin; everything else is dropped.","params":[],"meta":{"lineno":8},"order":0,"mdaics":{"dist":"packages/backend/dist/utils/open-source.js:7","src":"packages/backend/src/utils/open-source.ts:12"},"level":0},{"id":"REFUSED_HOSTNAMES","longname":"REFUSED_HOSTNAMES","name":"REFUSED_HOSTNAMES","kind":"constant","scope":"global","description":"Hostnames always refused, regardless of EGRESS_ALLOWLIST.","params":[],"meta":{"lineno":10},"order":1,"mdaics":{"dist":"packages/backend/dist/utils/open-source.js:8","src":"packages/backend/src/utils/open-source.ts:15"},"level":0},{"id":"EGRESS_ALLOWLIST","longname":"EGRESS_ALLOWLIST","name":"EGRESS_ALLOWLIST","kind":"constant","scope":"global","description":"Hostnames from EGRESS_ALLOWLIST, lowercased; empty = allowlist inactive.","params":[],"meta":{"lineno":46},"order":5,"mdaics":{"dist":"packages/backend/dist/utils/open-source.js:28","src":"packages/backend/src/utils/open-source.ts:57"},"level":0},{"id":"ipv4Octets","longname":"ipv4Octets","name":"ipv4Octets","kind":"function","scope":"global","description":"Parses a bare IPv4 literal into its octets, or undefined for anything else.","params":[{"description":"Lowercased bare host (no brackets).","name":"host","type":{"names":["string"]}}],"returns":[{"description":"The four octets, or undefined when not an IPv4 literal.","type":{"names":["[number, number, number, number]"]}}],"meta":{"lineno":16},"order":2,"mdaics":{"dist":"packages/backend/dist/utils/open-source.js:9","src":"packages/backend/src/utils/open-source.ts:22"},"level":0},{"id":"isPrivateIpv4","longname":"isPrivateIpv4","name":"isPrivateIpv4","kind":"function","scope":"global","description":"Whether an IPv4 literal sits in a loopback, private, link-local or CGNAT range.","params":[{"description":"The four octets of the literal.","name":"octets","type":{"names":["[number, number, number, number]"]}}],"returns":[{"description":"True when the literal must not be fetched.","type":{"names":["boolean"]}}],"meta":{"lineno":28},"order":3,"mdaics":{"dist":"packages/backend/dist/utils/open-source.js:16","src":"packages/backend/src/utils/open-source.ts:34"},"level":0},{"id":"isPrivateIpv6","longname":"isPrivateIpv6","name":"isPrivateIpv6","kind":"function","scope":"global","description":"Whether a bare IPv6 literal (already bracket-stripped) sits in ::1/::/fc00::/7/fe80::/10.","params":[{"description":"Lowercased bare host without brackets.","name":"host","type":{"names":["string"]}}],"returns":[{"description":"True when the literal must not be fetched.","type":{"names":["boolean"]}}],"meta":{"lineno":44},"order":4,"mdaics":{"dist":"packages/backend/dist/utils/open-source.js:27","src":"packages/backend/src/utils/open-source.ts:53"},"level":0},{"id":"assertEgressAllowed","longname":"assertEgressAllowed","name":"assertEgressAllowed","kind":"function","scope":"global","description":"Enforces the egress rules for a user-supplied source URL:\nscheme allowlist (http/https only), private/loopback-literal denial, and\nthe optional `EGRESS_ALLOWLIST` (exact host or dotted suffix).\n\nNote: DNS resolution is not interposed, so a public hostname that resolves\nto a private address is out of scope; `EGRESS_ALLOWLIST` is the control for\nsuch deployments.","params":[{"description":"The parsed source URL.","name":"url","type":{"names":["URL"]}}],"exceptions":[{"description":"BadRequestException When the URL fails the egress rules."}],"meta":{"lineno":58},"order":6,"mdaics":{"dist":"packages/backend/dist/utils/open-source.js:29","src":"packages/backend/src/utils/open-source.ts:72"},"level":0},{"id":"openMediaSource","longname":"openMediaSource","name":"openMediaSource","kind":"function","scope":"global","description":"Opens the media source for the current request: sets the source direction\n(`upload` for POSTs, `download` otherwise) and the source stream on the\nCLS store.\n\nIdempotent: when a source stream is already present on the CLS store the\ncall is a no-op, so interceptors bound before or after each other can both\nrely on it without opening the source twice. Method-less requests (e.g.\nsynthetic invocations) carry no media and are left untouched.\n\nEgress (GET): the URL scheme is limited to http/https and loopback, private,\nlink-local and CGNAT literals are refused; `EGRESS_ALLOWLIST` can further\nrestrict the fetchable hosts (comma-separated bare hosts, dotted suffixes\nallowed). Only `accept`, `accept-language` and `user-agent` are forwarded —\nclient credentials (authorization, cookie, x-*, ...) are never sent to the\nremote origin.\n\nSize cap: both paths are bounded by `CLAMAV_MAX_BYTES` independently of\nwhether virus scanning is enabled — a declared `content-length` over the cap\nis rejected 413 before any byte flows, and a byte-counting transform\nself-destructs past the cap for unsized uploads and chunked downloads.","params":[{"description":"The normalized CLS service carrying the current request context.","name":"cls","type":{"names":["NormalizedClsService"]}}],"returns":[{"description":"Resolves once the source has been opened (or skipped).","type":{"names":["Promise<void>"]}}],"meta":{"lineno":140},"order":9,"mdaics":{"dist":"packages/backend/dist/utils/open-source.js:77","src":"packages/backend/src/utils/open-source.ts:159"},"level":0}],"fp":"654d1bc865dd600809881d839391dce728717cea4e65adc52e49bf5fc43653bc","issues":[],"kind":"tdata","lastUsed":1795079894456,"symbols":0},"md:packages/backend/src/utils/open-source.ts":{"fp":"3778f8913550e30b63e0428faa816789c0427b070e4eb6d1532cbffdf137152a","issues":[],"kind":"md","markdown":"## Classes\n\n<dl>\n<dt><a href=\"#ByteCapTransform\">ByteCapTransform</a></dt>\n<dd><p>Streams bytes through while counting them; self-destructs with a\n<code>PayloadTooLargeException</code> once the running total exceeds <code>maxBytes</code>.</p>\n</dd>\n</dl>\n\n## Constants\n\n<dl>\n<dt><a href=\"#FORWARDABLE_HEADERS\">FORWARDABLE_HEADERS</a></dt>\n<dd><p>Headers safe to forward to the remote origin; everything else is dropped.</p>\n</dd>\n<dt><a href=\"#REFUSED_HOSTNAMES\">REFUSED_HOSTNAMES</a></dt>\n<dd><p>Hostnames always refused, regardless of EGRESS_ALLOWLIST.</p>\n</dd>\n<dt><a href=\"#EGRESS_ALLOWLIST\">EGRESS_ALLOWLIST</a></dt>\n<dd><p>Hostnames from EGRESS_ALLOWLIST, lowercased; empty = allowlist inactive.</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#ipv4Octets\">ipv4Octets(host)</a> ⇒ <code>[number, number, number, number]</code></dt>\n<dd><p>Parses a bare IPv4 literal into its octets, or undefined for anything else.</p>\n</dd>\n<dt><a href=\"#isPrivateIpv4\">isPrivateIpv4(octets)</a> ⇒ <code>boolean</code></dt>\n<dd><p>Whether an IPv4 literal sits in a loopback, private, link-local or CGNAT range.</p>\n</dd>\n<dt><a href=\"#isPrivateIpv6\">isPrivateIpv6(host)</a> ⇒ <code>boolean</code></dt>\n<dd><p>Whether a bare IPv6 literal (already bracket-stripped) sits in ::1/::/fc00::/7/fe80::/10.</p>\n</dd>\n<dt><a href=\"#assertEgressAllowed\">assertEgressAllowed(url)</a></dt>\n<dd><p>Enforces the egress rules for a user-supplied source URL:\nscheme allowlist (http/https only), private/loopback-literal denial, and\nthe optional <code>EGRESS_ALLOWLIST</code> (exact host or dotted suffix).</p>\n<p>Note: DNS resolution is not interposed, so a public hostname that resolves\nto a private address is out of scope; <code>EGRESS_ALLOWLIST</code> is the control for\nsuch deployments.</p>\n</dd>\n<dt><a href=\"#openMediaSource\">openMediaSource(cls)</a> ⇒ <code>Promise&lt;void&gt;</code></dt>\n<dd><p>Opens the media source for the current request: sets the source direction\n(<code>upload</code> for POSTs, <code>download</code> otherwise) and the source stream on the\nCLS store.</p>\n<p>Idempotent: when a source stream is already present on the CLS store the\ncall is a no-op, so interceptors bound before or after each other can both\nrely on it without opening the source twice. Method-less requests (e.g.\nsynthetic invocations) carry no media and are left untouched.</p>\n<p>Egress (GET): the URL scheme is limited to http/https and loopback, private,\nlink-local and CGNAT literals are refused; <code>EGRESS_ALLOWLIST</code> can further\nrestrict the fetchable hosts (comma-separated bare hosts, dotted suffixes\nallowed). Only <code>accept</code>, <code>accept-language</code> and <code>user-agent</code> are forwarded —\nclient credentials (authorization, cookie, x-*, ...) are never sent to the\nremote origin.</p>\n<p>Size cap: both paths are bounded by <code>CLAMAV_MAX_BYTES</code> independently of\nwhether virus scanning is enabled — a declared <code>content-length</code> over the cap\nis rejected 413 before any byte flows, and a byte-counting transform\nself-destructs past the cap for unsized uploads and chunked downloads.</p>\n</dd>\n</dl>\n\n<a name=\"ByteCapTransform\"></a>\n\n## ByteCapTransform\nStreams bytes through while counting them; self-destructs with a\n`PayloadTooLargeException` once the running total exceeds `maxBytes`.\n\n**Kind**: global class  \nsrc: packages/backend/src/utils/open-source.ts:115  \ndist: packages/backend/dist/utils/open-source.js:61\n<a name=\"new_ByteCapTransform_new\"></a>\n\n### new ByteCapTransform(maxBytes)\n\n| Param | Type | Description |\n| --- | --- | --- |\n| maxBytes | <code>number</code> | Maximum bytes to accept before destroying the stream. |\n\n<a name=\"FORWARDABLE_HEADERS\"></a>\n\n## FORWARDABLE\\_HEADERS\nHeaders safe to forward to the remote origin; everything else is dropped.\n\n**Kind**: global constant  \nsrc: packages/backend/src/utils/open-source.ts:12  \ndist: packages/backend/dist/utils/open-source.js:7\n<a name=\"REFUSED_HOSTNAMES\"></a>\n\n## REFUSED\\_HOSTNAMES\nHostnames always refused, regardless of EGRESS_ALLOWLIST.\n\n**Kind**: global constant  \nsrc: packages/backend/src/utils/open-source.ts:15  \ndist: packages/backend/dist/utils/open-source.js:8\n<a name=\"EGRESS_ALLOWLIST\"></a>\n\n## EGRESS\\_ALLOWLIST\nHostnames from EGRESS_ALLOWLIST, lowercased; empty = allowlist inactive.\n\n**Kind**: global constant  \nsrc: packages/backend/src/utils/open-source.ts:57  \ndist: packages/backend/dist/utils/open-source.js:28\n<a name=\"ipv4Octets\"></a>\n\n## ipv4Octets(host) ⇒ <code>[number, number, number, number]</code>\nParses a bare IPv4 literal into its octets, or undefined for anything else.\n\n**Kind**: global function  \n**Returns**: <code>[number, number, number, number]</code> - The four octets, or undefined when not an IPv4 literal.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| host | <code>string</code> | Lowercased bare host (no brackets). |\n\nsrc: packages/backend/src/utils/open-source.ts:22  \ndist: packages/backend/dist/utils/open-source.js:9\n<a name=\"isPrivateIpv4\"></a>\n\n## isPrivateIpv4(octets) ⇒ <code>boolean</code>\nWhether an IPv4 literal sits in a loopback, private, link-local or CGNAT range.\n\n**Kind**: global function  \n**Returns**: <code>boolean</code> - True when the literal must not be fetched.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| octets | <code>[number, number, number, number]</code> | The four octets of the literal. |\n\nsrc: packages/backend/src/utils/open-source.ts:34  \ndist: packages/backend/dist/utils/open-source.js:16\n<a name=\"isPrivateIpv6\"></a>\n\n## isPrivateIpv6(host) ⇒ <code>boolean</code>\nWhether a bare IPv6 literal (already bracket-stripped) sits in ::1/::/fc00::/7/fe80::/10.\n\n**Kind**: global function  \n**Returns**: <code>boolean</code> - True when the literal must not be fetched.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| host | <code>string</code> | Lowercased bare host without brackets. |\n\nsrc: packages/backend/src/utils/open-source.ts:53  \ndist: packages/backend/dist/utils/open-source.js:27\n<a name=\"assertEgressAllowed\"></a>\n\n## assertEgressAllowed(url)\nEnforces the egress rules for a user-supplied source URL:\nscheme allowlist (http/https only), private/loopback-literal denial, and\nthe optional `EGRESS_ALLOWLIST` (exact host or dotted suffix).\n\nNote: DNS resolution is not interposed, so a public hostname that resolves\nto a private address is out of scope; `EGRESS_ALLOWLIST` is the control for\nsuch deployments.\n\n**Kind**: global function  \n**Throws**:\n\n- BadRequestException When the URL fails the egress rules.\n\n\n| Param | Type | Description |\n| --- | --- | --- |\n| url | <code>URL</code> | The parsed source URL. |\n\nsrc: packages/backend/src/utils/open-source.ts:72  \ndist: packages/backend/dist/utils/open-source.js:29\n<a name=\"openMediaSource\"></a>\n\n## openMediaSource(cls) ⇒ <code>Promise&lt;void&gt;</code>\nOpens the media source for the current request: sets the source direction\n(`upload` for POSTs, `download` otherwise) and the source stream on the\nCLS store.\n\nIdempotent: when a source stream is already present on the CLS store the\ncall is a no-op, so interceptors bound before or after each other can both\nrely on it without opening the source twice. Method-less requests (e.g.\nsynthetic invocations) carry no media and are left untouched.\n\nEgress (GET): the URL scheme is limited to http/https and loopback, private,\nlink-local and CGNAT literals are refused; `EGRESS_ALLOWLIST` can further\nrestrict the fetchable hosts (comma-separated bare hosts, dotted suffixes\nallowed). Only `accept`, `accept-language` and `user-agent` are forwarded —\nclient credentials (authorization, cookie, x-*, ...) are never sent to the\nremote origin.\n\nSize cap: both paths are bounded by `CLAMAV_MAX_BYTES` independently of\nwhether virus scanning is enabled — a declared `content-length` over the cap\nis rejected 413 before any byte flows, and a byte-counting transform\nself-destructs past the cap for unsized uploads and chunked downloads.\n\n**Kind**: global function  \n**Returns**: <code>Promise&lt;void&gt;</code> - Resolves once the source has been opened (or skipped).  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| cls | <code>NormalizedClsService</code> | The normalized CLS service carrying the current request context. |\n\nsrc: packages/backend/src/utils/open-source.ts:159  \ndist: packages/backend/dist/utils/open-source.js:77\n","symbols":10,"lastUsed":1795079894534},"tdata:packages/backend/src/utils/pdq.ts":{"doclets":[{"id":"loadPdq","longname":"loadPdq","name":"loadPdq","kind":"constant","scope":"global","description":"Loads and initializes the PDQ perceptual-hash class, caching it for reuse.\n\nThis function takes no parameters.\n\nThe `pdq-wasm` ESM entry (`dist/esm/index.js`) cannot locate its `.wasm`\nfile under Node, so the working CommonJS entry is loaded on purpose with\n`createRequire(import.meta.url)('pdq-wasm')` instead of a static ESM import.\nThe first call requires the package and awaits `PDQ.init()`; concurrent\nfirst calls share a single in-flight initialization promise, and later\ncalls return the cached class. The memoized entry is dropped if\ninitialization rejects, so a failed attempt is retried on the next call.","returns":[{"description":"The initialized `PDQ` class."}],"meta":{"lineno":18},"order":0,"mdaics":{"dist":"packages/backend/dist/utils/pdq.js:4","src":"packages/backend/src/utils/pdq.ts:25"},"level":0}],"fp":"610591473afffd62100fb8f0cb7d234309f33578e4755faf0722e1a7c68a4f2a","issues":[],"kind":"tdata","lastUsed":1795079894504,"symbols":0},"md:packages/backend/src/utils/pdq.ts":{"fp":"e69de2372b8afb28e9871dd0d126e2bf36f88c31b6feea6f61fc47c1d2dfb556","issues":[],"kind":"md","markdown":"<a name=\"loadPdq\"></a>\n\n## loadPdq ⇒\nLoads and initializes the PDQ perceptual-hash class, caching it for reuse.\n\nThis function takes no parameters.\n\nThe `pdq-wasm` ESM entry (`dist/esm/index.js`) cannot locate its `.wasm`\nfile under Node, so the working CommonJS entry is loaded on purpose with\n`createRequire(import.meta.url)('pdq-wasm')` instead of a static ESM import.\nThe first call requires the package and awaits `PDQ.init()`; concurrent\nfirst calls share a single in-flight initialization promise, and later\ncalls return the cached class. The memoized entry is dropped if\ninitialization rejects, so a failed attempt is retried on the next call.\n\n**Kind**: global constant  \n**Returns**: The initialized `PDQ` class.  \nsrc: packages/backend/src/utils/pdq.ts:25  \ndist: packages/backend/dist/utils/pdq.js:4\n","symbols":1,"lastUsed":1795079894610},"tdata:packages/backend/src/utils/pipe.spec.ts":{"doclets":[{"id":"collector","longname":"collector","name":"collector","kind":"function","scope":"global","description":"Collects everything written to a Writable.","params":[],"returns":[{"description":"Sink with the collected chunks and the raw writable stream.","type":{"names":["{ chunks: Buffer<ArrayBufferLike>[]; raw: Writable; }"]}}],"meta":{"lineno":9},"order":0,"mdaics":{"src":"packages/backend/src/utils/pipe.spec.ts:12"},"level":0}],"fp":"ba73339846d9912c09e811c678f13ff3d9666095306d4b5be3645e6d9131e267","issues":[],"kind":"tdata","lastUsed":1795079894565,"symbols":0},"md:packages/backend/src/utils/pipe.spec.ts":{"fp":"b624f9dd011ade9bf4756afe3cf73e13e7b6123f991def5b81e2de31a3167109","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","markdown":"<a name=\"collector\"></a>\n\n## collector() ⇒ <code>{ chunks: Buffer&lt;ArrayBufferLike&gt;[]; raw: Writable; }</code>\nCollects everything written to a Writable.\n\n**Kind**: global function  \n**Returns**: <code>{ chunks: Buffer&lt;ArrayBufferLike&gt;[]; raw: Writable; }</code> - Sink with the collected chunks and the raw writable stream.  \nsrc: packages/backend/src/utils/pipe.spec.ts:12  \n","symbols":1,"lastUsed":1795079894586},"tdata:packages/backend/src/utils/pipe.ts":{"doclets":[{"id":"pipeToReply","longname":"pipeToReply","name":"pipeToReply","kind":"function","scope":"global","description":"Streams a processed media stream into the raw HTTP response.\n\nOnce headers are sent there is nothing left to report to the client, so\nerrors (worker failure, client disconnect) are logged and the raw response\nis destroyed instead of being rethrown into the exception filter.\n\nUnlike `pipeline()`, a destination failure does NOT destroy `source`: the\nremainder is drained to EOF instead. A destroyed branch would stall the\nsibling branch of the `jutilities` tee that feeds the cache writer, so the\nworker output would never be persisted on early client disconnects.","params":[{"description":"Stream produced by a worker or served from the cache.","name":"source","type":{"names":["Readable"]}},{"description":"Fastify reply wrapping the raw HTTP response.","name":"response","type":{"names":["FastifyReply<import(\"fastify\").RouteGenericInterface, import(\"fastify\").RawServerDefault, import(\"http\").IncomingMessage, import(\"http\").ServerResponse<import(\"http\").IncomingMessage>, unknown, import(\"fastify\").FastifySchema, import(\"fastify\").FastifyTypeProviderDefault, unknown>"]}},{"description":"Optional pass-through transform placed between the source\nand the raw response to count streamed bytes (see `createOutMeter`).","name":"outMeter","type":{"names":["Transform"]}}],"meta":{"lineno":20},"order":0,"mdaics":{"dist":"packages/backend/dist/utils/pipe.js:4","src":"packages/backend/src/utils/pipe.ts:27"},"returns":[{"type":{"names":["Promise<void>"]}}],"level":0},{"id":"<anonymous>~finish","longname":"<anonymous>~finish","name":"finish","kind":"function","scope":"inner","description":"Settles the pump exactly once.","memberof":"<anonymous>","params":[{"description":"Whether the stream failed (rather than finished cleanly).","name":"failed","type":{"names":["boolean"]}},{"description":"The error that caused the failure, if any.","name":"error","type":{"names":["unknown"]}}],"meta":{"lineno":32},"order":1,"mdaics":{"dist":"packages/backend/dist/utils/pipe.js:9","src":"packages/backend/src/utils/pipe.ts:44"}}],"fp":"c1c0b6cbe4370ffc80d1e96118c2bf9ddebbd9da7b8ad26cc38981f85d242189","issues":[],"kind":"tdata","lastUsed":1795079894610,"symbols":0},"md:packages/backend/src/utils/pipe.ts":{"fp":"72da65c8a7b9335046e366a4d0a12c0f9b01fd06ccf29baa7df44f136edfde07","issues":[],"kind":"md","markdown":"<a name=\"pipeToReply\"></a>\n\n## pipeToReply(source, response, outMeter) ⇒ <code>Promise&lt;void&gt;</code>\nStreams a processed media stream into the raw HTTP response.\n\nOnce headers are sent there is nothing left to report to the client, so\nerrors (worker failure, client disconnect) are logged and the raw response\nis destroyed instead of being rethrown into the exception filter.\n\nUnlike `pipeline()`, a destination failure does NOT destroy `source`: the\nremainder is drained to EOF instead. A destroyed branch would stall the\nsibling branch of the `jutilities` tee that feeds the cache writer, so the\nworker output would never be persisted on early client disconnects.\n\n**Kind**: global function  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| source | <code>Readable</code> | Stream produced by a worker or served from the cache. |\n| response | <code>FastifyReply&lt;import(&quot;fastify&quot;).RouteGenericInterface, import(&quot;fastify&quot;).RawServerDefault, import(&quot;http&quot;).IncomingMessage, import(&quot;http&quot;).ServerResponse&lt;import(&quot;http&quot;).IncomingMessage&gt;, unknown, import(&quot;fastify&quot;).FastifySchema, import(&quot;fastify&quot;).FastifyTypeProviderDefault, unknown&gt;</code> | Fastify reply wrapping the raw HTTP response. |\n| outMeter | <code>Transform</code> | Optional pass-through transform placed between the source and the raw response to count streamed bytes (see `createOutMeter`). |\n\nsrc: packages/backend/src/utils/pipe.ts:27  \ndist: packages/backend/dist/utils/pipe.js:4\n","symbols":2,"lastUsed":1795079894641},"tdata:packages/backend/src/utils/versions.ts":{"doclets":[{"id":"PDQ_WASM_VERSION","longname":"PDQ_WASM_VERSION","name":"PDQ_WASM_VERSION","kind":"constant","scope":"global","description":"Version of the installed `pdq-wasm` package.","meta":{"lineno":42},"order":1,"mdaics":{"dist":"packages/backend/dist/utils/versions.js:29","src":"packages/backend/src/utils/versions.ts:46"},"level":0},{"id":"NODE_AV_VERSION","longname":"NODE_AV_VERSION","name":"NODE_AV_VERSION","kind":"constant","scope":"global","description":"Version of the installed `node-av` package (media backend).","meta":{"lineno":44},"order":2,"mdaics":{"dist":"packages/backend/dist/utils/versions.js:30","src":"packages/backend/src/utils/versions.ts:48"},"level":0},{"id":"SHARP_VERSION","longname":"SHARP_VERSION","name":"SHARP_VERSION","kind":"constant","scope":"global","description":"Version of the installed `sharp` package.","meta":{"lineno":46},"order":3,"mdaics":{"dist":"packages/backend/dist/utils/versions.js:31","src":"packages/backend/src/utils/versions.ts:50"},"level":0},{"id":"packageVersion","longname":"packageVersion","name":"packageVersion","kind":"function","scope":"global","description":"Reads an installed package's version from its `package.json`.\n\nSubpath imports such as `require('sharp/package.json')` are blocked by\nthose packages' `exports` maps, so the entry point is resolved first and\nthe directory tree is walked upward until the matching `package.json`\nis found.","params":[{"description":"The package name to look up.","name":"name","type":{"names":["string"]}},{"description":"Optional directory to start the walk-up from (defaults to the resolved package entry's directory).","name":"fromDir","type":{"names":["string"]}}],"returns":[{"description":"The package version string.","type":{"names":["string"]}}],"meta":{"lineno":16},"order":0,"mdaics":{"dist":"packages/backend/dist/utils/versions.js:5","src":"packages/backend/src/utils/versions.ts:18"},"level":0}],"fp":"2b269cd959f692db8ba88409acfb9c5777df788245bf34796f62a544bf46891f","issues":[],"kind":"tdata","lastUsed":1795079894619,"symbols":0},"md:packages/backend/src/utils/versions.ts":{"fp":"df6566adb6021295d5e2826db99dcc5c95f8ee7405b6b33895929296cb503e81","issues":[],"kind":"md","markdown":"## Constants\n\n<dl>\n<dt><a href=\"#PDQ_WASM_VERSION\">PDQ_WASM_VERSION</a></dt>\n<dd><p>Version of the installed <code>pdq-wasm</code> package.</p>\n</dd>\n<dt><a href=\"#NODE_AV_VERSION\">NODE_AV_VERSION</a></dt>\n<dd><p>Version of the installed <code>node-av</code> package (media backend).</p>\n</dd>\n<dt><a href=\"#SHARP_VERSION\">SHARP_VERSION</a></dt>\n<dd><p>Version of the installed <code>sharp</code> package.</p>\n</dd>\n</dl>\n\n## Functions\n\n<dl>\n<dt><a href=\"#packageVersion\">packageVersion(name, fromDir)</a> ⇒ <code>string</code></dt>\n<dd><p>Reads an installed package&#39;s version from its <code>package.json</code>.</p>\n<p>Subpath imports such as <code>require(&#39;sharp/package.json&#39;)</code> are blocked by\nthose packages&#39; <code>exports</code> maps, so the entry point is resolved first and\nthe directory tree is walked upward until the matching <code>package.json</code>\nis found.</p>\n</dd>\n</dl>\n\n<a name=\"PDQ_WASM_VERSION\"></a>\n\n## PDQ\\_WASM\\_VERSION\nVersion of the installed `pdq-wasm` package.\n\n**Kind**: global constant  \nsrc: packages/backend/src/utils/versions.ts:46  \ndist: packages/backend/dist/utils/versions.js:29\n<a name=\"NODE_AV_VERSION\"></a>\n\n## NODE\\_AV\\_VERSION\nVersion of the installed `node-av` package (media backend).\n\n**Kind**: global constant  \nsrc: packages/backend/src/utils/versions.ts:48  \ndist: packages/backend/dist/utils/versions.js:30\n<a name=\"SHARP_VERSION\"></a>\n\n## SHARP\\_VERSION\nVersion of the installed `sharp` package.\n\n**Kind**: global constant  \nsrc: packages/backend/src/utils/versions.ts:50  \ndist: packages/backend/dist/utils/versions.js:31\n<a name=\"packageVersion\"></a>\n\n## packageVersion(name, fromDir) ⇒ <code>string</code>\nReads an installed package's version from its `package.json`.\n\nSubpath imports such as `require('sharp/package.json')` are blocked by\nthose packages' `exports` maps, so the entry point is resolved first and\nthe directory tree is walked upward until the matching `package.json`\nis found.\n\n**Kind**: global function  \n**Returns**: <code>string</code> - The package version string.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| name | <code>string</code> | The package name to look up. |\n| fromDir | <code>string</code> | Optional directory to start the walk-up from (defaults to the resolved package entry's directory). |\n\nsrc: packages/backend/src/utils/versions.ts:18  \ndist: packages/backend/dist/utils/versions.js:5\n","symbols":4,"lastUsed":1795079894676},"tdata:packages/backend/src/utils/versions.spec.ts":{"doclets":[],"fp":"ca651df73d1887e7bda87a588a85ed36568e0b0a9c9a4c6509c2d8c5e4d4e44f","issues":[],"kind":"tdata","lastUsed":1795079894615,"symbols":0},"md:packages/backend/src/utils/versions.spec.ts":{"fp":"6e63660da7e2c70666c9cd94199aebfab4dabb9c5bd076dd55ff41b4fc13b777","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795079894618},"tdata:packages/backend/src/utils/zod.spec.ts":{"doclets":[],"fp":"696f416c7df167675ff9194f585a8e1980ee2089c7abbc0a97064193ae612fae","issues":[],"kind":"tdata","lastUsed":1795079894646,"symbols":0},"md:packages/backend/src/utils/zod.spec.ts":{"fp":"9356fbcd8a8d786fbaa3462018c74665e05493d624435c306b27db48d4204a7a","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795079894646},"tdata:packages/backend/src/utils/zod.ts":{"doclets":[{"id":"trimmed","longname":"trimmed","name":"trimmed","kind":"function","scope":"global","description":"Trim the input string, then validate it with the given schema.","params":[{"description":"The schema to apply after trimming.","name":"schema","type":{"names":["T"]}}],"returns":[{"description":"Zod pipe: string().trim() piped into `schema`.","type":{"names":["z.ZodPipe<z.ZodString, T>"]}}],"meta":{"lineno":7},"order":0,"mdaics":{"dist":"packages/backend/dist/utils/zod.js:2","src":"packages/backend/src/utils/zod.ts:8"},"level":0}],"fp":"07b1c6d86dccd7126a2445f4415950e1f193853eca0f8ce22636a45e8a565828","issues":[],"kind":"tdata","lastUsed":1795079894645,"symbols":0},"md:packages/backend/src/utils/zod.ts":{"fp":"58bf95d28de440a8b3bafc3fbd06da846cefed08bb2e63bdb29a275a8fb6fcc0","issues":[],"kind":"md","markdown":"<a name=\"trimmed\"></a>\n\n## trimmed(schema) ⇒ <code>z.ZodPipe&lt;z.ZodString, T&gt;</code>\nTrim the input string, then validate it with the given schema.\n\n**Kind**: global function  \n**Returns**: <code>z.ZodPipe&lt;z.ZodString, T&gt;</code> - Zod pipe: string().trim() piped into `schema`.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| schema | <code>T</code> | The schema to apply after trimming. |\n\nsrc: packages/backend/src/utils/zod.ts:8  \ndist: packages/backend/dist/utils/zod.js:2\n","symbols":1,"lastUsed":1795079894715},"tdata:packages/dashboard/src/components/IpDetailPage.tsx":{"doclets":[{"id":"IpDetailPage","longname":"IpDetailPage","name":"IpDetailPage","kind":"function","scope":"global","description":"Single client IP: its totals plus its share of the fleet's traffic.","params":[{"description":"Component props.","name":"props","type":{"names":["{ ip: string; }"]}},{"description":"The client IP to render.","name":"props.ip"}],"returns":[{"description":"The IP detail page.","type":{"names"