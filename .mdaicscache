| (string | number | boolean | { [x: string]: unknown; c?: { [x: string]: unknown; a: string; t: string; }[]; f?: string; l?: { [x: string]: unknown; Target?: string; Tooltip?: string; }; t?: \"b\" | \"n\" | \"s\" | \"d\" | \"e\" | \"z\"; v?: unknown; z?: string; })[])[]; cellDates?: boolean; cols?: { [x: string]: unknown; hidden?: boolean; level?: number; wch?: number; width?: number; wpx?: number; }[]; columns?: string[]; merges?: any[]; sheetVisibility?: 0 | 1 | 2; }[]; workbook?: { [x: string]: unknown; Names?: { [x: string]: unknown; Name: string; Ref: string; Sheet?: number; }[]; Props?: { [x: string]: unknown; Author?: string; Category?: string; Comments?: string; Company?: string; CreatedDate?: Date; Keywords?: string; Manager?: string; ModifiedBy?: string; ModifiedDate?: Date; Subject?: string; Title?: string; }; WBProps?: { [x: string]: unknown; CodeName?: string; date1904?: boolean; filterPrivacy?: boolean; }; }; }"]}}],"returns":[{"description":"The workbook bytes (201).","type":{"names":["Promise<void>"]}}],"meta":{"lineno":83},"async":true,"order":1,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/xlsx.controller.js:29","src":"packages/backend/src/resources/xlsx/xlsx.controller.ts:52"},"level":0},{"id":"XlsxController#extract","longname":"XlsxController#extract","name":"extract","kind":"function","scope":"instance","description":"Extracts one sheet as typed JSON.","memberof":"XlsxController","params":[{"description":"Flat reader options.","name":"query","type":{"names":["{ [x: string]: any; maxCells: number; raw: boolean; blankrows?: boolean; skipHidden?: boolean; }"]}}],"returns":[{"description":"The records and sheet name (201).","type":{"names":["Promise<{ records: unknown[]; sheet: string; truncated: boolean; } | { records: unknown[]; sheet: string; truncated?: undefined; }>"]}}],"meta":{"lineno":94},"order":2,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/xlsx.controller.js:35","src":"packages/backend/src/resources/xlsx/xlsx.controller.ts:69"},"level":0},{"id":"XlsxController#metadata","longname":"XlsxController#metadata","name":"metadata","kind":"function","scope":"instance","description":"Structural workbook metadata: dims, counts, props, names, formula inventory, cell census.","memberof":"XlsxController","params":[{"description":"Flat metadata options.","name":"query","type":{"names":["{ maxCells: number; }"]}}],"returns":[{"description":"The metadata document (201).","type":{"names":["Promise<{ custprops: object; definedNames: { name: string; ref: string; sheet: number; }[]; props: import(\"xlsx\").FullProperties; sheets: { autofilter: boolean; cells: number; cols: number; formulas: number; hidden: boolean; merges: number; name: string; ref: string; rows: number; types: { [k: string]: number; }; }[]; totalCells: number; }>"]}}],"meta":{"lineno":102},"order":3,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/xlsx.controller.js:38","src":"packages/backend/src/resources/xlsx/xlsx.controller.ts:82"},"level":0}],"fp":"9db4797017ab9aa703ff4822efcaefc6e11732bda878d2b3abe35082059fc0bb","issues":[],"kind":"tdata","lastUsed":1795079893419,"symbols":0},"md:packages/backend/src/resources/xlsx/xlsx.controller.ts":{"fp":"784a13fa6ee4b96476e03dd26d9e1054a263217be750a5b25e5ea415fc116a2d","issues":[],"kind":"md","markdown":"<a name=\"XlsxController\"></a>\n\n## XlsxController\nSpreadsheet routes. `/xlsx/build` consumes JSON (no media interceptors);\n`/xlsx/extract` and `/xlsx/metadata` take the binary upload and are\nClamAV-scanned like any other binary payload.\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/xlsx/xlsx.controller.ts:39  \ndist: packages/backend/dist/resources/xlsx/xlsx.controller.js:22\n\n* [XlsxController](#XlsxController)\n    * [.build(response, body)](#XlsxController+build) ⇒ <code>Promise&lt;void&gt;</code>\n    * [.extract(query)](#XlsxController+extract) ⇒ <code>Promise&lt;{ records: unknown[]; sheet: string; truncated: boolean; } \\| { records: unknown[]; sheet: string; truncated?: undefined; }&gt;</code>\n    * [.metadata(query)](#XlsxController+metadata) ⇒ <code>Promise&lt;{ custprops: object; definedNames: { name: string; ref: string; sheet: number; }[]; props: import(&quot;xlsx&quot;).FullProperties; sheets: { autofilter: boolean; cells: number; cols: number; formulas: number; hidden: boolean; merges: number; name: string; ref: string; rows: number; types: { [k: string]: number; }; }[]; totalCells: number; }&gt;</code>\n\n<a name=\"XlsxController+build\"></a>\n\n### xlsxController.build(response, body) ⇒ <code>Promise&lt;void&gt;</code>\nBuilds a workbook from JSON rows and cell objects.\n\n**Kind**: instance method of [<code>XlsxController</code>](#XlsxController)  \n**Returns**: <code>Promise&lt;void&gt;</code> - The workbook bytes (201).  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| response | <code>FastifyReply&lt;import(&quot;fastify&quot;).RouteGenericInterface, import(&quot;fastify&quot;).RawServerDefault, import(&quot;http&quot;).IncomingMessage, import(&quot;http&quot;).ServerResponse&lt;import(&quot;http&quot;).IncomingMessage&gt;, unknown, import(&quot;fastify&quot;).FastifySchema, import(&quot;fastify&quot;).FastifyTypeProviderDefault, unknown&gt;</code> | Raw reply, streamed as `.xlsx`. |\n| body | <code>{ sheets: { [x: string]: any; rows: (Record&lt;string, string \\| number \\| boolean \\| { [x: string]: unknown; c?: { [x: string]: unknown; a: string; t: string; }[]; f?: string; l?: { [x: string]: unknown; Target?: string; Tooltip?: string; }; t?: &quot;b&quot; \\| &quot;n&quot; \\| &quot;s&quot; \\| &quot;d&quot; \\| &quot;e&quot; \\| &quot;z&quot;; v?: unknown; z?: string; }&gt; \\| (string \\| number \\| boolean \\| { [x: string]: unknown; c?: { [x: string]: unknown; a: string; t: string; }[]; f?: string; l?: { [x: string]: unknown; Target?: string; Tooltip?: string; }; t?: &quot;b&quot; \\| &quot;n&quot; \\| &quot;s&quot; \\| &quot;d&quot; \\| &quot;e&quot; \\| &quot;z&quot;; v?: unknown; z?: string; })[])[]; cellDates?: boolean; cols?: { [x: string]: unknown; hidden?: boolean; level?: number; wch?: number; width?: number; wpx?: number; }[]; columns?: string[]; merges?: any[]; sheetVisibility?: 0 \\| 1 \\| 2; }[]; workbook?: { [x: string]: unknown; Names?: { [x: string]: unknown; Name: string; Ref: string; Sheet?: number; }[]; Props?: { [x: string]: unknown; Author?: string; Category?: string; Comments?: string; Company?: string; CreatedDate?: Date; Keywords?: string; Manager?: string; ModifiedBy?: string; ModifiedDate?: Date; Subject?: string; Title?: string; }; WBProps?: { [x: string]: unknown; CodeName?: string; date1904?: boolean; filterPrivacy?: boolean; }; }; }</code> | Sheets, workbook properties, defined names. |\n\nsrc: packages/backend/src/resources/xlsx/xlsx.controller.ts:52  \ndist: packages/backend/dist/resources/xlsx/xlsx.controller.js:29\n<a name=\"XlsxController+extract\"></a>\n\n### xlsxController.extract(query) ⇒ <code>Promise&lt;{ records: unknown[]; sheet: string; truncated: boolean; } \\| { records: unknown[]; sheet: string; truncated?: undefined; }&gt;</code>\nExtracts one sheet as typed JSON.\n\n**Kind**: instance method of [<code>XlsxController</code>](#XlsxController)  \n**Returns**: <code>Promise&lt;{ records: unknown[]; sheet: string; truncated: boolean; } \\| { records: unknown[]; sheet: string; truncated?: undefined; }&gt;</code> - The records and sheet name (201).  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| query | <code>{ [x: string]: any; maxCells: number; raw: boolean; blankrows?: boolean; skipHidden?: boolean; }</code> | Flat reader options. |\n\nsrc: packages/backend/src/resources/xlsx/xlsx.controller.ts:69  \ndist: packages/backend/dist/resources/xlsx/xlsx.controller.js:35\n<a name=\"XlsxController+metadata\"></a>\n\n### xlsxController.metadata(query) ⇒ <code>Promise&lt;{ custprops: object; definedNames: { name: string; ref: string; sheet: number; }[]; props: import(&quot;xlsx&quot;).FullProperties; sheets: { autofilter: boolean; cells: number; cols: number; formulas: number; hidden: boolean; merges: number; name: string; ref: string; rows: number; types: { [k: string]: number; }; }[]; totalCells: number; }&gt;</code>\nStructural workbook metadata: dims, counts, props, names, formula inventory, cell census.\n\n**Kind**: instance method of [<code>XlsxController</code>](#XlsxController)  \n**Returns**: <code>Promise&lt;{ custprops: object; definedNames: { name: string; ref: string; sheet: number; }[]; props: import(&quot;xlsx&quot;).FullProperties; sheets: { autofilter: boolean; cells: number; cols: number; formulas: number; hidden: boolean; merges: number; name: string; ref: string; rows: number; types: { [k: string]: number; }; }[]; totalCells: number; }&gt;</code> - The metadata document (201).  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| query | <code>{ maxCells: number; }</code> | Flat metadata options. |\n\nsrc: packages/backend/src/resources/xlsx/xlsx.controller.ts:82  \ndist: packages/backend/dist/resources/xlsx/xlsx.controller.js:38\n","symbols":4,"lastUsed":1795079893516},"tdata:packages/backend/src/resources/xlsx/xlsx.failure.spec.ts":{"doclets":[],"fp":"4f2d964ceb2ccae0be37cee7c1c7ca76fd75a6d0dc1ceca13079f16eb6f383e9","issues":[],"kind":"tdata","lastUsed":1795079893418,"symbols":0},"md:packages/backend/src/resources/xlsx/xlsx.failure.spec.ts":{"fp":"05e7ed7b5cfdd36ec3e5e6bcf73230bc9da830171bc1c404e02512e6375096b1","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","skipped":"no-jsdoc","symbols":0,"lastUsed":1795079893419},"tdata:packages/backend/src/resources/xlsx/xlsx.module.ts":{"doclets":[{"id":"XlsxModule","longname":"XlsxModule","name":"XlsxModule","kind":"member","scope":"global","description":"XLSX feature module: build, extract and metadata routes.","params":[],"meta":{"lineno":41},"order":0,"mdaics":{"dist":"packages/backend/dist/resources/xlsx/xlsx.module.js:17","src":"packages/backend/src