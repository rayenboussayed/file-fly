ckend/dist/resources/docx/docx.controller.js:28","src":"packages/backend/src/resources/docx/docx.controller.ts:41"},"level":0},{"id":"DocxController#extract","longname":"DocxController#extract","name":"extract","kind":"function","scope":"instance","description":"Extracts text and structure from an uploaded .docx (201).","memberof":"DocxController","params":[{"description":"Empty query object; junk parameters are rejected with 400.","name":"_query","type":{"names":["unknown"]}}],"returns":[{"description":"The extracted metadata, structure and body text.","type":{"names":["Promise<{ format: string; metadata: any; structure: { headings: { level: number; text: string; }[]; hyperlinks: any; images: { alts: string[]; count: number; }; lists: number; tables: any; }; text: string; }>"]}}],"meta":{"lineno":93},"order":2,"mdaics":{"dist":"packages/backend/dist/resources/docx/docx.controller.js:34","src":"packages/backend/src/resources/docx/docx.controller.ts:60"},"level":0},{"id":"DocxController#metadata","longname":"DocxController#metadata","name":"metadata","kind":"function","scope":"instance","description":"Normalized OOXML metadata for an uploaded .docx (201).","memberof":"DocxController","params":[{"description":"Empty query object; junk parameters are rejected with 400.","name":"_query","type":{"names":["unknown"]}}],"returns":[{"description":"The metadata document.","type":{"names":["Promise<any>"]}}],"meta":{"lineno":101},"order":3,"mdaics":{"dist":"packages/backend/dist/resources/docx/docx.controller.js:37","src":"packages/backend/src/resources/docx/docx.controller.ts:73"},"level":0}],"fp":"0b92e6f7473cc0a6311e39e1edb8752d0032ae5a9a89824746a9012108382c67","issues":[],"kind":"tdata","lastUsed":1795730449246,"symbols":0},"md:packages/backend/src/resources/docx/docx.controller.spec.ts":{"fp":"5d2a7fd74863b71a8dc3fc0f103ccd66d570f686bb6e2d6da2977432635b5725","issues":["dist file not found — dist: line omitted (build first)"],"kind":"md","markdown":"<a name=\"rawSink\"></a>\n\n## rawSink() ⇒ <code>Writable &amp; { setHeader: ReturnType&lt;typeof vi.fn&gt;; }</code>\nCreates a Writable raw sink with `setHeader` mocks for assertions.\n\n**Kind**: global function  \n**Returns**: <code>Writable &amp; { setHeader: ReturnType&lt;typeof vi.fn&gt;; }</code> - A writable with a mocked `setHeader`.  \nsrc: packages/backend/src/resources/docx/docx.controller.spec.ts:10  \n","symbols":1,"lastUsed":1795730449295},"md:packages/backend/src/resources/docx/docx.controller.ts":{"fp":"2e789958ffb9621e8c46765b56ce4ea9c97f3641f7999de45663eb30dade9a8e","issues":[],"kind":"md","markdown":"<a name=\"DocxController\"></a>\n\n## DocxController\nDOCX routes. `/docx/build` consumes JSON and bypasses the media\ninterceptors by design (JSON bodies are never virus-scanned or signature-probed);\n`/docx/extract` and `/docx/metadata` take the binary upload and are ClamAV-scanned.\n\n**Kind**: global variable  \nsrc: packages/backend/src/resources/docx/docx.controller.ts:28  \ndist: packages/backend/dist/resources/docx/docx.controller.js:21\n\n* [DocxController](#DocxController)\n    * [.build(response, body)](#DocxController+build) ⇒ <code>Promise&lt;void&gt;</code>\n    * [.extract(_query)](#DocxController+extract) ⇒ <code>Promise&lt;{ format: string; metadata: any; structure: { headings: { level: number; text: string; }[]; hyperlinks: any; images: { alts: string[]; count: number; }; lists: number; tables: any; }; text: string; }&gt;</code>\n    * [.metadata(_query)](#DocxController+metadata) ⇒ <code>Promise&lt;any&gt;</code>\n\n<a name=\"DocxController+build\"></a>\n\n### docxController.build(response, body) ⇒ <code>Promise&lt;void&gt;</code>\nBuilds a .docx from the JSON payload (201).\n\n**Kind**: instance method of [<code>DocxController</code>](#DocxController)  \n**Returns**: <code>Promise&lt;void&gt;</code> - The document bytes (201).  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| response | <code>FastifyReply&lt;import(&quot;fastify&quot;).Route