ingle&quot; \\| &quot;double&quot; \\| &quot;thick&quot; \\| &quot;dotted&quot; \\| &quot;dotDash&quot; \\| &quot;wave&quot; \\| &quot;dashed&quot;; size?: number; }; }; headerRow?: boolean; layout?: &quot;fixed&quot; \\| &quot;autofit&quot;; width?: number; } \\| { levels: number; title: string; type: &quot;toc&quot;; } \\| { type: &quot;pageBreak&quot;; } \\| { type: &quot;columnBreak&quot;; } \\| { type: &quot;thematicBreak&quot;; }</code> | The element descriptor. |\n\nsrc: packages/backend/src/resources/docx/elements.ts:275  \ndist: packages/backend/dist/resources/docx/elements.js:200\n<a name=\"buildSectionOptions\"></a>\n\n## buildSectionOptions ⇒ <code>{ column: { count: number; space: number; }; page: { margin: { bottom: number; left: number; right: number; top: number; }; size: { height: number; orientation: &quot;portrait&quot; \\| &quot;landscape&quot;; width: number; }; }; type: &quot;continuous&quot; \\| &quot;nextColumn&quot; \\| &quot;nextPage&quot; \\| &quot;evenPage&quot; \\| &quot;oddPage&quot;; }</code>\nSection options for the packer.\n\n**Kind**: global constant  \n**Returns**: <code>{ column: { count: number; space: number; }; page: { margin: { bottom: number; left: number; right: number; top: number; }; size: { height: number; orientation: &quot;portrait&quot; \\| &quot;landscape&quot;; width: number; }; }; type: &quot;continuous&quot; \\| &quot;nextColumn&quot; \\| &quot;nextPage&quot; \\| &quot;evenPage&quot; \\| &quot;oddPage&quot;; }</code> - The packer section options.  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| section | <code>{ properties?: { columns?: number \\| { count: number; spacing: number; }; margins?: { bottom?: number; left?: number; right?: number; top?: number; }; orientation?: &quot;landscape&quot; \\| &quot;portrait&quot;; pageSize?: { height: number; width: number; }; sectionType?: &quot;continuous&quot; \\| &quot;evenPage&quot; \\| &quot;nextColumn&quot; \\| &quot;nextPage&quot; \\| &quot;oddPage&quot;; }; }</code> | The section descriptor. |\n| section.properties |  | The section properties. |\n| section.properties.columns |  | Column count, or count plus spacing in points. |\n| section.properties.margins |  | Page margins in twentieths of a point (twips). |\n| section.properties.margins.bottom |  | Bottom margin (twips). |\n| section.properties.margins.left |  | Left margin (twips). |\n| section.properties.margins.right |  | Right margin (twips). |\n| section.properties.margins.top |  | Top margin (twips). |\n| section.properties.orientation |  | Page orientation. |\n| section.properties.pageSize |  | Page dimensions. |\n| section.properties.pageSize.height |  | Page height (twips). |\n| section.properties.pageSize.width |  | Page width (twips). |\n| section.properties.sectionType |  | Section break type. |\n\nsrc: packages/backend/src/resources/docx/elements.ts:378  \ndist: packages/backend/dist/resources/docx/elements.js:270\n<a name=\"buildRun\"></a>\n\n## buildRun(run) ⇒ <code>EndnoteReferenceRun \\| FootnoteReferenceRun \\| TextRun</code>\nBuilds one TextRun-like component from a run descriptor.\n\n**Kind**: global function  \n**Returns**: <code>EndnoteReferenceRun \\| FootnoteReferenceRun \\| TextRun</code> - The built run (text, footnote or endnote reference).  \n\n| Param | Type | Description |\n| --- | --- | --- |\n| run | <code>{ [x: string]: any; text: string; allCaps?: boolean; bold?: boolean; break?: number; doubleStrike?: boolean; endnote?: number; footnote?: number; highlight?: &quot;black&quot; \\| &quot;blue&quot; \\| &quot;cyan&quot; \\| &quot;darkBlue&quot; \\| &quot;darkCyan&quot; \\| &quot;darkGray&quot; \\| &quot;darkGreen&quot; \\| &quot;darkMagenta&quot; \\| &quot;darkRed&quot; \\| &quot;darkYellow&quot; \\| &quot;green&quot; \\| &quot;lightGray&quot; \\| &quot;magenta&quot; \\| &quot;none&quot; \\| &quot;red&quot; \\| &quot;white&quot; \\| &quot;yellow&quot;; italics?: boolean; language?: string; smallCaps?: boolean; strike?: boolean; subS