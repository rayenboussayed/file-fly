/backend/src/resources/model/model.service.ts:158"},"level":0},{"id":"mimeFor","longname":"mimeFor","name":"mimeFor","kind":"function","scope":"global","description":"Rewrites resource URIs to data URIs so the .gltf is a single self-contained file.","params":[{"description":"The resource URI.","name":"uri","type":{"names":["string"]}}],"returns":[{"description":"The best-known MIME type for the resource.","type":{"names":["string"]}}],"meta":{"lineno":354},"order":11,"mdaics":{"dist":"packages/backend/dist/resources/model/model.service.js:354 (approx.)","src":"packages/backend/src/resources/model/model.service.ts:330"},"level":0},{"id":"inlineResources","longname":"inlineResources","name":"inlineResources","kind":"function","scope":"global","description":"Rewrites resource URIs to data URIs so the .gltf is a single self-contained file.","params":[{"description":"The glTF JSON document to rewrite in place.","name":"json","type":{"names":["GLTF.IGLTF"]}},{"description":"The resource map from writeJSON.","name":"resources","type":{"names":["{ [s: string]: Uint8Array<ArrayBuffer>; }"]}}],"meta":{"lineno":376},"order":12,"mdaics":{"dist":"packages/backend/dist/resources/model/model.service.js:376 (approx.)","src":"packages/backend/src/resources/model/model.service.ts:346"},"level":0},{"id":"ModelService#convert","longname":"ModelService#convert","name":"convert","kind":"function","scope":"instance","description":"Converts the uploaded GLB between container formats.\n`glb`: binary container (lossless round-trip). `gltf`: self-contained JSON with data URIs.","memberof":"ModelService","params":[{"description":"Target container.","name":"query","type":{"names":["{ to: \"glb\" | \"gltf\"; }"]}}],"returns":[{"description":"The converted bytes.","type":{"names":["Promise<Buffer<ArrayBufferLike>>"]}}],"meta":{"lineno":283},"async":true,"order":7,"mdaics":{"dist":"packages/backend/dist/resources/model/model.service.js:283 (approx.)","src":"packages/backend/src/resources/model/mod