{
  "name": "file-fly",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "npm run build && npm run typecheck && npm run lint && npm run test:full && npm run knip",
    "build": "npm run build --workspaces --if-present",
    "deploy": "npm run deploy -w file-fly-backend",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/test/**/*.{ts,tsx}\"",
    "start": "npm run start -w file-fly-backend",
    "start:dev": "npm run start:dev -w file-fly-backend",
    "start:debug": "npm run start:debug -w file-fly-backend",
    "start:prod": "npm run start:prod -w file-fly-backend",
    "test": "npm run test --workspaces --if-present",
    "test:perf": "npm run test:perf --workspaces --if-present",
    "test:mem": "npm run test:mem --workspaces --if-present",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "test:cov": "npm run test:cov --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "test:full": "npm run test:full --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --fix --cache --max-warnings=0",
    "knip": "knip --cache",
    "knip:fix": "knip -f --cache",
    "prepare": "husky",
    "script:union-to-enum": "npm run script:union-to-enum -w file-fly-backend",
    "docs": "mdaics"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@stackrb/eslint-config": "0.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-unicorn": "80.0.0",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "mdaics": "^1.0.0",
    "prettier": "^3.4.2"
  },
  "allowScripts": {
    "node-av@6.2.0": true
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "^2.1.0"
    }
  }
}
