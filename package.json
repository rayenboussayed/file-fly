{
  "name": "file-fly",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run test:full && npm run knip && npm run build",
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint . --fix --cache --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:perf": "vitest bench --run --config ./vitest.config.perf.ts",
    "test:mem": "vitest run --config ./vitest.config.mem.ts",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "npm run build && vitest run --config ./vitest.config.e2e.ts",
    "test:full": "npm run test && npm run test:e2e",
    "knip": "knip --cache",
    "knip:fix": "knip -f --cache",
    "prepare": "husky",
    "script:union-to-enum": "node scripts/union-to-enum.js --file node_modules/node-av/dist/constants/formats.d.ts --types DemuxerFormat MuxerFormat --output src/constants/av-formats.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "file-type": "^22.3.0",
    "jutilities": "^1.2.0",
    "nestjs-cls": "^7.0.2",
    "node-av": "^6.2.0",
    "pdq-wasm": "^0.3.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "undici": "^8.12.3",
    "zod": "^4.6.7",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@deslint/eslint-plugin": "^0.10.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.0.0",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-de-morgan": "^2.3.0",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-deprecate": "^0.9.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.3.2",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.13.0",
    "knip": "^6.44.1",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  },
  "allowScripts": {
    "node-av@6.2.0": true
  }
}
