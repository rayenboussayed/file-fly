{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": [
    "-lintignore"
  ],
  "workspaces": {
    "packages/dashboard": {
      "entry": [
        "src/**/*.spec.ts",
        "src/**/*.spec.tsx",
        "test/e2e/**/*.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "test/e2e/**/*.ts"
      ]
    },
    "packages/backend": {
      "entry": [
        "src/main.ts",
        "test/helpers.ts",
        "test/fake-clamd.ts",
        "test/*.e2e-spec.ts",
        "src/**/worker/*.ts",
        "src/**/*.spec.ts",
        "test/perf/*.bench.ts",
        "test/mem/*.spec.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ],
      "nest": {
        "config": [
          "nest-cli.json",
          ".nestcli.json",
          ".nest-cli.json",
          "nest.json"
        ]
      }
    }
  },
  "ignoreDependencies": [
    "fastify",
    "@nestjs/mau",
    "@types/eslint-plugin-security",
    "source-map-support"
  ],
  "ignoreBinaries": [],
  "ignore": [
    "mdaics.config.js"
  ]
}
